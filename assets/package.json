                "fetch": "lazy",
                "enabled": true
            },
            "article_filters": {
                "main": "controllers/article_filters_controller.js",
                "name": "article-filters",
                "fetch": "lazy",
                "enabled": true
            },
            "back_to_top": {
                "main": "controllers/back_to_top_controller.js",
                "name": "back-to-top",
                "fetch": "lazy",
                "enabled": true
