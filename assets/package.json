            "location_map": {
                "main": "controllers/location_map_controller.js",
                "name": "location-map",
                "fetch": "lazy",
                "enabled": true
            },
            "combobox": {
                "main": "controllers/combobox_controller.js",
                "name": "combobox",
                "fetch": "lazy",
                "enabled": true
            },
            "fileinput": {
                "main": "controllers/fileinput_controller.js",
