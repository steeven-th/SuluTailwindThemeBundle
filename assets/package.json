                "fetch": "lazy",
                "enabled": true
            },
            "slider": {
                "main": "controllers/slider_controller.js",
                "name": "slider",
                "fetch": "lazy",
                "enabled": true
            },
            "hero_parallax": {
                "main": "controllers/hero_parallax_controller.js",
                "name": "hero-parallax",
                "fetch": "lazy",
                "enabled": true
            },
            "carousel3d": {
                "main": "controllers/carousel3d_controller.js",
                "name": "carousel3d",
                "fetch": "lazy",
                "enabled": true
            },
            "key_figures": {
                "main": "controllers/key_figures_controller.js",
                "name": "key-figures",
                "fetch": "lazy",
                "enabled": true
            },
            "location_overlay": {
                "main": "controllers/location_overlay_controller.js",
                "name": "location-overlay",
                "fetch": "lazy",
                "enabled": true
