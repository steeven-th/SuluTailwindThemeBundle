{
    "name": "@itech-world/sulu-tailwind-theme-bundle",
    "description": "Frontend assets (Stimulus controllers, CSS) for SuluTailwindThemeBundle",
    "license": "MIT",
    "style": "styles/app.css",
    "dependencies": {
        "glightbox": "^3.3.0",
        "leaflet": "^1.9.4"
    },
    "symfony": {
        "controllers": {
            "lightbox": {
                "main": "controllers/lightbox_controller.js",
