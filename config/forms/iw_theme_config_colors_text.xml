<?xml version="1.0" ?>
<!--
    Admin form: Colors tab, Text sub-tab.

    Body text and links, stored apart from the palette because they carry no
    shades.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_colors_text</key>

    <properties>
        <property name="colors_text" type="iw_theme_color_token_editor" colspan="4">
            <meta>
                <title>iw_sulu_tailwind_theme.colors_text</title>
            </meta>
        </property>

        <property name="colors_link" type="iw_theme_color_token_editor" colspan="4">
            <meta>
                <title>iw_sulu_tailwind_theme.colors_link</title>
            </meta>
        </property>

        <property name="colors_linkHover" type="iw_theme_color_token_editor" colspan="4">
            <meta>
                <title>iw_sulu_tailwind_theme.colors_linkHover</title>
            </meta>
        </property>
    </properties>
</form>
