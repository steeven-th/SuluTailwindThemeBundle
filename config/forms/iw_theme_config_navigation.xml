<?xml version="1.0" ?>
<!--
    Admin form: Default settings tab, Navigation sub-tab.

    What carries the visitor around the site rather than through a page: the
    breadcrumb, the pagination of a list, and the back to top button.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_navigation</key>

    <properties>
        <!-- Breadcrumb section -->
        <section name="componentsBreadcrumb">
            <meta>
                <title>iw_sulu_tailwind_theme.components_section_breadcrumb</title>
            </meta>
            <properties>
                <property name="components_breadcrumbText" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_text</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_breadcrumbCurrent" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_current</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_breadcrumbAccent" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_accent</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="breadcrumbs_enabled" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.breadcrumbs_enabled</title></meta>
                    <params>
                        <param name="default_value" value="both"/>
                        <param name="values" type="collection">
                            <param name="off"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_enabled_off</title></meta></param>
                            <param name="pages"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_enabled_pages</title></meta></param>
                            <param name="articles"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_enabled_articles</title></meta></param>
                            <param name="both"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_enabled_both</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="breadcrumbs_separator" type="single_select" colspan="6"
                          visibleCondition="breadcrumbs_enabled != 'off'">
                    <meta><title>iw_sulu_tailwind_theme.breadcrumbs_separator</title></meta>
                    <params>
                        <param name="default_value" value="chevron"/>
                        <param name="values" type="collection">
                            <param name="chevron"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_separator_chevron</title></meta></param>
                            <param name="slash"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_separator_slash</title></meta></param>
                            <param name="dot"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_separator_dot</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="breadcrumbs_align" type="single_select" colspan="6"
                          visibleCondition="breadcrumbs_enabled != 'off'">
                    <meta><title>iw_sulu_tailwind_theme.breadcrumbs_align</title></meta>
                    <params>
                        <param name="default_value" value="left"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_align_left</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_align_center</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.breadcrumbs_align_right</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="breadcrumbs_homeLabel" type="text_line" colspan="6"
                          visibleCondition="breadcrumbs_enabled != 'off' AND breadcrumbs_homeLink == true">
                    <meta><title>iw_sulu_tailwind_theme.breadcrumbs_home_label</title></meta>
                </property>

                <property name="breadcrumbs_homeLink" type="checkbox" colspan="6"
                          visibleCondition="breadcrumbs_enabled != 'off'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.breadcrumbs_home_link</title>
                            </meta>
                        </param>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Pagination colors (empty = inherit the global surfaces) -->
        <section name="componentsPagination">
            <meta>
                <title>iw_sulu_tailwind_theme.components_section_pagination</title>
            </meta>
            <properties>
                <property name="components_paginationText" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_text</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_paginationAccent" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_accent</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
            </properties>
        </section>

        <!-- Site-wide components: floating helpers shown across the whole site
             (rendered in base.html.twig). Opt-in (off by default). -->
        <section name="componentsBackToTop">
            <meta>
                <title>iw_sulu_tailwind_theme.components_section_back_to_top</title>
            </meta>
            <properties>
                <property name="components_backToTopEnabled" type="checkbox" colspan="6">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.components_back_to_top_enabled</title></meta></param>
                    </params>
                </property>
                <property name="components_backToTopThreshold" type="number" colspan="6"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.components_back_to_top_threshold</title></meta>
                    <params>
                        <param name="default_value" value="400"/>
                    </params>
                </property>

                <property name="components_backToTopShape" type="iw_theme_radius_selector" colspan="12"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.components_back_to_top_shape</title></meta>
                    <params><param name="default_value" value="rounded-full"/></params>
                </property>

                <property name="components_backToTopSize" type="single_select" colspan="6"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.components_back_to_top_size</title></meta>
                    <params>
                        <param name="default_value" value="md"/>
                        <param name="values" type="collection">
                            <param name="sm"><meta><title>iw_sulu_tailwind_theme.components_back_to_top_size_sm</title></meta></param>
                            <param name="md"><meta><title>iw_sulu_tailwind_theme.components_back_to_top_size_md</title></meta></param>
                            <param name="lg"><meta><title>iw_sulu_tailwind_theme.components_back_to_top_size_lg</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="components_backToTopBg" type="iw_theme_color_token_editor" colspan="6"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.components_back_to_top_bg</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <!-- Empty: the background mixed towards the text, so the button
                     reacts whatever background it was given. -->
                <property name="components_backToTopHoverBg" type="iw_theme_color_token_editor" colspan="6"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_back_to_top_hover_bg</title>
                        <info_text>iw_sulu_tailwind_theme.components_back_to_top_hover_bg_info</info_text>
                    </meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="components_backToTopIconColor" type="iw_theme_color_token_editor" colspan="6"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.components_back_to_top_icon_color</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="backToTopIconHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.config_group_icon</title></meta>
                        </param>
                    </params>
                </property>

                <!--
                    The whole library rather than the four shapes this field
                    used to offer. Those four are still stored on existing
                    themes and still render: the template reads them through a
                    table of equivalents, which is enough when the old set of
                    values is finite and known - cheaper than a migration
                    command, and it cannot half-run.
                -->
                <property name="components_backToTopIcon" type="single_icon_selection" colspan="6"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_back_to_top_icon</title>
                    </meta>
                    <params>
                        <param name="icon_set" value="iw_theme_outline"/>
                    </params>
                </property>

                <!-- Custom icon from the media library, overrides the preset above. -->
                <property name="components_backToTopIconMedia" type="single_media_selection" colspan="12"
                          visibleCondition="components_backToTopEnabled == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_back_to_top_icon_media</title>
                        <info_text>iw_sulu_tailwind_theme.components_back_to_top_icon_media_info</info_text>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>
            </properties>
        </section>

        <!--
            The arrows, dots and chevrons that move a visitor through a block.
            They split by what they sit on, which is the rule the surfaces
            already follow: whoever guarantees the background guarantees what
            reads on it.
        -->
        <section name="componentsControls">
            <meta>
                <title>iw_sulu_tailwind_theme.components_section_controls</title>
                <info_text>iw_sulu_tailwind_theme.components_section_controls_info</info_text>
            </meta>
            <properties>
                <!-- On the content: the variant paints the text around them, so
                     an empty field means they follow it. -->
                <property name="components_controlsOnContentColor" type="iw_theme_color_token_editor" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_on_content_color</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_on_content_color_info</info_text>
                    </meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <!-- On a media: the variant can say nothing about a photograph
                     the editor chose, so these carry their own colour. -->
                <property name="components_controlsOnMediaColor" type="iw_theme_color_token_editor" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_on_media_color</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_on_media_color_info</info_text>
                    </meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="components_controlsOnMediaBg" type="iw_theme_color_token_editor" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_on_media_bg</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_on_media_bg_info</info_text>
                    </meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>


                <property name="components_controlsOnMediaBgHover" type="iw_theme_color_token_editor" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_on_media_bg_hover</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_on_media_bg_hover_info</info_text>
                    </meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="controlsIconHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.config_group_icon</title></meta>
                        </param>
                    </params>
                </property>

                <!--
                    The same pair every pictogram of the bundle offers: one from
                    the theme library, or one of the project's own from the
                    media library. A toggle decides, so the two never compete
                    for the same slot.
                -->
                <property name="components_controlsArrowIconCustom" type="checkbox" colspan="12">
                    <meta>
                        <info_text>iw_sulu_tailwind_theme.components_controls_arrow_icon_custom_info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.components_controls_arrow_icon_custom</title></meta>
                        </param>
                    </params>
                </property>

                <property name="components_controlsArrowIcon" type="single_icon_selection" colspan="6"
                          visibleCondition="components_controlsArrowIconCustom != true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_arrow_icon</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_arrow_icon_info</info_text>
                    </meta>
                    <params>
                        <param name="icon_set" value="iw_theme_outline"/>
                    </params>
                </property>

                <property name="components_controlsArrowIconMedia" type="single_media_selection" colspan="12"
                          visibleCondition="components_controlsArrowIconCustom == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_arrow_icon_media</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_arrow_icon_media_info</info_text>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>

                <property name="components_controlsArrowIconSize" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_arrow_icon_size</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_arrow_icon_size_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.button_icon_size_auto</title></meta></param>
                            <param name="16"><meta><title>16 px</title></meta></param>
                            <param name="24"><meta><title>24 px</title></meta></param>
                            <param name="32"><meta><title>32 px</title></meta></param>
                            <param name="48"><meta><title>48 px</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="controlsButtonHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.components_controls_group_button</title></meta>
                        </param>
                    </params>
                </property>

                <!-- The disc the arrows over a media sit in. -->
                <property name="components_controlsShape" type="iw_theme_radius_selector" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_shape</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_shape_info</info_text>
                    </meta>
                </property>

                <property name="components_controlsButtonSize" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_controls_button_size</title>
                        <info_text>iw_sulu_tailwind_theme.components_controls_button_size_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.button_icon_size_auto</title></meta></param>
                            <param name="sm"><meta><title>iw_sulu_tailwind_theme.components_controls_button_size_sm</title></meta></param>
                            <param name="md"><meta><title>iw_sulu_tailwind_theme.components_controls_button_size_md</title></meta></param>
                            <param name="lg"><meta><title>iw_sulu_tailwind_theme.components_controls_button_size_lg</title></meta></param>
                        </param>
                    </params>
                </property>

            </properties>
        </section>
    </properties>
</form>
