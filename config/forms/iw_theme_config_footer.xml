<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_footer</key>

    <properties>
        <!-- Footer Layout -->
        <section name="footerSettings">
            <meta>
                <title>iw_sulu_tailwind_theme.footer_settings</title>
            </meta>
            <properties>
                <property name="footerConfig_type" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_type</title>
                        <info_text>iw_sulu_tailwind_theme.footer_type_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" type="string" value="columns"/>
                        <param name="values" type="collection">
                            <param name="columns">
                                <meta><title>iw_sulu_tailwind_theme.footer_type_columns</title></meta>
                            </param>
                            <param name="centered">
                                <meta><title>iw_sulu_tailwind_theme.footer_type_centered</title></meta>
                            </param>
                            <param name="minimal">
                                <meta><title>iw_sulu_tailwind_theme.footer_type_minimal</title></meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="footerConfig_mutedText" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_mutedText</title>
                        <info_text>iw_sulu_tailwind_theme.footer_mutedText_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Colors: three per row, each falls back to the footer's surroundings when empty -->
        <section name="footerColors">
            <meta>
                <title>iw_sulu_tailwind_theme.footer_colors</title>
            </meta>
            <properties>
                <property name="footerConfig_colors_bg" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_bg</title>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                        <param name="allow_gradient" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_text" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_text</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_text_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_title" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_title</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_title_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_link" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_link</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_link_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_linkHover" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_linkHover</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_linkHover_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_accent" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_accent</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_accent_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_divider" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_divider</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_divider_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_socialMedia" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_socialMedia</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_socialMedia_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>

                <property name="footerConfig_colors_socialMediaHover" type="iw_theme_color_token_editor" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_colors_socialMediaHover</title>
                        <info_text>iw_sulu_tailwind_theme.footer_colors_socialMediaHover_info</info_text>
                    </meta>
                    <params>
                        <param name="show_palette" value="true"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Display Options -->
        <section name="footerDisplay">
            <meta>
                <title>iw_sulu_tailwind_theme.footer_display</title>
            </meta>
            <properties>
                <property name="footerConfig_displayLogo" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_displayLogo</title>
                    </meta>
                </property>

                <!-- Full width: a media selection is taller than the toggle that
                     reveals it, and the row would read broken with both on it. -->
                <property name="footerConfig_logo" type="single_media_selection" colspan="12"
                          visibleCondition="footerConfig_displayLogo == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_logo</title>
                        <info_text>iw_sulu_tailwind_theme.footer_logo_info</info_text>
                    </meta>
                </property>

                <property name="footerConfig_logoHeight" type="number" colspan="6"
                          visibleCondition="footerConfig_displayLogo == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_logoHeight</title>
                        <info_text>iw_sulu_tailwind_theme.footer_logoHeight_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="40"/>
                        <param name="min" value="12"/>
                        <param name="max" value="200"/>
                    </params>
                </property>

                <property name="footerConfig_displaySiteName" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_displaySiteName</title>
                    </meta>
                </property>

                <property name="footerConfig_siteNamePosition" type="single_select" colspan="6"
                          visibleCondition="footerConfig_displaySiteName == true AND footerConfig_displayLogo == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_siteNamePosition</title>
                        <info_text>iw_sulu_tailwind_theme.footer_siteNamePosition_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" type="string" value="beside"/>
                        <param name="values" type="collection">
                            <param name="beside">
                                <meta><title>iw_sulu_tailwind_theme.footer_siteNamePosition_beside</title></meta>
                            </param>
                            <param name="below">
                                <meta><title>iw_sulu_tailwind_theme.footer_siteNamePosition_below</title></meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="footerConfig_tagline" type="text_line" colspan="12"
                          visibleCondition="footerConfig_type == 'columns' OR footerConfig_type == 'centered'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_tagline</title>
                        <info_text>iw_sulu_tailwind_theme.footer_tagline_info</info_text>
                    </meta>
                </property>

                <property name="footerConfig_displaySocialMedia" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_displaySocialMedia</title>
                        <info_text>iw_sulu_tailwind_theme.footer_displaySocialMedia_info</info_text>
                    </meta>
                </property>

                <property name="footerConfig_copyright" type="text_line" colspan="12">
                    <meta>
                        <title>iw_sulu_tailwind_theme.footer_copyright</title>
                        <info_text>iw_sulu_tailwind_theme.footer_copyright_info</info_text>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</form>
