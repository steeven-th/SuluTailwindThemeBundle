<?xml version="1.0" ?>
<!--
    Admin form: Articles tab.
    Style pickers for article page layouts, listing config, and display toggles.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_articles</key>

    <properties>
        <!-- Page styles section -->
        <section name="articlePageStyles">
            <meta>
                <title>iw_sulu_tailwind_theme.articles_section_page_styles</title>
            </meta>
            <properties>
                <property name="articles_newsStyle" type="iw_theme_article_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.articles_news_style</title></meta>
                    <params>
                        <param name="article_type" value="news"/>
                    </params>
                </property>

                <property name="articles_eventStyle" type="iw_theme_article_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.articles_event_style</title></meta>
                    <params>
                        <param name="article_type" value="event"/>
                    </params>
                </property>

                <property name="articles_blogStyle" type="iw_theme_article_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.articles_blog_style</title></meta>
                    <params>
                        <param name="article_type" value="blog"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Listing section -->
        <section name="articleListing">
            <meta>
                <title>iw_sulu_tailwind_theme.articles_section_listing</title>
            </meta>
            <properties>
                <property name="articles_listingStyle" type="iw_theme_article_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.articles_listing_style</title></meta>
                    <params>
                        <param name="article_type" value="listing"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Filter sidebar & table of contents: layout/controls of the
             listing sidebar, plus the surface colors shared by both side
             panels (empty = inherit the global surfaces). Keys keep their
             components_* prefix for backward compatibility. -->
        <section name="articleFiltersSidebar">
            <meta>
                <title>iw_sulu_tailwind_theme.components_section_sidebar</title>
            </meta>
            <properties>
                <property name="components_sidebarBg" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_bg</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_sidebarText" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_text</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_sidebarMuted" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_muted</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_sidebarBorder" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_border</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
                <property name="components_sidebarAccent" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_label_accent</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="components_sidebarButtonStyle" type="iw_theme_button_style_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_sidebar_button_style</title></meta>
                </property>

                <!-- Mobile "Filters" toggle button. Empty = neutral surface style;
                     it sits on the page background, so it has its own picker. -->
                <property name="components_filtersToggleStyle" type="iw_theme_button_style_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_filters_toggle_style</title></meta>
                </property>

                <!-- Auto-submit the filter form on change (JS enhancement). When on,
                     the controller submits on checkbox/sort change and after a
                     short search debounce, and hides the "Apply" button. Without
                     JS the button stays and the form works as usual. -->
                <property name="components_filtersAutoSubmit" type="checkbox" colspan="6">
                    <meta>
                        <info_text>iw_sulu_tailwind_theme.components_filters_auto_submit_info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.components_filters_auto_submit</title>
                            </meta>
                        </param>
                    </params>
                </property>

                <!-- Sidebar layout: left/right column, or a permanent offcanvas
                     drawer (behind a "Filters" button at every screen size). On
                     small screens left/right collapse to the drawer anyway. -->
                <property name="components_sidebarStyle" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.components_sidebar_style</title></meta>
                    <params>
                        <param name="default_value" value="left"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_left</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_right</title></meta></param>
                            <param name="offcanvas"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_offcanvas</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Which filter controls to expose in the sidebar (all on by default). -->
                <property name="components_filtersShowSearch" type="checkbox" colspan="6">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_search</title></meta></param>
                    </params>
                </property>
                <property name="components_filtersShowSort" type="checkbox" colspan="6">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_sort</title></meta></param>
                    </params>
                </property>
                <property name="components_filtersShowCategories" type="checkbox" colspan="6">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_categories</title></meta></param>
                    </params>
                </property>
                <property name="components_filtersShowTags" type="checkbox" colspan="6">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_tags</title></meta></param>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Display elements section -->
        <section name="articleDisplay">
            <meta>
                <title>iw_sulu_tailwind_theme.articles_section_display</title>
            </meta>
            <properties>
                <property name="articles_showDates" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_show_dates</title></meta>
                    <params>
                        <param name="default_value" value="both"/>
                        <param name="values" type="collection">
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.articles_visibility_hidden</title></meta></param>
                            <param name="page"><meta><title>iw_sulu_tailwind_theme.articles_visibility_page</title></meta></param>
                            <param name="listing"><meta><title>iw_sulu_tailwind_theme.articles_visibility_listing</title></meta></param>
                            <param name="both"><meta><title>iw_sulu_tailwind_theme.articles_visibility_both</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="articles_showAuthors" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_show_authors</title></meta>
                    <params>
                        <param name="default_value" value="both"/>
                        <param name="values" type="collection">
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.articles_visibility_hidden</title></meta></param>
                            <param name="page"><meta><title>iw_sulu_tailwind_theme.articles_visibility_page</title></meta></param>
                            <param name="listing"><meta><title>iw_sulu_tailwind_theme.articles_visibility_listing</title></meta></param>
                            <param name="both"><meta><title>iw_sulu_tailwind_theme.articles_visibility_both</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="articles_showCategories" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_show_categories</title></meta>
                    <params>
                        <param name="default_value" value="both"/>
                        <param name="values" type="collection">
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.articles_visibility_hidden</title></meta></param>
                            <param name="page"><meta><title>iw_sulu_tailwind_theme.articles_visibility_page</title></meta></param>
                            <param name="listing"><meta><title>iw_sulu_tailwind_theme.articles_visibility_listing</title></meta></param>
                            <param name="both"><meta><title>iw_sulu_tailwind_theme.articles_visibility_both</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="articles_showExcerpts" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_show_excerpts</title></meta>
                    <params>
                        <param name="default_value" value="listing"/>
                        <param name="values" type="collection">
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.articles_visibility_hidden</title></meta></param>
                            <param name="listing"><meta><title>iw_sulu_tailwind_theme.articles_visibility_listing</title></meta></param>
                            <param name="both"><meta><title>iw_sulu_tailwind_theme.articles_visibility_both</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="articles_showRelated" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_show_related</title></meta>
                    <params>
                        <param name="default_value" value="page"/>
                        <param name="values" type="collection">
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.articles_visibility_hidden</title></meta></param>
                            <param name="page"><meta><title>iw_sulu_tailwind_theme.articles_visibility_page</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="articles_relatedCount" type="number" colspan="4"
                          visibleCondition="articles_showRelated != 'hidden'">
                    <meta><title>iw_sulu_tailwind_theme.articles_related_count</title></meta>
                    <params>
                        <param name="default_value" value="3"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Reading components section: article-page helpers rendered by
             _article_base.html.twig. Opt-in (off by default). -->
        <section name="articleReadingComponents">
            <meta>
                <title>iw_sulu_tailwind_theme.articles_section_reading_components</title>
            </meta>
            <properties>
                <property name="articles_shareEnabled" type="checkbox" colspan="6">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_share_enabled</title></meta></param>
                    </params>
                </property>
                <property name="articles_sharePosition" type="single_select" colspan="6"
                          visibleCondition="articles_shareEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.articles_share_position</title></meta>
                    <params>
                        <param name="default_value" value="footer"/>
                        <param name="values" type="collection">
                            <param name="header"><meta><title>iw_sulu_tailwind_theme.articles_share_position_header</title></meta></param>
                            <param name="footer"><meta><title>iw_sulu_tailwind_theme.articles_share_position_footer</title></meta></param>
                            <param name="both"><meta><title>iw_sulu_tailwind_theme.articles_share_position_both</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Share actions: each button can be toggled individually. The
                     native button falls back to copying the link when the Web
                     Share API is unavailable. -->
                <property name="articles_shareNative" type="checkbox" colspan="4"
                          visibleCondition="articles_shareEnabled == true">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_share_native</title></meta></param>
                    </params>
                </property>
                <property name="articles_shareCopy" type="checkbox" colspan="4"
                          visibleCondition="articles_shareEnabled == true">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_share_copy</title></meta></param>
                    </params>
                </property>
                <property name="articles_shareEmail" type="checkbox" colspan="4"
                          visibleCondition="articles_shareEnabled == true">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_share_email</title></meta></param>
                    </params>
                </property>

                <!-- Empty = neutral surface style; otherwise the chosen theme
                     button variant owns the colors (same pattern as the sidebar buttons). -->
                <property name="articles_shareButtonStyle" type="iw_theme_button_style_picker" colspan="6"
                          visibleCondition="articles_shareEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.articles_share_button_style</title></meta>
                </property>

                <!-- Reading progress: a thin bar fixed at the top of the
                     viewport, filling as the visitor scrolls the article. -->
                <property name="articles_readingProgressEnabled" type="checkbox" colspan="12">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_reading_progress_enabled</title></meta></param>
                    </params>
                </property>
                <property name="articles_readingProgressSize" type="single_select" colspan="6"
                          visibleCondition="articles_readingProgressEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.articles_reading_progress_size</title></meta>
                    <params>
                        <param name="default_value" value="md"/>
                        <param name="values" type="collection">
                            <param name="sm"><meta><title>iw_sulu_tailwind_theme.articles_reading_progress_size_sm</title></meta></param>
                            <param name="md"><meta><title>iw_sulu_tailwind_theme.articles_reading_progress_size_md</title></meta></param>
                            <param name="lg"><meta><title>iw_sulu_tailwind_theme.articles_reading_progress_size_lg</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="articles_readingProgressColor" type="iw_theme_color_token_editor" colspan="6"
                          visibleCondition="articles_readingProgressEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.articles_reading_progress_color</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <!-- Table of contents: built client-side from the article's
                     h2/h3 headings, with anchors and scroll-spy. -->
                <property name="articles_tocEnabled" type="checkbox" colspan="12">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                        <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_toc_enabled</title></meta></param>
                    </params>
                </property>
                <property name="articles_tocPosition" type="single_select" colspan="6"
                          visibleCondition="articles_tocEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.articles_toc_position</title></meta>
                    <params>
                        <param name="default_value" value="inline"/>
                        <param name="values" type="collection">
                            <param name="inline"><meta><title>iw_sulu_tailwind_theme.articles_toc_position_inline</title></meta></param>
                            <param name="sticky"><meta><title>iw_sulu_tailwind_theme.articles_toc_position_sticky</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="articles_tocDepth" type="single_select" colspan="6"
                          visibleCondition="articles_tocEnabled == true">
                    <meta><title>iw_sulu_tailwind_theme.articles_toc_depth</title></meta>
                    <params>
                        <param name="default_value" value="h3"/>
                        <param name="values" type="collection">
                            <param name="h2"><meta><title>iw_sulu_tailwind_theme.articles_toc_depth_h2</title></meta></param>
                            <param name="h3"><meta><title>iw_sulu_tailwind_theme.articles_toc_depth_h3</title></meta></param>
                        </param>
                    </params>
                </property>
            </properties>
        </section>
    </properties>
</form>
