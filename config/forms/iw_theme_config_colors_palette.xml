<?xml version="1.0" ?>
<!--
    Admin form: Colors tab, Palette sub-tab.

    The named roles of the theme, which every other colour field points at
    rather than repeating a hex value. One editor, holding the whole list.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_colors_palette</key>

    <properties>
        <property name="palette" type="iw_theme_palette_editor" colspan="12">
            <meta>
                <title>iw_sulu_tailwind_theme.colors_section_main</title>
                <info_text>iw_sulu_tailwind_theme.palette_info</info_text>
            </meta>
        </property>
    </properties>
</form>
