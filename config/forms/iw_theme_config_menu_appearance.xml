<?xml version="1.0" ?>
<!--
    Admin form: Menu tab, Chrome sub-tab.

    The bar as an object: its border, its shadow, and how much of the page
    shows through it.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_menu_appearance</key>

    <properties>
            <property name="menuConfig_borderWidth" type="single_select" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_borderWidth</title>
                    <info_text>iw_sulu_tailwind_theme.menu_borderWidth_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="none"/>
                    <param name="values" type="collection">
                        <param name="none"><meta><title>iw_sulu_tailwind_theme.menu_borderWidth_none</title></meta></param>
                        <param name="1"><meta><title>iw_sulu_tailwind_theme.menu_borderWidth_1</title></meta></param>
                        <param name="2"><meta><title>iw_sulu_tailwind_theme.menu_borderWidth_2</title></meta></param>
                        <param name="3"><meta><title>iw_sulu_tailwind_theme.menu_borderWidth_3</title></meta></param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_colors_border" type="iw_theme_color_token_editor" colspan="6"
                      visibleCondition="menuConfig_borderWidth != 'none'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_colors_border</title>
                    <info_text>iw_sulu_tailwind_theme.menu_colors_border_info</info_text>
                </meta>
                <params>
                    <param name="show_palette" value="true"/>
                </params>
            </property>

            <property name="menuConfig_shadow" type="single_select" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_shadow</title>
                    <info_text>iw_sulu_tailwind_theme.menu_shadow_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="none"/>
                    <param name="values" type="collection">
                        <param name="none"><meta><title>iw_sulu_tailwind_theme.menu_shadow_none</title></meta></param>
                        <param name="subtle"><meta><title>iw_sulu_tailwind_theme.menu_shadow_subtle</title></meta></param>
                        <param name="strong"><meta><title>iw_sulu_tailwind_theme.menu_shadow_strong</title></meta></param>
                    </param>
                </params>
            </property>

            <!-- Background opacity: what makes the blur visible. A fully opaque
                 bar has nothing to blur behind it, hence the paired info text. -->
            <property name="menuConfig_bgOpacity" type="number" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_bgOpacity</title>
                    <info_text>iw_sulu_tailwind_theme.menu_bgOpacity_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="100"/>
                    <param name="min" value="0"/>
                    <param name="max" value="100"/>
                    <param name="step" value="5"/>
                </params>
            </property>

            <property name="menuConfig_blur" type="single_select" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_blur</title>
                    <info_text>iw_sulu_tailwind_theme.menu_blur_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="none"/>
                    <param name="values" type="collection">
                        <param name="none"><meta><title>iw_sulu_tailwind_theme.menu_blur_none</title></meta></param>
                        <param name="light"><meta><title>iw_sulu_tailwind_theme.menu_blur_light</title></meta></param>
                        <param name="medium"><meta><title>iw_sulu_tailwind_theme.menu_blur_medium</title></meta></param>
                        <param name="strong"><meta><title>iw_sulu_tailwind_theme.menu_blur_strong</title></meta></param>
                    </param>
                </params>
            </property>

            <!-- The dropdowns hanging from the bar: their own radius, and square
                 top corners against the bar unless asked (a dropdown on a
                 different background than the bar may want them round). -->
            <property name="menuConfig_dropdownHeading" type="heading">
                <params>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.menu_dropdownHeading</title></meta>
                    </param>
                </params>
            </property>

            <property name="menuConfig_dropdownRadius" type="iw_theme_radius_selector" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_dropdownRadius</title>
                    <info_text>iw_sulu_tailwind_theme.menu_dropdownRadius_info</info_text>
                </meta>
            </property>

            <property name="menuConfig_dropdownRadiusTop" type="checkbox" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_dropdownRadiusTop</title>
                    <info_text>iw_sulu_tailwind_theme.menu_dropdownRadiusTop_info</info_text>
                </meta>
            </property>

            <!-- The chevron of the menus: the theme one by default, or one of
                 the menu's own. Its colors are set per level in Menu > Colors. -->
            <property name="menuConfig_chevronHeading" type="heading">
                <params>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.menu_chevronHeading</title></meta>
                    </param>
                </params>
            </property>

            <property name="menuConfig_chevronOwn" type="checkbox" colspan="12">
                <meta>
                    <info_text>iw_sulu_tailwind_theme.menu_chevronOwn_info</info_text>
                </meta>
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="false"/>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.menu_chevronOwn</title></meta>
                    </param>
                </params>
            </property>

            <property name="menuConfig_chevronIconCustom" type="checkbox" colspan="12"
                      visibleCondition="menuConfig_chevronOwn == true">
                <meta>
                    <info_text>iw_sulu_tailwind_theme.components_controls_arrow_icon_custom_info</info_text>
                </meta>
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="false"/>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.components_controls_arrow_icon_custom</title></meta>
                    </param>
                </params>
            </property>

            <property name="menuConfig_chevronIcon" type="single_icon_selection" colspan="6"
                      visibleCondition="menuConfig_chevronOwn == true AND menuConfig_chevronIconCustom != true">
                <meta>
                    <title>iw_sulu_tailwind_theme.components_controls_chevron_icon</title>
                </meta>
                <params>
                    <param name="icon_set" value="iw_theme_outline"/>
                </params>
            </property>

            <property name="menuConfig_chevronIconMedia" type="single_media_selection" colspan="12"
                      visibleCondition="menuConfig_chevronOwn == true AND menuConfig_chevronIconCustom == true">
                <meta>
                    <title>iw_sulu_tailwind_theme.components_controls_arrow_icon_media</title>
                    <info_text>iw_sulu_tailwind_theme.components_controls_arrow_icon_media_info</info_text>
                </meta>
                <params>
                    <param name="types" value="image"/>
                </params>
            </property>

            <property name="menuConfig_chevronIconSize" type="single_select" colspan="6"
                      visibleCondition="menuConfig_chevronOwn == true">
                <meta>
                    <title>iw_sulu_tailwind_theme.components_controls_arrow_icon_size</title>
                </meta>
                <params>
                    <param name="default_value" value=""/>
                    <param name="values" type="collection">
                        <param name=""><meta><title>iw_sulu_tailwind_theme.button_icon_size_auto</title></meta></param>
                        <param name="12"><meta><title>12 px</title></meta></param>
                        <param name="16"><meta><title>16 px</title></meta></param>
                        <param name="20"><meta><title>20 px</title></meta></param>
                        <param name="24"><meta><title>24 px</title></meta></param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_chevronIconDirection" type="single_select" colspan="6"
                      visibleCondition="menuConfig_chevronOwn == true">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_chevronIconDirection</title>
                    <info_text>iw_sulu_tailwind_theme.menu_chevronIconDirection_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="right"/>
                    <param name="values" type="collection">
                        <param name="right"><meta><title>iw_sulu_tailwind_theme.menu_chevronIconDirection_right</title></meta></param>
                        <param name="down"><meta><title>iw_sulu_tailwind_theme.menu_chevronIconDirection_down</title></meta></param>
                        <param name="left"><meta><title>iw_sulu_tailwind_theme.menu_chevronIconDirection_left</title></meta></param>
                        <param name="up"><meta><title>iw_sulu_tailwind_theme.menu_chevronIconDirection_up</title></meta></param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_chevronRotate" type="checkbox" colspan="12">
                <meta>
                    <info_text>iw_sulu_tailwind_theme.menu_chevronRotate_info</info_text>
                </meta>
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="true"/>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.menu_chevronRotate</title></meta>
                    </param>
                </params>
            </property>
    </properties>
</form>
