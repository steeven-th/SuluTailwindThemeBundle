<?xml version="1.0" ?>
<!--
    Admin form: Articles tab, Filters and contents sub-tab.

    The two side panels: the filter sidebar of a listing, and the table of
    contents of an article.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_articles_filters</key>

    <properties>
            <!--
                The section holds three subjects in a row: the colours of
                the sidebar, the style of its buttons, then what the filter
                panel shows. A heading between them closes the row and names
                the group, which is what keeps a one-line colour field from
                landing beside a grid of button thumbnails.
            -->
            <property name="sidebarColorsHeading" type="heading">
                <params>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.config_group_colors</title></meta>
                    </param>
                </params>
            </property>

            <property name="components_sidebarBg" type="iw_theme_color_token_editor" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_bg</title></meta>
                <params><param name="show_palette" value="true"/></params>
            </property>
            <property name="components_sidebarText" type="iw_theme_color_token_editor" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_text</title></meta>
                <params><param name="show_palette" value="true"/></params>
            </property>
            <property name="components_sidebarMuted" type="iw_theme_color_token_editor" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_muted</title></meta>
                <params><param name="show_palette" value="true"/></params>
            </property>
            <property name="components_sidebarBorder" type="iw_theme_color_token_editor" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_border</title></meta>
                <params><param name="show_palette" value="true"/></params>
            </property>
            <property name="components_sidebarAccent" type="iw_theme_color_token_editor" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_accent</title></meta>
                <params><param name="show_palette" value="true"/></params>
            </property>

            <property name="components_sidebarRadius" type="iw_theme_radius_selector" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.components_label_radius</title>
                    <info_text>iw_sulu_tailwind_theme.components_sidebar_radius_info</info_text>
                </meta>
            </property>

<property name="components_sidebarShadow" type="single_select" colspan="6">
            <meta>
                <title>iw_sulu_tailwind_theme.components_label_shadow</title>
            </meta>
            <params>
                <param name="default_value" value=""/>
                <param name="values" type="collection">
                    <param name=""><meta><title>iw_sulu_tailwind_theme.button_icon_size_auto</title></meta></param>
                    <param name="none"><meta><title>iw_sulu_tailwind_theme.components_shadow_none</title></meta></param>
                    <param name="sm"><meta><title>iw_sulu_tailwind_theme.components_shadow_sm</title></meta></param>
                    <param name="md"><meta><title>iw_sulu_tailwind_theme.components_shadow_md</title></meta></param>
                    <param name="lg"><meta><title>iw_sulu_tailwind_theme.components_shadow_lg</title></meta></param>
                </param>
            </params>
                </property>

            <property name="components_sidebarFontSize" type="single_select" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_font_size</title></meta>
                <params>
                    <param name="default_value" value=""/>
                    <param name="values" type="collection">
                        <param name=""><meta><title>iw_sulu_tailwind_theme.button_icon_size_auto</title></meta></param>
                        <param name="0.75rem"><meta><title>12 px</title></meta></param>
                        <param name="0.875rem"><meta><title>14 px</title></meta></param>
                        <param name="1rem"><meta><title>16 px</title></meta></param>
                        <param name="1.125rem"><meta><title>18 px</title></meta></param>
                    </param>
                </params>
            </property>

            <property name="sidebarButtonsHeading" type="heading">
                <params>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.config_group_buttons</title></meta>
                    </param>
                </params>
            </property>

            <property name="components_sidebarButtonStyle" type="iw_theme_button_style_picker" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_sidebar_button_style</title></meta>
            </property>

            <!-- Mobile "Filters" toggle button. Empty = neutral surface style;
                 it sits on the page background, so it has its own picker. -->
            <property name="components_filtersToggleStyle" type="iw_theme_button_style_picker" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_filters_toggle_style</title></meta>
            </property>

            <property name="sidebarDisplayHeading" type="heading">
                <params>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.config_group_display</title></meta>
                    </param>
                </params>
            </property>

            <!-- Auto-submit the filter form on change (JS enhancement). When on,
                 the controller submits on checkbox/sort change and after a
                 short search debounce, and hides the "Apply" button. Without
                 JS the button stays and the form works as usual. -->
            <property name="components_filtersAutoSubmit" type="checkbox" colspan="6">
                <meta>
                    <info_text>iw_sulu_tailwind_theme.components_filters_auto_submit_info</info_text>
                </meta>
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="false"/>
                    <param name="label">
                        <meta>
                            <title>iw_sulu_tailwind_theme.components_filters_auto_submit</title>
                        </meta>
                    </param>
                </params>
            </property>

            <!-- Sidebar layout: left/right column, or a permanent offcanvas
                 drawer (behind a "Filters" button at every screen size). On
                 small screens left/right collapse to the drawer anyway. -->
            <property name="components_sidebarStyle" type="single_select" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_sidebar_style</title></meta>
                <params>
                    <param name="default_value" value="left"/>
                    <param name="values" type="collection">
                        <param name="left"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_left</title></meta></param>
                        <param name="right"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_right</title></meta></param>
                        <param name="topbar"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_topbar</title></meta></param>
                        <param name="offcanvas"><meta><title>iw_sulu_tailwind_theme.components_sidebar_style_offcanvas</title></meta></param>
                    </param>
                </params>
            </property>

            <!-- Which filter controls to expose in the sidebar (all on by default). -->
            <property name="components_filtersShowSearch" type="checkbox" colspan="6">
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="true"/>
                    <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_search</title></meta></param>
                </params>
            </property>
            <property name="components_filtersShowSort" type="checkbox" colspan="6">
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="true"/>
                    <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_sort</title></meta></param>
                </params>
            </property>
            <property name="components_filtersShowCategories" type="checkbox" colspan="6">
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="true"/>
                    <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_categories</title></meta></param>
                </params>
            </property>
            <property name="components_filtersShowTags" type="checkbox" colspan="6">
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="true"/>
                    <param name="label"><meta><title>iw_sulu_tailwind_theme.components_filters_show_tags</title></meta></param>
                </params>
            </property>

        <property name="tocHeading" type="heading">
            <params>
                <param name="label">
                    <meta><title>iw_sulu_tailwind_theme.articles_group_toc</title></meta>
                </param>
            </params>
        </property>

            <!-- Table of contents: built client-side from the article's
                 h2/h3 headings, with anchors and scroll-spy. -->
            <property name="articles_tocEnabled" type="checkbox" colspan="12">
                <params>
                    <param name="type" value="toggler"/>
                    <param name="default_value" value="false"/>
                    <param name="label"><meta><title>iw_sulu_tailwind_theme.articles_toc_enabled</title></meta></param>
                </params>
            </property>

            <property name="articles_tocPosition" type="single_select" colspan="6"
                      visibleCondition="articles_tocEnabled == true">
                <meta><title>iw_sulu_tailwind_theme.articles_toc_position</title></meta>
                <params>
                    <param name="default_value" value="inline"/>
                    <param name="values" type="collection">
                        <param name="inline"><meta><title>iw_sulu_tailwind_theme.articles_toc_position_inline</title></meta></param>
                        <param name="sticky"><meta><title>iw_sulu_tailwind_theme.articles_toc_position_sticky</title></meta></param>
                    </param>
                </params>
            </property>

            <property name="articles_tocDepth" type="single_select" colspan="6"
                      visibleCondition="articles_tocEnabled == true">
                <meta><title>iw_sulu_tailwind_theme.articles_toc_depth</title></meta>
                <params>
                    <param name="default_value" value="h3"/>
                    <param name="values" type="collection">
                        <param name="h2"><meta><title>iw_sulu_tailwind_theme.articles_toc_depth_h2</title></meta></param>
                        <param name="h3"><meta><title>iw_sulu_tailwind_theme.articles_toc_depth_h3</title></meta></param>
                    </param>
                </params>
            </property>
            <property name="sidebarSpacingHeading" type="heading">
                <params>
                    <param name="label">
                        <meta><title>iw_sulu_tailwind_theme.components_group_spacing</title></meta>
                    </param>
                </params>
            </property>

            <property name="components_sidebarPadding" type="iw_theme_margin_selector" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_padding</title></meta>
            </property>

            <property name="components_sidebarGap" type="iw_theme_margin_selector" colspan="6">
                <meta><title>iw_sulu_tailwind_theme.components_label_gap</title></meta>
            </property>
    </properties>
</form>
