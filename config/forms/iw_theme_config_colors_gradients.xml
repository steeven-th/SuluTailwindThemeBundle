<?xml version="1.0" ?>
<!--
    Admin form: Colors tab, Gradients sub-tab.

    Named gradients, defined once and picked like a palette color by the
    fields that accept one. One editor, holding the whole list.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_colors_gradients</key>

    <properties>
        <property name="gradients" type="iw_theme_gradient_editor" colspan="12">
            <meta>
                <title>iw_sulu_tailwind_theme.gradients</title>
                <info_text>iw_sulu_tailwind_theme.gradients_info</info_text>
            </meta>
        </property>
    </properties>
</form>
