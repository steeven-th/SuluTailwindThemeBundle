<?xml version="1.0" ?>
<!--
    Admin form: Colors tab, Surfaces sub-tab.

    The semantic colours shared by every transverse component: the filter
    sidebar, the pagination, the breadcrumb, the badges. These are a palette
    rather than a component setting, which is why they sit under Colors.

    Leave a field empty to derive it from the theme, which works in light and
    in dark alike.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_colors_surfaces</key>

    <properties>
        <property name="components_surfaceBg" type="iw_theme_color_token_editor" colspan="6">
            <meta><title>iw_sulu_tailwind_theme.components_surface_bg</title></meta>
            <params><param name="show_palette" value="true"/></params>
        </property>

        <property name="components_surfaceText" type="iw_theme_color_token_editor" colspan="6">
            <meta><title>iw_sulu_tailwind_theme.components_surface_text</title></meta>
            <params><param name="show_palette" value="true"/></params>
        </property>

        <property name="components_surfaceMuted" type="iw_theme_color_token_editor" colspan="6">
            <meta><title>iw_sulu_tailwind_theme.components_surface_muted</title></meta>
            <params><param name="show_palette" value="true"/></params>
        </property>

        <property name="components_surfaceBorder" type="iw_theme_color_token_editor" colspan="6">
            <meta><title>iw_sulu_tailwind_theme.components_surface_border</title></meta>
            <params><param name="show_palette" value="true"/></params>
        </property>

        <property name="components_surfaceAccent" type="iw_theme_color_token_editor" colspan="6">
            <meta><title>iw_sulu_tailwind_theme.components_surface_accent</title></meta>
            <params><param name="show_palette" value="true"/></params>
        </property>

        <property name="components_surfaceOnAccent" type="iw_theme_color_token_editor" colspan="6">
            <meta><title>iw_sulu_tailwind_theme.components_surface_on_accent</title></meta>
            <params><param name="show_palette" value="true"/></params>
        </property>
    </properties>
</form>
