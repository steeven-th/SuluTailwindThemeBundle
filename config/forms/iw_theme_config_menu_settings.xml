<?xml version="1.0" ?>
<!--
    Admin form: Menu tab, Configuration sub-tab.

    Which menu the site runs, and how it behaves: what opens a sub-level, how
    deep it goes, and the settings each kind of menu brings with it.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_menu_settings</key>

    <properties>
            <property name="menuConfig_type" type="single_select" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_type</title>
                </meta>
                <params>
                    <param name="values" type="collection">
                        <param name="navbar">
                            <meta><title>iw_sulu_tailwind_theme.menu_type_navbar</title></meta>
                        </param>
                        <param name="burger">
                            <meta><title>iw_sulu_tailwind_theme.menu_type_burger</title></meta>
                        </param>
                        <param name="fullscreen">
                            <meta><title>iw_sulu_tailwind_theme.menu_type_fullscreen</title></meta>
                        </param>
                        <param name="megamenu">
                            <meta><title>iw_sulu_tailwind_theme.menu_type_megamenu</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_megamenuSource" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'megamenu'">
                <meta>
                    <title>iw_sulu_tailwind_theme.mega_source</title>
                    <info_text>iw_sulu_tailwind_theme.mega_source_info</info_text>
                </meta>
                <params>
                    <param name="default_value" type="string" value="native"/>
                    <param name="values" type="collection">
                        <param name="native">
                            <meta><title>iw_sulu_tailwind_theme.mega_source_native</title></meta>
                        </param>
                        <param name="snippet">
                            <meta><title>iw_sulu_tailwind_theme.mega_source_snippet</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_navPosition" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'navbar' OR menuConfig_type == 'megamenu'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_navPosition</title>
                </meta>
                <params>
                    <param name="default_value" value="center"/>
                    <param name="values" type="collection">
                        <param name="left">
                            <meta><title>iw_sulu_tailwind_theme.menu_navPosition_left</title></meta>
                        </param>
                        <param name="center">
                            <meta><title>iw_sulu_tailwind_theme.menu_navPosition_center</title></meta>
                        </param>
                        <param name="right">
                            <meta><title>iw_sulu_tailwind_theme.menu_navPosition_right</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <!-- Width under which the bar gives way to the burger. The labels,
                 the logo and the icons decide what fits, hence the automatic
                 value, which measures the bar instead of guessing a width. -->
            <property name="menuConfig_collapseAt" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'navbar' OR menuConfig_type == 'megamenu'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_collapseAt</title>
                    <info_text>iw_sulu_tailwind_theme.menu_collapseAt_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="auto"/>
                    <param name="values" type="collection">
                        <param name="md">
                            <meta><title>iw_sulu_tailwind_theme.menu_collapseAt_md</title></meta>
                        </param>
                        <param name="lg">
                            <meta><title>iw_sulu_tailwind_theme.menu_collapseAt_lg</title></meta>
                        </param>
                        <param name="xl">
                            <meta><title>iw_sulu_tailwind_theme.menu_collapseAt_xl</title></meta>
                        </param>
                        <param name="auto">
                            <meta><title>iw_sulu_tailwind_theme.menu_collapseAt_auto</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <!-- The burger opens its panel over the whole screen, or on a
                 side at a set width with the page dimmed behind it. The
                 former sidebar menu type is the side panel. -->
            <property name="menuConfig_panelLayout" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'burger'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_panelLayout</title>
                    <info_text>iw_sulu_tailwind_theme.menu_panelLayout_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="full"/>
                    <param name="values" type="collection">
                        <param name="full">
                            <meta><title>iw_sulu_tailwind_theme.menu_panelLayout_full</title></meta>
                        </param>
                        <param name="side">
                            <meta><title>iw_sulu_tailwind_theme.menu_panelLayout_side</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_panelSide" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'burger' AND menuConfig_panelLayout == 'side'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_panelSide</title>
                    <info_text>iw_sulu_tailwind_theme.menu_panelSide_info</info_text>
                </meta>
                <params>
                    <param name="default_value" type="string" value="right"/>
                    <param name="values" type="collection">
                        <param name="left">
                            <meta><title>iw_sulu_tailwind_theme.menu_position_left</title></meta>
                        </param>
                        <param name="right">
                            <meta><title>iw_sulu_tailwind_theme.menu_position_right</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <!-- The bar stays visible above the open panel, with the social
                 icons and the language switcher: a panel narrower than that
                 row leaves them hanging over the page. -->
            <property name="menuConfig_panelWidth" type="number" colspan="6"
                      visibleCondition="menuConfig_type == 'burger' AND menuConfig_panelLayout == 'side'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_panelWidth</title>
                    <info_text>iw_sulu_tailwind_theme.menu_panelWidth_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="288"/>
                    <param name="min" value="200"/>
                    <param name="max" value="640"/>
                </params>
            </property>

            <property name="menuConfig_animation" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type != 'fullscreen' AND menuConfig_type != 'megamenu'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_animation</title>
                </meta>
                <params>
                    <param name="values" type="collection">
                        <param name="none">
                            <meta><title>iw_sulu_tailwind_theme.menu_animation_none</title></meta>
                        </param>
                        <param name="slide">
                            <meta><title>iw_sulu_tailwind_theme.menu_animation_slide</title></meta>
                        </param>
                        <param name="fade">
                            <meta><title>iw_sulu_tailwind_theme.menu_animation_fade</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_slideDirection" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type != 'fullscreen' AND menuConfig_type != 'megamenu' AND (menuConfig_type != 'burger' OR menuConfig_panelLayout != 'side')"
                      disabledCondition="menuConfig_animation != 'slide'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_slideDirection</title>
                </meta>
                <params>
                    <param name="default_value" value="top"/>
                    <param name="values" type="collection">
                        <param name="top">
                            <meta><title>iw_sulu_tailwind_theme.menu_slideDirection_top</title></meta>
                        </param>
                        <param name="right">
                            <meta><title>iw_sulu_tailwind_theme.menu_slideDirection_right</title></meta>
                        </param>
                        <param name="bottom">
                            <meta><title>iw_sulu_tailwind_theme.menu_slideDirection_bottom</title></meta>
                        </param>
                        <param name="left">
                            <meta><title>iw_sulu_tailwind_theme.menu_slideDirection_left</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_clickParentPage" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type != 'navbar' AND menuConfig_type != 'megamenu' AND (menuConfig_type != 'burger' OR menuConfig_subMenuPanels != true)">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_clickParentPage</title>
                    <info_text>iw_sulu_tailwind_theme.menu_clickParentPage_info</info_text>
                </meta>
                <params>
                    <param name="default_value" type="string" value="none"/>
                    <param name="values" type="collection">
                        <param name="none">
                            <meta><title>iw_sulu_tailwind_theme.menu_clickParentPage_none</title></meta>
                        </param>
                        <param name="split">
                            <meta><title>iw_sulu_tailwind_theme.menu_clickParentPage_split</title></meta>
                        </param>
                        <param name="selflink">
                            <meta><title>iw_sulu_tailwind_theme.menu_clickParentPage_selflink</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <!-- Panels mode has no split/selflink distinction: the parent is
                 simply linkable (its title at the top of the sub-panel) or not. -->
            <property name="menuConfig_clickParentPagePanels" type="checkbox" colspan="6"
                      visibleCondition="menuConfig_type == 'burger' AND menuConfig_subMenuPanels == true">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_clickParentPage</title>
                    <info_text>iw_sulu_tailwind_theme.menu_clickParentPagePanels_info</info_text>
                </meta>
                <params>
                    <param name="type" value="toggler"/>
                </params>
            </property>

            <!-- Drill-down: sub-menus open as stacked sliding panels instead of
                 inline accordions (burger menu). -->
            <property name="menuConfig_subMenuPanels" type="checkbox" colspan="6"
                      visibleCondition="menuConfig_type == 'burger'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_subMenuPanels</title>
                    <info_text>iw_sulu_tailwind_theme.menu_subMenuPanels_info</info_text>
                </meta>
                <params>
                    <param name="type" value="toggler"/>
                </params>
            </property>

            <property name="menuConfig_clickParentPageNavbar" type="checkbox" colspan="6"
                      visibleCondition="menuConfig_type == 'navbar' OR (menuConfig_type == 'megamenu' AND menuConfig_megamenuSource != 'snippet')">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_clickParentPageNavbar</title>
                    <info_text>iw_sulu_tailwind_theme.menu_clickParentPageNavbar_info</info_text>
                </meta>
            </property>

            <property name="menuConfig_childLevels" type="single_select" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_childLevels</title>
                </meta>
                <params>
                    <param name="values" type="collection">
                        <param name="1">
                            <meta><title>1</title></meta>
                        </param>
                        <param name="2">
                            <meta><title>2</title></meta>
                        </param>
                        <param name="3">
                            <meta><title>3</title></meta>
                        </param>
                        <param name="4">
                            <meta><title>4</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <!-- Full width: the only tall field of a section made of selects
                 and toggles, so it would break whichever row it landed on. -->
            <property name="menuConfig_fullscreenImage" type="single_media_selection" colspan="12"
                      visibleCondition="menuConfig_type == 'fullscreen'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_fullscreenImage</title>
                    <info_text>iw_sulu_tailwind_theme.menu_fullscreenImage_info</info_text>
                </meta>
            </property>

            <property name="menuConfig_twoColumns" type="checkbox" colspan="6"
                      visibleCondition="menuConfig_type == 'fullscreen'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_twoColumns</title>
                    <info_text>iw_sulu_tailwind_theme.menu_twoColumns_info</info_text>
                </meta>
            </property>

            <!-- Two columns always start on the left, so only one column offers it. -->
            <property name="menuConfig_fullscreenAlign" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'fullscreen' AND menuConfig_twoColumns != true">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_fullscreenAlign</title>
                </meta>
                <params>
                    <param name="default_value" value="center"/>
                    <param name="values" type="collection">
                        <param name="left">
                            <meta><title>iw_sulu_tailwind_theme.menu_fullscreenAlign_left</title></meta>
                        </param>
                        <param name="center">
                            <meta><title>iw_sulu_tailwind_theme.menu_fullscreenAlign_center</title></meta>
                        </param>
                        <param name="right">
                            <meta><title>iw_sulu_tailwind_theme.menu_fullscreenAlign_right</title></meta>
                        </param>
                    </param>
                </params>
            </property>

            <property name="menuConfig_fullscreenCollapse" type="single_select" colspan="6"
                      visibleCondition="menuConfig_type == 'fullscreen'">
                <meta>
                    <title>iw_sulu_tailwind_theme.menu_fullscreenCollapse</title>
                    <info_text>iw_sulu_tailwind_theme.menu_fullscreenCollapse_info</info_text>
                </meta>
                <params>
                    <param name="default_value" value="level3"/>
                    <param name="values" type="collection">
                        <param name="level3">
                            <meta><title>iw_sulu_tailwind_theme.menu_fullscreenCollapse_level3</title></meta>
                        </param>
                        <param name="levels23">
                            <meta><title>iw_sulu_tailwind_theme.menu_fullscreenCollapse_levels23</title></meta>
                        </param>
                        <param name="none">
                            <meta><title>iw_sulu_tailwind_theme.menu_fullscreenCollapse_none</title></meta>
                        </param>
                    </param>
                </params>
            </property>

    </properties>
</form>
