<?xml version="1.0" ?>
<!--
    Admin form: Default settings tab, Cards sub-tab.

    How a card looks everywhere it is drawn: the cards block, an article
    listing, a related-articles row. A block may still override what it needs
    on its own.

    Twenty fields in one run read as a wall, so they are grouped by what they
    change: the shape of the card, its text, its border, then what happens on
    hover.
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_cards</key>

    <properties>
        <section name="cardsAppearance">
            <meta>
                <title>iw_sulu_tailwind_theme.cards_section_appearance</title>
            </meta>
            <properties>
                <property name="cardImageRatio" type="single_select" colspan="4">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_image_ratio</title></meta>
                    <params>
                        <param name="default_value" value="16:9"/>
                        <param name="values" type="collection">
                            <param name="16:9"><meta><title>16:9</title></meta></param>
                            <param name="4:3"><meta><title>4:3</title></meta></param>
                            <param name="1:1"><meta><title>1:1</title></meta></param>
                            <param name="3:4"><meta><title>3:4 (portrait)</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Gap between article cards, in every card grid/list/carousel.
                     Image grids and the other component grids have their own
                     settings under Defaults > Blocks. -->
                <property name="cardGap" type="single_select" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.card_gap</title>
                        <info_text>iw_sulu_tailwind_theme.card_gap_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="1.5rem"/>
                        <param name="values" type="collection">
                            <param name="0.5rem"><meta><title>iw_sulu_tailwind_theme.card_gap_very_compact</title></meta></param>
                            <param name="1rem"><meta><title>iw_sulu_tailwind_theme.card_gap_compact</title></meta></param>
                            <param name="1.25rem"><meta><title>iw_sulu_tailwind_theme.card_gap_compact_plus</title></meta></param>
                            <param name="1.5rem"><meta><title>iw_sulu_tailwind_theme.card_gap_normal</title></meta></param>
                            <param name="2rem"><meta><title>iw_sulu_tailwind_theme.card_gap_spacious</title></meta></param>
                            <param name="2.5rem"><meta><title>iw_sulu_tailwind_theme.card_gap_large</title></meta></param>
                            <param name="3rem"><meta><title>iw_sulu_tailwind_theme.card_gap_xlarge</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Surface -->
                <property name="cardSurface" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_surface</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardPadding" type="single_select" colspan="3">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_padding</title></meta>
                    <params>
                        <param name="default_value" value="1rem"/>
                        <param name="values" type="collection">
                            <param name="0"><meta><title>iw_sulu_tailwind_theme.articles_card_padding_none</title></meta></param>
                            <param name="0.5rem"><meta><title>8 px (0.5rem · p-2)</title></meta></param>
                            <param name="0.75rem"><meta><title>12 px (0.75rem · p-3)</title></meta></param>
                            <param name="1rem"><meta><title>16 px (1rem · p-4)</title></meta></param>
                            <param name="1.25rem"><meta><title>20 px (1.25rem · p-5)</title></meta></param>
                            <param name="1.5rem"><meta><title>24 px (1.5rem · p-6)</title></meta></param>
                            <param name="2rem"><meta><title>32 px (2rem · p-8)</title></meta></param>
                            <param name="2.5rem"><meta><title>40 px (2.5rem · p-10)</title></meta></param>
                            <param name="3rem"><meta><title>48 px (3rem · p-12)</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="cardImagePadded" type="checkbox" colspan="3">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.articles_card_image_padded</title></meta>
                        </param>
                    </params>
                </property>
            </properties>
        </section>

        <section name="cardsText">
            <meta>
                <title>iw_sulu_tailwind_theme.cards_section_text</title>
            </meta>
            <properties>
                <!-- Content colors (empty = theme defaults) -->
                <!--
                    Sizes of the card title and text, shared by every family of
                    card. Left empty each family keeps the size it ships with,
                    so a site upgrading sees nothing move. Filled, they all
                    follow, which is the point: a card title is a component, not
                    a step of the heading scale, and nothing else was lining
                    them up.
                -->
                <property name="cardTitleSize" type="number" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.card_title_size</title>
                        <info_text>iw_sulu_tailwind_theme.card_title_size_info</info_text>
                    </meta>
                    <params>
                        <param name="min" value="0.5"/>
                        <param name="max" value="4"/>
                        <param name="step" value="0.0625"/>
                    </params>
                </property>

                <property name="cardTextSize" type="number" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.card_text_size</title>
                        <info_text>iw_sulu_tailwind_theme.card_text_size_info</info_text>
                    </meta>
                    <params>
                        <param name="min" value="0.5"/>
                        <param name="max" value="3"/>
                        <param name="step" value="0.0625"/>
                    </params>
                </property>

                <property name="cardTitleColor" type="iw_theme_color_token_editor" colspan="4">
                    <meta><title>iw_sulu_tailwind_theme.card_title_color</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardTextColor" type="iw_theme_color_token_editor" colspan="4">
                    <meta><title>iw_sulu_tailwind_theme.card_text_color</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardBadgeBg" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.card_badge_bg</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardBadgeText" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.card_badge_text</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
            </properties>
        </section>

        <section name="cardsBorder">
            <meta>
                <title>iw_sulu_tailwind_theme.cards_section_border</title>
            </meta>
            <properties>
                <!-- Border -->
                <property name="cardBorder" type="iw_theme_color_token_editor" colspan="4">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_border</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardBorderWidth" type="single_select" colspan="4"
                          visibleCondition="cardBorder != 'none'">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_border_width</title></meta>
                    <params>
                        <param name="default_value" value="1px"/>
                        <param name="values" type="collection">
                            <param name="1px"><meta><title>1px</title></meta></param>
                            <param name="2px"><meta><title>2px</title></meta></param>
                            <param name="3px"><meta><title>3px</title></meta></param>
                            <param name="4px"><meta><title>4px</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="cardBorderStyle" type="single_select" colspan="4"
                          visibleCondition="cardBorder != 'none'">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_border_style</title></meta>
                    <params>
                        <param name="default_value" value="solid"/>
                        <param name="values" type="collection">
                            <param name="solid"><meta><title>Solid</title></meta></param>
                            <param name="dashed"><meta><title>Dashed</title></meta></param>
                            <param name="dotted"><meta><title>Dotted</title></meta></param>
                            <param name="double"><meta><title>Double</title></meta></param>
                        </param>
                    </params>
                </property>
            </properties>
        </section>

        <section name="cardsHover">
            <meta>
                <title>iw_sulu_tailwind_theme.cards_section_hover</title>
            </meta>
            <properties>
                <!-- Hover effects -->
                <!--
                    Defaults to the lift the Cards block has always drawn: this
                    setting now drives every family of card, and a card you can
                    click that answers nothing on hover reads as broken rather
                    than as restraint.
                -->
                <property name="cardHoverTransform" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform</title></meta>
                    <params>
                        <param name="default_value" value="lift"/>
                        <param name="values" type="collection">
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform_none</title></meta></param>
                            <param name="lift"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform_lift</title></meta></param>
                            <param name="lift-strong"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform_lift_strong</title></meta></param>
                            <param name="scale-up"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform_scale_up</title></meta></param>
                            <param name="scale-down"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform_scale_down</title></meta></param>
                            <param name="tilt"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_transform_tilt</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="cardHoverImage" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_hover_image</title></meta>
                    <params>
                        <param name="default_value" value="zoom"/>
                        <param name="values" type="collection">
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_image_none</title></meta></param>
                            <param name="zoom"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_image_zoom</title></meta></param>
                            <param name="zoom-strong"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_image_zoom_strong</title></meta></param>
                            <param name="grayscale"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_image_grayscale</title></meta></param>
                            <param name="brightness"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_image_brightness</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="cardHoverBorder" type="iw_theme_color_token_editor" colspan="6"
                          visibleCondition="cardBorder != 'none'">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_hover_border</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardHoverDuration" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_hover_duration</title></meta>
                    <params>
                        <param name="default_value" value="300ms"/>
                        <param name="values" type="collection">
                            <param name="150ms"><meta><title>150ms</title></meta></param>
                            <param name="300ms"><meta><title>300ms</title></meta></param>
                            <param name="500ms"><meta><title>500ms</title></meta></param>
                            <param name="700ms"><meta><title>700ms</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="cardHoverEasing" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.articles_card_hover_easing</title></meta>
                    <params>
                        <param name="default_value" value="ease-out"/>
                        <param name="values" type="collection">
                            <param name="linear"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_easing_linear</title></meta></param>
                            <param name="ease-out"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_easing_ease_out</title></meta></param>
                            <param name="ease-in-out"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_easing_ease_in_out</title></meta></param>
                            <param name="bounce"><meta><title>iw_sulu_tailwind_theme.articles_card_hover_easing_bounce</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- The shadow, as a geometry rather than as a named size. Four
                     sizes could not say where a shadow falls nor how strong it
                     is, so every theme drew the same one, and neither could
                     they express the common case of no shadow at rest and one
                     on hover.

                     Seven settings, one stored value: a Sulu field type
                     receives one value and returns one, so separate properties
                     would mean seven fields with no shared preview - which is
                     what made this hard to set to begin with.

                     The two colours are not here. What a shadow is drawn
                     against depends on the surface under the card, so they
                     belong to the variant. -->
                <property name="cardShadow" type="iw_theme_shadow_editor" colspan="12">
                    <meta>
                        <title>iw_sulu_tailwind_theme.components_label_shadow</title>
                        <info_text>iw_sulu_tailwind_theme.card_shadow_info</info_text>
                    </meta>
                </property>

                <!-- The colour a card casts its shadow in, for every card the
                     site draws. A variant overrides it for the cards inside its
                     own block, but an article listing page carries no variant
                     at all: without these two its cards would draw a black
                     shadow whatever the page is made of, the way their
                     background is already set here rather than per block. -->
                <property name="cardShadowColor" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.variant_card_shadow_color</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>

                <property name="cardShadowHoverColor" type="iw_theme_color_token_editor" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.variant_card_shadow_hover_color</title></meta>
                    <params><param name="show_palette" value="true"/></params>
                </property>
            </properties>
        </section>
    </properties>
</form>
