<?xml version="1.0" ?>
<!--
    Admin form: Components tab.
    Configuration for site-wide transverse components (breadcrumb today;
    table of contents, share buttons, back-to-top, reading progress later).
-->
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_components</key>

    <properties>
        <!-- Page hero: site-wide appearance of the optional page banner. The
             per-page content (image, title, subtitle) lives in the page's Hero
             section; these settings drive how it is displayed everywhere. -->
        <section name="componentsPageHero">
            <meta>
                <title>iw_sulu_tailwind_theme.components_section_page_hero</title>
                <info_text>iw_sulu_tailwind_theme.components_section_page_hero_info</info_text>
            </meta>
            <properties>
                <!-- Shown on every mode, side_by_side included: that one takes
                     its height from the content, but a page with no image falls
                     back to the overlay banner, which reads this. Hidden, the
                     height of that fallback could not be set at all. -->
                <property name="pageHero_height" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_height</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_height_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="md"/>
                        <param name="values" type="collection">
                            <param name="sm"><meta><title>iw_sulu_tailwind_theme.page.hero_height_sm</title></meta></param>
                            <param name="md"><meta><title>iw_sulu_tailwind_theme.page.hero_height_md</title></meta></param>
                            <param name="lg"><meta><title>iw_sulu_tailwind_theme.page.hero_height_lg</title></meta></param>
                            <param name="full"><meta><title>iw_sulu_tailwind_theme.page.hero_height_full</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="pageHero_parallax" type="checkbox" colspan="6"
                          visibleCondition="pageHero_titleDisplay != 'side_by_side'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_parallax</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_parallax_info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                    </params>
                </property>

                <property name="pageHero_titleDisplay" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_title_display</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_title_display_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="overlay"/>
                        <param name="values" type="collection">
                            <param name="overlay"><meta><title>iw_sulu_tailwind_theme.page.hero_display_overlay</title></meta></param>
                            <param name="below"><meta><title>iw_sulu_tailwind_theme.page.hero_display_below</title></meta></param>
                            <param name="side_by_side"><meta><title>iw_sulu_tailwind_theme.page.hero_display_side_by_side</title></meta></param>
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.page.hero_display_hidden</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="pageHero_breadcrumb" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_breadcrumb</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_breadcrumb_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="with_title"/>
                        <param name="values" type="collection">
                            <param name="with_title"><meta><title>iw_sulu_tailwind_theme.page.hero_breadcrumb_with_title</title></meta></param>
                            <param name="top_bar"><meta><title>iw_sulu_tailwind_theme.page.hero_breadcrumb_top_bar</title></meta></param>
                            <param name="bottom_bar"><meta><title>iw_sulu_tailwind_theme.page.hero_breadcrumb_bottom_bar</title></meta></param>
                            <param name="hidden"><meta><title>iw_sulu_tailwind_theme.page.hero_breadcrumb_hidden</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Only the side-by-side banner crops its image: the other modes
                     fill the banner edge to edge, where a ratio is set by the
                     height instead. -->
                <property name="pageHero_imageFormat" type="single_select" colspan="6"
                          visibleCondition="pageHero_titleDisplay == 'side_by_side'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_image_format</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_image_format_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="original"/>
                        <param name="values" type="collection">
                            <param name="16_9"><meta><title>16:9</title></meta></param>
                            <param name="4_3"><meta><title>4:3</title></meta></param>
                            <param name="1_1"><meta><title>1:1</title></meta></param>
                            <param name="3_4"><meta><title>3:4</title></meta></param>
                            <param name="original"><meta><title>iw_sulu_tailwind_theme.format_original</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Only meaningful when the breadcrumb sits with the titles.
                     The bars have a place of their own. -->
                <property name="pageHero_breadcrumbPosition" type="single_select" colspan="6"
                          visibleCondition="pageHero_breadcrumb == 'with_title'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_breadcrumb_position</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_breadcrumb_position_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="above"/>
                        <param name="values" type="collection">
                            <param name="above"><meta><title>iw_sulu_tailwind_theme.page.hero_breadcrumb_above</title></meta></param>
                            <param name="below"><meta><title>iw_sulu_tailwind_theme.page.hero_breadcrumb_below</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="pageHero_alignX" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.page.hero_align_x</title></meta>
                    <params>
                        <param name="default_value" value="left"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.align_left</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.align_center</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.align_right</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- The side-by-side banner falls back to the overlay one when a
                     page has no image, and the text then spans the full width
                     instead of sitting in a column. That is a different layout,
                     so it gets its own alignment. Empty follows the one above,
                     which is what every theme did before this existed. -->
                <property name="pageHero_alignXNoImage" type="single_select" colspan="6"
                          visibleCondition="pageHero_titleDisplay == 'side_by_side'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_align_x_no_image</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_align_x_no_image_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.page.hero_align_x_follow</title></meta></param>
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.align_left</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.align_center</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.align_right</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="pageHero_alignY" type="single_select" colspan="6"
                          visibleCondition="pageHero_titleDisplay == 'overlay'">
                    <meta><title>iw_sulu_tailwind_theme.page.hero_align_y</title></meta>
                    <params>
                        <param name="default_value" value="bottom"/>
                        <param name="values" type="collection">
                            <param name="top"><meta><title>iw_sulu_tailwind_theme.page.hero_align_top</title></meta></param>
                            <param name="middle"><meta><title>iw_sulu_tailwind_theme.page.hero_align_middle</title></meta></param>
                            <param name="bottom"><meta><title>iw_sulu_tailwind_theme.page.hero_align_bottom</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- The vertical position on the side-by-side banner, which the
                     overlay field above does not cover: there the text is
                     placed in the banner height, here in the row facing the
                     image. Both cases are named outright rather than one
                     following the other, the overlay field being hidden on this
                     mode. The defaults are what the CSS did before they
                     existed. -->
                <property name="pageHero_alignYWithImage" type="single_select" colspan="6"
                          visibleCondition="pageHero_titleDisplay == 'side_by_side'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_align_y_with_image</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_align_y_with_image_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="middle"/>
                        <param name="values" type="collection">
                            <param name="top"><meta><title>iw_sulu_tailwind_theme.page.hero_align_top</title></meta></param>
                            <param name="middle"><meta><title>iw_sulu_tailwind_theme.page.hero_align_middle</title></meta></param>
                            <param name="bottom"><meta><title>iw_sulu_tailwind_theme.page.hero_align_bottom</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="pageHero_alignYNoImage" type="single_select" colspan="6"
                          visibleCondition="pageHero_titleDisplay == 'side_by_side'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_align_y_no_image</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_align_y_no_image_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="bottom"/>
                        <param name="values" type="collection">
                            <param name="top"><meta><title>iw_sulu_tailwind_theme.page.hero_align_top</title></meta></param>
                            <param name="middle"><meta><title>iw_sulu_tailwind_theme.page.hero_align_middle</title></meta></param>
                            <param name="bottom"><meta><title>iw_sulu_tailwind_theme.page.hero_align_bottom</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="pageHero_shade" type="single_select" colspan="6"
                          visibleCondition="pageHero_titleDisplay == 'overlay'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.page.hero_shade</title>
                        <info_text>iw_sulu_tailwind_theme.page.hero_shade_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="medium"/>
                        <param name="values" type="collection">
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.page.hero_shade_none</title></meta></param>
                            <param name="light"><meta><title>iw_sulu_tailwind_theme.page.hero_shade_light</title></meta></param>
                            <param name="medium"><meta><title>iw_sulu_tailwind_theme.page.hero_shade_medium</title></meta></param>
                            <param name="strong"><meta><title>iw_sulu_tailwind_theme.page.hero_shade_strong</title></meta></param>
                        </param>
                    </params>
                </property>
            </properties>
        </section>

    </properties>
</form>
