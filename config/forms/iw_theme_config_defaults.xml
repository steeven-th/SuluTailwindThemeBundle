<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>iw_theme_config_defaults</key>

    <properties>
        <section name="borderRadii">
            <meta>
                <title>iw_sulu_tailwind_theme.borders_radii</title>
            </meta>
            <properties>
                <property name="borders_cardRadius" type="iw_theme_radius_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.borders_cardRadius</title>
                    </meta>
                    <params>
                        <param name="default_value" value="rounded-none"/>
                    </params>
                </property>

                <property name="borders_imageRadius" type="iw_theme_radius_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.borders_imageRadius</title>
                    </meta>
                    <params>
                        <param name="default_value" value="rounded-none"/>
                    </params>
                </property>

                <property name="borders_paragraphRadius" type="iw_theme_radius_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.borders_paragraphRadius</title>
                    </meta>
                    <params>
                        <param name="default_value" value="rounded-none"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Site-wide block defaults: settings shared by every block that are
             not tied to a single component (components have their own tab). -->
        <!-- The padding a block takes when the editor never chose one. Same
             selector as the block field, so the two read the same, and the
             shipped defaults are the ones the block fields used to carry: a
             site that never opens this section renders as before. -->
        <section name="blockPadding">
            <meta>
                <title>iw_sulu_tailwind_theme.defaults_section_block_padding</title>
                <info_text>iw_sulu_tailwind_theme.defaults_section_block_padding_info</info_text>
            </meta>
            <properties>
                <property name="defaults_blockPaddingTop" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_blockPaddingTop</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_blockPaddingTop_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="pt"/>
                        <param name="default_value" value="pt-5"/>
                    </params>
                </property>

                <property name="defaults_blockPaddingBottom" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_blockPaddingBottom</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_blockPaddingBottom_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="pb"/>
                        <param name="default_value" value="pb-5"/>
                    </params>
                </property>

                <property name="defaults_blockPaddingLateral" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_blockPaddingLateral</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_blockPaddingLateral_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="px"/>
                        <param name="default_value" value="px-5"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Space between a surface and what sits on it. Only surfaces that
             paint something need it: the compiler emits these paddings inside
             the rules already guarded by "has a background or a border", so a
             block with neither keeps its current layout. -->
        <section name="surfacePadding">
            <meta>
                <title>iw_sulu_tailwind_theme.defaults_section_surface_padding</title>
                <info_text>iw_sulu_tailwind_theme.defaults_section_surface_padding_info</info_text>
            </meta>
            <properties>
                <property name="defaults_contentPaddingX" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_contentPaddingX</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_contentPaddingX_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="px"/>
                        <param name="default_value" value="px-6"/>
                    </params>
                </property>

                <property name="defaults_contentPaddingY" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_contentPaddingY</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_contentPaddingY_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="py"/>
                        <param name="default_value" value="py-6"/>
                    </params>
                </property>

                <property name="defaults_paragraphPaddingX" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_paragraphPaddingX</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_paragraphPaddingX_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="px"/>
                        <param name="default_value" value="px-6"/>
                    </params>
                </property>

                <property name="defaults_paragraphPaddingY" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_paragraphPaddingY</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_paragraphPaddingY_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="py"/>
                        <param name="default_value" value="py-4"/>
                    </params>
                </property>
            </properties>
        </section>

        <section name="blockDefaults">
            <meta>
                <title>iw_sulu_tailwind_theme.defaults_section_blocks</title>
            </meta>
            <properties>
                <!-- Gap between the two content zones of split blocks
                     (text + images, form + widget, map + info, text + figures).
                     Halved below the md breakpoint, see app.css. -->
                <property name="defaults_blockGap" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_blockGap</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_blockGap_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="gap"/>
                        <param name="default_value" value="gap-6"/>
                    </params>
                </property>

                <!-- Space between a block's titles group and its content.
                     Owned by `.iw-block__titles`; the separator only carries
                     its top margin, so a variant hiding it keeps the spacing. -->
                <property name="defaults_titleGap" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_titleGap</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_titleGap_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="gap"/>
                        <param name="default_value" value="gap-6"/>
                    </params>
                </property>

                <!-- Spacing between the images of an image grid (text + images
                     mosaic, gallery grid, masonry and slider). Each block can
                     override it from its own Image spacing field. -->
                <property name="defaults_imageGap" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_imageGap</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_imageGap_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="gap"/>
                        <param name="default_value" value="gap-6"/>
                    </params>
                </property>

                <!-- Spacing inside the component grids that are not article
                     cards (accordion, documents, linked pages, testimonials,
                     key figures). Article card grids follow the card spacing
                     of the Components tab instead. -->
                <property name="defaults_componentGap" type="iw_theme_margin_selector" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_componentGap</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_componentGap_info</info_text>
                    </meta>
                    <params>
                        <param name="prefix" value="gap"/>
                        <param name="default_value" value="gap-6"/>
                    </params>
                </property>

                <!-- Maximum width of a block's content. Blocks are as wide as
                     the container by default, which leaves a short paragraph
                     stretched over the whole page. The steps follow Tailwind's
                     container scale, and each block can override the value
                     from its own Settings section. -->
                <property name="defaults_blockMaxWidth" type="single_select" colspan="4">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_blockMaxWidth</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_blockMaxWidth_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="none"/>
                        <param name="values" type="collection">
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.max_width_none</title></meta></param>
                            <param name="lg"><meta><title>iw_sulu_tailwind_theme.max_width_lg</title></meta></param>
                            <param name="xl"><meta><title>iw_sulu_tailwind_theme.max_width_xl</title></meta></param>
                            <param name="2xl"><meta><title>iw_sulu_tailwind_theme.max_width_2xl</title></meta></param>
                            <param name="3xl"><meta><title>iw_sulu_tailwind_theme.max_width_3xl</title></meta></param>
                            <param name="4xl"><meta><title>iw_sulu_tailwind_theme.max_width_4xl</title></meta></param>
                            <param name="5xl"><meta><title>iw_sulu_tailwind_theme.max_width_5xl</title></meta></param>
                            <param name="6xl"><meta><title>iw_sulu_tailwind_theme.max_width_6xl</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Which blocks the maximum width applies to. The field is a
                     button opening a modal, so 16 block types and their styles
                     do not weigh on the settings page. Disabled rather than
                     hidden without a width: the setting stays where the eye
                     found it, and the row keeps its three columns. -->
                <property name="defaults_blockMaxWidthScope" type="iw_theme_block_scope" colspan="4"
                          disabledCondition="defaults_blockMaxWidth == 'none'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.defaults_blockMaxWidthScope</title>
                        <info_text>iw_sulu_tailwind_theme.defaults_blockMaxWidthScope_info</info_text>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</form>
