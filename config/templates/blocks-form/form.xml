<?xml version="1.0" ?>
<!-- Global block type: Form (basic — without SuluFormBundle) -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>form</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.form</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading-plain.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_form</title></meta>
                        </param>
                    </params>
                </property>

                <xi:include href="../fragments/block-title-alignment.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="twigTemplate" type="text_line">
                    <meta>
                        <title>iw_sulu_tailwind_theme.form_twig_template</title>
                        <info_text>iw_sulu_tailwind_theme.form_twig_template_info</info_text>
                    </meta>
                </property>


                <!--
                    The widget zone, now the shared block type. It replaces a
                    select plus one conditioned field per kind, which is the
                    same shape text_images had. Four kinds here rather than the
                    three this block used to offer: a video beside a form is as
                    reasonable as a picture, and it costs an include.
                -->
                <block name="widget" default-type="text" minOccurs="1" maxOccurs="1"
                       visibleCondition="__parent.style == 'split'">
                    <meta><title>iw_sulu_tailwind_theme.widget</title></meta>
                    <types>
                        <xi:include href="../fragments/widgets/text.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                        <xi:include href="../fragments/widgets/image.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                        <xi:include href="../fragments/widgets/video.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                        <xi:include href="../fragments/widgets/location.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                    </types>
                </block>

            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="form"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <!-- Split-only: position of the form column vs the widget column -->
                <property name="formRight" type="checkbox"
                          visibleCondition="__parent.style == 'split'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.form_position_right</title>
                            </meta>
                        </param>
                    </params>
                </property>
                <!--
                    How the two zones share the width. Not a shared fragment,
                    because the field only makes sense for the styles that have
                    two zones and a condition cannot ride on an xi:include. The
                    same property lives in text_images, both form variants and
                    location: change one, change them all. The steps themselves
                    are guarded by `MediaRatioContractTest`.
                -->
                <property name="mediaRatio" type="single_select" colspan="6"
                          visibleCondition="__parent.style == 'split'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block_media_ratio</title>
                        <info_text>iw_sulu_tailwind_theme.block_media_ratio_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.media_ratio_style</title></meta></param>
                            <param name="auto"><meta><title>iw_sulu_tailwind_theme.media_ratio_auto</title></meta></param>
                            <param name="1-8"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_8</title></meta></param>
                            <param name="1-6"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_6</title></meta></param>
                            <param name="1-4"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_4</title></meta></param>
                            <param name="1-3"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_3</title></meta></param>
                            <param name="2-5"><meta><title>iw_sulu_tailwind_theme.media_ratio_2_5</title></meta></param>
                            <param name="1-2"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_2</title></meta></param>
                            <param name="3-5"><meta><title>iw_sulu_tailwind_theme.media_ratio_3_5</title></meta></param>
                            <param name="2-3"><meta><title>iw_sulu_tailwind_theme.media_ratio_2_3</title></meta></param>
                            <param name="3-4"><meta><title>iw_sulu_tailwind_theme.media_ratio_3_4</title></meta></param>
                        </param>
                    </params>
                </property>

                <!--
                    How the two zones line up vertically, once the taller one
                    has set the height. Its own field rather than more entries
                    in the media position: the two axes are independent, and
                    folding them together would mean a select of every
                    combination. Same duplication rule as the width split above.
                -->
                <property name="zonesAlign" type="single_select" colspan="6"
                          visibleCondition="__parent.style == 'split'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block_zones_align</title>
                        <info_text>iw_sulu_tailwind_theme.block_zones_align_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.zones_align_style</title></meta></param>
                            <param name="start"><meta><title>iw_sulu_tailwind_theme.zones_align_start</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.zones_align_center</title></meta></param>
                            <param name="end"><meta><title>iw_sulu_tailwind_theme.zones_align_end</title></meta></param>
                            <param name="stretch"><meta><title>iw_sulu_tailwind_theme.zones_align_stretch</title></meta></param>
                        </param>
                    </params>
                </property>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="imageRadius" type="iw_theme_radius_selector" colspan="6"
                          visibleCondition="__parent.style == 'split'">
                    <meta><title>iw_sulu_tailwind_theme.image_radius</title></meta>
                    <params>
                        <param name="theme_key" value="imageRadius"/>
                    </params>
                </property>
                <xi:include href="../fragments/block-background.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
