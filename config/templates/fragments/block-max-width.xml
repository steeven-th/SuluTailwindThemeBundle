<?xml version="1.0" ?>
<!--
    Fragment: maximum width of a block's content.

    A block is as wide as the page container by default, which leaves a short
    paragraph stretched over the whole width. This field caps it, and the
    stored value is a step of the Tailwind container scale ("3xl") rather than
    a class name, so a block and the theme default speak the same language and
    `_block_wrapper` only has to compare them.

    An empty value follows the theme (Settings > Themes > Defaults > Blocks >
    Maximum width), "none" opts a single block out of a theme that constrains
    everything.

    Include it in a block's `settings` section:

        <xi:include href="../fragments/block-max-width.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

    The rendering comes for free with `blocks/common/_block_wrapper.html.twig`:
    the constraint lands on the <section> when the lateral margins are
    exterior - the background is limited to the container there, so it has to
    shrink with the content - and on the inner container otherwise, where the
    background already runs edge to edge.
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <property name="maxWidth" type="single_select" colspan="6">
        <meta>
            <title>iw_sulu_tailwind_theme.block_max_width</title>
            <info_text>iw_sulu_tailwind_theme.block_max_width_info</info_text>
        </meta>
        <params>
            <param name="default_value" value=""/>
            <param name="values" type="collection">
                <param name=""><meta><title>iw_sulu_tailwind_theme.max_width_theme</title></meta></param>
                <param name="none"><meta><title>iw_sulu_tailwind_theme.max_width_none</title></meta></param>
                <param name="lg"><meta><title>iw_sulu_tailwind_theme.max_width_lg</title></meta></param>
                <param name="xl"><meta><title>iw_sulu_tailwind_theme.max_width_xl</title></meta></param>
                <param name="2xl"><meta><title>iw_sulu_tailwind_theme.max_width_2xl</title></meta></param>
                <param name="3xl"><meta><title>iw_sulu_tailwind_theme.max_width_3xl</title></meta></param>
                <param name="4xl"><meta><title>iw_sulu_tailwind_theme.max_width_4xl</title></meta></param>
                <param name="5xl"><meta><title>iw_sulu_tailwind_theme.max_width_5xl</title></meta></param>
                <param name="6xl"><meta><title>iw_sulu_tailwind_theme.max_width_6xl</title></meta></param>
            </param>
        </params>
    </property>
</properties>
