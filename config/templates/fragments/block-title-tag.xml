<?xml version="1.0" ?>
<!--
    Fragment: heading level of a block title.

    The visible level is a content decision, not a styling one. A block placed
    below the page <h1> usually wants an <h2>, one nested inside a section
    wants an <h3>, and the theme styles all of them the same way, so changing
    it never breaks the design.

    Bundled in `block-heading.xml`. Include it on its own only when a block
    needs the level without the rest of the heading group:

        <xi:include href="../fragments/block-title-tag.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <property name="titleTag" type="single_select" colspan="6">
        <meta>
            <title>iw_sulu_tailwind_theme.title_level</title>
            <info_text>iw_sulu_tailwind_theme.title_level_info</info_text>
        </meta>
        <params>
            <param name="default_value" value="h2"/>
            <param name="values" type="collection">
                <param name="h2"><meta><title>iw_sulu_tailwind_theme.title_level_h2</title></meta></param>
                <param name="h3"><meta><title>iw_sulu_tailwind_theme.title_level_h3</title></meta></param>
                <param name="h4"><meta><title>iw_sulu_tailwind_theme.title_level_h4</title></meta></param>
            </param>
        </params>
    </property>
</properties>
