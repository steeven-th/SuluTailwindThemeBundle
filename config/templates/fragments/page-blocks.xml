<?xml version="1.0" ?>
<!--
    Fragment: the content block container, with every block type the theme ships.

    Pages and articles offer the same palette, so the list lives here rather
    than in each template. That is also what keeps a newly added block type
    from landing on pages and being forgotten on articles.

    Include it with the `block` xpointer, not the `property` one:

        <xi:include href="../fragments/page-blocks.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:block)"/>

    To offer a shorter list, skip this fragment and write your own container
    with the `<type ref="..."/>` entries you want. The block types themselves
    are registered globally, so any of them can be referenced by name.
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <block name="blocks" default-type="text" minOccurs="0">
        <meta>
            <title>iw_sulu_tailwind_theme.content_blocks</title>
        </meta>
        <types>
            <type ref="text"/>
            <type ref="text_images"/>
            <type ref="gallery"/>
            <type ref="key_figures"/>
            <type ref="linked_pages"/>
            <type ref="location"/>
            <type ref="form"/>
            <type ref="document"/>
            <type ref="testimonial"/>
            <type ref="accordion"/>
            <type ref="iframe"/>
            <type ref="code"/>
            <type ref="separator"/>
            <type ref="article_carousel"/>
            <type ref="article_featured"/>
            <type ref="article_list"/>
        </types>
    </block>
</properties>
