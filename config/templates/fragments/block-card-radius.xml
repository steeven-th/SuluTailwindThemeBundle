<?xml version="1.0" ?>
<!--
    Fragment: corner radius of the cards a block renders.

    For blocks that repeat a surface: article teasers, accordion items,
    testimonials, documents. It leaves the block background alone, which is
    what `block-radius.xml` covers.
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <property name="cardRadius" type="iw_theme_radius_selector" colspan="6">
        <meta><title>iw_sulu_tailwind_theme.card_radius</title></meta>
        <params>
            <param name="theme_key" value="cardRadius"/>
        </params>
    </property>
</properties>
