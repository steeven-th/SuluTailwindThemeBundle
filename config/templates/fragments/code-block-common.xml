<?xml version="1.0" ?>
<!--
    Fragment: Code block settings shared by both variants of the block.

    The code block ships in two forms, selected in the bundle extension from
    `blocks.code.allow_unsandboxed`:
      - blocks-code/code.xml          — sandbox always on (default)
      - blocks-code-open/code.xml     — adds a per-block "disable the sandbox"
                                        checkbox, for projects that opted in

    Everything except that checkbox lives here, so the two variants cannot
    drift apart.
-->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xi="http://www.w3.org/2001/XInclude">
    <property name="heightMode" type="single_select" colspan="6">
        <meta>
            <title>iw_sulu_tailwind_theme.embed_height_mode</title>
            <info_text>iw_sulu_tailwind_theme.code_height_mode_info</info_text>
        </meta>
        <params>
            <param name="default_value" value="auto"/>
            <param name="values" type="collection">
                <param name="auto"><meta><title>iw_sulu_tailwind_theme.code_height_auto</title></meta></param>
                <param name="ratio"><meta><title>iw_sulu_tailwind_theme.embed_height_mode_ratio</title></meta></param>
                <param name="preset"><meta><title>iw_sulu_tailwind_theme.embed_height_mode_preset</title></meta></param>
                <param name="custom"><meta><title>iw_sulu_tailwind_theme.embed_height_mode_custom</title></meta></param>
            </param>
        </params>
    </property>

    <property name="ratio" type="single_select" colspan="6"
              visibleCondition="__parent.heightMode == 'ratio'">
        <meta><title>iw_sulu_tailwind_theme.embed_ratio</title></meta>
        <params>
            <param name="default_value" value="16-9"/>
            <param name="values" type="collection">
                <param name="16-9"><meta><title>iw_sulu_tailwind_theme.embed_ratio_16_9</title></meta></param>
                <param name="4-3"><meta><title>iw_sulu_tailwind_theme.embed_ratio_4_3</title></meta></param>
                <param name="1-1"><meta><title>iw_sulu_tailwind_theme.embed_ratio_1_1</title></meta></param>
                <param name="21-9"><meta><title>iw_sulu_tailwind_theme.embed_ratio_21_9</title></meta></param>
                <param name="9-16"><meta><title>iw_sulu_tailwind_theme.embed_ratio_9_16</title></meta></param>
            </param>
        </params>
    </property>

    <property name="heightPreset" type="single_select" colspan="6"
              visibleCondition="__parent.heightMode == 'preset'">
        <meta><title>iw_sulu_tailwind_theme.embed_height_preset</title></meta>
        <params>
            <param name="default_value" value="500"/>
            <param name="values" type="collection">
                <param name="300"><meta><title>iw_sulu_tailwind_theme.embed_height_300</title></meta></param>
                <param name="400"><meta><title>iw_sulu_tailwind_theme.embed_height_400</title></meta></param>
                <param name="500"><meta><title>iw_sulu_tailwind_theme.embed_height_500</title></meta></param>
                <param name="600"><meta><title>iw_sulu_tailwind_theme.embed_height_600</title></meta></param>
                <param name="800"><meta><title>iw_sulu_tailwind_theme.embed_height_800</title></meta></param>
                <param name="1000"><meta><title>iw_sulu_tailwind_theme.embed_height_1000</title></meta></param>
            </param>
        </params>
    </property>

    <property name="heightCustom" type="number" colspan="6"
              visibleCondition="__parent.heightMode == 'custom'">
        <meta>
            <title>iw_sulu_tailwind_theme.embed_height_custom</title>
            <info_text>iw_sulu_tailwind_theme.embed_height_custom_info</info_text>
        </meta>
        <params>
            <param name="default_value" value="500"/>
        </params>
    </property>

    <property name="inheritThemeStyles" type="checkbox">
        <meta>
            <title>iw_sulu_tailwind_theme.code_inherit_styles</title>
            <info_text>iw_sulu_tailwind_theme.code_inherit_styles_info</info_text>
        </meta>
        <params>
            <param name="default_value" value="true"/>
        </params>
    </property>

    <property name="allowTopNavigation" type="checkbox">
        <meta>
            <title>iw_sulu_tailwind_theme.embed_allow_top_navigation</title>
            <info_text>iw_sulu_tailwind_theme.embed_allow_top_navigation_info</info_text>
        </meta>
        <params>
            <param name="default_value" value="false"/>
        </params>
    </property>

    <property name="consentMode" type="single_select">
        <meta>
            <title>iw_sulu_tailwind_theme.consent_mode</title>
            <info_text>iw_sulu_tailwind_theme.consent_mode_info</info_text>
        </meta>
        <params>
            <param name="default_value" value="none"/>
            <param name="values" type="collection">
                <param name="none"><meta><title>iw_sulu_tailwind_theme.consent_mode_none</title></meta></param>
                <param name="placeholder"><meta><title>iw_sulu_tailwind_theme.consent_mode_placeholder</title></meta></param>
                <param name="delegated"><meta><title>iw_sulu_tailwind_theme.consent_mode_delegated</title></meta></param>
            </param>
        </params>
    </property>

    <property name="consentService" type="text_line" colspan="6"
              visibleCondition="__parent.consentMode != 'none'">
        <meta>
            <title>iw_sulu_tailwind_theme.consent_service</title>
            <info_text>iw_sulu_tailwind_theme.consent_service_info</info_text>
        </meta>
    </property>

    <property name="consentText" type="text_area" colspan="6"
              visibleCondition="__parent.consentMode != 'none'">
        <meta>
            <title>iw_sulu_tailwind_theme.consent_text</title>
            <info_text>iw_sulu_tailwind_theme.consent_text_info</info_text>
        </meta>
    </property>

    <xi:include href="block-spacing.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

    <xi:include href="block-radius.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

    <xi:include href="block-card-radius.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

    <xi:include href="block-background.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
</properties>
