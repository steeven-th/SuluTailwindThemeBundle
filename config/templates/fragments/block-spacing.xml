<?xml version="1.0" ?>
<!--
    Fragment: the whole spacing group of a block, in its canonical order.

    Margins, then how the block sits in the container, then its maximum width,
    then the inner paddings. Every block opens its `settings` section with it,
    which is what keeps the settings tab recognisable from one block to the
    next and makes a change to the group land everywhere at once.

        <xi:include href="../fragments/block-spacing.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

    A block that has to alter one field composes the group from the four
    fragments below instead of including this one, and writes only the field
    it changes. See `text_images` for a worked example.
-->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xi="http://www.w3.org/2001/XInclude">
    <!--
        A heading, and a deliberate one: it names the group, and it spans the
        full width, which resets the two-column grid. Without that reset an odd
        number of half-width fields above pushes every pair below out of step,
        and a margin selector full of boxes ends up beside a plain select. The
        count above cannot be fixed by hand either, since visibility conditions
        change it at runtime.
    -->
    <property name="spacingHeading" type="heading">
        <params>
            <param name="label">
                <meta><title>iw_sulu_tailwind_theme.settings_group_spacing</title></meta>
            </param>
        </params>
    </property>

    <xi:include href="block-margins.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
    <xi:include href="block-lateral-margins.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
    <xi:include href="block-max-width.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
    <xi:include href="block-paddings.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
</properties>
