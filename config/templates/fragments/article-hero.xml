<?xml version="1.0" ?>
<!--
    Fragment: Article hero section properties.
    Now hero-content.xml, shared with pages. Kept so the project templates
    that include it keep working. Its former `subtitle` is `heroSubtitle`
    there: content saved before is moved by iw-sulu:theme:migrate-article-hero.
    Summary/description, categories, tags, and SEO fields are handled
    natively by Sulu's Excerpt tab.
-->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xi="http://www.w3.org/2001/XInclude">
    <xi:include href="hero-content.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
</properties>
