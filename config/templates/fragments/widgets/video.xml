<?xml version="1.0" ?>
<!--
    Widget: an embedded or self-hosted video.

    The provider decides which field follows, so that condition stays inside the
    type: one level, on a sibling, rather than the three-level chain it took
    when the whole thing hung off a select in the block.

    YouTube and Vimeo are contacted as soon as the frame loads, so an embedded
    video always waits for consent, the way the project's `consent.mode`
    setting says (doc/consent.md). There is no field for it here: an editor
    cannot know whether a cookie manager is wired, the developer does. The
    preview image is the `poster` of a hosted file, and the backdrop of the
    consent placeholder otherwise. It is never what protects.
-->
<types xmlns="http://schemas.sulu.io/template/template">
    <type name="video">
        <meta>
            <title>iw_sulu_tailwind_theme.widget_video</title>
        </meta>
        <properties>
            <!-- The provider on its own row: the field that follows is an id or a
                 media picker, both of which want the full width. -->
            <property name="provider" type="single_select" colspan="6">
                <meta>
                    <title>iw_sulu_tailwind_theme.video_provider</title>
                </meta>
                <params>
                    <param name="default_value" value="youtube"/>
                    <param name="values" type="collection">
                        <param name="youtube"><meta><title>iw_sulu_tailwind_theme.video_provider_youtube</title></meta></param>
                        <param name="vimeo"><meta><title>iw_sulu_tailwind_theme.video_provider_vimeo</title></meta></param>
                        <param name="file"><meta><title>iw_sulu_tailwind_theme.video_provider_file</title></meta></param>
                    </param>
                </params>
            </property>
            <!-- Beside the provider, on the row it leaves free. A playlist is
                 embedded by its own id, the one after `list=`, and through
                 another address: two fields rather than one, so each keeps a
                 label and a help that say what to paste, and switching back
                 keeps the video id. -->
            <property name="youtubePlaylist" type="checkbox" colspan="6"
                      visibleCondition="__parent.provider == 'youtube'">
                <meta><title>iw_sulu_tailwind_theme.video_youtube_playlist</title></meta>
            </property>
            <property name="youtubeId" type="text_line"
                      visibleCondition="__parent.provider == 'youtube' AND __parent.youtubePlaylist != true">
                <meta>
                    <title>iw_sulu_tailwind_theme.video_youtube_id</title>
                    <info_text>iw_sulu_tailwind_theme.video_youtube_id_info</info_text>
                </meta>
            </property>
            <property name="youtubePlaylistId" type="text_line"
                      visibleCondition="__parent.provider == 'youtube' AND __parent.youtubePlaylist == true">
                <meta>
                    <title>iw_sulu_tailwind_theme.video_youtube_playlist_id</title>
                    <info_text>iw_sulu_tailwind_theme.video_youtube_playlist_id_info</info_text>
                </meta>
            </property>
            <property name="vimeoId" type="text_line"
                      visibleCondition="__parent.provider == 'vimeo'">
                <meta>
                    <title>iw_sulu_tailwind_theme.video_vimeo_id</title>
                    <info_text>iw_sulu_tailwind_theme.video_vimeo_id_info</info_text>
                </meta>
            </property>
            <property name="videoFile" type="single_media_selection"
                      visibleCondition="__parent.provider == 'file'">
                <meta><title>iw_sulu_tailwind_theme.video_file</title></meta>
                <params>
                    <param name="types" value="video"/>
                </params>
            </property>
            <property name="videoPoster" type="single_media_selection">
                <meta>
                    <title>iw_sulu_tailwind_theme.video_poster</title>
                    <info_text>iw_sulu_tailwind_theme.video_poster_info</info_text>
                </meta>
                <params>
                    <param name="types" value="image"/>
                </params>
            </property>
        </properties>
    </type>
</types>
