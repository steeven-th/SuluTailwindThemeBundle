<?xml version="1.0" ?>
<!--
    Fragment: which theme the colours and buttons of this snippet come from.

    A snippet carries no site, so the swatches and button previews in its form
    belong to the theme of whichever site shows it. An editor looking at a
    palette has no way of knowing whose it is, and on a multi-site project the
    answer decides whether what they are picking is the right thing at all.

    The notice says that, rather than explaining how areas work. Where a
    snippet appears is a question the editor asks once, which the documentation
    answers. Whose colours these are is a question the form itself raises every
    time it is opened.

    Included as the first property of every area-assigned snippet:

        <xi:include href="../fragments/snippet-area-notice.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <property name="areaNotice" type="heading">
        <params>
            <param name="label">
                <meta><title>iw_sulu_tailwind_theme.snippet_area_notice</title></meta>
            </param>
            <param name="description">
                <meta><title>iw_sulu_tailwind_theme.snippet_area_notice_info</title></meta>
            </param>
            <param name="icon" value="su-webspace"/>
        </params>
    </property>
</properties>
