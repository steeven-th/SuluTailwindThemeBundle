<?xml version="1.0" ?>
<!--
    Fragment: Page hero section properties (per-page DATA only).
    Now hero-content.xml, shared with articles. Kept so the project templates
    that include it keep working.
    The banner appearance (height, title placement, alignment, veil,
    parallax, breadcrumb) is configured site-wide in the theme admin
    (Components tab → Page hero), exposed as iw_sulu_tailwind_theme.pageHero_*.
-->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xi="http://www.w3.org/2001/XInclude">
    <xi:include href="hero-content.xml"
                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
</properties>
