<?xml version="1.0" ?>
<!--
    Fragment: inner paddings of a block.

    Paddings live inside the block background, so they are what gives a
    coloured block its breathing room. The lateral one carries the `px` prefix
    because the selector defaults to the vertical scale.

    All three are half width. The lateral one ends up alone on its row, which
    is fine: the heading opening the next group closes the row anyway, so it
    cannot be paired with a field of another height.

    None of them ships a default value any more: left empty they follow the
    theme, which is what `theme_key` tells the selector to display. A block
    that DID choose a padding keeps it, `pt-0` included - empty and zero are
    different answers, one deferring to the theme and the other refusing any
    padding at all.

    Bundled in `block-spacing.xml`.
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <property name="paddingTop" type="iw_theme_margin_selector" colspan="6">
        <meta><title>iw_sulu_tailwind_theme.padding_top</title></meta>
        <params>
            <param name="theme_key" value="top"/>
        </params>
    </property>
    <property name="paddingBottom" type="iw_theme_margin_selector" colspan="6">
        <meta><title>iw_sulu_tailwind_theme.padding_bottom</title></meta>
        <params>
            <param name="theme_key" value="bottom"/>
        </params>
    </property>
    <property name="paddingLateral" type="iw_theme_margin_selector" colspan="6">
        <meta><title>iw_sulu_tailwind_theme.padding_lateral</title></meta>
        <params>
            <param name="prefix" value="px"/>
            <param name="theme_key" value="lateral"/>
        </params>
    </property>
</properties>
