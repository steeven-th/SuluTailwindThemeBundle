<?xml version="1.0" ?>
<!--
    Article template: Event.
    Provides an event article structure with start/end dates, location,
    pricing, organizer, performers, hero, and content blocks. Categories, tags, description,
    and SEO are handled by Sulu's native Excerpt tab.
-->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>iw_event</key>
    <group>events</group>
    <view>@ItechWorldSuluTailwindTheme/articles/event</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title>iw_sulu_tailwind_theme.article.event</title>
    </meta>

    <properties>
        <!-- Header -->
        <xi:include href="../../fragments/article-header.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

        <!-- Hero section -->
        <section name="hero">
            <meta><title>iw_sulu_tailwind_theme.article.section_hero</title></meta>
            <properties>
                <xi:include href="../../fragments/article-hero.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>

        <!-- Event details section -->
        <section name="eventDetails">
            <meta><title>iw_sulu_tailwind_theme.article.section_event_details</title></meta>
            <properties>
                <property name="startDate" type="datetime" mandatory="true" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.article.event_start_date</title></meta>
                </property>

                <property name="endDate" type="datetime" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.article.event_end_date</title></meta>
                </property>

                <property name="isOnline" type="checkbox" colspan="12">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_is_online</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_is_online_info</info_text>
                    </meta>
                </property>

                <property name="location" type="location" colspan="12"
                          visibleCondition="isOnline == false OR isOnline == null">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_location</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_location_info</info_text>
                    </meta>
                </property>

                <property name="showMapLink" type="checkbox" colspan="12"
                          visibleCondition="isOnline == false OR isOnline == null">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_show_map_link</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_show_map_link_info</info_text>
                    </meta>
                </property>

                <property name="locationUrl" type="url" colspan="12"
                          visibleCondition="isOnline == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_location_url</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_location_url_info</info_text>
                    </meta>
                    <params>
                        <param name="defaults" type="collection">
                            <param name="scheme" value="https://"/>
                        </param>
                        <param name="schemes" type="collection">
                            <param name="https://"/>
                            <param name="http://"/>
                        </param>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Pricing section: always produces a schema.org Offer, free events included -->
        <section name="pricing">
            <meta><title>iw_sulu_tailwind_theme.article.section_pricing</title></meta>
            <properties>
                <property name="isPaid" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_is_paid</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_is_paid_info</info_text>
                    </meta>
                </property>

                <property name="price" type="number" colspan="6" visibleCondition="isPaid == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_price</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_price_info</info_text>
                    </meta>
                    <params>
                        <param name="min" value="0"/>
                        <param name="step" value="0.01"/>
                    </params>
                </property>

                <property name="ticketUrl" type="url" colspan="12">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.event_ticket_url</title>
                        <info_text>iw_sulu_tailwind_theme.article.event_ticket_url_info</info_text>
                    </meta>
                    <!-- Web links only: a mailto: or tel: here would be served to search
                         engines as the URL of the event, and ftp:// has no place in it. -->
                    <params>
                        <param name="defaults" type="collection">
                            <param name="scheme" value="https://"/>
                        </param>
                        <param name="schemes" type="collection">
                            <param name="https://"/>
                            <param name="http://"/>
                        </param>
                    </params>
                </property>
            </properties>
        </section>

        <!-- Organizer section -->
        <section name="organizer">
            <meta><title>iw_sulu_tailwind_theme.article.section_organizer</title></meta>
            <properties>
                <block name="organizer" default-type="custom" minOccurs="0" maxOccurs="1">
                    <meta><title>iw_sulu_tailwind_theme.article.organizer</title></meta>
                    <types>
                        <xi:include href="../../fragments/event-party-types.xml"
                                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                    </types>
                </block>
            </properties>
        </section>

        <!-- Performers section: who leads the event (speaker, trainer, host),
             schema.org `performer`, distinct from the organizer -->
        <section name="performers">
            <meta><title>iw_sulu_tailwind_theme.article.section_performers</title></meta>
            <properties>
                <block name="performers" default-type="custom" minOccurs="0" maxOccurs="10">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.performer</title>
                        <info_text>iw_sulu_tailwind_theme.article.performer_info</info_text>
                    </meta>
                    <types>
                        <xi:include href="../../fragments/event-party-types.xml"
                                xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                    </types>
                </block>
            </properties>
        </section>

        <!-- Content blocks -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.article.section_content</title></meta>
            <properties>
                <xi:include href="../../fragments/page-blocks.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:block)"/>
            </properties>
        </section>

    </properties>
</template>
