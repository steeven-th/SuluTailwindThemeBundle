<?xml version="1.0" ?>
<!--
    Default page template for SuluTailwindThemeBundle.
    Uses global block types registered via sulu_admin.templates.block.directories.

    To create a custom page with fewer blocks, copy this file and replace the
    `page-blocks` include with your own <block> container, keeping only the
    <type ref="..."/> entries you want. Block types are registered globally,
    so any of them can be referenced by name from your own templates.
-->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>iw_theme_default</key>
    <view>@ItechWorldSuluTailwindTheme/pages/default</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title>iw_sulu_tailwind_theme.page.default</title>
    </meta>

    <properties>
        <xi:include href="../fragments/page-header.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

        <!-- Hero section: optional full-width banner image + overriding H1 title -->
        <section name="hero">
            <meta><title>iw_sulu_tailwind_theme.page.section_hero</title></meta>
            <properties>
                <xi:include href="../fragments/page-hero.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>

        <xi:include href="../fragments/page-blocks.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:block)"/>
    </properties>
</template>
