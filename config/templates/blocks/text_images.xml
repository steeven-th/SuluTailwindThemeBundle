<?xml version="1.0" ?>
<!-- Global block type: Text and images -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>text_images</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.text_images</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <property name="title" type="iw_theme_title_editor">
                    <meta>
                        <title>iw_sulu_tailwind_theme.title</title>
                        <info_text>iw_sulu_tailwind_theme.title_info</info_text>
                    </meta>
                    <params>
                        <param name="context" value="blocks"/>
                    </params>
                </property>
                <property name="subTitle" type="iw_theme_title_editor">
                    <meta><title>iw_sulu_tailwind_theme.subtitle</title></meta>
                    <params>
                        <param name="context" value="blocks"/>
                    </params>
                </property>
                <property name="titleTag" type="single_select">
                    <meta>
                        <title>iw_sulu_tailwind_theme.title_level</title>
                        <info_text>iw_sulu_tailwind_theme.title_level_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="h2"/>
                        <param name="values" type="collection">
                            <param name="h2"><meta><title>iw_sulu_tailwind_theme.title_level_h2</title></meta></param>
                            <param name="h3"><meta><title>iw_sulu_tailwind_theme.title_level_h3</title></meta></param>
                            <param name="h4"><meta><title>iw_sulu_tailwind_theme.title_level_h4</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="titleAlignment" type="single_select">
                    <meta><title>iw_sulu_tailwind_theme.title_alignment</title></meta>
                    <params>
                        <param name="default_value" value="left"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.align_left</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.align_center</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.align_right</title></meta></param>
                        </param>
                    </params>
                </property>
                <!-- Classic: the media zone can hold a video rather than images.
                     Carried over from the CTA block's video accessory, removed
                     in 3.0.0. -->
                <property name="mediaType" type="single_select"
                          visibleCondition="__parent.style == 'classic'">
                    <meta><title>iw_sulu_tailwind_theme.media_type</title></meta>
                    <params>
                        <param name="default_value" value="images"/>
                        <param name="values" type="collection">
                            <param name="images"><meta><title>iw_sulu_tailwind_theme.media_type_images</title></meta></param>
                            <param name="video"><meta><title>iw_sulu_tailwind_theme.media_type_video</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="videoProvider" type="single_select"
                          visibleCondition="__parent.style == 'classic' AND __parent.mediaType == 'video'">
                    <meta><title>iw_sulu_tailwind_theme.video_provider</title></meta>
                    <params>
                        <param name="default_value" value="youtube"/>
                        <param name="values" type="collection">
                            <param name="youtube"><meta><title>YouTube</title></meta></param>
                            <param name="vimeo"><meta><title>Vimeo</title></meta></param>
                            <param name="file"><meta><title>iw_sulu_tailwind_theme.video_provider_file</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="youtubeId" type="text_line"
                          visibleCondition="__parent.style == 'classic' AND __parent.mediaType == 'video' AND __parent.videoProvider == 'youtube'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.youtube_id</title>
                        <info_text>iw_sulu_tailwind_theme.youtube_id_info</info_text>
                    </meta>
                </property>

                <property name="vimeoId" type="text_line"
                          visibleCondition="__parent.style == 'classic' AND __parent.mediaType == 'video' AND __parent.videoProvider == 'vimeo'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.vimeo_id</title>
                        <info_text>iw_sulu_tailwind_theme.vimeo_id_info</info_text>
                    </meta>
                </property>

                <property name="videoFile" type="single_media_selection"
                          visibleCondition="__parent.style == 'classic' AND __parent.mediaType == 'video' AND __parent.videoProvider == 'file'">
                    <meta><title>iw_sulu_tailwind_theme.video_file</title></meta>
                </property>

                <property name="videoPoster" type="single_media_selection"
                          visibleCondition="__parent.style == 'classic' AND __parent.mediaType == 'video' AND __parent.videoProvider == 'file'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.video_poster</title>
                        <info_text>iw_sulu_tailwind_theme.video_poster_info</info_text>
                    </meta>
                </property>

                <!-- Multiple images: hidden for overlay and hero_banner (use single image) -->
                <property name="images" type="media_selection"
                          visibleCondition="__parent.style != 'overlay' AND __parent.style != 'hero_banner'">
                    <meta><title>iw_sulu_tailwind_theme.images</title></meta>
                </property>
                <!-- Single image: only for overlay and hero_banner layouts -->
                <property name="image" type="single_media_selection"
                          visibleCondition="__parent.style == 'overlay' OR __parent.style == 'hero_banner'">
                    <meta><title>iw_sulu_tailwind_theme.image</title></meta>
                </property>
                <property name="imageFilter" type="single_select"
                          visibleCondition="__parent.style != 'overlay' AND __parent.style != 'mosaic' AND __parent.style != 'hero_banner' AND __parent.style != 'split_screen'">
                    <meta><title>iw_sulu_tailwind_theme.image_format</title></meta>
                    <params>
                        <param name="default_value" value="original"/>
                        <param name="values" type="collection">
                            <param name="16_9"><meta><title>16:9</title></meta></param>
                            <param name="4_3"><meta><title>4:3</title></meta></param>
                            <param name="1_1"><meta><title>1:1</title></meta></param>
                            <param name="3_4"><meta><title>3:4</title></meta></param>
                            <param name="original"><meta><title>iw_sulu_tailwind_theme.format_original</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="imagePosition" type="single_select"
                          visibleCondition="__parent.style == 'classic'">
                    <meta><title>iw_sulu_tailwind_theme.image_position</title></meta>
                    <params>
                        <param name="default_value" value="right"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.position_left</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.position_right</title></meta></param>
                            <param name="top"><meta><title>iw_sulu_tailwind_theme.position_top</title></meta></param>
                            <param name="bottom"><meta><title>iw_sulu_tailwind_theme.position_bottom</title></meta></param>
                            <param name="background"><meta><title>iw_sulu_tailwind_theme.position_background</title></meta></param>
                        </param>
                    </params>
                </property>
                <!-- Classic (left/right) + Split-screen: mobile-only image position
                     (desktop position is driven by imagePosition / contentRight) -->
                <property name="mobileImagePosition" type="single_select"
                          visibleCondition="(__parent.style == 'classic' AND (__parent.imagePosition == 'left' OR __parent.imagePosition == 'right')) OR __parent.style == 'split_screen'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.mobile_image_position</title>
                        <info_text>iw_sulu_tailwind_theme.mobile_image_position_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="top"/>
                        <param name="values" type="collection">
                            <param name="top"><meta><title>iw_sulu_tailwind_theme.position_top</title></meta></param>
                            <param name="bottom"><meta><title>iw_sulu_tailwind_theme.position_bottom</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Mosaic: choose where the mosaic sits relative to the text -->
                <property name="mosaicImagePosition" type="single_select"
                          visibleCondition="__parent.style == 'mosaic'">
                    <meta><title>iw_sulu_tailwind_theme.image_position</title></meta>
                    <params>
                        <param name="default_value" value="right"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.position_left</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.position_right</title></meta></param>
                            <param name="top"><meta><title>iw_sulu_tailwind_theme.position_top</title></meta></param>
                            <param name="bottom"><meta><title>iw_sulu_tailwind_theme.position_bottom</title></meta></param>
                        </param>
                    </params>
                </property>
                <!-- Mosaic: spacing between the images of the mosaic grid.
                     Empty follows the theme's card spacing; an explicit choice
                     emits an `iw-gap` class feeding the gap variable. -->
                <property name="mosaicGap" type="single_select"
                          visibleCondition="__parent.style == 'mosaic'">
                    <meta><title>iw_sulu_tailwind_theme.mosaic_gap</title></meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.image_gap_theme</title></meta></param>
                            <param name="iw-gap--0"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_none</title></meta></param>
                            <param name="iw-gap--2"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_very_compact</title></meta></param>
                            <param name="iw-gap--4"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_compact</title></meta></param>
                            <param name="iw-gap--5"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_compact_plus</title></meta></param>
                            <param name="iw-gap--6"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_normal</title></meta></param>
                            <param name="iw-gap--8"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_spacious</title></meta></param>
                            <param name="iw-gap--10"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_large</title></meta></param>
                            <param name="iw-gap--12"><meta><title>iw_sulu_tailwind_theme.defaults_spacing_xlarge</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="showImagesName" type="checkbox"
                          visibleCondition="__parent.style != 'overlay' AND __parent.style != 'hero_banner'">
                    <meta><title>iw_sulu_tailwind_theme.show_images_name</title></meta>
                </property>
                <!-- Overlay / Sidebar: toggle content position left/right -->
                <property name="contentRight" type="checkbox"
                          visibleCondition="__parent.style == 'overlay' OR __parent.style == 'sidebar' OR __parent.style == 'split_screen'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.content_position_right</title>
                            </meta>
                        </param>
                    </params>
                </property>
                <!-- Fullwidth: toggle image position top/bottom -->
                <property name="imageBottom" type="checkbox"
                          visibleCondition="__parent.style == 'fullwidth'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.image_position_bottom</title>
                            </meta>
                        </param>
                    </params>
                </property>
                <!-- Fullwidth: toggle image padding (auto-on when radius is set) -->
                <property name="imagePadding" type="checkbox"
                          visibleCondition="__parent.style == 'fullwidth'">
                    <meta>
                        <info_text>iw_sulu_tailwind_theme.image_padding_info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.image_padding</title>
                            </meta>
                        </param>
                    </params>
                </property>
                <property name="text" type="text_editor">
                    <meta><title>iw_sulu_tailwind_theme.text</title></meta>
                </property>
                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <property name="variant" type="iw_theme_variant_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.color_variant</title></meta>
                </property>
                <property name="style" type="iw_theme_style_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="text_images"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <property name="marginTop" type="iw_theme_margin_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.margin_top</title></meta>
                    <params>
                        <param name="default_value" value="mt-5"/>
                    </params>
                </property>
                <property name="marginBottom" type="iw_theme_margin_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.margin_bottom</title></meta>
                    <params>
                        <param name="default_value" value="mb-5"/>
                    </params>
                </property>
                <property name="lateralMargins" type="single_select"
                          visibleCondition="__parent.style != 'hero_banner'">
                    <meta><title>iw_sulu_tailwind_theme.lateral_margins</title></meta>
                    <params>
                        <param name="default_value" value="exterior"/>
                        <param name="values" type="collection">
                            <param name="exterior"><meta><title>iw_sulu_tailwind_theme.lateral_margins_exterior</title></meta></param>
                            <param name="interior"><meta><title>iw_sulu_tailwind_theme.lateral_margins_interior</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.lateral_margins_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <!-- Maximum width of the block content, shared by every block.
                     Left out of the theme's suggested scope: the block pairs a
                     text zone with an image zone, so a site-wide cap shrinks
                     the image along with the text. An editor who wants it here
                     still sets it per block. -->
                <xi:include href="../fragments/block-max-width.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="paddingTop" type="iw_theme_margin_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.padding_top</title></meta>
                    <params>
                        <param name="default_value" value="pt-5"/>
                    </params>
                </property>
                <property name="paddingBottom" type="iw_theme_margin_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.padding_bottom</title></meta>
                    <params>
                        <param name="default_value" value="pb-5"/>
                    </params>
                </property>
                <property name="paddingLateral" type="iw_theme_margin_selector">
                    <meta><title>iw_sulu_tailwind_theme.padding_lateral</title></meta>
                    <params>
                        <param name="prefix" value="px"/>
                        <param name="default_value" value="px-5"/>
                    </params>
                </property>
                <property name="blockRadius" type="iw_theme_radius_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.block_radius</title></meta>
                    <params>
                        <param name="theme_key" value="cardRadius"/>
                    </params>
                </property>
                <property name="paragraphRadius" type="iw_theme_radius_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.paragraph_radius</title></meta>
                    <params>
                        <param name="theme_key" value="paragraphRadius"/>
                    </params>
                </property>
                <property name="imageRadius" type="iw_theme_radius_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.image_radius</title></meta>
                    <params>
                        <param name="theme_key" value="imageRadius"/>
                    </params>
                </property>
                <property name="showBackground" type="checkbox">
                    <meta><title>iw_sulu_tailwind_theme.show_background</title></meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>
            </properties>
        </section>
    </properties>
</template>
