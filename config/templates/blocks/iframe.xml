<?xml version="1.0" ?>
<!-- Global block type: Iframe (external embed) -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>iframe</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.iframe</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_embed</title></meta>
                        </param>
                    </params>
                </property>

                <property name="url" type="text_line">
                    <meta>
                        <title>iw_sulu_tailwind_theme.iframe_url</title>
                        <info_text>iw_sulu_tailwind_theme.iframe_url_info</info_text>
                    </meta>
                </property>
                <property name="iframeTitle" type="text_line">
                    <meta>
                        <title>iw_sulu_tailwind_theme.iframe_title</title>
                        <info_text>iw_sulu_tailwind_theme.iframe_title_info</info_text>
                    </meta>
                </property>
                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="iframe"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <property name="heightMode" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_height_mode</title>
                        <info_text>iw_sulu_tailwind_theme.embed_height_mode_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="ratio"/>
                        <param name="values" type="collection">
                            <param name="ratio"><meta><title>iw_sulu_tailwind_theme.embed_height_mode_ratio</title></meta></param>
                            <param name="preset"><meta><title>iw_sulu_tailwind_theme.embed_height_mode_preset</title></meta></param>
                            <param name="custom"><meta><title>iw_sulu_tailwind_theme.embed_height_mode_custom</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="ratio" type="single_select" colspan="6"
                          visibleCondition="__parent.heightMode == 'ratio'">
                    <meta><title>iw_sulu_tailwind_theme.embed_ratio</title></meta>
                    <params>
                        <param name="default_value" value="16-9"/>
                        <param name="values" type="collection">
                            <param name="16-9"><meta><title>iw_sulu_tailwind_theme.embed_ratio_16_9</title></meta></param>
                            <param name="4-3"><meta><title>iw_sulu_tailwind_theme.embed_ratio_4_3</title></meta></param>
                            <param name="1-1"><meta><title>iw_sulu_tailwind_theme.embed_ratio_1_1</title></meta></param>
                            <param name="21-9"><meta><title>iw_sulu_tailwind_theme.embed_ratio_21_9</title></meta></param>
                            <param name="9-16"><meta><title>iw_sulu_tailwind_theme.embed_ratio_9_16</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="heightPreset" type="single_select" colspan="6"
                          visibleCondition="__parent.heightMode == 'preset'">
                    <meta><title>iw_sulu_tailwind_theme.embed_height_preset</title></meta>
                    <params>
                        <param name="default_value" value="500"/>
                        <param name="values" type="collection">
                            <param name="300"><meta><title>iw_sulu_tailwind_theme.embed_height_300</title></meta></param>
                            <param name="400"><meta><title>iw_sulu_tailwind_theme.embed_height_400</title></meta></param>
                            <param name="500"><meta><title>iw_sulu_tailwind_theme.embed_height_500</title></meta></param>
                            <param name="600"><meta><title>iw_sulu_tailwind_theme.embed_height_600</title></meta></param>
                            <param name="800"><meta><title>iw_sulu_tailwind_theme.embed_height_800</title></meta></param>
                            <param name="1000"><meta><title>iw_sulu_tailwind_theme.embed_height_1000</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="heightCustom" type="number" colspan="6"
                          visibleCondition="__parent.heightMode == 'custom'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_height_custom</title>
                        <info_text>iw_sulu_tailwind_theme.embed_height_custom_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="500"/>
                    </params>
                </property>
                <property name="sandboxMode" type="single_select">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_sandbox</title>
                        <info_text>iw_sulu_tailwind_theme.embed_sandbox_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="standard"/>
                        <param name="values" type="collection">
                            <param name="standard"><meta><title>iw_sulu_tailwind_theme.embed_sandbox_standard</title></meta></param>
                            <param name="strict"><meta><title>iw_sulu_tailwind_theme.embed_sandbox_strict</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.embed_sandbox_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="lazyLoad" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_lazy_load</title>
                        <info_text>iw_sulu_tailwind_theme.embed_lazy_load_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>
                <property name="allowFullscreen" type="checkbox" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.embed_allow_fullscreen</title></meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>
                <property name="allowMedia" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_allow_media</title>
                        <info_text>iw_sulu_tailwind_theme.embed_allow_media_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <property name="allowGeolocation" type="checkbox" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_allow_geolocation</title>
                        <info_text>iw_sulu_tailwind_theme.embed_allow_geolocation_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <property name="allowTopNavigation" type="checkbox">
                    <meta>
                        <title>iw_sulu_tailwind_theme.embed_allow_top_navigation</title>
                        <info_text>iw_sulu_tailwind_theme.embed_allow_top_navigation_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <property name="consentMode" type="single_select">
                    <meta>
                        <title>iw_sulu_tailwind_theme.consent_mode</title>
                        <info_text>iw_sulu_tailwind_theme.consent_mode_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="none"/>
                        <param name="values" type="collection">
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.consent_mode_none</title></meta></param>
                            <param name="placeholder"><meta><title>iw_sulu_tailwind_theme.consent_mode_placeholder</title></meta></param>
                            <param name="delegated"><meta><title>iw_sulu_tailwind_theme.consent_mode_delegated</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="consentService" type="text_line" colspan="6"
                          visibleCondition="__parent.consentMode != 'none'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.consent_service</title>
                        <info_text>iw_sulu_tailwind_theme.consent_service_info</info_text>
                    </meta>
                </property>
                <property name="consentText" type="text_area"
                          visibleCondition="__parent.consentMode != 'none'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.consent_text</title>
                        <info_text>iw_sulu_tailwind_theme.consent_text_info</info_text>
                    </meta>
                </property>
                <property name="consentImage" type="single_media_selection"
                          visibleCondition="__parent.consentMode != 'none'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.consent_image</title>
                        <info_text>iw_sulu_tailwind_theme.consent_image_info</info_text>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-background.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
