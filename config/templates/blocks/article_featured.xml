<?xml version="1.0" ?>
<!-- Global block type: Featured article highlight with hero/side_by_side/spotlight styles -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>article_featured</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.article_featured</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_articles</title></meta>
                        </param>
                    </params>
                </property>

                <property name="articles_hero" type="smart_content"
                          visibleCondition="__parent.style == 'hero'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_featured.source</title>
                    </meta>
                    <params>
                        <param name="provider" value="articles"/>
                        <param name="properties" type="collection">
                            <param name="title" value="title"/>
                            <param name="url" value="url"/>
                            <param name="heroImage" value="heroImage"/>
                            <param name="subtitle" value="subtitle"/>
                            <param name="authored" value="authored"/>
                            <param name="excerptTitle" value="excerpt.title"/>
                            <param name="excerptDescription" value="excerpt.description"/>
                            <param name="excerptImages" value="excerpt.images"/>
                            <param name="excerptCategories" value="excerpt.categories"/>
                            <param name="excerptTags" value="excerpt.tags"/>
                        </param>
                    </params>
                </property>
                <property name="articles_side_by_side" type="smart_content"
                          visibleCondition="__parent.style == 'side_by_side'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_featured.source</title>
                    </meta>
                    <params>
                        <param name="provider" value="articles"/>
                        <param name="properties" type="collection">
                            <param name="title" value="title"/>
                            <param name="url" value="url"/>
                            <param name="heroImage" value="heroImage"/>
                            <param name="subtitle" value="subtitle"/>
                            <param name="authored" value="authored"/>
                            <param name="excerptTitle" value="excerpt.title"/>
                            <param name="excerptDescription" value="excerpt.description"/>
                            <param name="excerptImages" value="excerpt.images"/>
                            <param name="excerptCategories" value="excerpt.categories"/>
                            <param name="excerptTags" value="excerpt.tags"/>
                        </param>
                    </params>
                </property>
                <property name="articles" type="smart_content"
                          visibleCondition="__parent.style == 'spotlight'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_featured.source</title>
                    </meta>
                    <params>
                        <param name="provider" value="articles"/>
                        <param name="properties" type="collection">
                            <param name="title" value="title"/>
                            <param name="url" value="url"/>
                            <param name="heroImage" value="heroImage"/>
                            <param name="subtitle" value="subtitle"/>
                            <param name="authored" value="authored"/>
                            <param name="excerptTitle" value="excerpt.title"/>
                            <param name="excerptDescription" value="excerpt.description"/>
                            <param name="excerptImages" value="excerpt.images"/>
                            <param name="excerptCategories" value="excerpt.categories"/>
                            <param name="excerptTags" value="excerpt.tags"/>
                        </param>
                    </params>
                </property>
                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="article_featured"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-background.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
