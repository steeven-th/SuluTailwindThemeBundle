<?xml version="1.0" ?>
<!-- Global block type: Call to action -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>cta</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.cta</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <property name="title" type="iw_theme_title_editor">
                    <meta>
                        <title>iw_sulu_tailwind_theme.title</title>
                        <info_text>iw_sulu_tailwind_theme.title_info</info_text>
                    </meta>
                    <params>
                        <param name="context" value="blocks"/>
                    </params>
                </property>
                <property name="subTitle" type="iw_theme_title_editor">
                    <meta><title>iw_sulu_tailwind_theme.subtitle</title></meta>
                    <params>
                        <param name="context" value="blocks"/>
                    </params>
                </property>
                <property name="titleTag" type="single_select">
                    <meta>
                        <title>iw_sulu_tailwind_theme.title_level</title>
                        <info_text>iw_sulu_tailwind_theme.title_level_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="h2"/>
                        <param name="values" type="collection">
                            <param name="h2"><meta><title>iw_sulu_tailwind_theme.title_level_h2</title></meta></param>
                            <param name="h3"><meta><title>iw_sulu_tailwind_theme.title_level_h3</title></meta></param>
                            <param name="h4"><meta><title>iw_sulu_tailwind_theme.title_level_h4</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="titleAlignment" type="single_select">
                    <meta><title>iw_sulu_tailwind_theme.title_alignment</title></meta>
                    <params>
                        <param name="default_value" value="left"/>
                        <param name="values" type="collection">
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.align_left</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.align_center</title></meta></param>
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.align_right</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="text" type="text_editor">
                    <meta><title>iw_sulu_tailwind_theme.text</title></meta>
                </property>
                <property name="primaryButtonLink" type="link">
                    <meta><title>iw_sulu_tailwind_theme.primary_button_link</title></meta>
                    <params>
                        <param name="enable_attributes" value="true"/>
                    </params>
                </property>
                <property name="primaryButtonStyle" type="iw_theme_button_style_picker">
                    <meta><title>iw_sulu_tailwind_theme.primary_button_style</title></meta>
                </property>
                <property name="secondaryButtonLink" type="link">
                    <meta><title>iw_sulu_tailwind_theme.secondary_button_link</title></meta>
                    <params>
                        <param name="enable_attributes" value="true"/>
                    </params>
                </property>
                <property name="secondaryButtonStyle" type="iw_theme_button_style_picker">
                    <meta><title>iw_sulu_tailwind_theme.secondary_button_style</title></meta>
                </property>
                <!-- Banner-only: optional background image -->
                <property name="bannerImage" type="single_media_selection"
                          visibleCondition="__parent.style == 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.image</title></meta>
                </property>

                <!-- Split-only: position of the content column vs the accessory -->
                <property name="contentRight" type="checkbox"
                          visibleCondition="__parent.style == 'split'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.content_position_right</title>
                            </meta>
                        </param>
                    </params>
                </property>

                <!-- Split-only: choose which kind of widget sits next to the content -->
                <property name="accessoryType" type="single_select"
                          visibleCondition="__parent.style == 'split'">
                    <meta><title>iw_sulu_tailwind_theme.accessory_type</title></meta>
                    <params>
                        <param name="default_value" value="image"/>
                        <param name="values" type="collection">
                            <param name="image"><meta><title>iw_sulu_tailwind_theme.accessory_image</title></meta></param>
                            <param name="video"><meta><title>iw_sulu_tailwind_theme.accessory_video</title></meta></param>
                            <param name="location"><meta><title>iw_sulu_tailwind_theme.accessory_location</title></meta></param>
                            <param name="counter"><meta><title>iw_sulu_tailwind_theme.accessory_counter</title></meta></param>
                        </param>
                    </params>
                </property>

                <!-- Accessory: image -->
                <property name="accessoryImage" type="single_media_selection"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'image'">
                    <meta><title>iw_sulu_tailwind_theme.image</title></meta>
                </property>

                <!-- Accessory: video — provider switcher + per-provider source -->
                <property name="accessoryVideoProvider" type="single_select"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'video'">
                    <meta><title>iw_sulu_tailwind_theme.accessory_video_provider</title></meta>
                    <params>
                        <param name="default_value" value="youtube"/>
                        <param name="values" type="collection">
                            <param name="youtube"><meta><title>iw_sulu_tailwind_theme.accessory_video_provider_youtube</title></meta></param>
                            <param name="vimeo"><meta><title>iw_sulu_tailwind_theme.accessory_video_provider_vimeo</title></meta></param>
                            <param name="file"><meta><title>iw_sulu_tailwind_theme.accessory_video_provider_file</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="accessoryYoutubeId" type="text_line"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'video' AND __parent.accessoryVideoProvider == 'youtube'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accessory_youtube_id</title>
                        <info_text>iw_sulu_tailwind_theme.accessory_youtube_id_info</info_text>
                    </meta>
                </property>
                <property name="accessoryVimeoId" type="text_line"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'video' AND __parent.accessoryVideoProvider == 'vimeo'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accessory_vimeo_id</title>
                        <info_text>iw_sulu_tailwind_theme.accessory_vimeo_id_info</info_text>
                    </meta>
                </property>
                <property name="accessoryVideoFile" type="single_media_selection"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'video' AND __parent.accessoryVideoProvider == 'file'">
                    <meta><title>iw_sulu_tailwind_theme.accessory_video_file</title></meta>
                    <params>
                        <param name="types" value="video"/>
                    </params>
                </property>
                <property name="accessoryVideoPoster" type="single_media_selection"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'video' AND __parent.accessoryVideoProvider == 'file'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accessory_video_poster</title>
                        <info_text>iw_sulu_tailwind_theme.accessory_video_poster_info</info_text>
                    </meta>
                </property>

                <!-- Accessory: location (Sulu native location field with OSM iframe) -->
                <property name="accessoryLocation" type="location"
                          visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'location'">
                    <meta><title>iw_sulu_tailwind_theme.accessory_location</title></meta>
                </property>

                <!-- Accessory: counter — up to 3 animated numbers -->
                <block name="accessoryCounters" default-type="counter" minOccurs="0" maxOccurs="3"
                       visibleCondition="__parent.style == 'split' AND __parent.accessoryType == 'counter'">
                    <meta><title>iw_sulu_tailwind_theme.accessory_counters</title></meta>
                    <types>
                        <type name="counter">
                            <meta><title>iw_sulu_tailwind_theme.accessory_counter</title></meta>
                            <properties>
                                <property name="count" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.accessory_counter_count</title></meta>
                                </property>
                                <property name="unit" type="text_line">
                                    <meta>
                                        <title>iw_sulu_tailwind_theme.accessory_counter_unit</title>
                                        <info_text>iw_sulu_tailwind_theme.accessory_counter_unit_info</info_text>
                                    </meta>
                                </property>
                                <property name="label" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.accessory_counter_label</title></meta>
                                </property>
                            </properties>
                        </type>
                    </types>
                </block>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <property name="variant" type="iw_theme_variant_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.color_variant</title></meta>
                </property>
                <property name="style" type="iw_theme_style_picker" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="cta"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <property name="marginTop" type="iw_theme_margin_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.margin_top</title></meta>
                    <params>
                        <param name="default_value" value="mt-5"/>
                    </params>
                </property>
                <property name="marginBottom" type="iw_theme_margin_selector" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.margin_bottom</title></meta>
                    <params>
                        <param name="default_value" value="mb-5"/>
                    </params>
                </property>
                <property name="lateralMargins" type="single_select"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.lateral_margins</title></meta>
                    <params>
                        <param name="default_value" value="exterior"/>
                        <param name="values" type="collection">
                            <param name="exterior"><meta><title>iw_sulu_tailwind_theme.lateral_margins_exterior</title></meta></param>
                            <param name="interior"><meta><title>iw_sulu_tailwind_theme.lateral_margins_interior</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.lateral_margins_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="paddingTop" type="iw_theme_margin_selector" colspan="6"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.padding_top</title></meta>
                    <params>
                        <param name="default_value" value="pt-5"/>
                    </params>
                </property>
                <property name="paddingBottom" type="iw_theme_margin_selector" colspan="6"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.padding_bottom</title></meta>
                    <params>
                        <param name="default_value" value="pb-5"/>
                    </params>
                </property>
                <property name="paddingLateral" type="iw_theme_margin_selector"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.padding_lateral</title></meta>
                    <params>
                        <param name="prefix" value="px"/>
                        <param name="default_value" value="px-5"/>
                    </params>
                </property>
                <property name="blockRadius" type="iw_theme_radius_selector" colspan="6"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.block_radius</title></meta>
                    <params>
                        <param name="theme_key" value="cardRadius"/>
                    </params>
                </property>
                <property name="paragraphRadius" type="iw_theme_radius_selector" colspan="6"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.paragraph_radius</title></meta>
                    <params>
                        <param name="theme_key" value="paragraphRadius"/>
                    </params>
                </property>
                <property name="imageRadius" type="iw_theme_radius_selector" colspan="6"
                          visibleCondition="__parent.style != 'banner'">
                    <meta><title>iw_sulu_tailwind_theme.image_radius</title></meta>
                    <params>
                        <param name="theme_key" value="imageRadius"/>
                    </params>
                </property>
                <property name="showBackground" type="checkbox">
                    <meta><title>iw_sulu_tailwind_theme.show_background</title></meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>
            </properties>
        </section>
    </properties>
</template>
