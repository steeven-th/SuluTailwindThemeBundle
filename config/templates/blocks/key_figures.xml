<?xml version="1.0" ?>
<!-- Global block type: Key figures -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>key_figures</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.key_figures</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_figures</title></meta>
                        </param>
                    </params>
                </property>

                <property name="text" type="text_editor">
                    <meta><title>iw_sulu_tailwind_theme.text</title></meta>
                    <tag name="sulu.block_preview" priority="80"/>
                </property>


                <block name="figures" default-type="figure" minOccurs="1">
                    <meta>
                        <title>iw_sulu_tailwind_theme.figures</title>
                    </meta>
                    <types>
                        <type name="figure">
                            <meta>
                                <title>iw_sulu_tailwind_theme.figure</title>
                            </meta>
                            <properties>
                                <!--
                                    The pictogram of the figure, shared picker.
                                    The media field it replaces was named
                                    `image`; the migration command moves those
                                    values to `iconMedia`.
                                -->
                                <xi:include href="../fragments/icon-picker.xml"
                                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                                <property name="title" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.title</title></meta>
                                </property>
                                <property name="subTitle" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.subtitle</title></meta>
                                </property>
                                <property name="number" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.number</title></meta>
                                </property>
                            </properties>
                        </type>
                    </types>
                </block>
                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="key_figures"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <!-- Side-by-side style: which side the figures sit on. -->
                <property name="contentRight" type="checkbox"
                          visibleCondition="__parent.style == 'split'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.content_position_right</title>
                            </meta>
                        </param>
                    </params>
                </property>
                <!--
                    The figure is the point of the block, and it used to read
                    quieter than its own label: the counter took the paragraph
                    colour while the label under it took the title colour. On by
                    default, which is also what the cards block does with
                    `.iw-card__number` - the two blocks print a number and had no
                    reason to disagree.

                    No colour picker here: the hue is the variant's "highlight
                    colour", the one already driving the [[marked]] words of a
                    title. One setting, one place to change it.

                    Left out of the progress style, whose percentage
                    accompanies its bar rather than leading the block, and would
                    compete with the bar's own colour.
                -->
                <property name="highlightNumbers" type="checkbox" colspan="6"
                          visibleCondition="__parent.style != 'progress'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.highlight_numbers</title>
                        <info_text>iw_sulu_tailwind_theme.highlight_numbers_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>

                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-surfaces.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
