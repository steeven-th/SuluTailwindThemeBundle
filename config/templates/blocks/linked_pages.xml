<?xml version="1.0" ?>
<!-- Global block type: Linked pages -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>linked_pages</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.linked_pages</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_links</title></meta>
                        </param>
                    </params>
                </property>

                <block name="links" default-type="link" minOccurs="0">
                    <meta>
                        <title>iw_sulu_tailwind_theme.links</title>
                    </meta>
                    <types>
                        <type name="link">
                            <meta>
                                <title>iw_sulu_tailwind_theme.link</title>
                            </meta>
                            <properties>
                                <property name="link" type="link">
                                    <meta><title>iw_sulu_tailwind_theme.link</title></meta>
                                    <params>
                                        <param name="enable_anchor" value="true"/>
                                        <param name="enable_attributes" value="true"/>
                                        <param name="types" type="collection">
                                            <param name="page"/>
                                            <param name="external"/>
                                            <param name="media"/>
                                        </param>
                                    </params>
                                </property>
                                <property name="excerpt" type="text_area">
                                    <meta><title>iw_sulu_tailwind_theme.excerpt</title></meta>
                                </property>
                                <property name="image" type="single_media_selection">
                                    <meta>
                                        <title>iw_sulu_tailwind_theme.image</title>
                                        <info_text>iw_sulu_tailwind_theme.block.linked_pages_image_info</info_text>
                                    </meta>
                                    <params>
                                        <param name="types" value="image"/>
                                    </params>
                                </property>
                            </properties>
                        </type>
                    </types>
                </block>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="linked_pages"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <!-- Only the cards and carousel styles show images. An empty style
                     renders as cards, hence the negative condition. -->
                <property name="imageRatio" type="single_select" colspan="6"
                          visibleCondition="__parent.style != 'list' AND __parent.style != 'minimal'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_image_ratio</title>
                        <info_text>iw_sulu_tailwind_theme.block.linked_pages_image_ratio_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="expression"
                               value="service('itech_world.sulu_tailwind_theme.image_ratios').getSelectValues('_', 'iw_sulu_tailwind_theme.block.article_image_ratio_default')"/>
                    </params>
                </property>
                <property name="hideImages" type="checkbox" colspan="6"
                          visibleCondition="__parent.style != 'list' AND __parent.style != 'minimal'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.linked_pages_hide_images</title>
                        <info_text>iw_sulu_tailwind_theme.block.linked_pages_hide_images_info</info_text>
                    </meta>
                </property>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-surfaces.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
