<?xml version="1.0" ?>
<!-- Global block type: Accordion (FAQ) -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>accordion</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.accordion</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_items</title></meta>
                        </param>
                    </params>
                </property>

                <block name="items" default-type="item" minOccurs="1">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_items</title>
                    </meta>
                    <types>
                        <type name="item">
                            <meta>
                                <title>iw_sulu_tailwind_theme.accordion_item</title>
                            </meta>
                            <properties>
                                <property name="itemTitle" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.accordion_item_title</title></meta>
                                </property>
                                <property name="itemContent" type="text_editor">
                                    <meta><title>iw_sulu_tailwind_theme.accordion_item_content</title></meta>
                                </property>
                                <property name="itemOpen" type="checkbox">
                                    <meta>
                                        <title>iw_sulu_tailwind_theme.accordion_item_open</title>
                                        <info_text>iw_sulu_tailwind_theme.accordion_item_open_info</info_text>
                                    </meta>
                                    <params>
                                        <param name="default_value" value="false"/>
                                    </params>
                                </property>
                            </properties>
                        </type>
                    </types>
                </block>
                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="accordion"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <property name="itemTitleTag" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_item_title_level</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_item_title_level_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="h3"/>
                        <param name="values" type="collection">
                            <param name="h3"><meta><title>iw_sulu_tailwind_theme.title_level_h3</title></meta></param>
                            <param name="h4"><meta><title>iw_sulu_tailwind_theme.title_level_h4</title></meta></param>
                            <param name="h5"><meta><title>iw_sulu_tailwind_theme.title_level_h5</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.accordion_item_title_level_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="iconStyle" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.accordion_icon_style</title></meta>
                    <params>
                        <param name="default_value" value="chevron"/>
                        <param name="values" type="collection">
                            <param name="chevron"><meta><title>iw_sulu_tailwind_theme.accordion_icon_chevron</title></meta></param>
                            <param name="plus"><meta><title>iw_sulu_tailwind_theme.accordion_icon_plus</title></meta></param>
                            <param name="arrow"><meta><title>iw_sulu_tailwind_theme.accordion_icon_arrow</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.accordion_icon_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="iconPosition" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.accordion_icon_position</title></meta>
                    <params>
                        <param name="default_value" value="right"/>
                        <param name="values" type="collection">
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.position_right</title></meta></param>
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.position_left</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="singleOpen" type="checkbox">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_single_open</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_single_open_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <property name="faqSchema" type="checkbox">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_faq_schema</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_faq_schema_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-background.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
