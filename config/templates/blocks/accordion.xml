<?xml version="1.0" ?>
<!-- Global block type: Accordion (FAQ) -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>accordion</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.accordion</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_items</title></meta>
                        </param>
                    </params>
                </property>

                <block name="items" default-type="item" minOccurs="1">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_items</title>
                    </meta>
                    <types>
                        <type name="item">
                            <meta>
                                <title>iw_sulu_tailwind_theme.accordion_item</title>
                            </meta>
                            <properties>
                                <property name="itemTitle" type="text_line">
                                    <meta><title>iw_sulu_tailwind_theme.accordion_item_title</title></meta>
                                </property>
                                <property name="itemContent" type="text_editor">
                                    <meta><title>iw_sulu_tailwind_theme.accordion_item_content</title></meta>
                                </property>
                                <property name="itemOpen" type="checkbox">
                                    <meta>
                                        <title>iw_sulu_tailwind_theme.accordion_item_open</title>
                                        <info_text>iw_sulu_tailwind_theme.accordion_item_open_info</info_text>
                                    </meta>
                                    <params>
                                        <param name="default_value" value="false"/>
                                    </params>
                                </property>
                            </properties>
                        </type>
                    </types>
                </block>
                <!--
                    The second zone of the split style. Four kinds, the same
                    catalogue the form block offers: a text, a picture, a video
                    or a map beside the questions.

                    The accordion widget is deliberately absent. The zone sits
                    next to an accordion already, and questions beside questions
                    is the one arrangement this block cannot need.
                -->
                <block name="widget" default-type="text" minOccurs="1" maxOccurs="1"
                       visibleCondition="__parent.style == 'split'">
                    <meta><title>iw_sulu_tailwind_theme.widget</title></meta>
                    <types>
                        <xi:include href="../fragments/widgets/text.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                        <xi:include href="../fragments/widgets/image.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                        <xi:include href="../fragments/widgets/video.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                        <xi:include href="../fragments/widgets/location.xml"
                                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:types/sulu:type)"/>
                    </types>
                </block>

                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="accordion"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <property name="itemTitleTag" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_item_title_level</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_item_title_level_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="h3"/>
                        <param name="values" type="collection">
                            <param name="h3"><meta><title>iw_sulu_tailwind_theme.title_level_h3</title></meta></param>
                            <param name="h4"><meta><title>iw_sulu_tailwind_theme.title_level_h4</title></meta></param>
                            <param name="h5"><meta><title>iw_sulu_tailwind_theme.title_level_h5</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.accordion_item_title_level_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="iconStyle" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.accordion_icon_style</title></meta>
                    <params>
                        <param name="default_value" value="chevron"/>
                        <param name="values" type="collection">
                            <param name="chevron"><meta><title>iw_sulu_tailwind_theme.accordion_icon_chevron</title></meta></param>
                            <param name="plus"><meta><title>iw_sulu_tailwind_theme.accordion_icon_plus</title></meta></param>
                            <param name="arrow"><meta><title>iw_sulu_tailwind_theme.accordion_icon_arrow</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.accordion_icon_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="iconPosition" type="single_select" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.accordion_icon_position</title></meta>
                    <params>
                        <param name="default_value" value="right"/>
                        <param name="values" type="collection">
                            <param name="right"><meta><title>iw_sulu_tailwind_theme.position_right</title></meta></param>
                            <param name="left"><meta><title>iw_sulu_tailwind_theme.position_left</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="headerSurface" type="single_select" colspan="6">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_header_surface</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_header_surface_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="paragraph"/>
                        <param name="values" type="collection">
                            <param name="paragraph"><meta><title>iw_sulu_tailwind_theme.accordion_header_surface_paragraph</title></meta></param>
                            <param name="accent"><meta><title>iw_sulu_tailwind_theme.accordion_header_surface_accent</title></meta></param>
                            <param name="none"><meta><title>iw_sulu_tailwind_theme.accordion_header_surface_none</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="singleOpen" type="checkbox">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_single_open</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_single_open_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <property name="faqSchema" type="checkbox">
                    <meta>
                        <title>iw_sulu_tailwind_theme.accordion_faq_schema</title>
                        <info_text>iw_sulu_tailwind_theme.accordion_faq_schema_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="false"/>
                    </params>
                </property>
                <!-- Split-only: which side the questions sit on. -->
                <property name="contentRight" type="checkbox"
                          visibleCondition="__parent.style == 'split'">
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label">
                            <meta>
                                <title>iw_sulu_tailwind_theme.content_position_right</title>
                            </meta>
                        </param>
                    </params>
                </property>
                <!--
                    How the two zones share the width, and how they line up once
                    the taller one has set the height. Written out rather than
                    included: a `visibleCondition` cannot ride on an xi:include,
                    and these only make sense with two zones. The same pair lives
                    in text_images, both form variants and location - change one,
                    change them all. `MediaRatioContractTest` guards the steps.
                -->
                <property name="mediaRatio" type="single_select" colspan="6"
                          visibleCondition="__parent.style == 'split'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block_media_ratio</title>
                        <info_text>iw_sulu_tailwind_theme.block_media_ratio_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.media_ratio_style</title></meta></param>
                            <param name="auto"><meta><title>iw_sulu_tailwind_theme.media_ratio_auto</title></meta></param>
                            <param name="1-8"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_8</title></meta></param>
                            <param name="1-6"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_6</title></meta></param>
                            <param name="1-4"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_4</title></meta></param>
                            <param name="1-3"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_3</title></meta></param>
                            <param name="2-5"><meta><title>iw_sulu_tailwind_theme.media_ratio_2_5</title></meta></param>
                            <param name="1-2"><meta><title>iw_sulu_tailwind_theme.media_ratio_1_2</title></meta></param>
                            <param name="3-5"><meta><title>iw_sulu_tailwind_theme.media_ratio_3_5</title></meta></param>
                            <param name="2-3"><meta><title>iw_sulu_tailwind_theme.media_ratio_2_3</title></meta></param>
                            <param name="3-4"><meta><title>iw_sulu_tailwind_theme.media_ratio_3_4</title></meta></param>
                        </param>
                    </params>
                </property>
                <property name="zonesAlign" type="single_select" colspan="6"
                          visibleCondition="__parent.style == 'split'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block_zones_align</title>
                        <info_text>iw_sulu_tailwind_theme.block_zones_align_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value=""/>
                        <param name="values" type="collection">
                            <param name=""><meta><title>iw_sulu_tailwind_theme.zones_align_style</title></meta></param>
                            <param name="start"><meta><title>iw_sulu_tailwind_theme.zones_align_start</title></meta></param>
                            <param name="center"><meta><title>iw_sulu_tailwind_theme.zones_align_center</title></meta></param>
                            <param name="end"><meta><title>iw_sulu_tailwind_theme.zones_align_end</title></meta></param>
                            <param name="stretch"><meta><title>iw_sulu_tailwind_theme.zones_align_stretch</title></meta></param>
                        </param>
                    </params>
                </property>
                <!-- Rounds the picture, the video frame and the map of the widget. -->
                <property name="imageRadius" type="iw_theme_radius_selector" colspan="6"
                          visibleCondition="__parent.style == 'split'">
                    <meta><title>iw_sulu_tailwind_theme.image_radius</title></meta>
                    <params>
                        <param name="theme_key" value="imageRadius"/>
                    </params>
                </property>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-surfaces.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
