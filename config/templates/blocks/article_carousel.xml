<?xml version="1.0" ?>
<!-- Global block type: Article carousel with autoplay support -->
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>article_carousel</key>
    <meta>
        <title>iw_sulu_tailwind_theme.block.article_carousel</title>
    </meta>

    <properties>
        <!-- ── Content ── -->
        <section name="content">
            <meta><title>iw_sulu_tailwind_theme.content</title></meta>
            <properties>
                <xi:include href="../fragments/block-heading.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>

                <property name="contentHeading" type="heading">
                    <params>
                        <param name="label">
                            <meta><title>iw_sulu_tailwind_theme.content_group_articles</title></meta>
                        </param>
                    </params>
                </property>

                <!-- What the block lists. Each choice shows the selection built
                     on the provider that answers it, so the preview in the admin
                     lists what the page will list. -->
                <property name="source" type="single_select" colspan="12">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_carousel.source_type</title>
                        <info_text>iw_sulu_tailwind_theme.block.article_carousel.source_type_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="articles"/>
                        <param name="values" type="collection">
                            <param name="articles"><meta><title>iw_sulu_tailwind_theme.article.source_articles</title></meta></param>
                            <param name="upcoming"><meta><title>iw_sulu_tailwind_theme.article.source_upcoming</title></meta></param>
                            <param name="past"><meta><title>iw_sulu_tailwind_theme.article.source_past</title></meta></param>
                        </param>
                    </params>
                </property>

                <property name="articles" type="smart_content" visibleCondition="__parent.source == 'articles'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_carousel.source</title>
                        <info_text>iw_sulu_tailwind_theme.block.article_carousel.source_info</info_text>
                    </meta>
                    <params>
                        <param name="provider" value="articles"/>
                        <param name="properties" type="collection">
                            <param name="title" value="title"/>
                            <param name="url" value="url"/>
                            <param name="heroImage" value="heroImage"/>
                            <param name="subtitle" value="subtitle"/>
                            <param name="authored" value="authored"/>
                            <param name="excerptTitle" value="excerpt.title"/>
                            <param name="excerptDescription" value="excerpt.description"/>
                            <param name="excerptImages" value="excerpt.images"/>
                            <param name="excerptCategories" value="excerpt.categories"/>
                        </param>
                    </params>
                </property>

                <property name="upcomingEvents" type="smart_content" visibleCondition="__parent.source == 'upcoming'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.upcoming_events</title>
                                            </meta>
                    <params>
                        <param name="provider" value="iw_events"/>
                        <param name="direction" value="upcoming"/>
                        <param name="properties" type="collection">
                            <param name="title" value="title"/>
                            <param name="url" value="url"/>
                            <param name="heroImage" value="heroImage"/>
                            <param name="subtitle" value="subtitle"/>
                            <param name="authored" value="authored"/>
                            <param name="startDate" value="startDate"/>
                            <param name="endDate" value="endDate"/>
                            <param name="excerptTitle" value="excerpt.title"/>
                            <param name="excerptDescription" value="excerpt.description"/>
                            <param name="excerptImages" value="excerpt.images"/>
                            <param name="excerptCategories" value="excerpt.categories"/>
                        </param>
                    </params>
                </property>

                <property name="pastEvents" type="smart_content" visibleCondition="__parent.source == 'past'">
                    <meta>
                        <title>iw_sulu_tailwind_theme.article.past_events</title>
                                            </meta>
                    <params>
                        <param name="provider" value="iw_events"/>
                        <param name="direction" value="past"/>
                        <param name="properties" type="collection">
                            <param name="title" value="title"/>
                            <param name="url" value="url"/>
                            <param name="heroImage" value="heroImage"/>
                            <param name="subtitle" value="subtitle"/>
                            <param name="authored" value="authored"/>
                            <param name="startDate" value="startDate"/>
                            <param name="endDate" value="endDate"/>
                            <param name="excerptTitle" value="excerpt.title"/>
                            <param name="excerptDescription" value="excerpt.description"/>
                            <param name="excerptImages" value="excerpt.images"/>
                            <param name="excerptCategories" value="excerpt.categories"/>
                        </param>
                    </params>
                </property>
                <property name="interval" type="number" colspan="6"
                          visibleCondition="__parent.autoplay == true">
                    <meta>
                        <title>iw_sulu_tailwind_theme.block.article_carousel.interval</title>
                        <info_text>iw_sulu_tailwind_theme.block.article_carousel.interval_info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="5000"/>
                        <param name="min" value="1000"/>
                        <param name="max" value="15000"/>
                    </params>
                </property>
                <!-- Call-to-action buttons, shared by every block that can carry actions. -->
                <xi:include href="../fragments/cta-buttons.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property|/sulu:properties/sulu:block)"/>
            </properties>
        </section>

        <!-- ── Appearance ── -->
        <section name="appearance">
            <meta><title>iw_sulu_tailwind_theme.appearance</title></meta>
            <properties>
                <xi:include href="../fragments/block-variant.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <property name="style" type="iw_theme_style_picker" colspan="12">
                    <meta><title>iw_sulu_tailwind_theme.layout_style</title></meta>
                    <params>
                        <param name="block_type" value="article_carousel"/>
                    </params>
                </property>
            </properties>
        </section>

        <!-- ── Settings ── -->
        <section name="settings">
            <meta><title>iw_sulu_tailwind_theme.settings</title></meta>
            <properties>
                <property name="autoplay" type="checkbox" colspan="6">
                    <meta><title>iw_sulu_tailwind_theme.block.article_carousel.autoplay</title></meta>
                </property>
                <xi:include href="../fragments/block-spacing.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-card-radius.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
                <xi:include href="../fragments/block-surfaces.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/sulu:property)"/>
            </properties>
        </section>
    </properties>
</template>
