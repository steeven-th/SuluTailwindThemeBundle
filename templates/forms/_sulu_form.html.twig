{#
    SuluFormBundle bridge — renders a form selected in the form block, themed
    with the bundle's form theme.

    This template is only ever included when SuluFormBundle is installed (the
    form block checks iw_sulu_tailwind_theme_has_form_bundle() first), so the
    form helpers below are always defined by the time Twig compiles it.

    After a successful submission the form is replaced by its success message —
    see doc/form-block.md. SuluFormBundle redirects to `?send=true`, which the
    bundle's FormSubmissionRedirectSubscriber completes with the id of the form
    that was posted, so a page holding two form blocks only confirms the right
    one.

    To customise the rendering, override this file in your project at
    templates/bundles/ItechWorldSuluTailwindThemeBundle/forms/_sulu_form.html.twig
    — the standard Symfony bundle-override path. A legacy project-level
    templates/forms/_sulu_form.html.twig also still takes precedence.

    Expected variables:
      - formView:   what single_form_selection resolves to in Sulu 3 — an
                    already-built Symfony FormView. A numeric id is also
                    accepted and resolved through sulu_form_get_by_id().
      - formType:   content type context passed to sulu_form_get_by_id ('page')
      - formTypeId: the id of the page or article holding the block
      - colorScheme: 'light' | 'dark' | 'auto' — surface the form sits on. Set on
                    the root form view (not passed to form(), which would not
                    survive to the children) so the Turnstile widget can read it
                    through form.parent.vars: a widget inside an iframe cannot be
                    themed with CSS, it only takes a light/dark hint.
#}

{% set suluForm = null %}

{% if formView is defined and formView is not empty %}
    {% if formView.vars is defined or formView is iterable %}
        {# Sulu 3: SingleFormSelectionPropertyResolver already returns a FormView. #}
        {% set suluForm = formView %}
    {% elseif formView matches '/^\\d+$/' %}
        {# A bare id, e.g. from content stored by an earlier version. #}
        {% set suluForm = sulu_form_get_by_id(formView, formType|default('page'), formTypeId|default('')) %}
    {% endif %}
{% endif %}

{% if suluForm is not null %}
    {% if iw_sulu_tailwind_theme_form_submitted(suluForm) %}
        {# Confirmation, shown in place of the form after a successful submission.
           The text is the one editors type per locale in the form's admin
           settings; an empty field falls back to a translated default, because
           an empty page reads as "nothing happened" and gets the form sent twice.

           The markup itself lives in the shared partial, so a form written in
           Twig template mode confirms exactly like this one - see
           doc/form-block.md. #}
        {% set submittedFormId = iw_sulu_tailwind_theme_form_id(suluForm) %}
        {% include '@ItechWorldSuluTailwindTheme/forms/_success.html.twig' with {
            text: iw_sulu_tailwind_theme_form_success_text(suluForm),
            colorScheme: colorScheme|default('auto'),
            id: submittedFormId ? 'iw-form-' ~ submittedFormId : ''
        } only %}
    {% else %}
        {# The theme puts iw-form on the <form> element itself: no wrapper needed. #}
        {# Two blocks of a page may point at the same form, and Sulu hands both the
           very same FormView — which Symfony refuses to render twice. This returns
           the view untouched the first time, and an id-suffixed copy afterwards. #}
        {% set suluForm = iw_sulu_tailwind_theme_reusable_form(suluForm) %}

        {% form_theme suluForm '@ItechWorldSuluTailwindTheme/form/theme.html.twig' %}
        {{ form(iw_sulu_tailwind_theme_with_color_scheme(suluForm, colorScheme|default('auto'))) }}
    {% endif %}
{% endif %}
