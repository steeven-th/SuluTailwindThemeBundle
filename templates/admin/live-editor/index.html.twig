{#
  Live Theme Editor — standalone editor shell.

  Opened in a dedicated window (window.open). Customizer-style layout: a left
  panel drives global theme settings (a root section list → per-section control
  screens), a live preview iframe fills the rest.

  The preview is a whole demo PAGE (menu + hero + blocks + footer), not one
  mock-up per screen: a screen declares in `data-previews` which pages already
  show what it configures, and the preview only reloads when the current page is
  not among them. Most edits therefore never move the page you are looking at.
  Structural settings ride the preview URL (?preview=…&<param>=…) and re-render
  it; token changes recompile CSS server-side and are pushed into the iframe via
  postMessage without any reload.

  Buildless on purpose (vanilla JS + Twig) so the UX can be validated fast; the
  existing React field types get grafted into the section screens later.

  Parameters:
    - themeId    : the ThemeConfig id
    - themeLabel : human-readable theme name
    - colors     : list of {role, label, value} for the Colors screen pickers
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Live Theme Editor — {{ themeLabel }}</title>
    <style>
        :root {
            --le-accent: #4f46e5;
            --le-accent-hover: #4338ca;
            --le-border: #e2e8f0;
            --le-bg: #f8fafc;
            --le-text: #0f172a;
            --le-muted: #64748b;
            --le-panel-w: 340px;
            --le-inspector-w: 320px;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color: var(--le-text);
            display: grid;
            grid-template-columns: var(--le-panel-w) 1fr var(--le-inspector-w);
            grid-template-rows: 1fr;
            height: 100vh;
        }
        /* Hidden on demand — the preview then takes the whole width. */
        body.no-inspector { grid-template-columns: var(--le-panel-w) 1fr; }

        /* ── Left panel ─────────────────────────────────────────────── */
        .le-panel {
            border-right: 1px solid var(--le-border);
            background: var(--le-bg);
            display: flex;
            flex-direction: column;
            min-height: 0;
        }
        .le-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--le-border);
            background: #fff;
        }
        .le-topbar__title { font-size: 13px; font-weight: 600; }
        .le-topbar__sub { font-size: 11px; color: var(--le-muted); margin-top: 2px; }
        .le-iconbtn {
            appearance: none; border: 1px solid var(--le-border); background: #fff;
            width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
            font-size: 16px; line-height: 1; color: var(--le-muted);
        }
        .le-iconbtn:hover { color: var(--le-text); border-color: #cbd5e1; }

        .le-body { flex: 1; overflow-y: auto; min-height: 0; }

        /* Screens: only one visible at a time. */
        .le-screen { display: none; padding: 16px; }
        .le-screen.is-active { display: block; }

        /* Root: section list */
        .le-sectionlist { display: flex; flex-direction: column; gap: 6px; }
        .le-section {
            display: flex; align-items: center; gap: 12px; width: 100%;
            padding: 12px 14px; border: 1px solid var(--le-border); border-radius: 10px;
            background: #fff; cursor: pointer; text-align: left; font-size: 13px;
            color: var(--le-text);
        }
        .le-section:hover:not(:disabled) { border-color: var(--le-accent); }
        .le-section:disabled { opacity: .55; cursor: default; }
        .le-section__icon { font-size: 18px; line-height: 1; }
        .le-section__label { flex: 1; font-weight: 500; }
        .le-section__meta { font-size: 11px; color: var(--le-muted); }
        .le-section__chevron { color: var(--le-muted); }

        /* Section screen header (back) */
        .le-screenhead {
            display: flex; align-items: center; gap: 10px; margin-bottom: 16px;
        }
        .le-back {
            appearance: none; border: 0; background: none; cursor: pointer;
            color: var(--le-accent); font-size: 13px; font-weight: 600; padding: 0;
        }
        .le-screenhead__title { font-size: 13px; font-weight: 600; }

        /* Controls */
        .le-field { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
        .le-label { font-size: 12px; font-weight: 500; color: #334155; }
        .le-color-row { display: flex; align-items: center; gap: 12px; }
        .le-color-row input[type="color"] {
            width: 48px; height: 40px; padding: 0; border: 1px solid #cbd5e1;
            border-radius: 8px; background: none; cursor: pointer;
        }
        .le-color-row output { font-family: ui-monospace, monospace; font-size: 13px; }
        .le-select {
            width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px;
            background: #fff; font-size: 13px; color: var(--le-text); cursor: pointer;
        }
        .le-select:focus { outline: 2px solid var(--le-accent); outline-offset: 0; border-color: var(--le-accent); }
        .le-hint { font-size: 11px; color: var(--le-muted); }
        .le-hint--lead { margin-top: 0; margin-bottom: 16px; }

        /* Typography screen */
        .le-subhead {
            font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em;
            color: var(--le-muted); margin: 22px 0 12px;
        }
        .le-subhead:first-of-type { margin-top: 0; }
        .le-typo-el {
            border: 1px solid var(--le-border); border-radius: 10px; background: #fff;
            padding: 12px 14px; margin-bottom: 12px;
        }
        .le-typo-el__title { font-size: 12px; font-weight: 600; margin: 0 0 10px; color: #334155; }
        .le-typo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .le-typo-cell { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
        .le-typo-cell--wide { grid-column: 1 / -1; }
        .le-typo-cell__label { font-size: 11px; font-weight: 500; color: var(--le-muted); }
        .le-typo-cell .le-select { padding: 7px 9px; font-size: 12px; }

        /* Color-token control: palette picker + optional custom color */
        .le-colortoken { display: flex; align-items: center; gap: 8px; }
        .le-colortoken .le-select { flex: 1; min-width: 0; }
        .le-colortoken input[type="color"] {
            width: 40px; height: 34px; padding: 0; border: 1px solid #cbd5e1;
            border-radius: 8px; background: none; cursor: pointer; flex: none;
        }

        /* Palette grid */
        .le-colorgrid { display: flex; flex-direction: column; gap: 10px; }
        .le-color-item { display: flex; align-items: center; gap: 12px; }
        .le-color-item input[type="color"] {
            width: 40px; height: 34px; padding: 0; border: 1px solid #cbd5e1;
            border-radius: 8px; background: none; cursor: pointer; flex: none;
        }
        .le-color-item__label {
            display: flex; flex-direction: column; font-size: 13px; font-weight: 500;
            cursor: pointer;
        }
        .le-color-item__val {
            font-family: ui-monospace, monospace; font-size: 11px; font-weight: 400;
            color: var(--le-muted); text-transform: uppercase;
        }

        /* Footer (save) */
        .le-footer {
            padding: 14px 16px; border-top: 1px solid var(--le-border); background: #fff;
            display: flex; align-items: center; gap: 12px;
        }
        .le-btn {
            appearance: none; border: 0; border-radius: 8px; padding: 10px 16px;
            font-size: 13px; font-weight: 600; color: #fff; background: var(--le-accent);
            cursor: pointer;
        }
        .le-btn:hover:not(:disabled) { background: var(--le-accent-hover); }
        .le-btn:disabled { opacity: .5; cursor: default; }
        .le-status { font-size: 12px; min-height: 16px; flex: 1; }
        .le-status.is-ok { color: #16a34a; }
        .le-status.is-err { color: #dc2626; }
        .le-status.is-busy { color: var(--le-muted); }

        /* ── Right inspector ────────────────────────────────────────
           Opened by clicking a component in the preview: it shows only the
           groups that restyle THAT component. Docked as a third column rather
           than floating, so it never lands somewhere awkward and the preview
           keeps a stable, predictable width. */
        .le-pop {
            grid-column: 3; display: flex; flex-direction: column; min-height: 0;
            background: #fff; border-left: 1px solid var(--le-border);
        }
        body.no-inspector .le-pop { display: none; }
        /* Empty state: shown until something is picked in the preview. */
        .le-pop__empty {
            margin: 0; padding: 24px 16px; font-size: 12px; line-height: 1.6;
            color: var(--le-muted); text-align: center;
        }
        .le-pop__head {
            display: flex; align-items: center; gap: 8px; padding: 14px 16px;
            border-bottom: 1px solid var(--le-border); background: var(--le-bg);
        }
        .le-pop__title { flex: 1; font-size: 13px; font-weight: 600; }
        .le-pop__body { flex: 1; overflow-y: auto; min-height: 0; padding: 16px 16px 4px; }
        .le-pop__body .le-field:last-child, .le-pop__body .le-color-item:last-child { margin-bottom: 16px; }
        .le-pop__group {
            font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em;
            color: var(--le-muted); margin: 0 0 10px;
        }
        .le-pop__section + .le-pop__section { margin-top: 20px; }
        .le-pop__section .le-color-item { margin-bottom: 10px; }
        .le-pop__more {
            display: block; width: 100%; text-align: left; appearance: none; cursor: pointer;
            border: 0; border-top: 1px solid var(--le-border); background: none;
            color: var(--le-accent); font-size: 12px; font-weight: 600; padding: 13px 16px;
        }
        .le-pop__more:hover { background: var(--le-bg); }

        /* ── Preview ────────────────────────────────────────────────── */
        .le-stage {
            display: flex; flex-direction: column; min-width: 0; min-height: 0;
            background: #e2e8f0;
        }
        .le-viewport {
            display: flex; align-items: center; justify-content: center; gap: 6px;
            padding: 8px; background: #fff; border-bottom: 1px solid var(--le-border);
            position: relative;
        }
        .le-viewport__group { display: flex; gap: 6px; }
        .le-viewport__group--pages { position: absolute; left: 8px; }
        .le-viewport__group--tools { position: absolute; right: 8px; }
        .le-viewport__btn {
            appearance: none; border: 1px solid var(--le-border); background: #fff;
            border-radius: 8px; padding: 5px 12px; font-size: 12px; font-weight: 500;
            color: var(--le-muted); cursor: pointer;
        }
        .le-viewport__btn:hover { color: var(--le-text); border-color: #cbd5e1; }
        .le-viewport__btn.is-active {
            color: #fff; background: var(--le-accent); border-color: var(--le-accent);
        }
        .le-stage__frame {
            flex: 1; min-height: 0; display: flex; justify-content: center;
            padding: 0; overflow: hidden;
        }
        /* Widths mirror the Tailwind breakpoints the theme is built on: below
           md (768px) for mobile, below lg (1024px) for tablet. */
        .le-stage--tablet .le-preview { max-width: 820px; }
        .le-stage--mobile .le-preview { max-width: 420px; }
        .le-stage:not(.le-stage--desktop) .le-stage__frame { padding: 12px; }
        .le-preview {
            border: 0; width: 100%; height: 100%; min-height: 0; background: #fff;
        }
        .le-stage:not(.le-stage--desktop) .le-preview {
            box-shadow: 0 4px 20px rgba(15, 23, 42, .15); border-radius: 10px;
        }
    </style>
</head>
<body
    data-preview-url="{{ path('iw_sulu_tailwind_theme.live_editor_preview', { id: themeId }) }}"
    data-preview-css-url="{{ path('iw_sulu_tailwind_theme.live_editor_preview_css', { id: themeId }) }}"
    data-save-url="{{ path('iw_sulu_tailwind_theme.live_editor_save', { id: themeId }) }}"
>
    <aside class="le-panel">
        <div class="le-topbar">
            <div>
                <div class="le-topbar__title">Live Theme Editor</div>
                <div class="le-topbar__sub">{{ themeLabel }}</div>
            </div>
            <button type="button" class="le-iconbtn" id="le-close" title="Close" aria-label="Close">×</button>
        </div>

        <div class="le-body">
            {# Root screen: list of configurable sections #}
            <div class="le-screen is-active" data-screen="root">
                <div class="le-sectionlist">
                    <button type="button" class="le-section" data-goto="colors" data-previews="page,articles,reference">
                        <span class="le-section__icon">🎨</span>
                        <span class="le-section__label">Colors</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                    <button type="button" class="le-section" data-goto="variants" data-previews="page"
                            {{ variants is empty ? 'disabled' : '' }}>
                        <span class="le-section__icon">🎭</span>
                        <span class="le-section__label">Block variants</span>
                        {% if variants is empty %}
                            <span class="le-section__meta">None</span>
                        {% else %}
                            <span class="le-section__chevron">›</span>
                        {% endif %}
                    </button>
                    <button type="button" class="le-section" data-goto="borders" data-previews="page,articles">
                        <span class="le-section__icon">⬜</span>
                        <span class="le-section__label">Borders &amp; radius</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                    <button type="button" class="le-section" data-goto="typography" data-previews="page,articles,reference">
                        <span class="le-section__icon">✍️</span>
                        <span class="le-section__label">Typography</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                    <button type="button" class="le-section" data-goto="cards" data-previews="articles">
                        <span class="le-section__icon">🃏</span>
                        <span class="le-section__label">Cards</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                    <button type="button" class="le-section" data-goto="hero" data-previews="page">
                        <span class="le-section__icon">🖼️</span>
                        <span class="le-section__label">Page hero</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                    <button type="button" class="le-section" data-goto="menu" data-previews="page,articles">
                        <span class="le-section__icon">🧭</span>
                        <span class="le-section__label">Menu</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                    <button type="button" class="le-section" disabled>
                        <span class="le-section__icon">📄</span>
                        <span class="le-section__label">Footer</span>
                        <span class="le-section__meta">Soon</span>
                    </button>
                    <button type="button" class="le-section" data-goto="articles" data-previews="articles">
                        <span class="le-section__icon">📰</span>
                        <span class="le-section__label">Articles</span>
                        <span class="le-section__chevron">›</span>
                    </button>
                </div>
            </div>

            {# Colors screen #}
            <div class="le-screen" data-screen="colors">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Colors &amp; variants</span>
                </div>

                <p class="le-hint le-hint--lead">Applied site-wide. The preview updates live; press Save to persist.</p>

                <div class="le-colorgrid">
                    {% for color in colors %}
                        <div class="le-color-item" data-group="{{ color.group }}">
                            <input type="color" class="le-color" data-role="{{ color.role }}"
                                   id="le-color-{{ color.role }}" value="{{ color.value }}">
                            <label class="le-color-item__label" for="le-color-{{ color.role }}">
                                {{ color.label }}
                                <span class="le-color-item__val" data-val-for="{{ color.role }}">{{ color.value }}</span>
                            </label>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Borders & radius screen #}
            <div class="le-screen" data-screen="borders">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Borders &amp; radius</span>
                </div>

                <p class="le-hint le-hint--lead">Corner rounding per context. Preview updates live; Save persists.</p>

                {% for field in borders %}
                    <div class="le-field" data-group="{{ field.group }}">
                        <label class="le-label" for="le-token-{{ loop.index }}">{{ field.label }}</label>
                        <select class="le-select le-token" id="le-token-{{ loop.index }}" data-path="{{ field.path }}">
                            {% for value, label in radiusOptions %}
                                <option value="{{ value }}"{{ value == field.value ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}
            </div>

            {# Typography screen #}
            <div class="le-screen" data-screen="typography">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Typography</span>
                </div>

                <p class="le-hint le-hint--lead">Font families and per-element sizing, applied site-wide. Preview updates live; Save persists.</p>

                {# Font families: 3 fixed slots (heading / body / accent) #}
                <p class="le-subhead">Font families</p>
                {% for family in typography.families %}
                    <div class="le-field" data-group="{{ family.group }}">
                        <label class="le-label" for="le-family-{{ family.role }}">{{ family.label }}</label>
                        <select class="le-select le-family" id="le-family-{{ family.role }}" data-role="{{ family.role }}">
                            <option value=""{{ family.name == '' ? ' selected' : '' }}>System default</option>
                            <optgroup label="Google Fonts">
                                {% for name in fontChoices.google %}
                                    <option value="{{ name }}"{{ name == family.name ? ' selected' : '' }}>{{ name }}</option>
                                {% endfor %}
                            </optgroup>
                            <optgroup label="System fonts">
                                {% for name in fontChoices.system %}
                                    <option value="{{ name }}"{{ name == family.name ? ' selected' : '' }}>{{ name }}</option>
                                {% endfor %}
                            </optgroup>
                        </select>
                    </div>
                {% endfor %}

                {# Per-element assignments: family / weight / size / style / line-height #}
                <p class="le-subhead">Elements</p>
                {% for el in typography.elements %}
                    <div class="le-typo-el" data-group="{{ el.group }}">
                        <p class="le-typo-el__title">{{ el.label }}</p>
                        <div class="le-typo-grid">
                            <label class="le-typo-cell le-typo-cell--wide">
                                <span class="le-typo-cell__label">Font</span>
                                <select class="le-select le-token" data-path="{{ el.path }}.family">
                                    {% for role, label in familySlots %}
                                        <option value="{{ role }}"{{ role == el.family ? ' selected' : '' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="le-typo-cell le-typo-cell--wide">
                                <span class="le-typo-cell__label">Weight</span>
                                <select class="le-select le-token" data-path="{{ el.path }}.weight">
                                    {% for value, label in typoWeights %}
                                        <option value="{{ value }}"{{ value == el.weight ? ' selected' : '' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="le-typo-cell">
                                <span class="le-typo-cell__label">Size (rem)</span>
                                <input type="number" class="le-select le-token" data-path="{{ el.path }}.size"
                                       min="0.5" max="10" step="0.125" value="{{ el.size }}">
                            </label>
                            <label class="le-typo-cell">
                                <span class="le-typo-cell__label">Line height</span>
                                <input type="number" class="le-select le-token" data-path="{{ el.path }}.lineHeight"
                                       min="0.8" max="3" step="0.05" value="{{ el.lineHeight }}">
                            </label>
                            <label class="le-typo-cell le-typo-cell--wide">
                                <span class="le-typo-cell__label">Style</span>
                                <select class="le-select le-token" data-path="{{ el.path }}.style">
                                    {% for value, label in typoStyles %}
                                        <option value="{{ value }}"{{ value == el.style ? ' selected' : '' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Cards screen #}
            <div class="le-screen" data-screen="cards">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Cards</span>
                </div>

                <p class="le-hint le-hint--lead">Global card styling for every article grid. Layout &amp; spacing update live; hover effects and image ratio reload the preview.</p>

                <p class="le-subhead">Layout &amp; spacing</p>
                {% for field in cards.css %}
                    <div class="le-field" data-group="{{ field.group }}">
                        <label class="le-label" for="le-card-{{ field.path }}">{{ field.label }}</label>
                        <select class="le-select le-token" id="le-card-{{ field.path }}" data-path="{{ field.path }}">
                            {% for value, label in field.options %}
                                <option value="{{ value }}"{{ value == field.value ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}

                <p class="le-subhead">Image &amp; hover</p>
                {% for field in cards.struct %}
                    <div class="le-field" data-group="{{ field.group }}">
                        <label class="le-label" for="le-card-{{ field.path }}">{{ field.label }}</label>
                        <select class="le-select le-token" id="le-card-{{ field.path }}" data-path="{{ field.path }}" data-struct="1">
                            {% for value, label in field.options %}
                                <option value="{{ value }}"{{ value == field.value ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}
            </div>

            {# Page hero screen #}
            <div class="le-screen" data-screen="hero">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Page hero</span>
                </div>

                <p class="le-hint le-hint--lead">Site-wide appearance of the optional page banner. Every change reloads the preview. Per-page image &amp; title stay on each page.</p>

                {% for field in hero %}
                    <div class="le-field" data-group="{{ field.group }}">
                        <label class="le-label" for="le-hero-{{ field.path }}">{{ field.label }}</label>
                        <select class="le-select le-token" id="le-hero-{{ field.path }}" data-path="{{ field.path }}" data-struct="1">
                            {% for value, label in field.options %}
                                <option value="{{ value }}"{{ value == field.value ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}
            </div>

            {# Block variants screen #}
            <div class="le-screen" data-screen="variants">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Block variants</span>
                </div>

                <p class="le-hint le-hint--lead">A variant is a color scheme content blocks can be switched to. The preview shows every block stamped with the variant below; changes apply live.</p>

                {% if variants is not empty %}
                    {# Shared option list for every color-token select (see below). #}
                    <template id="le-colortoken-options">
                        {% for tokenGroup in colorTokenGroups %}
                            <optgroup label="{{ tokenGroup.label }}">
                                {% for value, label in tokenGroup.options %}
                                    <option value="{{ value }}">{{ label }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endfor %}
                        <option value="custom">Custom color…</option>
                    </template>

                    <div class="le-field">
                        <label class="le-label" for="le-variant-pick">Variant to edit</label>
                        <select class="le-select" id="le-variant-pick" data-struct="1" data-path="variant">
                            {% for variant in variants %}
                                <option value="{{ variant.slug }}">{{ variant.label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {% for variant in variants %}
                        <div class="le-variant-panel" data-variant="{{ variant.slug }}"{{ loop.first ? '' : ' hidden' }}>
                            {% for group in variantColorGroups %}
                                <p class="le-subhead">{{ group }}</p>
                                {% for color in variant.colors|filter(c => c.groupLabel == group) %}
                                    <div class="le-field" data-group="{{ color.group }}">
                                        <label class="le-label" for="le-var-{{ color.path }}">{{ color.label }}</label>
                                        <div class="le-colortoken">
                                            {# The palette options are cloned from #le-colortoken-options on
                                               load: inlining ~100 options in each of these selects would
                                               weigh the page down by an order of magnitude. #}
                                            <select class="le-select le-variant" id="le-var-{{ color.path }}"
                                                    data-path="{{ color.path }}" data-colortoken
                                                    data-value="{{ color.value|slice(0, 1) == '#' ? 'custom' : color.value }}">
                                                {% if color.custom != '' %}
                                                    <option value="" selected>Current: {{ color.custom }}</option>
                                                {% else %}
                                                    <option value="">Not set</option>
                                                {% endif %}
                                            </select>
                                            <input type="color" class="le-variant-custom"
                                                   value="{{ color.value|slice(0, 1) == '#' ? color.value : '#808080' }}"
                                                   {{ color.value|slice(0, 1) == '#' ? '' : 'hidden' }}
                                                   aria-label="{{ color.label }} custom color">
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endfor %}

                            <p class="le-subhead">Separator</p>
                            <div class="le-field" data-group="variant.separator">
                                <label class="le-label" for="le-var-{{ variant.slug }}-sepmode">Display</label>
                                <select class="le-select le-variant" id="le-var-{{ variant.slug }}-sepmode"
                                        data-path="{{ variant.slug }}.separatorMode">
                                    {% for value, label in separatorModes %}
                                        <option value="{{ value }}"{{ value == variant.separatorMode ? ' selected' : '' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="le-field" data-group="variant.separator">
                                <label class="le-label" for="le-var-{{ variant.slug }}-sepstyle">Style</label>
                                <select class="le-select le-variant" id="le-var-{{ variant.slug }}-sepstyle"
                                        data-path="{{ variant.slug }}.separatorStyle">
                                    {% for value, label in separatorStyles %}
                                        <option value="{{ value }}"{{ value == variant.separatorStyle ? ' selected' : '' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            {% if buttonChoices is not empty %}
                                <p class="le-subhead">Buttons</p>
                                <div class="le-field" data-group="variant.button">
                                    <label class="le-label" for="le-var-{{ variant.slug }}-btn">Button style</label>
                                    <select class="le-select le-variant" id="le-var-{{ variant.slug }}-btn"
                                            data-path="{{ variant.slug }}.buttonStyle">
                                        {% for value, label in buttonChoices %}
                                            <option value="{{ value }}"{{ value == variant.buttonStyle ? ' selected' : '' }}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Menu screen #}
            <div class="le-screen" data-screen="menu">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Menu</span>
                </div>

                <p class="le-hint le-hint--lead">Site-wide header. Layout options reload the preview; colors update live. Interact with the preview to open the menu. Logos are set in the theme form.</p>

                <p class="le-subhead">Layout &amp; behavior</p>
                {% for field in menu.struct %}
                    <div class="le-field le-menu-field" data-group="{{ field.group }}" data-show-for="{{ field.showFor }}" data-panels="{{ field.panels }}">
                        <label class="le-label" for="le-menu-{{ field.path }}">{{ field.label }}</label>
                        <select class="le-select le-menu" id="le-menu-{{ field.path }}" data-path="{{ field.path }}" data-struct="1">
                            {% for value, label in field.options %}
                                <option value="{{ value }}"{{ value == field.value ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}

                <p class="le-subhead">Colors</p>
                <div class="le-colorgrid">
                    {% for color in menu.colors %}
                        <div class="le-color-item" data-group="{{ color.group }}">
                            <input type="color" class="le-menu-color" data-path="colors.{{ color.slot }}"
                                   id="le-menu-color-{{ color.slot }}" value="{{ color.value }}">
                            <label class="le-color-item__label" for="le-menu-color-{{ color.slot }}">
                                {{ color.label }}
                                <span class="le-color-item__val" data-val-for="menu-{{ color.slot }}">
                                    {{ color.alias != '' ? color.alias : color.value }}
                                </span>
                            </label>
                        </div>
                    {% endfor %}
                </div>
                <p class="le-hint">A slot showing a <code>ref:</code> alias follows the palette. It is left untouched unless you pick a color here, which replaces the alias with a fixed value.</p>
            </div>

            {# Articles screen #}
            <div class="le-screen" data-screen="articles">
                <div class="le-screenhead">
                    <button type="button" class="le-back" data-back>‹ Back</button>
                    <span class="le-screenhead__title">Articles</span>
                </div>

                <p class="le-hint le-hint--lead">Article listing layout and what shows on each card. Every change reloads the preview.</p>

                {% for field in articles %}
                    <div class="le-field" data-group="{{ field.group }}">
                        <label class="le-label" for="le-articles-{{ field.path }}">{{ field.label }}</label>
                        <select class="le-select le-token" id="le-articles-{{ field.path }}" data-path="{{ field.path }}" data-struct="1">
                            {% for value, label in field.options %}
                                <option value="{{ value }}"{{ value == field.value ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="le-footer">
            <span class="le-status" id="le-status" role="status" aria-live="polite"></span>
            <button type="button" class="le-btn" id="le-save">Save</button>
        </div>
    </aside>

    <div class="le-stage le-stage--desktop" id="le-stage">
        {# Viewport widths: the theme is responsive, and several components
           (burger button, mobile overlay, sidebar) only show below a
           breakpoint — a full-width iframe would never reveal them. #}
        <div class="le-viewport">
            {# Previews are whole pages, so most settings stay editable without
               switching: the page holds menu + hero + blocks + footer. #}
            <div class="le-viewport__group le-viewport__group--pages" role="group" aria-label="Preview page">
                <button type="button" class="le-viewport__btn is-active" data-preview="page">Page</button>
                <button type="button" class="le-viewport__btn" data-preview="articles">Articles</button>
                <button type="button" class="le-viewport__btn" data-preview="reference">Reference</button>
            </div>
            <div class="le-viewport__group" role="group" aria-label="Preview width">
                <button type="button" class="le-viewport__btn is-active" data-viewport="desktop">Desktop</button>
                <button type="button" class="le-viewport__btn" data-viewport="tablet">Tablet</button>
                <button type="button" class="le-viewport__btn" data-viewport="mobile">Mobile</button>
            </div>
            <div class="le-viewport__group le-viewport__group--tools">
                {# Click-to-edit: off by default so the preview stays interactive
                   (opening the burger menu, following a link…). Like a browser
                   inspector, picking an element turns it back off — unless the
                   lock next to it is closed. #}
                <button type="button" class="le-viewport__btn" id="le-inspect"
                        aria-pressed="false" title="Pick an element in the preview to edit it">
                    ✎ Pick
                </button>
                <button type="button" class="le-viewport__btn" id="le-inspect-lock"
                        aria-pressed="false" title="Keep picking after each selection">
                    🔓
                </button>
                <button type="button" class="le-viewport__btn is-active" id="le-inspector-toggle"
                        aria-pressed="true" title="Show or hide the settings panel">
                    ⬛ Panel
                </button>
            </div>
        </div>
        <div class="le-stage__frame">
            <iframe id="le-preview" class="le-preview" title="Theme preview"></iframe>
        </div>
    </div>

    {# Right inspector — filled by moving the matching field nodes out of their
       screen and back on close, so there is a single instance of every control
       (same listeners, same save payload). #}
    <aside class="le-pop" id="le-pop" aria-label="Element settings">
        <div class="le-pop__head">
            <span class="le-pop__title" id="le-pop-title">Element settings</span>
            <button type="button" class="le-iconbtn" id="le-pop-close" aria-label="Hide panel">×</button>
        </div>
        <div class="le-pop__body" id="le-pop-body"></div>
        <p class="le-pop__empty" id="le-pop-empty">
            Turn on <strong>✎ Pick</strong>, then click a component in the preview
            to edit just its settings here.
        </p>
        <button type="button" class="le-pop__more" id="le-pop-more" hidden></button>
    </aside>

    {# Group labels for the inspector headings. #}
    <script id="le-group-labels" type="application/json">{{ groupLabels|json_encode|raw }}</script>

    <script>
        (function () {
            var GROUP_LABELS = JSON.parse(document.getElementById('le-group-labels').textContent);
            var body = document.body;
            var previewUrl = body.dataset.previewUrl;
            var previewCssUrl = body.dataset.previewCssUrl;
            var saveUrl = body.dataset.saveUrl;
            var origin = window.location.origin;

            var iframe = document.getElementById('le-preview');
            var colorInputs = document.querySelectorAll('.le-color');
            var tokenInputs = document.querySelectorAll('.le-token');
            var familyInputs = document.querySelectorAll('.le-family');
            var menuInputs = document.querySelectorAll('.le-menu');
            var menuColorInputs = document.querySelectorAll('.le-menu-color');
            var variantInputs = document.querySelectorAll('.le-variant');
            var saveBtn = document.getElementById('le-save');
            var status = document.getElementById('le-status');
            var screens = document.querySelectorAll('.le-screen');

            // The preview page currently loaded (page | articles | reference).
            var currentPreview = 'page';
            // Tracks whether any control changed since load, so a section switch
            // (which reloads the iframe) can re-push the in-progress CSS instead
            // of reverting to the persisted theme.
            var dirty = false;

            // Structural tokens (card image ratio/hover, hero layout, menu type…)
            // drive Twig params, not CSS vars, so they ride the preview URL and
            // re-render the demo on reload instead of a CSS swap. A preview page
            // shows several components at once, so ALL structural controls are
            // sent regardless of the open screen — their parameter names are
            // unique across screens.
            //
            // Unscoped on purpose: the inspector borrows field nodes out of
            // their screen, so scoping to `.le-screen` would silently drop
            // whatever is currently open on the right.
            function structQuery() {
                var parts = [];
                document.querySelectorAll('[data-struct]').forEach(function (i) {
                    parts.push(encodeURIComponent(i.dataset.path) + '=' + encodeURIComponent(i.value));
                });
                return parts.join('&');
            }
            // Session demo-image seed: picked once on load so demo images vary
            // between openings yet stay stable across structural reloads.
            var demoSeed = Math.floor(Math.random() * 100000) + 1;

            function previewSrc(preview) {
                var src = previewUrl + '?preview=' + encodeURIComponent(preview)
                    + '&demoSeed=' + demoSeed;
                var q = structQuery();
                if (q) { src += '&' + q; }
                return src;
            }

            function loadPreview(preview) {
                currentPreview = preview;
                document.querySelectorAll('[data-preview]').forEach(function (btn) {
                    btn.classList.toggle('is-active', btn.dataset.preview === preview);
                });
                iframe.src = previewSrc(preview);
            }

            loadPreview(currentPreview);

            function setStatus(text, kind) {
                status.textContent = text || '';
                status.className = 'le-status' + (kind ? ' is-' + kind : '');
            }

            function showScreen(name) {
                screens.forEach(function (s) {
                    s.classList.toggle('is-active', s.dataset.screen === name);
                });
            }

            // ── Section navigation ──────────────────────────────────
            // A screen lists the previews that already show what it configures.
            // The preview only switches when the current one is not among them,
            // so moving between screens (or clicking around with click-to-edit)
            // keeps the page you are looking at.
            function openScreen(screen) {
                var btn = document.querySelector('.le-section[data-goto="' + screen + '"]');
                if (!btn || btn.disabled) { return false; }
                // Reclaim whatever the inspector borrowed: the screen about to
                // be shown would otherwise be missing those fields.
                closePop();
                var previews = (btn.dataset.previews || '').split(',');
                if (previews[0] && previews.indexOf(currentPreview) === -1) {
                    loadPreview(previews[0]);
                }
                showScreen(screen);
                return true;
            }

            document.querySelectorAll('.le-section[data-goto]').forEach(function (btn) {
                btn.addEventListener('click', function () { openScreen(btn.dataset.goto); });
            });
            document.querySelectorAll('[data-back]').forEach(function (btn) {
                btn.addEventListener('click', function () { showScreen('root'); });
            });

            document.getElementById('le-close').addEventListener('click', function () {
                window.close();
            });

            // Collect the full desired state. The editor always posts everything:
            // colors as a { role: hex } map, tokens as a { dotPath: value } patch.
            function collectColors() {
                var colors = {};
                colorInputs.forEach(function (input) { colors[input.dataset.role] = input.value; });
                return colors;
            }
            function collectTokens() {
                var tokens = {};
                tokenInputs.forEach(function (input) {
                    // Skip a cleared number field so it keeps its last value
                    // rather than emitting an empty (invalid) CSS length.
                    if (input.type === 'number' && input.value === '') { return; }
                    tokens[input.dataset.path] = input.value;
                });
                return tokens;
            }
            function collectFamilies() {
                var families = {};
                familyInputs.forEach(function (input) { families[input.dataset.role] = input.value; });
                return families;
            }
            // Menu settings live in the entity's own menuConfig column, not in
            // tokens, so they travel in a dedicated channel. Colors are sent
            // only once touched: an untouched slot may hold a palette alias
            // (ref:…) that the color input cannot represent and must not erase.
            function collectMenu() {
                var menu = {};
                menuInputs.forEach(function (input) { menu[input.dataset.path] = input.value; });
                menuColorInputs.forEach(function (input) {
                    if (input.dataset.touched) { menu[input.dataset.path] = input.value; }
                });
                return menu;
            }
            // Block variants live in tokens.blockVariants, a list addressed by
            // slug — hence their own channel keyed "<slug>.<prop>". An empty
            // value means "leave the stored one alone": that is how a value the
            // palette picker cannot represent (a raw rgba…) survives untouched.
            function collectVariants() {
                var variants = {};
                variantInputs.forEach(function (input) {
                    var value = input.value;
                    if (value === 'custom') {
                        var picker = input.parentNode.querySelector('.le-variant-custom');
                        value = picker ? picker.value : '';
                    }
                    if (value !== '') { variants[input.dataset.path] = value; }
                });
                return variants;
            }
            function buildPayload() {
                return {
                    colors: collectColors(),
                    tokens: collectTokens(),
                    families: collectFamilies(),
                    menu: collectMenu(),
                    variants: collectVariants(),
                };
            }

            // ── Live preview: push recompiled CSS into the iframe ───
            function pushCss(css) {
                iframe.contentWindow.postMessage({ type: 'iw-live-theme-css', css: css }, origin);
            }

            function requestPreview() {
                setStatus('Updating…', 'busy');
                fetch(previewCssUrl, {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(buildPayload()),
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.css === undefined) { throw new Error(data.error || 'No CSS'); }
                        pushCss(data.css);
                        setStatus('', '');
                    })
                    .catch(function (e) { setStatus('Preview error: ' + e.message, 'err'); });
            }

            var debounceTimer = null;
            function schedulePreview() {
                dirty = true;
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(requestPreview, 200);
            }

            // On a section switch the iframe reloads with the persisted theme;
            // re-apply the in-progress overrides so the preview stays continuous,
            // and restore the click-to-edit state the fresh document lost.
            iframe.addEventListener('load', function () {
                if (dirty) { requestPreview(); }
                sendInspectState();
            });

            colorInputs.forEach(function (input) {
                var valOut = document.querySelector('[data-val-for="' + input.dataset.role + '"]');
                input.addEventListener('input', function () {
                    if (valOut) { valOut.textContent = input.value; }
                    schedulePreview();
                });
            });
            // 'input' covers both selects and number fields so the preview
            // updates as the value changes, not only on blur. Structural tokens
            // reload the demo (re-render) instead of a CSS swap.
            tokenInputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    if (input.dataset.struct) {
                        dirty = true;
                        iframe.src = previewSrc(currentPreview);
                    } else {
                        schedulePreview();
                    }
                });
            });
            familyInputs.forEach(function (input) {
                input.addEventListener('input', schedulePreview);
            });

            // ── Menu ────────────────────────────────────────────────
            // Menu types offering the drill-down sub-menu mode; for any other
            // type the panels constraint of a control does not apply.
            var PANELS_TYPES = ['burger', 'sidebar'];
            var menuTypeInput = document.getElementById('le-menu-type');
            var menuPanelsInput = document.getElementById('le-menu-subMenuPanels');

            // Mirror the visibleCondition rules of the admin menu form: only
            // show the controls that apply to the selected menu type (and
            // sub-menu mode).
            function syncMenuFields() {
                if (!menuTypeInput) { return; }
                var type = menuTypeInput.value;
                var panels = menuPanelsInput ? menuPanelsInput.value : '0';
                document.querySelectorAll('.le-menu-field').forEach(function (field) {
                    var showFor = field.dataset.showFor;
                    var visible = !showFor || showFor.split(',').indexOf(type) !== -1;
                    if (visible && field.dataset.panels && PANELS_TYPES.indexOf(type) !== -1) {
                        visible = field.dataset.panels === panels;
                    }
                    field.hidden = !visible;
                });
            }
            syncMenuFields();

            menuInputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    syncMenuFields();
                    dirty = true;
                    iframe.src = previewSrc(currentPreview);
                });
            });
            menuColorInputs.forEach(function (input) {
                var valOut = document.querySelector('[data-val-for="menu-' + input.dataset.path.slice(7) + '"]');
                input.addEventListener('input', function () {
                    input.dataset.touched = '1';
                    if (valOut) { valOut.textContent = input.value; }
                    schedulePreview();
                });
            });

            // ── Block variants ──────────────────────────────────────
            // Fill every color-token select from the shared option template,
            // then restore its stored value (a raw hex selects "Custom color…",
            // which reveals the picker next to it).
            var colorTokenTemplate = document.getElementById('le-colortoken-options');
            if (colorTokenTemplate) {
                document.querySelectorAll('[data-colortoken]').forEach(function (select) {
                    select.appendChild(colorTokenTemplate.content.cloneNode(true));
                    select.value = select.dataset.value;
                });
            }

            // Every variant's controls are in the DOM; only the edited one is
            // shown, so switching variants needs no round-trip to the server.
            var variantPick = document.getElementById('le-variant-pick');
            if (variantPick) {
                variantPick.addEventListener('input', function () {
                    document.querySelectorAll('.le-variant-panel').forEach(function (panel) {
                        panel.hidden = panel.dataset.variant !== variantPick.value;
                    });
                    // Which variant the demo blocks carry is a Twig param, so
                    // the preview re-renders (it rides the URL via data-struct).
                    dirty = true;
                    iframe.src = previewSrc(currentPreview);
                });
            }

            variantInputs.forEach(function (input) {
                var picker = input.parentNode.querySelector('.le-variant-custom');
                input.addEventListener('input', function () {
                    // The custom color picker only shows for the "custom" option.
                    if (picker) { picker.hidden = input.value !== 'custom'; }
                    schedulePreview();
                });
                if (picker) { picker.addEventListener('input', schedulePreview); }
            });

            // ── Click-to-edit ───────────────────────────────────────
            // Clicking a component in the preview opens the right inspector,
            // holding ONLY the field groups that restyle it. The fields are not
            // duplicated: they are moved out of their screen and put back on
            // close, so a control exists once (one listener, one value in the
            // payload).
            var inspectBtn = document.getElementById('le-inspect');
            var lockBtn = document.getElementById('le-inspect-lock');
            var panelBtn = document.getElementById('le-inspector-toggle');
            var popTitle = document.getElementById('le-pop-title');
            var popBody = document.getElementById('le-pop-body');
            var popEmpty = document.getElementById('le-pop-empty');
            var popMore = document.getElementById('le-pop-more');
            var inspecting = false;
            // Locked = keep picking after a selection, like a pinned inspector.
            var pickLocked = false;
            // Where each borrowed node has to go back: [node, parent, nextSibling].
            var borrowed = [];
            var popScreen = '';

            function sendInspectState() {
                iframe.contentWindow.postMessage(
                    { type: 'iw-live-theme-inspect', enabled: inspecting },
                    origin,
                );
            }

            function setPicking(on) {
                inspecting = on;
                inspectBtn.classList.toggle('is-active', on);
                inspectBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
                sendInspectState();
            }

            inspectBtn.addEventListener('click', function () { setPicking(!inspecting); });

            lockBtn.addEventListener('click', function () {
                pickLocked = !pickLocked;
                lockBtn.textContent = pickLocked ? '🔒' : '🔓';
                lockBtn.classList.toggle('is-active', pickLocked);
                lockBtn.setAttribute('aria-pressed', pickLocked ? 'true' : 'false');
            });

            panelBtn.addEventListener('click', function () {
                var hidden = body.classList.toggle('no-inspector');
                panelBtn.classList.toggle('is-active', !hidden);
                panelBtn.setAttribute('aria-pressed', hidden ? 'false' : 'true');
            });

            // Empty the inspector: give every borrowed field back to its screen
            // and show the hint again. The panel itself stays in place.
            // `keepSelection` is set when clearing right before refilling: the
            // preview has just drawn the new selection frame, and telling it to
            // deselect would wipe it.
            function closePop(keepSelection) {
                borrowed.forEach(function (entry) {
                    entry[1].insertBefore(entry[0], entry[2]);
                });
                borrowed = [];
                popBody.textContent = '';
                popTitle.textContent = 'Element settings';
                popEmpty.hidden = false;
                popMore.hidden = true;
                popScreen = '';
                if (!keepSelection) {
                    iframe.contentWindow.postMessage({ type: 'iw-live-theme-deselect' }, origin);
                }
            }

            // The × hides the panel; the fields go home first so the left
            // sidebar is never left with holes in it.
            document.getElementById('le-pop-close').addEventListener('click', function () {
                closePop();
                body.classList.add('no-inspector');
                panelBtn.classList.remove('is-active');
                panelBtn.setAttribute('aria-pressed', 'false');
            });
            document.addEventListener('keydown', function (event) {
                if ('Escape' === event.key) { closePop(); }
            });

            // Which screen holds a given group. Derived from the group key, not
            // from the clicked element's screen: a card title offers both
            // typography and card groups, which live on two different screens.
            var GROUP_SCREENS = {
                menu: 'menu', typo: 'typography', cards: 'cards', hero: 'hero',
                articles: 'articles', borders: 'borders', colors: 'colors', variant: 'variants',
            };

            // Move a group's fields into the popover, under their group heading.
            // Scoping by screen matters: menu colors and variant colors both use
            // `colors.*` paths but live on different screens.
            function appendGroup(group, variant) {
                var screen = GROUP_SCREENS[group.split('.')[0]] || '';
                var scope = screen
                    ? '.le-screen[data-screen="' + screen + '"] '
                    : '';
                // Variant fields are repeated once per variant panel.
                if (variant && 'variants' === screen) {
                    scope += '.le-variant-panel[data-variant="' + variant + '"] ';
                }
                var fields = document.querySelectorAll(scope + '[data-group="' + group + '"]');
                if (!fields.length) { return false; }

                var section = document.createElement('div');
                section.className = 'le-pop__section';
                var heading = document.createElement('p');
                heading.className = 'le-pop__group';
                heading.textContent = GROUP_LABELS[group] || group;
                section.appendChild(heading);

                fields.forEach(function (field) {
                    // A hidden field is one the current menu type does not use.
                    if (field.hidden) { return; }
                    borrowed.push([field, field.parentNode, field.nextSibling]);
                    section.appendChild(field);
                });

                if (section.children.length < 2) { return false; }
                popBody.appendChild(section);
                return true;
            }

            function openPop(data) {
                closePop(true);
                popTitle.textContent = data.label || 'Settings';
                popScreen = data.screen || '';

                var shown = 0;
                (data.groups || []).forEach(function (group) {
                    if (appendGroup(group, data.variant)) { shown++; }
                });

                if (!shown) {
                    // Nothing group-specific: fall back to the whole screen.
                    if (popScreen) { openScreen(popScreen); }
                    return;
                }

                popEmpty.hidden = true;
                popMore.hidden = !popScreen;
                popMore.textContent = 'All ' + (data.componentLabel || 'component') + ' settings →';
                // A selection is worth showing even if the panel was hidden.
                body.classList.remove('no-inspector');
                panelBtn.classList.add('is-active');
                panelBtn.setAttribute('aria-pressed', 'true');

                // Like a browser inspector, picking ends the pick mode unless
                // the user locked it.
                if (!pickLocked) { setPicking(false); }
            }

            popMore.addEventListener('click', function () {
                openScreen(popScreen);
            });

            window.addEventListener('message', function (event) {
                if (event.origin !== origin) { return; }
                var data = event.data || {};
                if (data.type !== 'iw-live-theme-edit') { return; }
                openPop(data);
            });

            // ── Preview page ────────────────────────────────────────
            document.querySelectorAll('[data-preview]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (btn.dataset.preview !== currentPreview) { loadPreview(btn.dataset.preview); }
                });
            });

            // ── Preview width ───────────────────────────────────────
            var stage = document.getElementById('le-stage');
            document.querySelectorAll('[data-viewport]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    stage.className = 'le-stage le-stage--' + btn.dataset.viewport;
                    document.querySelectorAll('[data-viewport]').forEach(function (b) {
                        b.classList.toggle('is-active', b === btn);
                    });
                });
            });

            // ── Save ────────────────────────────────────────────────
            saveBtn.addEventListener('click', function () {
                saveBtn.disabled = true;
                setStatus('Saving…', 'busy');
                fetch(saveUrl, {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(buildPayload()),
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) { throw new Error(data.error || 'Save failed'); }
                        dirty = false;
                        setStatus('Saved ✓', 'ok');
                    })
                    .catch(function (e) { setStatus('Save error: ' + e.message, 'err'); })
                    .finally(function () { saveBtn.disabled = false; });
            });
        })();
    </script>
</body>
</html>
