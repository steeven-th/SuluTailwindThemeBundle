{#
    Page hero component — full-width banner at the top of page templates.
    Configurable via the page-hero.xml fragment.

    The banner image is a PROPERTY of the hero, not a condition for it: the
    component renders with or without one, so the site-wide appearance settings
    (height, alignment, title placement) apply in both cases. Without an image
    the header sits on the page background and takes the theme text colors.

    Parameters:
    - image: media ID or resolved media object. Optional — the hero renders
             without it (flat background, same layout settings).
    - title: H1 text. Overrides the page title when the editor set heroTitle.
    - subtitle: optional tagline below the H1
    - display: 'overlay' (title over the banner) | 'below' (title under the
               image) | 'hidden' (image only, the H1 is kept for crawlers and
               assistive tech). Default 'overlay'.
               Without an image, 'below' behaves like 'overlay' — there is no
               image for the header to sit under — and 'hidden' renders no
               banner at all, only the hidden H1.
    - alignX: 'left' | 'center' | 'right' — horizontal text alignment (both modes)
    - alignY: 'top' | 'middle' | 'bottom' — vertical position (overlay only)
    - shade: 'none' | 'light' | 'medium' | 'strong' — readability veil. Ignored
             without an image: there is nothing to veil.
    - height: 'sm' | 'md' | 'lg' | 'full' — banner height, image or not
    - parallax: bool — vertical parallax scroll on the image (image only)
    - breadcrumb: bool — render the breadcrumb next to the title (already gated
                  by the admin breadcrumbs setting by the caller)
    - imageFormat: 16_9 | 4_3 | 1_1 | 3_4 | original — the crop of the image,
                  side_by_side only
    - breadcrumbPosition: above | below — where the breadcrumb sits relative to
                  the titles, when it sits with them
    - breadcrumbPageUuid / breadcrumbCurrentTitle: breadcrumb context

    Public CSS API:
    - .iw-page-hero (block) + .iw-page-hero--h-{sm|md|lg|full} + .iw-page-hero--parallax
    - .iw-page-hero--no-image (flat background, theme text colors)
    - .iw-page-hero__image (the rendered <img>)
    - .iw-page-hero__overlay (+ .iw-page-hero--y-{top|middle|bottom} + .iw-page-hero--shade-{…})
    - .iw-page-hero__caption (the "below" wrapper)
    - .iw-page-hero__inner (+ .iw-page-hero--x-{left|center|right})
    - .iw-page-hero__breadcrumb / __title / __subtitle
    Overridable via --iw-page-hero-* (see app.css).
#}

{% set media = null %}

{% if image is defined and image is not empty %}
    {% if image is iterable and image.url is defined %}
        {% set media = image %}
    {% else %}
        {# single_media_selection stores a scalar media id #}
        {% set media = sulu_resolve_media(image, app.request.locale) %}
    {% endif %}
{% endif %}

{# A deleted media resolves to null: fall back to the image-less hero rather
   than dropping the header — and the H1 with it. #}
{% set hasImage = media is not null %}

{# Whitelist every option so unexpected values fall back to a sane default. #}
{% set heroTitle = title|default('') %}
{% set heroSubtitle = subtitle|default('') %}
{% set display = display|default('overlay') in ['overlay', 'below', 'side_by_side', 'hidden'] ? display : 'overlay' %}
{% set alignX = alignX|default('left') in ['left', 'center', 'right'] ? alignX : 'left' %}
{% set alignY = alignY|default('bottom') in ['top', 'middle', 'bottom'] ? alignY : 'bottom' %}
{% set shade = shade|default('medium') in ['none', 'light', 'medium', 'strong'] ? shade : 'medium' %}
{% set height = height|default('md') in ['sm', 'md', 'lg', 'full'] ? height : 'md' %}
{% set parallax = hasImage and parallax|default(false) %}
{% set showBreadcrumb = breadcrumb|default(false) %}
{% set breadcrumbPosition = breadcrumbPosition|default('above') == 'below' ? 'below' : 'above' %}

{#- Built once and printed where the setting asks. `--above` names what the
    class does - the breadcrumb sits above the titles, so it needs a bottom
    margin - rather than the mode that happened to use it. -#}
{% set breadcrumbHtml %}
    {% if showBreadcrumb %}
        <div class="iw-page-hero__breadcrumb{{ breadcrumbPosition == 'above' ? ' iw-page-hero__breadcrumb--above' : '' }}">
            {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                context: 'page',
                pageUuid: breadcrumbPageUuid|default(null),
                currentTitle: breadcrumbCurrentTitle|default(''),
                align: alignX,
            } only %}
        </div>
    {% endif %}
{% endset %}

{# "below" needs an image to sit under, and "side_by_side" one to sit beside;
   without one the header goes back into the banner itself. #}
{% set display = (not hasImage and display in ['below', 'side_by_side']) ? 'overlay' : display %}

{% set hasHeader = heroTitle is not empty or heroSubtitle is not empty or showBreadcrumb %}

{# An image-less banner with nothing to show is just an empty box: skip it and
   keep the heading for crawlers and assistive tech. #}
{% set renderBanner = hasImage or (display != 'hidden' and hasHeader) %}

{% if display == 'hidden' and heroTitle is not empty and not renderBanner %}
    <h1 class="iw-visually-hidden">{{ iw_sulu_tailwind_theme_title_markup(heroTitle) }}</h1>
{% endif %}

{% if display == 'side_by_side' %}
    {#- Text on one side, image on the other. Unlike the other modes the image
        is part of the flow rather than a background, so it takes the theme
        image radius and the banner has no height, no veil and no parallax:
        the content sets the height. -#}
    <section class="iw-page-hero iw-page-hero--side-by-side">
        <div class="iw-page-hero__inner container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="iw-page-hero__text iw-page-hero--x-{{ alignX }}">
                {% if breadcrumbPosition == 'above' %}{{ breadcrumbHtml }}{% endif %}
                {% if heroTitle is not empty %}
                    <h1 class="iw-page-hero__title iw-page-hero__title--side">{{ iw_sulu_tailwind_theme_title_markup(heroTitle) }}</h1>
                {% endif %}
                {% if heroSubtitle is not empty %}
                    <p class="iw-page-hero__subtitle iw-page-hero__subtitle--side">{{ iw_sulu_tailwind_theme_title_markup(heroSubtitle) }}</p>
                {% endif %}
                {% if breadcrumbPosition == 'below' %}{{ breadcrumbHtml }}{% endif %}
            </div>

            {#- The only mode that crops its image: the others fill the banner
                edge to edge, where the ratio comes from the height instead.
                `original` keeps the natural ratio, so no crop box is set. -#}
            {% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4'} %}
            {% set ratioMap = {'16_9': '16-9', '4_3': '4-3', '1_1': '1-1', '3_4': '3-4'} %}
            {% set chosenFormat = imageFormat|default('original') %}

            <div class="iw-page-hero__visual">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig' with {
                    media: media,
                    format: formatMap[chosenFormat]|default('iw_theme_hero'),
                    ratio: ratioMap[chosenFormat]|default(null),
                    alt: media.title|default(''),
                    loading: 'eager',
                    radiusClass: iw_sulu_tailwind_theme_radius_class('image', '')
                } only %}
            </div>
        </div>
    </section>
{% elseif renderBanner %}
    {% set imgClasses = 'iw-page-hero__image' ~ (parallax ? ' iw-page-hero__image--parallax' : '') %}

    <section class="iw-page-hero iw-page-hero--h-{{ height }}{{ hasImage ? '' : ' iw-page-hero--no-image' }}{{ parallax ? ' iw-page-hero--parallax' : '' }}"
             {%- if parallax %} data-controller="hero-parallax"{% endif %}>
        {# "hidden" hides the title visually, not semantically: the page
           would otherwise ship without any <h1>. #}
        {% if display == 'hidden' and heroTitle is not empty %}
            <h1 class="iw-visually-hidden">{{ iw_sulu_tailwind_theme_title_markup(heroTitle) }}</h1>
        {% endif %}

        {% if hasImage %}
            {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                media: media,
                format: 'iw_theme_hero',
                alt: media.title|default(''),
                raw: true,
                loading: 'eager',
                itemprop: 'image',
                classes: imgClasses,
            }) }}
        {% endif %}

        {% if display == 'overlay' and hasHeader %}
            {# The veil only makes sense over an image. #}
            <div class="iw-page-hero__overlay iw-page-hero--y-{{ alignY }}{{ hasImage ? ' iw-page-hero--shade-' ~ shade : '' }}">
                <div class="iw-page-hero__inner iw-page-hero--x-{{ alignX }} container mx-auto px-4 sm:px-6 lg:px-8">
                    {% if breadcrumbPosition == 'above' %}{{ breadcrumbHtml }}{% endif %}
                    {% if heroTitle is not empty %}
                        <h1 class="iw-page-hero__title">{{ iw_sulu_tailwind_theme_title_markup(heroTitle) }}</h1>
                    {% endif %}
                    {% if heroSubtitle is not empty %}
                        <p class="iw-page-hero__subtitle">{{ iw_sulu_tailwind_theme_title_markup(heroSubtitle) }}</p>
                    {% endif %}
                    {% if breadcrumbPosition == 'below' %}{{ breadcrumbHtml }}{% endif %}
                </div>
            </div>
        {% endif %}
    </section>

    {% if display == 'below' and hasHeader %}
        <div class="iw-page-hero__caption iw-page-hero--x-{{ alignX }} container mx-auto px-4 sm:px-6 lg:px-8">
            {% if breadcrumbPosition == 'above' %}{{ breadcrumbHtml }}{% endif %}
            {% if heroTitle is not empty %}
                <h1 class="iw-page-hero__title iw-page-hero__title--below">{{ iw_sulu_tailwind_theme_title_markup(heroTitle) }}</h1>
            {% endif %}
            {% if heroSubtitle is not empty %}
                <p class="iw-page-hero__subtitle iw-page-hero__subtitle--below">{{ iw_sulu_tailwind_theme_title_markup(heroSubtitle) }}</p>
            {% endif %}
            {% if breadcrumbPosition == 'below' %}{{ breadcrumbHtml }}{% endif %}
        </div>
    {% endif %}
{% endif %}
