{# Default page template — renders content blocks using the block dispatcher pattern #}
{% extends 'base.html.twig' %}

{% block content %}
    {# Per-page hero DATA (image, title, subtitle). The banner appearance is
       configured site-wide in the theme admin (Components → Page hero), read
       below from iw_sulu_tailwind_theme.pageHero_*. heroTitle (when set) becomes
       the H1, overriding the page title — so editors keep a short page name for
       menus and a longer editorial headline here. #}
    {% set heroImageId = content.heroImage|default(null) %}
    {% set heroTitleText = content.heroTitle|default('') %}
    {% set pageH1 = heroTitleText is not empty ? heroTitleText : content.title|default('') %}

    {# Site-wide hero config (with the same defaults as the admin form). #}
    {% set heroDisplay = iw_sulu_tailwind_theme.pageHero_titleDisplay|default('overlay') %}
    {% set heroBreadcrumbMode = iw_sulu_tailwind_theme.pageHero_breadcrumb|default('with_title') %}
    {% set heroParallax = iw_sulu_tailwind_theme.pageHero_parallax is defined ? iw_sulu_tailwind_theme.pageHero_parallax : false %}

    {# Site-wide breadcrumbs toggle for pages (Components config). #}
    {% set pageBreadcrumbsOn = (iw_sulu_tailwind_theme.breadcrumbs_enabled|default('both')) in ['both', 'pages'] %}

    {% if heroImageId %}
        {# "with_title" needs a visible header; fall back to a top bar otherwise. #}
        {% set effectiveBreadcrumb = (heroDisplay == 'hidden' and heroBreadcrumbMode == 'with_title')
            ? 'top_bar' : heroBreadcrumbMode %}

        {% if effectiveBreadcrumb == 'top_bar' and pageBreadcrumbsOn %}
            <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-6">
                {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                    context: 'page',
                    pageUuid: resource.uuid|default(null),
                } only %}
            </div>
        {% endif %}

        {% include '@ItechWorldSuluTailwindTheme/pages/common/_page_hero.html.twig' with {
            image: heroImageId,
            title: pageH1,
            subtitle: content.heroSubtitle|default(''),
            display: heroDisplay,
            alignX: iw_sulu_tailwind_theme.pageHero_alignX|default('left'),
            alignY: iw_sulu_tailwind_theme.pageHero_alignY|default('bottom'),
            shade: iw_sulu_tailwind_theme.pageHero_shade|default('medium'),
            height: iw_sulu_tailwind_theme.pageHero_height|default('md'),
            parallax: heroParallax,
            breadcrumb: (effectiveBreadcrumb == 'with_title') and pageBreadcrumbsOn,
            breadcrumbPageUuid: resource.uuid|default(null),
            breadcrumbCurrentTitle: content.title|default(''),
        } only %}
    {% else %}
        {# No banner image: keep the standard top breadcrumb, gated by the config. #}
        {% if pageBreadcrumbsOn %}
            <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-6">
                {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                    context: 'page',
                    pageUuid: resource.uuid|default(null),
                } only %}
            </div>
        {% endif %}

        {# Always emit the H1, using pageH1 rather than heroTitleText: a content
           page with neither a banner nor a heroTitle is the most common case of
           all, and it used to render no <h1> at all — a silent SEO and a11y
           hole on most of the site. When the site-wide config hides the hero
           title, keep the heading for crawlers and assistive tech only. #}
        {% if pageH1 is not empty %}
            {% if heroDisplay == 'hidden' %}
                <h1 class="iw-visually-hidden">{{ pageH1 }}</h1>
            {% else %}
                <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-6">
                    <h1 class="iw-page-title">{{ pageH1 }}</h1>
                </div>
            {% endif %}
        {% endif %}
    {% endif %}

    {% include '@ItechWorldSuluTailwindTheme/components/_blocks.html.twig' with {
        blocks: content.blocks|default([]),
    } %}
{% endblock %}
