{#
    Article listing page template.
    Renders a paginated list of articles using the active listing style
    from theme configuration (grid/list/cards).

    When the custom ArticleListingController is active, articles are filtered
    server-side from the query string (?category=&tag=&q=&sort=&page=) and exposed
    as `filteredArticles` + `articlePagination` + `articleFacets` + `activeFilters`
    + `articleFilterQuery`. A left filter sidebar (F3) lets visitors refine within
    the page's editorial scope. Pagination links preserve the active filters.
    Falls back to the native smart_content (`content.articles`) when the controller
    is not in use (e.g. preview).
#}
{% extends 'base.html.twig' %}

{% block content %}
    {# Site-wide breadcrumb (pages) — gated by the Components config #}
    {% if (iw_sulu_tailwind_theme.breadcrumbs_enabled|default('both')) in ['both', 'articles'] %}
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-6">
            {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                context: 'page',
                pageUuid: resource.uuid|default(null),
            } only %}
        </div>
    {% endif %}

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Page title #}
        {% if content.title is defined and content.title is not empty %}
            <h1 class="font-[var(--font-h1-family)] text-[var(--font-size-h1)] font-[var(--font-h1-weight)] leading-[var(--line-height-h1)] mb-8">
                {{ content.title }}
            </h1>
        {% endif %}

        {# Prefer the server-side filtered list; fall back to native smart_content. #}
        {% set isFiltered = filteredArticles is defined %}
        {% set listingArticles = isFiltered ? filteredArticles : (content.articles|default([])) %}

        {% if isFiltered %}
            {% set listingCurrentPage = articlePagination.page %}
            {% set listingTotalPages = articlePagination.totalPages %}
            {% set listingFilterQuery = articleFilterQuery|default({}) %}
        {% else %}
            {% set listingCurrentPage = view.articles.page|default(1) %}
            {% set listingTotalPages = view.articles.hasNextPage is defined and view.articles.hasNextPage ? view.articles.page + 1 : view.articles.page|default(1) %}
            {% set listingFilterQuery = {} %}
        {% endif %}

        {% set baseUrl = sulu_content_path(content.url) %}

        {% set activeFiltersData = activeFilters|default({}) %}
        {% set hasActiveFilters = (activeFiltersData.categories|default([])|length > 0)
            or (activeFiltersData.tags|default([])|length > 0)
            or (activeFiltersData.q|default('') is not empty) %}
        {# Number of active filter criteria (sort excluded) — shown on the mobile
           drawer toggle so a filtered state is visible while the drawer is closed. #}
        {% set activeFilterCount = (activeFiltersData.categories|default([])|length)
            + (activeFiltersData.tags|default([])|length)
            + (activeFiltersData.q|default('') is not empty ? 1 : 0) %}

        {# The results column: result count + active filters, then the active
           listing style + pagination, or a soigné empty state. #}
        {% set resultsColumn %}
            {% if isFiltered %}
                {% include '@ItechWorldSuluTailwindTheme/components/_article_active_filters.html.twig' with {
                    total: articlePagination.total|default(0),
                    active: activeFiltersData,
                    facets: articleFacets|default({}),
                    baseUrl: baseUrl,
                } only %}
            {% endif %}

            {% if listingArticles is iterable and listingArticles|length > 0 %}
                {% set listingStyle = iw_sulu_tailwind_theme_listing_style() %}
                {% set stylePath = '@ItechWorldSuluTailwindTheme/articles/listing/_style_' ~ listingStyle ~ '.html.twig' %}
                {% set fallbackPath = '@ItechWorldSuluTailwindTheme/articles/listing/_style_grid.html.twig' %}

                {% include [stylePath, fallbackPath] with {
                    articles: listingArticles,
                    currentPage: listingCurrentPage,
                    totalPages: listingTotalPages,
                    baseUrl: baseUrl,
                    filterQuery: listingFilterQuery,
                } only %}
            {% elseif isFiltered and hasActiveFilters %}
                {# Empty because the active filters match nothing — offer a way out. #}
                <div class="iw-article-listing__empty">
                    <p class="iw-article-listing__empty-text">
                        {{ 'iw_sulu_tailwind_theme.article.no_results_filtered'|trans }}
                    </p>
                    <a class="iw-article-listing__empty-action" href="{{ baseUrl }}">
                        {{ 'iw_sulu_tailwind_theme.article.filters_clear'|trans }}
                    </a>
                </div>
            {% else %}
                <p class="iw-article-listing__empty iw-article-listing__empty-text">
                    {{ 'iw_sulu_tailwind_theme.article.no_articles'|trans }}
                </p>
            {% endif %}
        {% endset %}

        {% if isFiltered %}
            {# Two-column layout: filter sidebar (left) + results (right).
               The article-filters controller turns the sidebar into a mobile
               offcanvas drawer (progressive enhancement) — without JS the sidebar
               stays in flow and the GET form keeps working. #}
            {% set sidebarStyle = iw_sulu_tailwind_theme.components_sidebarStyle|default('left') %}
            <div class="iw-article-layout iw-article-layout--{{ sidebarStyle }}" data-controller="article-filters"
                 data-article-filters-auto-submit-value="{{ iw_sulu_tailwind_theme.components_filtersAutoSubmit|default(false) ? 'true' : 'false' }}"
                 data-article-filters-offcanvas-value="{{ sidebarStyle == 'offcanvas' ? 'true' : 'false' }}">
                {# Anti-FOUC: arm the drawer synchronously before paint so the
                   in-flow sidebar never flashes before the (lazy) Stimulus
                   controller connects. Runs only with JS, so the no-JS fallback
                   (in-flow sidebar) is preserved. The controller re-syncs after. #}
                <script>(function(){var e=document.currentScript.parentElement;if('true'===e.getAttribute('data-article-filters-offcanvas-value')||window.matchMedia('(max-width: 767.98px)').matches){e.classList.add('iw-article-layout--drawer-armed');}})();</script>
                {# Mobile drawer toggle: hidden in markup, revealed by JS on small
                   screens only (the CSS media query gates its actual display).
                   When a theme button style is configured (Components > Filter
                   sidebar), iw-button--<style> owns the colors and --themed keeps
                   the count badge legible; empty = the neutral surface style. #}
                {% set toggleButtonStyle = iw_sulu_tailwind_theme.components_filtersToggleStyle|default('') %}
                <button type="button"
                        class="iw-article-filters__toggle{% if toggleButtonStyle is not empty %} iw-button--{{ toggleButtonStyle }} iw-article-filters__toggle--themed{% endif %}"
                        hidden
                        data-article-filters-target="toggle"
                        data-action="article-filters#open"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="iw-article-filters-panel">
                    <span class="iw-article-filters__toggle-label">{{ 'iw_sulu_tailwind_theme.article.filters_title'|trans }}</span>
                    {% if activeFilterCount > 0 %}
                        <span class="iw-article-filters__toggle-count" aria-hidden="true">{{ activeFilterCount }}</span>
                    {% endif %}
                </button>

                {# Backdrop behind the open drawer (hidden until JS enhances). #}
                <div class="iw-article-filters__backdrop"
                     hidden
                     data-article-filters-target="backdrop"
                     data-action="article-filters#close"></div>

                {% include '@ItechWorldSuluTailwindTheme/components/_article_filters.html.twig' with {
                    facets: articleFacets|default({}),
                    active: activeFilters|default({}),
                    baseUrl: baseUrl,
                    resultCount: articlePagination.total|default(0),
                } only %}
                <div class="iw-article-layout__results" data-article-filters-target="results">
                    {{ resultsColumn }}
                </div>
            </div>
        {% else %}
            {{ resultsColumn }}
        {% endif %}
    </div>
{% endblock %}
