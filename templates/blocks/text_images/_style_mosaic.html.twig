{# Text + Images block — mosaic layout with multiple images and lightbox #}
{# Does NOT extend _block_wrapper so we can enforce minimum padding defaults
   (padding always present even when explicitly set to 0). #}

{# ── Wrapper logic (replicated from _block_wrapper) ───────────────────────── #}
{% set allVariants = iw_sulu_tailwind_theme.blockVariants|default([]) %}
{% set variantSlug = iw_sulu_tailwind_theme_variant_slug(variant|default(null), allVariants) %}
{% set variantClass = variantSlug ? 'iw-variant--' ~ variantSlug : '' %}
{% set mtClass = marginTop|default('mt-0') %}
{% set mbClass = marginBottom|default('mb-0') %}

{# Padding values — section ALWAYS has padding.
   If a value is undefined, null, empty or explicitly 0 → force default (pt-3/pb-3/pl-3/pr-3). #}
{% set ptVal = paddingTop|default('') %}
{% set ptClass = (ptVal is empty or ptVal == 'pt-0') ? 'pt-3' : ptVal %}
{% set pbVal = paddingBottom|default('') %}
{% set pbClass = (pbVal is empty or pbVal == 'pb-0') ? 'pb-3' : pbVal %}
{% set pxVal = paddingLateral|default('') %}
{% if pxVal is not empty and pxVal != 'px-0' %}
    {% set plClass = pxVal|replace({'px-': 'pl-'}) %}
    {% set prClass = pxVal|replace({'px-': 'pr-'}) %}
{% else %}
    {% set plClass = 'pl-3' %}
    {% set prClass = 'pr-3' %}
{% endif %}

{% set lateralMode = lateralMargins|default('interior') %}
{% if lateralMode is same as(true) or lateralMode == '1' %}
    {% set lateralMode = 'exterior' %}
{% elseif lateralMode is same as(false) or lateralMode == '0' or lateralMode == '' %}
    {% set lateralMode = 'interior' %}
{% endif %}

{% set sectionContainerClass = (lateralMode == 'exterior') ? 'container mx-auto' : '' %}
{% set bgAttr = (showBackground ?? true) ? 'data-has-bg="true"' : '' %}

{# Block radius: only in exterior mode. #}
{% set blockRadiusClass = iw_sulu_tailwind_theme_radius_class('card', blockRadius|default('')) %}
{% set effectiveBlockRadius = iw_sulu_tailwind_theme_effective_radius('card', blockRadius|default('')) %}
{% set hasBlockRadius = effectiveBlockRadius is not empty and effectiveBlockRadius != 'rounded-none' %}
{% set radiusClass = (lateralMode == 'exterior' and hasBlockRadius) ? blockRadiusClass : '' %}

{% set paragraphRadiusClass = iw_sulu_tailwind_theme_radius_class('paragraph', paragraphRadius|default('')) %}
{% set imageRadiusClass = iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')) %}

{# Mosaic uses two different formats: 16:9 for the hero image, user-selected for the rest #}
{# Fix: XML stores values with underscores (16_9, 4_3…), not colons #}
{% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4', 'original': 'iw_theme_1_1'} %}
{% set baseFormat = formatMap[imageFilter|default('original')]|default('iw_theme_1_1') %}

{# ── Section ──────────────────────────────────────────────────────────────── #}
<section
    class="block iw-block-text-images iw-block-text-images--mosaic iw-block-text-images--lateral-mode-{{ lateralMode }} iw-block-text-images--position-{{ mosaicImagePosition|default('right') }} {{ variantClass }} {{ sectionContainerClass }} {{ mtClass }} {{ mbClass }} {{ ptClass }} {{ pbClass }} {{ plClass }} {{ prClass }} {{ radiusClass }} {% if radiusClass %}overflow-hidden{% endif %}"
    {{ bgAttr|raw }}
    data-controller="lightbox"
>
    {% if lateralMode == 'interior' %}
    <div class="container mx-auto">
    {% endif %}

        {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
            title: title|default(''),
            subTitle: subTitle|default(''),
            titleAlignment: titleAlignment|default('left'),
            titleTag: titleTag|default('h2'),
            variant: variant|default(0)
        } only %}

        {# Mosaic image position (top / bottom / left / right). Default = right.
           - left / right: text + mosaic side-by-side on lg+ (lg:grid-cols-3),
             order swap via lg:order utilities. Stacks vertically on mobile.
           - top / bottom: text + mosaic stacked vertically full-width,
             order swap via flex order utilities. #}
        {% set mosaicPos = mosaicImagePosition|default('right') %}
        {% set isSideBySide = mosaicPos in ['left', 'right'] %}
        {% set imageFirst = mosaicPos in ['left', 'top'] %}

        <div class="iw-block-text-images__grid {{ isSideBySide ? 'grid grid-cols-1 lg:grid-cols-3 gap-2 md:gap-5' : 'flex flex-col gap-2 md:gap-5' }}">
            {# Text area — full width when stacked, 1 column when side-by-side #}
            <div class="iw-block-text-images__content {{ isSideBySide ? 'lg:col-span-1' : '' }} {{ imageFirst ? 'order-2' : 'order-1' }} {{ isSideBySide ? (imageFirst ? 'lg:order-2' : 'lg:order-1') : '' }}">
                {% if text is defined and text is not empty %}
                    <div class="iw-block__text iw-block-text-images__text prose max-w-none {{ paragraphRadiusClass }}" style="margin-block: 0;">
                        {{ text|raw }}
                    </div>
                {% endif %}
            </div>

            {# Mosaic images — full width when stacked, 2 columns when side-by-side #}
            {% if images is defined and images is iterable %}
                <div class="iw-block-text-images__mosaic-grid {{ isSideBySide ? 'lg:col-span-2' : '' }} {{ imageFirst ? 'order-1' : 'order-2' }} {{ isSideBySide ? (imageFirst ? 'lg:order-1' : 'lg:order-2') : '' }} grid grid-cols-2 gap-2 md:gap-5">
                    {% for mediaId in images %}
                        {% set media = sulu_resolve_media(mediaId, app.request.locale) %}
                        {# First image spans full width in 16:9, others use selected format #}
                        {% set isHero = loop.first %}
                        {% set imgFormat = isHero ? 'iw_theme_16_9' : baseFormat %}
                        <figure class="iw-block__image {{ isHero ? 'col-span-2' : '' }} {{ imageRadiusClass }} overflow-hidden">
                            <a
                                href="{{ media.url }}"
                                class="glightbox"
                                data-title="{{ (showImagesName|default(false)) and media.title is defined ? media.title : '' }}"
                            >
                                {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                                    media: media,
                                    format: imgFormat,
                                    ratio: isHero ? '16/9' : '1/1',
                                    classes: 'cursor-pointer',
                                }) }}
                            </a>
                        </figure>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    {% if lateralMode == 'interior' %}
    </div>
    {% endif %}
</section>
