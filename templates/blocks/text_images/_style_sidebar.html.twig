{# Text + Images block — sticky sidebar with image, scrollable text area #}

{# The buttons belong under the text, not under the whole block. #}
{# ── Widget zone ──
   The media zone is one `widget` block, typed by the editor. Mapping it back
   to `images` and `image` keeps every rendering below untouched: what used to
   be two fields is now one, and only the reading changes. A style that can
   also show a video, a map or a text panel branches on `widgetKind` where it
   renders the zone. The others ignore the other types, which the field's info
   text warns about. #}
{% set widgetItem = widget is defined and widget is iterable ? (widget|first) : null %}
{% set widgetKind = widgetItem ? widgetItem.type|default('image') : 'image' %}
{% set rawWidgetImages = widgetKind == 'image' and widgetItem ? widgetItem.images|default([]) : [] %}
{# `media_selection` is stored as `{ids: [...]}` and resolved to a plain list at
   render time, but not in every context: the same guard is used for the excerpt
   images elsewhere in the bundle. #}
{% set images = rawWidgetImages.ids|default(rawWidgetImages) %}
{# `media_selection` yields raw ids, `single_media_selection` yielded an object.
   The layouts painting a background were written against the latter, so the
   first id is wrapped to keep `image.id` working. #}
{% set firstImageId = images|first|default(null) %}
{% set image = firstImageId ? {'id': firstImageId} : null %}
{% set showImagesName = widgetItem ? widgetItem.showImagesName|default(false) : false %}
{% set ctaBlockKey = _key|default(null) %}
{# Does NOT extend _block_wrapper so we can enforce minimum padding defaults
   (padding always present even when explicitly set to 0). #}

{# ── Wrapper logic (replicated from _block_wrapper) ───────────────────────── #}
{% set allVariants = iw_sulu_tailwind_theme.blockVariants|default([]) %}
{% set variantSlug = iw_sulu_tailwind_theme_variant_slug(variant|default(null), allVariants) %}
{% set variantClass = variantSlug ? 'iw-variant--' ~ variantSlug : '' %}
{% set mtClass = marginTop|default('mt-0') %}
{% set mbClass = marginBottom|default('mb-0') %}

{# Padding values — section ALWAYS has padding.
   If a value is undefined, null, empty or explicitly 0 → force default (pt-3/pb-3/pl-3/pr-3). #}
{% set ptVal = paddingTop|default('') %}
{% set ptClass = (ptVal is empty or ptVal == 'pt-0') ? 'pt-3' : ptVal %}
{% set pbVal = paddingBottom|default('') %}
{% set pbClass = (pbVal is empty or pbVal == 'pb-0') ? 'pb-3' : pbVal %}
{% set pxVal = paddingLateral|default('') %}
{% if pxVal is not empty and pxVal != 'px-0' %}
    {% set plClass = pxVal|replace({'px-': 'pl-'}) %}
    {% set prClass = pxVal|replace({'px-': 'pr-'}) %}
{% else %}
    {% set plClass = 'pl-3' %}
    {% set prClass = 'pr-3' %}
{% endif %}

{% set lateralMode = lateralMargins|default('interior') %}
{% if lateralMode is same as(true) or lateralMode == '1' %}
    {% set lateralMode = 'exterior' %}
{% elseif lateralMode is same as(false) or lateralMode == '0' or lateralMode == '' %}
    {% set lateralMode = 'interior' %}
{% endif %}

{% set sectionContainerClass = (lateralMode == 'exterior') ? 'container mx-auto' : '' %}

{# Maximum width of the block, mirroring `_block_wrapper`: exterior margins cap
   the background at the container, so the constraint goes on the <section> and
   the background shrinks with the content. The other modes paint the
   background edge to edge and only the inner container is capped. #}
{% set maxWidthClass = iw_sulu_tailwind_theme_max_width_class(maxWidth|default(''), type|default(''), style|default('')) %}
{% set sectionMaxWidthClass = (lateralMode == 'exterior') ? maxWidthClass : '' %}
{% set innerWrapperClass = ((lateralMode == 'interior') ? 'container mx-auto ' : '') ~ ((lateralMode == 'exterior') ? '' : maxWidthClass) %}
{% set bgAttr = (showBackground ?? true) ? 'data-has-bg="true"' : '' %}

{# Block radius: only in exterior mode. #}
{% set blockRadiusClass = iw_sulu_tailwind_theme_radius_class('card', blockRadius|default('')) %}
{% set effectiveBlockRadius = iw_sulu_tailwind_theme_effective_radius('card', blockRadius|default('')) %}
{% set hasBlockRadius = effectiveBlockRadius is not empty and effectiveBlockRadius != 'rounded-none' %}
{% set radiusClass = (lateralMode == 'exterior' and hasBlockRadius) ? blockRadiusClass : '' %}

{% set paragraphRadiusClass = iw_sulu_tailwind_theme_radius_class('paragraph', paragraphRadius|default('')) %}
{% set imageRadiusClass = iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')) %}

{# Fix: XML stores values with underscores (16_9, 4_3…), not colons #}
{% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4', 'original': 'iw_theme_3_4'} %}
{% set format = formatMap[imageFilter|default('original')]|default('iw_theme_3_4') %}
{# Content position: contentRight = true → text right, image left (default: text left, image right) #}
{% set isRight = contentRight|default(false) %}

{# Map image format to CSS aspect-ratio #}
{% set ratioMap = {'iw_theme_16_9': '16/9', 'iw_theme_4_3': '4/3', 'iw_theme_1_1': '1/1', 'iw_theme_3_4': '3/4', 'iw_theme_hero': '12/5'} %}
{% set ratio = ratioMap[format]|default('3/4') %}

{# ── Section ──────────────────────────────────────────────────────────────── #}
<section
    class="block iw-block-text-images iw-block-text-images--sidebar iw-block-text-images--lateral-mode-{{ lateralMode }} {{ variantClass }} {{ sectionContainerClass }} {{ sectionMaxWidthClass }} {{ mtClass }} {{ mbClass }} {{ ptClass }} {{ pbClass }} {{ plClass }} {{ prClass }} {{ radiusClass }}"
    {{ bgAttr|raw }}
    data-controller="lightbox"
>
    {% if innerWrapperClass|trim %}
    <div class="{{ innerWrapperClass|trim }}">
    {% endif %}

        {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
            title: title|default(''),
            subTitle: subTitle|default(''),
            titleAlignment: titleAlignment|default('left'),
            titleTag: titleTag|default('h2'),
            variant: variant|default(0)
        } only %}

        {% set splitClass = iw_sulu_tailwind_theme_media_ratio_class(mediaRatio|default(''), '2-5') %}
        {% set alignClass = iw_sulu_tailwind_theme_zones_align_class(zonesAlign|default(''), 'stretch') %}
        <div class="iw-block-text-images__grid iw-split-gap iw-split-cols {{ splitClass }}{{ alignClass ? " " ~ alignClass : "" }}{{ isRight ? ' iw-split-cols--reverse' : '' }}">
            {# Main text area — 3/5 = 60% #}
            <div class="iw-block-text-images__content{{ isRight ? ' md:order-2' : ' md:order-1' }}">
                {% if text is defined and text is not empty %}
                    <div class="iw-block__text iw-block-text-images__text prose max-w-none {{ paragraphRadiusClass }}" style="margin-block: 0;">
                        {{ text|raw }}
                    </div>
                {% endif %}

                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                    buttons: ctaButtons|default([]),
                    buttonsView: ctaBlockKey is not null ? view.blocks[ctaBlockKey].ctaButtons|default([]) : [],
                    alignment: ctaAlignment|default('title'),
                    direction: ctaDirection|default('row'),
                    titleAlignment: titleAlignment|default('left')
                } only %}

            </div>

            {# Sidebar images — 2/5 = 40%.
               Grid cell stretches to full row height; sticky child stays visible while text scrolls. #}
            <div class="iw-block-text-images__image-column{{ isRight ? ' md:order-1' : ' md:order-2' }} {{ iw_sulu_tailwind_theme_image_max_width_class(imageMaxWidth|default('')) }}">
                <div class="iw-block-text-images__image-wrap {{ imageRadiusClass }} overflow-hidden" style="position: sticky; top: 6rem;">
                    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_widget.html.twig' with {
                        widget: widget|default([]),
                        imageFormat: format,
                        aspectRatio: ratio,
                        imageRadius: imageRadiusClass|default(''),
                        blockPrefix: 'iw-block-text-images'
                    } only %}
                </div>
            </div>
        </div>

    {% if innerWrapperClass|trim %}
    </div>
    {% endif %}
</section>
