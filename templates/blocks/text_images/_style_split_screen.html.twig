{# Text + Images block — 50/50 split screen with full-height image slider #}

{# The buttons belong under the text, not under the whole block. #}
{# ── Widget zone ──
   The media zone is one `widget` block, typed by the editor. Mapping it back
   to `images` and `image` keeps every rendering below untouched: what used to
   be two fields is now one, and only the reading changes. A style that can
   also show a video, a map or a text panel branches on `widgetKind` where it
   renders the zone. The others ignore the other types, which the field's info
   text warns about. #}
{% set widgetItem = null %}
{% if widget is defined and widget is iterable %}
    {% set widgetItem = widget.type is defined ? widget : (widget|first) %}
{% endif %}
{% set widgetKind = widgetItem ? widgetItem.type|default('image') : 'image' %}
{% set rawWidgetImages = widgetKind == 'image' and widgetItem ? widgetItem.images|default([]) : [] %}
{# `media_selection` is stored as `{ids: [...]}` and resolved to a plain list at
   render time, but not in every context: the same guard is used for the excerpt
   images elsewhere in the bundle. #}
{% set images = rawWidgetImages.ids|default(rawWidgetImages) %}
{# `media_selection` yields raw ids, `single_media_selection` yielded an object.
   The layouts painting a background were written against the latter, so the
   first id is wrapped to keep `image.id` working. #}
{% set firstImageId = images|first|default(null) %}
{% set image = firstImageId ? {'id': firstImageId} : null %}
{% set showImagesName = widgetItem ? widgetItem.showImagesName|default(false) : false %}
{% set ctaBlockKey = _key|default(null) %}
{# Does NOT extend _block_wrapper because padding applies to content only,
   not the section, so the image always fills its half edge-to-edge. #}

{# ── Wrapper logic (replicated from _block_wrapper) ───────────────────────── #}
{% set allVariants = iw_sulu_tailwind_theme.blockVariants|default([]) %}
{% set variantSlug = iw_sulu_tailwind_theme_variant_slug(variant|default(null), allVariants) %}
{% set variantClass = variantSlug ? 'iw-variant--' ~ variantSlug : '' %}
{% set mtClass = marginTop|default('mt-0') %}
{% set mbClass = marginBottom|default('mb-0') %}

{% set lateralMode = lateralMargins|default('interior') %}
{% if lateralMode is same as(true) or lateralMode == '1' %}
    {% set lateralMode = 'exterior' %}
{% elseif lateralMode is same as(false) or lateralMode == '0' or lateralMode == '' %}
    {% set lateralMode = 'interior' %}
{% endif %}

{% set sectionContainerClass = (lateralMode == 'exterior') ? 'container mx-auto' : '' %}
{% set bgAttr = (showBackground ?? true) ? 'data-has-bg="true"' : '' %}

{# Block radius: only in exterior mode.
   Applied from sm: breakpoint only (edge-to-edge on mobile). #}
{% set blockRadiusClass = iw_sulu_tailwind_theme_radius_class('card', blockRadius|default('')) %}
{% set effectiveBlockRadius = iw_sulu_tailwind_theme_effective_radius('card', blockRadius|default('')) %}
{% set hasBlockRadius = effectiveBlockRadius is not empty and effectiveBlockRadius != 'rounded-none' %}
{% set radiusClasses = (lateralMode == 'exterior' and hasBlockRadius) ? ('sm:' ~ blockRadiusClass ~ ' sm:overflow-hidden') : '' %}

{% set paragraphRadiusClass = iw_sulu_tailwind_theme_radius_class('paragraph', paragraphRadius|default('')) %}

{# Fix: XML stores values with underscores (16_9, 4_3…), not colons #}
{% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4', 'original': 'iw_theme_16_9'} %}
{% set format = formatMap[imageFilter|default('original')]|default('iw_theme_16_9') %}

{# Content position: contentRight = true → text right, image left (default: text left, image right) #}
{% set isRight = contentRight|default(false) %}

{# Mobile image position: drives the DOM stacking order on `<lg` so the
   editor can choose whether the image sits above or below the text on
   mobile, independently from the desktop left/right placement. #}
{% set mobilePos = mobileImagePosition|default('top') %}
{% set imageMobileOrder = mobilePos == 'top' ? 'order-1' : 'order-2' %}
{% set contentMobileOrder = mobilePos == 'top' ? 'order-2' : 'order-1' %}

{# ── Padding for content area only ────────────────────────────────────────── #}
{# Content must ALWAYS have padding so text never touches the edges.
   If a value is undefined, null, empty or explicitly 0 → force default. #}
{% set ptVal = paddingTop|default('') %}
{% set ptClass = (ptVal is empty or ptVal == 'pt-0') ? 'pt-3' : ptVal %}
{% set pbVal = paddingBottom|default('') %}
{% set pbClass = (pbVal is empty or pbVal == 'pb-0') ? 'pb-3' : pbVal %}
{% set pxVal = paddingLateral|default('') %}
{% if pxVal is not empty and pxVal != 'px-0' %}
    {% set plClass = pxVal|replace({'px-': 'pl-'}) %}
    {% set prClass = pxVal|replace({'px-': 'pr-'}) %}
{% else %}
    {% set plClass = 'pl-3' %}
    {% set prClass = 'pr-3' %}
{% endif %}

{# ── Resolve images for slider ────────────────────────────────────────────── #}
{% set resolvedImages = [] %}
{% if images is defined and images is iterable %}
    {% for mediaId in images %}
        {% set resolvedMedia = sulu_resolve_media(mediaId, app.request.locale) %}
        {# A media deleted from the library resolves to null: keep it out of the
           list, which drives the slide count, the dots and the lightbox. #}
        {% if resolvedMedia is not null %}
            {% set resolvedImages = resolvedImages|merge([resolvedMedia]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# ── Section: no padding, image fills its half edge-to-edge ───────────────── #}
<section
    class="block iw-block-text-images iw-block-text-images--split-screen iw-block-text-images--lateral-mode-{{ lateralMode }} {{ variantClass }} {{ sectionContainerClass }} {{ mtClass }} {{ mbClass }} {{ radiusClasses }} overflow-hidden"
    {{ bgAttr|raw }}
    data-controller="lightbox"
>
    {% set splitClass = iw_sulu_tailwind_theme_media_ratio_class(mediaRatio|default(''), '1-2') %}
    {% set alignClass = iw_sulu_tailwind_theme_zones_align_class(zonesAlign|default(''), 'center') %}
    <div class="iw-block-text-images__grid iw-split-gap iw-split-cols iw-split-cols--from-lg {{ splitClass }}{{ alignClass ? " " ~ alignClass : "" }}{{ not isRight ? ' iw-split-cols--reverse' : '' }}">
        {# Image side — full-height cover with slider support.
           Custom rendering (not _image_slider partial) because images must fill
           the full grid cell height with no aspect-ratio constraint. #}
        <div class="iw-block-text-images__image-side {{ imageMobileOrder }} {{ isRight ? 'lg:order-2' : 'lg:order-1' }} relative min-h-[300px] lg:min-h-[400px]"
            {% if resolvedImages|length > 1 %}
                data-controller="slider"
                data-slider-mode-value="carousel"
                data-slider-autoplay-value="true"
                data-slider-interval-value="5000"
            {% endif %}
        >
            {# The cover rendering below only makes sense for an image: it stretches
           the media to the full height of the zone. The other widget kinds keep
           their natural rendering, which is what the shared partial gives. #}
        {% if widgetKind != 'image' %}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_widget.html.twig' with {
                widget: widget|default([]),
                imageFormat: format|default('iw_theme_16_9'),
                aspectRatio: '16/9',
                imageRadius: imageRadiusClass|default(''),
                blockPrefix: 'iw-block-text-images'
            } only %}
        {% elseif resolvedImages|length == 1 %}
                {% set media = resolvedImages[0] %}
                <a
                    href="{{ media.url }}"
                    class="glightbox absolute inset-0 block w-full h-full"
                    data-title="{{ (showImagesName|default(false)) and media.title is defined ? media.title : '' }}"
                >
                    {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                        media: media,
                        format: format,
                        cover: true,
                        classes: 'cursor-pointer',
                        pictureClasses: 'absolute inset-0 w-full h-full',
                    }) }}
                </a>

            {% elseif resolvedImages|length > 1 %}
                {# Slides #}
                {% for media in resolvedImages %}
                    <div
                        data-slider-target="slide"
                        class="absolute inset-0 w-full h-full {{ loop.first ? '' : 'hidden' }}"
                    >
                        <a
                            href="{{ media.url }}"
                            class="glightbox block w-full h-full"
                            data-title="{{ (showImagesName|default(false)) and media.title is defined ? media.title : '' }}"
                        >
                            {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                                media: media,
                                format: format,
                                cover: true,
                                classes: 'cursor-pointer',
                                pictureClasses: 'absolute inset-0 w-full h-full',
                            }) }}
                        </a>
                    </div>
                {% endfor %}

                {# Navigation arrows #}
                <button
                    type="button"
                    class="absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-black/40 hover:bg-black/60 text-white rounded-full w-9 h-9 flex items-center justify-center transition-colors"
                    data-action="slider#prev"
                    aria-label="Previous"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                    </svg>
                </button>
                <button
                    type="button"
                    class="absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-black/40 hover:bg-black/60 text-white rounded-full w-9 h-9 flex items-center justify-center transition-colors"
                    data-action="slider#next"
                    aria-label="Next"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                </button>

                {# Dot indicators #}
                <div data-slider-target="dots" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/30 backdrop-blur-sm z-20">
                    {% for media in resolvedImages %}
                        <button
                            type="button"
                            class="w-2.5 h-2.5 rounded-full transition-colors {{ loop.first ? 'bg-white' : 'bg-white/50' }}"
                            data-action="slider#goTo"
                            data-slider-index-param="{{ loop.index0 }}"
                            aria-label="Slide {{ loop.index }}"
                        ></button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# Text side — vertically centered with padding, max-w to keep lines
           readable on wide screens. A block max width replaces that default:
           the column is then centered inside its half rather than pushed
           against the image, `.iw-block-maxw` owning both margins. #}
        {% set maxWidthClass = iw_sulu_tailwind_theme_max_width_class(maxWidth|default(''), type|default(''), style|default('')) %}
        <div class="iw-block-text-images__content {{ contentMobileOrder }} {{ isRight ? 'lg:order-1' : 'lg:order-2' }} flex items-center {{ ptClass }} {{ pbClass }} {{ plClass }} {{ prClass }}">
            <div class="w-full max-w-2xl{{ isRight ? ' ml-auto' : '' }} {{ maxWidthClass }}">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
                    title: title|default(''),
                    subTitle: subTitle|default(''),
                    titleAlignment: titleAlignment|default('left'),
                    titleTag: titleTag|default('h2'),
                    variant: variant|default(0)
                } only %}

                {% if text is defined and text is not empty %}
                    <div class="iw-block__text iw-block-text-images__text prose max-w-none {{ paragraphRadiusClass }}" style="margin-block: 0;">
                        {{ text|raw }}
                    </div>
                {% endif %}

                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                    buttons: ctaButtons|default([]),
                    buttonsView: ctaBlockKey is not null ? view.blocks[ctaBlockKey].ctaButtons|default([]) : [],
                    alignment: ctaAlignment|default('title'),
                    direction: ctaDirection|default('row'),
                    titleAlignment: titleAlignment|default('left')
                } only %}

            </div>
        </div>
    </div>
</section>
