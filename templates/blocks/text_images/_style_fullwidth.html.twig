{# Text + Images block — full-width image with text content #}

{# The buttons belong under the text, not under the whole block. #}
{% set ctaBlockKey = _key|default(null) %}
{# Custom section: image always edge-to-edge, padding applies to content only. #}
{# Does NOT extend _block_wrapper because padding must not affect the image, #}
{# so the image always fills the full block width (top/left/right or bottom/left/right). #}

{# ── Wrapper logic (replicated from _block_wrapper) ───────────────────────── #}
{% set allVariants = iw_sulu_tailwind_theme.blockVariants|default([]) %}
{% set variantSlug = iw_sulu_tailwind_theme_variant_slug(variant|default(null), allVariants) %}
{% set variantClass = variantSlug ? 'iw-variant--' ~ variantSlug : '' %}
{% set mtClass = marginTop|default('mt-0') %}
{% set mbClass = marginBottom|default('mb-0') %}

{% set lateralMode = lateralMargins|default('interior') %}
{% if lateralMode is same as(true) or lateralMode == '1' %}
    {% set lateralMode = 'exterior' %}
{% elseif lateralMode is same as(false) or lateralMode == '0' or lateralMode == '' %}
    {% set lateralMode = 'interior' %}
{% endif %}

{% set sectionContainerClass = (lateralMode == 'exterior') ? 'container mx-auto' : '' %}

{# Maximum width of the block, mirroring `_block_wrapper`: exterior margins cap
   the background at the container, so the constraint goes on the <section> and
   the background shrinks with the content. The other modes paint the
   background edge to edge and only the inner container is capped. #}
{% set maxWidthClass = iw_sulu_tailwind_theme_max_width_class(maxWidth|default(''), type|default(''), style|default('')) %}
{% set sectionMaxWidthClass = (lateralMode == 'exterior') ? maxWidthClass : '' %}
{% set innerWrapperClass = ((lateralMode == 'interior') ? 'container mx-auto ' : '') ~ ((lateralMode == 'exterior') ? '' : maxWidthClass) %}
{% set bgAttr = (showBackground ?? true) ? 'data-has-bg="true"' : '' %}

{# Block radius: only in exterior mode (interior = image fills full width, no radius).
   Applied from sm: breakpoint only (edge-to-edge on mobile). #}
{% set blockRadiusClass = iw_sulu_tailwind_theme_radius_class('card', blockRadius|default('')) %}
{% set effectiveBlockRadius = iw_sulu_tailwind_theme_effective_radius('card', blockRadius|default('')) %}
{% set hasBlockRadius = effectiveBlockRadius is not empty and effectiveBlockRadius != 'rounded-none' %}
{% set radiusClasses = (lateralMode == 'exterior' and hasBlockRadius) ? ('sm:' ~ blockRadiusClass ~ ' sm:overflow-hidden') : '' %}

{# Fix: XML stores values with underscores (16_9, 4_3…), not colons #}
{% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4', 'original': 'iw_theme_16_9'} %}
{% set format = formatMap[imageFilter|default('original')]|default('iw_theme_16_9') %}

{# Map image format to CSS aspect-ratio #}
{% set ratioMap = {'iw_theme_16_9': '16/9', 'iw_theme_4_3': '4/3', 'iw_theme_1_1': '1/1', 'iw_theme_3_4': '3/4', 'iw_theme_hero': '12/5'} %}
{% set ratio = ratioMap[format]|default('16/9') %}

{# Split radius contexts — empty value means "follow the theme" via iw-radius--* utilities #}
{% set paragraphRadiusClass = iw_sulu_tailwind_theme_radius_class('paragraph', paragraphRadius|default('')) %}
{% set imageRadiusClass = iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')) %}

{# Image position: top (default) or bottom #}
{% set isBottom = imageBottom|default(false) %}

{# ── Padding & paragraph margin logic (same as classic TOP) ───────────────── #}
{% set hasTopPad = paddingTop is defined and paddingTop is not empty and paddingTop != 'pt-0' %}
{% set hasBotPad = paddingBottom is defined and paddingBottom is not empty and paddingBottom != 'pb-0' %}
{% set hasLatPad = paddingLateral is defined and paddingLateral is not empty and paddingLateral != 'px-0' %}

{# Vertical padding for content area. The side facing the image is separated
   by the shared block gap (`.iw-split-gap` on the section), so an explicit 0
   is honoured there; the side facing the block edge keeps its minimum so the
   text never touches it. Both add up to the gap when set. #}
{% set ptClass = hasTopPad ? paddingTop : (isBottom ? 'pt-3' : 'pt-0') %}
{% set pbClass = hasBotPad ? paddingBottom : (isBottom ? 'pb-0' : 'pb-3') %}

{# Lateral padding for content area #}
{% if hasLatPad %}
    {% set plClass = paddingLateral|replace({'px-': 'pl-'}) %}
    {% set prClass = paddingLateral|replace({'px-': 'pr-'}) %}
{% else %}
    {% set plClass = '' %}
    {% set prClass = '' %}
{% endif %}

{# Paragraph lateral margin: ALWAYS present when no lateral padding,
   value matches pb or pt so it aligns with the image. Fallback to 4. #}
{% set paraMargin = '' %}
{% if not hasLatPad %}
    {% if hasBotPad %}
        {% set paraMargin = 'mx-' ~ (paddingBottom|split('-')|last) %}
    {% elseif hasTopPad %}
        {% set paraMargin = 'mx-' ~ (paddingTop|split('-')|last) %}
    {% else %}
        {% set paraMargin = 'mx-4' %}
    {% endif %}
{% endif %}

{# Image wrap: by default the fullwidth image is edge-to-edge. It gets a
   margin (lateral + matching top/bottom according to imageBottom) in two cases:
     - a real image radius is in effect (anything other than `rounded-none`
       — otherwise the rounded corners wouldn't be visible against the
       section edges); the theme borders config is resolved when the block
       leaves the field empty;
     - the admin enabled the `imagePadding` toggle manually.
   When both conditions are off, the wrap is skipped and the image stays
   edge-to-edge. Lateral margin reuses paddingLateral (fallback mx-4),
   vertical margin reuses paddingTop / paddingBottom (fallback mt-4 / mb-4). #}
{% set effectiveImageRadius = iw_sulu_tailwind_theme_effective_radius('image', imageRadius|default('')) %}
{% set hasRealRadius = effectiveImageRadius is not empty and effectiveImageRadius != 'rounded-none' %}
{% set hasImagePadding = imagePadding|default(false) %}
{% set applyImageWrap = hasRealRadius or hasImagePadding %}
{% if applyImageWrap %}
    {% set imgMarginX = hasLatPad ? paddingLateral|replace({'px-': 'mx-'}) : 'mx-4' %}
    {% if isBottom %}
        {% set imgMarginV = hasBotPad ? paddingBottom|replace({'pb-': 'mb-'}) : 'mb-4' %}
    {% else %}
        {% set imgMarginV = hasTopPad ? paddingTop|replace({'pt-': 'mt-'}) : 'mt-4' %}
    {% endif %}
    {% set imageWrapClass = imgMarginX ~ ' ' ~ imgMarginV ~ (hasRealRadius ? ' ' ~ imageRadiusClass ~ ' overflow-hidden' : '') %}
{% else %}
    {% set imageWrapClass = '' %}
{% endif %}

{# ── Section: no padding, image fills edge-to-edge ────────────────────────── #}
{# Image NEVER has its own radius — it follows the section edges.
   In exterior mode the section's overflow-hidden + blockRadius handle rounding. #}
<section
    class="block iw-block-text-images iw-block-text-images--fullwidth iw-block-text-images--lateral-mode-{{ lateralMode }} iw-block-text-images--position-{{ isBottom ? 'bottom' : 'top' }} iw-split-gap flex flex-col {{ variantClass }} {{ sectionContainerClass }} {{ sectionMaxWidthClass }} {{ mtClass }} {{ mbClass }} {{ radiusClasses }} overflow-hidden"
    {{ bgAttr|raw }}
    data-controller="lightbox"
>
    {% if not isBottom %}
        {# Image first — edge-to-edge by default, framed with margin + radius
           when a real image radius is in effect. #}
        {% if imageWrapClass %}<div class="iw-block-text-images__image-wrap {{ imageWrapClass }}">{% endif %}
        {% include '@ItechWorldSuluTailwindTheme/blocks/common/_image_slider.html.twig' with {
            images: images|default([]),
            imageFormat: format,
            showName: showImagesName|default(false),
            autoplay: true,
            aspectRatio: ratio
        } only %}
        {% if imageWrapClass %}</div>{% endif %}
    {% endif %}

    {# Content: titles + paragraph with padding #}
    <div class="iw-block-text-images__content {{ ptClass }} {{ pbClass }} {{ plClass }} {{ prClass }}">
        {% if innerWrapperClass|trim %}
        <div class="{{ innerWrapperClass|trim }}">
        {% endif %}

            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
                title: title|default(''),
                subTitle: subTitle|default(''),
                titleAlignment: titleAlignment|default('left'),
                titleTag: titleTag|default('h2'),
                variant: variant|default(0)
            } only %}

            {# Paragraph: lateral margin when no paddingLateral (reset at sm in interior mode) #}
            {% if paraMargin %}
                <div class="{{ paraMargin }}{% if lateralMode == 'interior' %} sm:mx-0{% endif %}">
                    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_paragraph.html.twig' with {
                        text: text|default(''),
                        paragraphRadius: paragraphRadiusClass
                    } only %}
                </div>
            {% else %}
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_paragraph.html.twig' with {
                    text: text|default(''),
                    paragraphRadius: paragraphRadiusClass
                } only %}
            {% endif %}

            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                buttons: ctaButtons|default([]),
                buttonsView: ctaBlockKey is not null ? view.blocks[ctaBlockKey].ctaButtons|default([]) : [],
                alignment: ctaAlignment|default('title'),
                direction: ctaDirection|default('row'),
                titleAlignment: titleAlignment|default('left')
            } only %}

        {% if innerWrapperClass|trim %}
        </div>
        {% endif %}
    </div>

    {% if isBottom %}
        {# Image last — edge-to-edge by default, framed with margin + radius
           when a real image radius is in effect. #}
        {% if imageWrapClass %}<div class="iw-block-text-images__image-wrap {{ imageWrapClass }}">{% endif %}
        {% include '@ItechWorldSuluTailwindTheme/blocks/common/_image_slider.html.twig' with {
            images: images|default([]),
            imageFormat: format,
            showName: showImagesName|default(false),
            autoplay: true,
            aspectRatio: ratio
        } only %}
        {% if imageWrapClass %}</div>{% endif %}
    {% endif %}
</section>
