{# Text block — decorative quote / pull-quote layout #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    <div class="iw-block-text iw-block-text--quote">
        {# The heading goes through the shared group like every other block, so
           the separator, the variant's separator mode and the theme title gap
           reach this style too - it used to render the title on its own and was
           the last block left without a rule under it.

           The subtitle stays out of it: here it is the attribution of the quote
           below, not a tagline, and the <footer> is where it belongs. #}
        {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
            title: title|default(''),
            subTitle: '',
            titleAlignment: titleAlignment|default('left'),
            titleTag: titleTag|default('h2'),
            variant: variant|default(0)
        } only %}

        {% if text is defined and text is not empty %}
            <blockquote class="iw-block-text__quote">
                <div class="iw-block-text__quote-body iw-block__text prose max-w-none text-xl md:text-2xl italic leading-relaxed {{ resolvedParagraphRadius|default('') }}">
                    {{ text|raw }}
                </div>
                {% if subTitle is defined and subTitle is not empty %}
                    <footer class="iw-block-text__quote-footer">
                        - {{ iw_sulu_tailwind_theme_title_markup(subTitle) }}
                    </footer>
                {% endif %}
            </blockquote>
        {% endif %}
    </div>
{% endblock %}
