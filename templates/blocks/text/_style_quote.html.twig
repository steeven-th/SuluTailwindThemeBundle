{# Text block — decorative quote / pull-quote layout #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% set alignMap = {'left': 'text-left', 'center': 'text-center', 'right': 'text-right'} %}
    {% set titleAlignClass = alignMap[titleAlignment|default('left')]|default('text-left') %}
    {% set titleTag = iw_sulu_tailwind_theme_heading_tag(titleTag|default('h2')) %}

    <div class="iw-block-text iw-block-text--quote">
        {% if title is defined and title is not empty %}
            <{{ titleTag }} class="iw-block__title text-2xl md:text-3xl font-[var(--font-h2-weight)] mb-6 {{ titleAlignClass }}">{{ iw_sulu_tailwind_theme_title_markup(title, false) }}</{{ titleTag }}>
        {% endif %}

        {% if text is defined and text is not empty %}
            <blockquote class="iw-block-text__quote">
                <div class="iw-block-text__quote-body iw-block__text prose max-w-none text-xl md:text-2xl italic leading-relaxed {{ resolvedParagraphRadius|default('') }}">
                    {{ text|raw }}
                </div>
                {% if subTitle is defined and subTitle is not empty %}
                    <footer class="iw-block-text__quote-footer">
                        — {{ iw_sulu_tailwind_theme_title_markup(subTitle, false) }}
                    </footer>
                {% endif %}
            </blockquote>
        {% endif %}
    </div>
{% endblock %}
