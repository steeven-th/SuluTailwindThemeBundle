{# Key figures block - a grid of framed figures.

   The file keeps its `grid_2x2` name, which is the key stored on every block
   already published and in the block styles of every theme in the database.
   The layout itself is no longer two columns: how many there are is a setting,
   because three figures in a two-column grid left one of them alone on a row.

   A figure is an enclosed unit here, so it is framed like every other card of
   the bundle - by the paragraph surface of the variant, not by a rule of its
   own. #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
{#- The figures take the variant's highlight colour unless the editor turns it
    off. `?? true` keeps the default for content published before the setting
    existed, where `|default(true)` would read an explicit false as empty and
    put the highlight back. -#}
{% set highlightClass = (highlightNumbers ?? true) ? ' iw-block-key-figures--highlight' : '' %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}

    {% if text is defined and text is not empty %}
        <div class="iw-block__text iw-block-key-figures__text prose max-w-none">
            {{ text|raw }}
        </div>
    {% endif %}

    {% if figures is defined and figures is iterable %}
        {#- `auto` gives every figure a column of its own, up to four. Past that
            the row would be too narrow to read, and the extras wrap. An
            explicit count wins over it, which is what the setting is for. -#}
        {% set columns = figureColumns|default('2') %}
        {% if columns not in ['2', '3', '4'] %}
            {% set columns = figures|length > 4 ? 4 : (figures|length ?: 1) %}
        {% endif %}
        {#- Two columns keep the reading width they always had. More of them
            need the whole block, or the cards come out too cramped to hold a
            counter. -#}
        {% set widthClass = columns > 2 ? ' iw-block-key-figures--grid-wide' : '' %}

        <div data-controller="key-figures" class="iw-block-key-figures iw-block-key-figures--grid-2x2 iw-block-key-figures--cols-{{ columns }}{{ widthClass }}{{ highlightClass }}">
            {% for figure in figures %}
                <div class="iw-key-figure iw-key-figure--card {{ iw_sulu_tailwind_theme_radius_class('card', cardRadius|default('')) }}">
                    {# Icon / Image #}
                    {% set figureIcon %}
                        {%- include '@ItechWorldSuluTailwindTheme/blocks/common/_icon.html.twig' with {
                            item: figure,
                            class: 'iw-key-figure__icon-img'
                        } only -%}
                    {% endset %}
                    {% if figureIcon|trim is not empty %}
                        <div class="iw-key-figure__icon">{{ figureIcon }}</div>
                    {% endif %}

                    {% if figure.number is defined and figure.number is not empty %}
                        <span
                            data-key-figures-target="counter"
                            data-key-figures-end-value="{{ figure.number }}"
                            class="iw-key-figure__counter"
                        >
                            0
                        </span>
                    {% endif %}
                    {% if figure.title is defined and figure.title is not empty %}
                        <span class="iw-key-figure__title iw-block__title">{{ figure.title }}</span>
                    {% endif %}
                    {% if figure.subTitle is defined and figure.subTitle is not empty %}
                        <span class="iw-key-figure__subtitle iw-block__subtitle">{{ figure.subTitle }}</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
