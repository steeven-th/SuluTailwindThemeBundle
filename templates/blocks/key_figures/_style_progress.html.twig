{# Key figures block — horizontal progress bars #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% if figures is defined and figures is iterable %}
        <div data-controller="key-figures" class="iw-block-key-figures iw-block-key-figures--progress">
            {% for item in figures %}
                {% if item.type|default('figure') == 'figure' %}
                    {% set percentage = item.number|default('0')|replace({',': '', '%': ''})|number_format(0) %}
                    <div class="iw-key-figure iw-key-figure--progress">
                        <div class="iw-key-figure__progress-header">
                            <span class="iw-key-figure__progress-label">{{ item.title|default('') }}</span>
                            <span class="iw-key-figure__progress-value" data-key-figures-target="counter" data-key-figures-end-value="{{ percentage }}%">0%</span>
                        </div>
                        <div class="iw-key-figure__progress-track">
                            <div
                                data-key-figures-target="progressBar"
                                data-value="{{ percentage }}"
                                class="iw-key-figure__progress-bar"
                            ></div>
                        </div>
                        {% if item.subTitle is defined and item.subTitle is not empty %}
                            <p class="iw-key-figure__subtitle iw-block__subtitle">{{ item.subTitle }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
