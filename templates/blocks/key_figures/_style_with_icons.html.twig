{# Key figures block — figures with large icons (1..4 columns on desktop) #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% if figures is defined and figures is iterable %}
        {% set colsLg = figures|length > 4 ? 4 : figures|length %}
        <div
            data-controller="key-figures"
            class="iw-block-key-figures iw-block-key-figures--with-icons iw-block-key-figures--cols-{{ colsLg }}"
        >
            {% for figure in figures %}
                <div class="iw-key-figure iw-key-figure--with-icon">
                    {# Icon / Image #}
                    {% if figure.image is defined and figure.image.id is defined %}
                        {% set media = sulu_resolve_media(figure.image.id, app.request.locale) %}
                        <div class="iw-key-figure__icon iw-key-figure__icon--lg">
                            {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                                media: media,
                                format: 'iw_theme_1_1',
                                classes: 'iw-key-figure__icon-img',
                            }) }}
                        </div>
                    {% endif %}

                    {% if figure.number is defined and figure.number is not empty %}
                        <span
                            data-key-figures-target="counter"
                            data-key-figures-end-value="{{ figure.number }}"
                            class="iw-key-figure__counter iw-key-figure__counter--lg"
                        >
                            0
                        </span>
                    {% endif %}
                    {% if figure.title is defined and figure.title is not empty %}
                        <span class="iw-key-figure__title iw-block__title">{{ figure.title }}</span>
                    {% endif %}
                    {% if figure.subTitle is defined and figure.subTitle is not empty %}
                        <span class="iw-key-figure__subtitle iw-block__subtitle">{{ figure.subTitle }}</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
