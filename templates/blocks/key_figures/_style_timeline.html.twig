{# Key figures block — vertical timeline layout #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}

    {% if text is defined and text is not empty %}
        <div class="iw-block__text iw-block-key-figures__text prose max-w-none">
            {{ text|raw }}
        </div>
    {% endif %}

    {% if figures is defined and figures is iterable %}
        <div data-controller="key-figures" class="iw-block-key-figures iw-block-key-figures--timeline">
            {# Vertical timeline line — left on mobile, centered on desktop #}
            <div class="iw-block-key-figures__timeline-line"></div>

            <div class="iw-block-key-figures__timeline-items">
                {% for item in figures %}
                    {% if item.type|default('figure') == 'figure' %}
                        <div class="iw-key-figure iw-key-figure--timeline">
                            <div class="iw-key-figure__timeline-dot"></div>
                            <div class="iw-key-figure__timeline-card {{ iw_sulu_tailwind_theme_radius_class('card', cardRadius|default('')) }}">
                                {% if item.number is defined and item.number is not empty %}
                                    <span
                                        data-key-figures-target="counter"
                                        data-key-figures-end-value="{{ item.number }}"
                                        class="iw-key-figure__counter iw-key-figure__counter--md"
                                    >
                                        {{ item.number }}
                                    </span>
                                {% endif %}
                                {% if item.title is defined and item.title is not empty %}
                                    <span class="iw-key-figure__title iw-block__title">{{ item.title }}</span>
                                {% endif %}
                                {% if item.subTitle is defined and item.subTitle is not empty %}
                                    <p class="iw-key-figure__subtitle iw-block__subtitle">{{ item.subTitle }}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
