{# Location block — map with address info sidebar #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        variant: variant|default(0)
    } only %}

    {% if location is defined and location.lat is defined and location.long is defined %}
        {% set zoom = location.zoom|default(15) %}
        {% set formattedAddress = iw_sulu_tailwind_theme_location_address(location) %}

        <div class="iw-block-location iw-block-location--map-with-info grid grid-cols-1 lg:grid-cols-3 gap-8">
            {# Map — 2 columns #}
            <div class="lg:col-span-2">
                <div class="iw-block-location__map-wrap {{ paragraphImageRadius|default('') }} overflow-hidden h-full min-h-[300px]">
                    {% include '@ItechWorldSuluTailwindTheme/components/_location_map.html.twig' with {
                        location: location,
                        title: title|default(''),
                        address: formattedAddress,
                        mapClass: 'iw-block-location__map w-full h-full min-h-[300px]'
                    } only %}
                </div>
            </div>

            {# Info sidebar — 1 column #}
            <div class="iw-block-location__info lg:col-span-1 space-y-6">
                {% if formattedAddress is not empty %}
                    <div class="iw-block-location__address {{ paragraphImageRadius|default('') }} p-5">
                        <span class="iw-block-location__address-label block font-semibold mb-2 flex items-center gap-2 text-[var(--iw-variant-title-color,inherit)]">
                            <svg class="iw-block-location__address-icon w-5 h-5 text-[var(--iw-variant-link-color,var(--color-primary))]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            {{ 'iw_sulu_tailwind_theme.address'|trans|default('Address') }}
                        </span>
                        <p class="iw-block-location__address-text whitespace-pre-line text-[var(--iw-variant-paragraph-color,inherit)]">{{ formattedAddress }}</p>
                    </div>
                {% endif %}

                {% if text is defined and text is not empty %}
                    <div class="iw-block__text iw-block-location__text prose max-w-none text-[var(--iw-variant-paragraph-color,inherit)] {{ paragraphImageRadius|default('') }} overflow-hidden">
                        {{ text|raw }}
                    </div>
                {% endif %}

                {# Link to open in external maps app #}
                <a
                    href="https://www.openstreetmap.org/?mlat={{ location.lat }}&mlon={{ location.long }}#map={{ zoom }}/{{ location.lat }}/{{ location.long }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="iw-button--variant iw-block-location__action inline-block px-6 py-3 text-center no-underline"
                >
                    {{ 'iw_sulu_tailwind_theme.open_map'|trans|default('Open in maps') }} &#8599;
                </a>
            </div>
        </div>
    {% endif %}
{% endblock %}
