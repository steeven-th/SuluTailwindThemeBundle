{# Location block — interactive map only #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        variant: variant|default(0)
    } only %}

    {% if location is defined and location.lat is defined and location.long is defined %}
        <div class="iw-block-location iw-block-location--map-only">
            <div class="iw-block-location__map-wrap {{ paragraphImageRadius|default('') }} overflow-hidden">
                {% include '@ItechWorldSuluTailwindTheme/components/_location_map.html.twig' with {
                    location: location,
                    title: title|default(''),
                    address: iw_sulu_tailwind_theme_location_address(location),
                    mapClass: 'iw-block-location__map w-full h-[400px] md:h-[500px]'
                } only %}
            </div>
        </div>
    {% endif %}
{% endblock %}
