{# Location block — map with collapsible floating info card #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{# The buttons belong under the text, not under the whole block. #}
{% set ctaInline = true %}
{% set ctaBlockKey = _key|default(null) %}

{% block block_content %}
    {% if location is defined and location.lat is defined and location.long is defined %}
        {% set zoom = location.zoom|default(15) %}
        {% set formattedAddress = iw_sulu_tailwind_theme_location_address(location) %}

        {% set hasInfo = (title is defined and title is not empty) or formattedAddress is not empty or (text is defined and text is not empty) %}

        <div class="iw-block-location iw-block-location--overlay relative">
            {# Map background — popup disabled: the floating card already shows the info #}
            <div class="iw-block-location__map-wrap {{ iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')) }} overflow-hidden">
                {% include '@ItechWorldSuluTailwindTheme/components/_location_map.html.twig' with {
                    location: location,
                    title: title|default(''),
                    address: formattedAddress,
                    popup: not hasInfo,
                    mapClass: 'iw-block-location__map w-full h-[400px] md:h-[500px]'
                } only %}
            </div>

            {# Floating collapsible info card #}
            {% if hasInfo %}
                <div class="iw-block-location__card"
                     data-controller="location-overlay"
                     data-location-overlay-target="card"
                >
                    {# Always-visible header with title + toggle #}
                    <button type="button"
                            class="iw-block-location__card-header"
                            data-location-overlay-target="header"
                            data-action="location-overlay#toggle"
                            aria-expanded="false"
                    >
                        <span class="iw-block-location__card-header-content">
                            {% if title is defined and title is not empty %}
                                <span class="text-base font-semibold text-black leading-tight">{{ iw_sulu_tailwind_theme_title_markup(title) }}</span>
                            {% endif %}
                            {% if formattedAddress is not empty and (title is not defined or title is empty) %}
                                <span class="text-sm text-black/75 leading-tight">{{ formattedAddress|split("\n")|first }}</span>
                            {% endif %}
                        </span>
                        <svg class="iw-block-location__card-chevron"
                             data-location-overlay-target="chevron"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>

                    {# Collapsible body — hidden by default #}
                    <div class="iw-block-location__card-body"
                         data-location-overlay-target="body"
                         style="display: none; max-height: 0px; opacity: 0;"
                    >
                        {% if formattedAddress is not empty %}
                            <div class="flex items-start gap-2">
                                <svg class="iw-block-location__address-icon w-5 h-5 text-[var(--iw-variant-link-color,var(--color-primary))] flex-none mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                <p class="iw-block-location__address-text text-sm whitespace-pre-line text-black/75">{{ formattedAddress }}</p>
                            </div>
                        {% endif %}

                        {% if text is defined and text is not empty %}
                            <div class="iw-block__text iw-block-location__text prose prose-sm max-w-none text-black">
                                {{ text|raw }}
                            </div>
                        {% endif %}

                        {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                            buttons: ctaButtons|default([]),
                            buttonsView: ctaBlockKey is not null ? view.blocks[ctaBlockKey].ctaButtons|default([]) : [],
                            alignment: ctaAlignment|default('title'),
                            direction: ctaDirection|default('row'),
                            titleAlignment: titleAlignment|default('left')
                        } only %}


                        <a
                            href="https://www.openstreetmap.org/?mlat={{ location.lat }}&mlon={{ location.long }}#map={{ zoom }}/{{ location.lat }}/{{ location.long }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="iw-button--variant iw-block-location__action inline-block px-4 py-2 text-sm text-center no-underline flex-shrink-0"
                        >
                            {{ 'iw_sulu_tailwind_theme.open_map'|trans|default('Open in maps') }} &#8599;
                        </a>
                    </div>

                    {# Scroll indicator — visible only when body is open and has overflow #}
                    <div class="iw-block-location__card-scroll-hint"
                         data-location-overlay-target="scrollHint"
                         data-action="click->location-overlay#scrollDown"
                         style="display: none; opacity: 0; pointer-events: none;"
                    >
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
