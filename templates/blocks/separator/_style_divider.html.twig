{# Separator block — divider with centered text or icon #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% set widthModifier = 'iw-block-separator__line--' ~ (lineWidth|default('thin')) %}
    {% set styleModifier = 'iw-block-separator__line--' ~ (lineStyle|default('solid')) %}
    {% set iconModifier = 'iw-block-separator__icon--' ~ (iconSize|default('md')) %}

    <div class="iw-block-separator iw-block-separator--divider">
        <div class="iw-block-separator__line {{ widthModifier }} {{ styleModifier }}"></div>

        {% if text is defined and text is not empty %}
            <span class="iw-block-separator__label">{{ text }}</span>
        {% elseif icon is defined and icon.id is defined %}
            {% set iconMedia = sulu_resolve_media(icon.id, app.request.locale) %}
            {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                media: iconMedia,
                format: 'iw_theme_avatar',
                alt: '',
                classes: 'iw-block-separator__icon ' ~ iconModifier,
            }) }}
        {% else %}
            <span class="iw-block-separator__icon-fallback">&#9670;</span>
        {% endif %}

        <div class="iw-block-separator__line {{ widthModifier }} {{ styleModifier }}"></div>
    </div>
{% endblock %}
