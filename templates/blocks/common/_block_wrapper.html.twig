{# Block wrapper — applies variant, margins, padding, radius, container and lightbox support. #}
{% set allVariants = iw_sulu_tailwind_theme.blockVariants|default([]) %}
{% set variantSlug = iw_sulu_tailwind_theme_variant_slug(variant|default(null), allVariants) %}
{% set variantClass = variantSlug ? 'iw-variant--' ~ variantSlug : '' %}
{% set mtClass = marginTop|default('mt-0') %}
{% set mbClass = marginBottom|default('mb-0') %}
{% set ptClass = paddingTop|default('pt-3') %}
{% set pbClass = paddingBottom|default('pb-3') %}
{% if paddingLateral is defined and paddingLateral %}
    {% set plClass = paddingLateral|replace({'px-': 'pl-'}) %}
    {% set prClass = paddingLateral|replace({'px-': 'pr-'}) %}
{% else %}
    {% set plClass = paddingLeft|default('pl-3') %}
    {% set prClass = paddingRight|default('pr-3') %}
{% endif %}
{% set lateralMode = lateralMargins|default('interior') %}
{# Backward compat: old checkbox true/false → map to exterior/none #}
{% if lateralMode is same as(true) or lateralMode == '1' %}
    {% set lateralMode = 'exterior' %}
{% elseif lateralMode is same as(false) or lateralMode == '0' or lateralMode == '' %}
    {% set lateralMode = 'interior' %}
{% endif %}
{% set sectionContainerClass = (lateralMode == 'exterior') ? 'container mx-auto' : '' %}
{% set blockRadiusClass = iw_sulu_tailwind_theme_radius_class('card', blockRadius|default('')) %}
{% set effectiveBlockRadius = iw_sulu_tailwind_theme_effective_radius('card', blockRadius|default('')) %}
{% set hasBlockRadius = effectiveBlockRadius is not empty and effectiveBlockRadius != 'rounded-none' %}
{% set radiusClass = (lateralMode == 'exterior' and hasBlockRadius) ? 'sm:' ~ blockRadiusClass : '' %}
{# `?? true` keeps the default-on-undefined behavior while letting an explicit
   `false` from the admin toggle disable the background. Twig's `|default(true)`
   would wrongly treat `false` as empty and reapply the default. #}
{% set bgAttr = (showBackground ?? true) ? 'data-has-bg="true"' : '' %}

{# Detect effective block padding per axis (same logic as text_images) #}
{% set hasTopPad = paddingTop is defined and paddingTop is not empty and paddingTop != 'pt-0' %}
{% set hasBotPad = paddingBottom is defined and paddingBottom is not empty and paddingBottom != 'pb-0' %}
{% set hasLatPad = false %}
{% if paddingLateral is defined and paddingLateral is not empty and paddingLateral != 'px-0' %}
    {% set hasLatPad = true %}
{% elseif (paddingLeft is defined and paddingLeft is not empty and paddingLeft != 'pl-0') or (paddingRight is defined and paddingRight is not empty and paddingRight != 'pr-0') %}
    {% set hasLatPad = true %}
{% endif %}

{# Compute conditional paragraph radius: only when lateral space exists (edges don't touch viewport).
   An empty value means "follow the theme" via the iw-radius--paragraph utility. #}
{% set rawParagraphRadius = iw_sulu_tailwind_theme_radius_class('paragraph', paragraphRadius|default('')) %}
{% set resolvedParagraphRadius = '' %}
{% if hasLatPad %}
    {% set resolvedParagraphRadius = rawParagraphRadius %}
{% elseif lateralMode == 'interior' %}
    {% set resolvedParagraphRadius = 'sm:' ~ rawParagraphRadius %}
{% endif %}

{# Call-to-action buttons close the block by default. A two-zone layout that
   wants them under its text column instead sets `ctaInline` before extending
   this wrapper, and includes `_cta_buttons.html.twig` where it needs them.
   `_key` is the index of this block in the page, needed to reach the view data
   that carries the link targets and labels. #}
{% set ctaBlockKey = _key|default(null) %}
{% set ctaButtonsView = ctaBlockKey is not null ? view.blocks[ctaBlockKey].ctaButtons|default([]) : [] %}

<section
    class="block {{ variantClass }} {{ sectionContainerClass }} {{ mtClass }} {{ mbClass }} {{ ptClass }} {{ pbClass }} {{ plClass }} {{ prClass }} {{ radiusClass }} {% if radiusClass %}sm:overflow-hidden{% endif %}"
    {{ bgAttr|raw }}
    data-controller="lightbox"
>
    {% if lateralMode == 'interior' %}
        <div class="container mx-auto">
            {{ block('block_content') }}

            {% if not (ctaInline|default(false)) %}
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                    buttons: ctaButtons|default([]),
                    buttonsView: ctaButtonsView,
                    alignment: ctaAlignment|default('title'),
                    direction: ctaDirection|default('row'),
                    titleAlignment: titleAlignment|default('left')
                } only %}
            {% endif %}
        </div>
    {% else %}
        {{ block('block_content') }}

        {% if not (ctaInline|default(false)) %}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                buttons: ctaButtons|default([]),
                buttonsView: ctaButtonsView,
                alignment: ctaAlignment|default('title'),
                direction: ctaDirection|default('row'),
                titleAlignment: titleAlignment|default('left')
            } only %}
        {% endif %}
    {% endif %}
</section>
