{# Call-to-action buttons - renders the `ctaButtons` list of any block that
   includes the `cta-buttons.xml` fragment.

   Expected variables:
     - buttons: the block's `ctaButtons` list ({ link, style } each)
     - buttonsView: the matching view data, for link targets and labels
     - alignment: `ctaAlignment` (title | left | center | right)
     - direction: `ctaDirection` (row | column)
     - titleAlignment: the block's own title alignment, used when the
       alignment follows the title (the default)
     - flush: drop the top margin, for a flex parent whose gap already spaces
       the buttons from the text above

   A block that extends `_block_wrapper` gets this for free at the end of the
   block; a two-zone layout sets `ctaInline` and includes this partial under
   its text column instead. #}
{% set ctaList = buttons is defined and buttons is iterable ? buttons : [] %}

{% if ctaList|length > 0 %}
    {% set ctaView = buttonsView is defined and buttonsView is iterable ? buttonsView : [] %}
    {% set ctaAlign = alignment|default('title') %}
    {% if ctaAlign == 'title' %}
        {% set ctaAlign = titleAlignment|default('left') %}
    {% endif %}
    {% set ctaDir = direction|default('row') == 'column' ? 'column' : 'row' %}

    {# Rendered only once the list holds at least one resolvable link, so a
       button added and left blank in the admin leaves no stray gap. Filtered
       rather than flagged inside a loop: a `set` there would not survive it. #}
    {% set ctaResolvable = ctaList|filter(cta => cta.link is defined and cta.link is not iterable and cta.link is not empty) %}

    {% if ctaResolvable|length > 0 %}
        <div class="iw-block__actions iw-block__actions--{{ ctaDir }} iw-block__actions--align-{{ ctaAlign }}{{ flush|default(false) ? ' iw-block__actions--flush' : '' }}">
            {% for cta in ctaList %}
                {# An unresolvable link - deleted or unpublished target - comes back
                   as the raw reference structure rather than a URL string. #}
                {% set ctaUrl = cta.link is defined and cta.link is not iterable ? cta.link : '' %}

                {% if ctaUrl is not empty %}
                    {% set ctaLinkView = ctaView[loop.index0].link|default({}) %}
                    {% set ctaTarget = ctaLinkView.target|default('_self') %}
                    {% set ctaRel = ctaLinkView.rel|default('') %}
                    {% set ctaLabel = ctaLinkView.title|default('') %}

                    {# Label fallbacks: link attribute, then the linked page or
                       media title, then the raw URL. #}
                    {% if ctaLabel is empty and ctaLinkView.provider|default('') == 'page' and ctaLinkView.href|default('') is not empty %}
                        {% set ctaLabel = sulu_page_load(ctaLinkView.href, {'title': 'title'}).title|default('') %}
                    {% endif %}
                    {% if ctaLabel is empty and ctaLinkView.provider|default('') == 'media' and ctaLinkView.href|default('') is not empty %}
                        {# A media deleted from the library resolves to null. #}
                        {% set ctaMedia = sulu_resolve_media(ctaLinkView.href, app.request.locale) %}
                        {% set ctaLabel = ctaMedia is not null ? ctaMedia.title|default('') : '' %}
                    {% endif %}
                    {% if ctaLabel is empty %}
                        {% set ctaLabel = ctaUrl %}
                    {% endif %}

                    {# Attributes are written as markup, not built as strings inside
                       `{{ }}`: autoescaping turns the quotes of a concatenated
                       expression into `&quot;`, which yields `target=&quot;_blank&quot;`
                       and a link that never opens in a new tab. A literal string
                       escapes the same way the moment a variable joins it. #}
                    <a href="{{ ctaUrl }}"
                       class="{{ cta.style|default('') ? 'iw-button--' ~ cta.style : 'iw-button--variant' }} iw-block__action"
                       {% if ctaTarget != '_self' %}target="{{ ctaTarget }}"{% endif %}
                       {% if ctaRel is not empty %}rel="{{ ctaRel }}"{% elseif ctaTarget == '_blank' %}rel="noopener noreferrer"{% endif %}
                    >
                        {{ ctaLabel }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endif %}
