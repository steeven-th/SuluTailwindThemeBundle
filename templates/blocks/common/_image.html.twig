{# ─────────────────────────────────────────────────────────────────────────
   Unified image partial — the single rendering point for every content image.

   Emits a <picture> with progressive avif/webp <source> elements and a fallback
   <img>. The avif/webp keys are only present in `media.thumbnails` when the
   server imagine driver can encode them, so the <source> is conditional and
   degrades cleanly to the original format (no broken URLs).

   Parameters:
     - media          : resolved media object (preferred). If omitted, `mediaId`
                        is resolved via sulu_resolve_media.
     - mediaId        : int media id (used only when `media` is not provided)
     - format         : Sulu format key (default 'iw_theme_16_9')
     - alt            : alt text override. Defaults to the media title. Pass ''
                        for purely decorative backgrounds.
     - ratio          : aspect-ratio token (e.g. '16/9', '4-3', '1:1'). When set
                        the image is cropped to that ratio (object-cover) inside
                        an `iw-ratio--X-Y` box; when omitted it keeps its natural
                        height. '/' and ':' are normalised to '-'.
     - cover          : bool (default false) — fill the parent with object-cover
                        instead of natural height. Use for backgrounds and
                        carousel slides where the parent already sets the size;
                        pass the sizing via `pictureClasses` (e.g. 'absolute
                        inset-0 w-full h-full'). Ignored when `ratio` is set
                        (a ratio already implies cover).
     - lightbox       : bool (default false) — wrap in a glightbox link
     - showName       : bool (default false) — use the media title as lightbox caption
     - sizes          : the width the image takes in the layout, as an HTML
                        `sizes` value (default '100vw'). Only read when the
                        format has width variants (config/image-formats.xml,
                        `<format>_w<width>`): the browser then picks the
                        smallest file covering that width. A grid of three
                        cards passes '(min-width: 1024px) 33vw, (min-width:
                        640px) 50vw, 100vw' and downloads a third of the bytes.
     - loading        : 'lazy' (default) | 'eager' (heroes / LCP images)
     - fetchpriority  : 'high' | 'low' | 'auto' (default: attribute omitted).
                        'high' only on the image likely to be the LCP (page
                        and article heroes). Not derived from 'eager': several
                        images per page are eager, and a priority given to
                        all of them is given to none.
     - focusMode      : 'img' (default) | 'none' — apply the focus-point class on
                        the <img> (object-position). Background callers use the
                        iw_sulu_tailwind_theme_focus_class(..., 'bg') function directly.
     - radiusClass    : optional radius class applied on the <picture> wrapper
                        (e.g. from iw_sulu_tailwind_theme_radius_class('image', ...))
     - classes        : extra classes on the <img>
     - pictureClasses : extra classes on the <picture>
     - notice         : true (default) | false | 'parent' | 'wrap'.
                        The credit and the AI label of the image
                        (components/_media_notice). They sit in a corner of
                        the rendered box: the <picture> is then wrapped in a
                        `.iw-media` span that takes its classes, the <picture>
                        itself being limited to <source> and <img>. In `raw`
                        mode the caller owns that box and says how to reach
                        it: 'parent' when its own positioned element is the
                        box of the image, 'wrap' for a block span around the
                        image (its CSS then sizes `.iw-media` where it sized
                        the <img>). A raw image given neither gets no notice
                        (avatars, too small to carry one). false is for an
                        image whose notices the caller renders itself
   ───────────────────────────────────────────────────────────────────────── #}

{% set media = media|default(null) %}
{% if media is null and mediaId is defined and mediaId %}
    {% set media = sulu_resolve_media(mediaId, app.request.locale) %}
{% endif %}

{% if media is not null and media is not empty %}
    {% set format = format|default('iw_theme_16_9') %}
    {% set enableLightbox = lightbox|default(false) %}
    {% set hasRatio = ratio is defined and ratio %}
    {% set ratioClass = hasRatio ? 'iw-ratio--' ~ (ratio|replace({'/': '-', ':': '-'})) : '' %}
    {% set focusClass = (focusMode|default('img')) != 'none'
        ? iw_sulu_tailwind_theme_focus_class(media.focusPointX|default(null), media.focusPointY|default(null), 'img')
        : '' %}

    {# Source URLs. Sulu always exposes the `.avif`/`.webp` keys, so avif is gated
       on the theme toggle (default on): disable it when the server imagine driver
       cannot encode AVIF. WebP is safe on any modern GD/Imagick and stays on.
       `is defined` (not |default) so an explicit `false` is honoured. #}
    {% set avifEnabled = iw_sulu_tailwind_theme.imageAvif is defined ? iw_sulu_tailwind_theme.imageAvif : true %}

    {# A vector gets no raster sibling. Sulu exposes the `.avif`/`.webp` keys for
       an SVG like it does for anything else, but requesting one asks the image
       converter to rasterize a vector and it answers with a 500, so the <source>
       would break the image instead of optimising it. The format URL itself is
       fine: it serves the original SVG untouched. Nothing to convert anyway, a
       vector is already smaller than any raster of it. #}
    {% set isVector = 'image/svg+xml' == media.mimeType|default('') %}

    {% set baseUrl = media.thumbnails[format]|default(media.url) %}
    {% set avifUrl = (avifEnabled and not isVector) ? media.thumbnails[format ~ '.avif']|default(null) : null %}
    {% set webpUrl = isVector ? null : media.thumbnails[format ~ '.webp']|default(null) %}

    {# Width candidates, when the format has `_w<width>` variants. A vector has
       none to offer, and a media cropped by hand in this format keeps its
       single size (the function returns null), the crop being per format. #}
    {% set baseSrcset = isVector ? null : iw_sulu_tailwind_theme_image_srcset(media, format) %}
    {% set avifSrcset = avifUrl ? iw_sulu_tailwind_theme_image_srcset(media, format, 'avif') : null %}
    {% set webpSrcset = webpUrl ? iw_sulu_tailwind_theme_image_srcset(media, format, 'webp') : null %}
    {% set imageSizes = (baseSrcset or avifSrcset or webpSrcset) ? (sizes|default('100vw')) : null %}

    {# Credit and AI label. The credit mode and the corner are theme
       settings, the label follows the `media.ai_label` project setting. #}
    {% set noticeMode = notice is defined ? notice : true %}
    {% set mediaNotice = noticeMode is same as(false) ? {credit: null, origin: null} : iw_sulu_tailwind_theme_media_notice(media) %}
    {% set creditMode = iw_sulu_tailwind_theme.imageCredits|default('overlay') %}
    {# A caption goes under an image in the flow of the page. One that fills
       a box (ratio, cover, a raw image sized by its caller) has no "under":
       its credit is laid over it instead. #}
    {% if creditMode == 'caption' and (raw|default(false) or hasRatio or cover|default(false)) %}
        {% set creditMode = 'overlay' %}
    {% endif %}
    {% set noticePosition = iw_sulu_tailwind_theme.imageNoticePosition|default('bottom-right') %}
    {% set hasLayerNotice = mediaNotice.origin is not null
        or (mediaNotice.credit is not null and creditMode in ['overlay', 'info']) %}
    {% set noticeVars = {notice: mediaNotice, creditMode: creditMode, position: noticePosition} %}

    {% if raw|default(false) %}
        {# Component-owned image: the <picture> is transparent (display:contents)
           so the caller's own CSS classes on the <img> fully drive the layout;
           the partial only injects the avif/webp sources and the focus class. #}
        {% set imgClasses = (focusClass ~ ' ' ~ (classes|default('')))|trim %}
        {% set pictureClass = ('contents ' ~ (pictureClasses|default('')))|trim %}
    {% else %}
        {% set coverFit = hasRatio or (cover|default(false)) %}
        {% set imgClasses = coverFit
            ? ('w-full h-full object-cover ' ~ focusClass ~ ' ' ~ (classes|default('')))|trim
            : ('w-full h-auto ' ~ (classes|default('')))|trim %}
        {% set hasRadius = (radiusClass|default('')) is not empty %}
        {% set pictureClass = ('block ' ~ ratioClass ~ ' ' ~ (radiusClass|default('')) ~ (hasRadius ? ' overflow-hidden' : '') ~ ' ' ~ (pictureClasses|default('')) ~ (enableLightbox ? ' cursor-pointer' : ''))|trim %}
    {% endif %}

    {# The box the image is rendered in carries the notices. Outside raw
       mode it is ours: a span takes over the classes of the <picture>,
       which keeps only its sources and turns transparent to layout. #}
    {% set wrapNotice = hasLayerNotice and not raw|default(false) %}
    {% set parentNotice = hasLayerNotice and raw|default(false) and noticeMode is same as('parent') %}
    {% set rawWrap = hasLayerNotice and raw|default(false) and noticeMode is same as('wrap') %}
    {% set captionCredit = mediaNotice.credit is not null and creditMode == 'caption' %}

    {% if enableLightbox %}
        <a
            href="{{ media.url }}"
            class="glightbox"
            data-title="{{ (showName|default(false)) and media.title is defined ? media.title : '' }}"
            {{- include('@ItechWorldSuluTailwindTheme/components/_lightbox_description.html.twig', {media: media, details: showName|default(false)}, with_context = false) }}
        >
    {% endif %}

    {% if captionCredit %}<span class="iw-media-figure">{% endif %}
    {% if wrapNotice %}<span class="iw-media {{ pictureClass }}">{% set pictureClass = 'contents' %}{% endif %}
    {% if rawWrap %}<span class="iw-media iw-media--wrap">{% endif %}
    <picture class="{{ pictureClass }}">
        {% if avifUrl %}<source srcset="{{ avifSrcset ?: avifUrl }}"{% if avifSrcset %} sizes="{{ imageSizes }}"{% endif %} type="image/avif">{% endif %}
        {% if webpUrl %}<source srcset="{{ webpSrcset ?: webpUrl }}"{% if webpSrcset %} sizes="{{ imageSizes }}"{% endif %} type="image/webp">{% endif %}
        <img
            src="{{ baseUrl }}"
            {%- if baseSrcset %} srcset="{{ baseSrcset }}" sizes="{{ imageSizes }}"{% endif %}
            alt="{{ alt is defined ? alt : media.title|default('') }}"
            loading="{{ loading|default('lazy') }}"
            {%- if fetchpriority|default(null) in ['high', 'low', 'auto'] %} fetchpriority="{{ fetchpriority }}"{% endif %}
            class="{{ imgClasses }}"
            {%- if itemprop is defined and itemprop %} itemprop="{{ itemprop }}"{% endif %}
        >
    </picture>
    {% if wrapNotice or parentNotice or rawWrap %}
        {{ include('@ItechWorldSuluTailwindTheme/components/_media_notice.html.twig', noticeVars, with_context = false) }}
    {% endif %}
    {% if wrapNotice or rawWrap %}</span>{% endif %}
    {% if captionCredit %}
        <span class="iw-media-figure__caption"><span class="sr-only">{{ 'iw_sulu_tailwind_theme.media_credit'|trans }} </span>{{ mediaNotice.credit }}</span>
        </span>
    {% endif %}

    {% if enableLightbox %}
        </a>
    {% endif %}
{% endif %}
