{# ─────────────────────────────────────────────────────────────────────────
   Widget: a video, embedded from YouTube or Vimeo, or hosted on the site.

   Parameters:
     - provider    : youtube | vimeo | file
     - youtubeId / vimeoId : the id for the matching provider
     - youtubePlaylist   : true to embed a YouTube playlist instead of a video
     - youtubePlaylistId : the playlist id, the part after `list=` in its link
     - videoFile   : Sulu media object, when the video is hosted here
     - videoPoster : Sulu media object. The `poster` of a hosted video, and
                     the background of the consent placeholder of an
                     embedded one.
     - videoRadius : optional radius class on the frame
   ───────────────────────────────────────────────────────────────────────── #}

{% set kind = provider|default('youtube') %}
{# An empty media picker is stored as `{id: null}`, not as nothing: testing
   `videoPoster.id is defined` answers true for a picker nobody filled. The
   value is what matters, not the key. #}
{% set hasPoster = videoPoster.id|default(null) is not null %}

{# A playlist is embedded through YouTube's `videoseries` address, which plays
   the list in order. Its id goes in a query string, hence the encoding. #}
{% set youtubeSrc = '' %}
{% if youtubePlaylist|default(false) %}
    {% if youtubePlaylistId|default('')|trim is not empty %}
        {% set youtubeSrc = 'https://www.youtube.com/embed/videoseries?list=' ~ youtubePlaylistId|trim|url_encode %}
    {% endif %}
{% elseif youtubeId|default('')|trim is not empty %}
    {% set youtubeSrc = 'https://www.youtube.com/embed/' ~ youtubeId|trim|url_encode %}
{% endif %}

{% set embedSrc = '' %}
{% if kind == 'youtube' and youtubeSrc is not empty %}
    {% set embedSrc = youtubeSrc %}
{% elseif kind == 'vimeo' and vimeoId|default('')|trim is not empty %}
    {% set embedSrc = 'https://player.vimeo.com/video/' ~ vimeoId|trim|url_encode %}
{% endif %}

{% if embedSrc is not empty %}
    {# YouTube and Vimeo are contacted as soon as the frame has a `src`, and
       set cookies: an embedded video always waits for consent, and the site's
       `consent.mode` setting decides how it gets it. The poster is an optional
       backdrop of the placeholder, the protection does not depend on it. The
       service key is the provider, the name the adapters of doc/consent.md
       grant, and the visitor reads the brand. #}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_embed_frame.html.twig' with {
        src: embedSrc,
        frameTitle: 'iw_sulu_tailwind_theme.media_video'|trans,
        heightMode: 'ratio',
        ratio: '16-9',
        sandboxMode: 'standard',
        lazyLoad: true,
        allowFullscreen: true,
        allowList: ['autoplay', 'encrypted-media', 'fullscreen', 'picture-in-picture'],
        consentRequired: true,
        consentService: kind,
        consentServiceLabel: {youtube: 'YouTube', vimeo: 'Vimeo'}[kind],
        consentImage: hasPoster ? videoPoster : null,
        frameClass: videoRadius|default('')
    } only %}
{% elseif kind == 'file' and videoFile.id|default(null) is not null %}
    {# A hosted file is served by the site itself: no third party, no consent. #}
    <div class="iw-widget__video-wrap{% if videoRadius|default('') %} {{ videoRadius }} overflow-hidden{% endif %}">
        {% set resolvedVideo = sulu_resolve_media(videoFile.id, app.request.locale) %}
        {% set posterUrl = '' %}
        {% if hasPoster %}
            {% set resolvedPoster = sulu_resolve_media(videoPoster.id, app.request.locale) %}
            {# A deleted poster costs the still frame, not the video. #}
            {% if resolvedPoster is not null %}
                {% set posterUrl = resolvedPoster.thumbnails['iw_theme_16_9']|default(resolvedPoster.url) %}
            {% endif %}
        {% endif %}
        {# A deleted video file leaves nothing to play: render no player at all. #}
        {% if resolvedVideo is not null %}
            <video
                src="{{ resolvedVideo.url }}"
                class="iw-widget__video w-full iw-ratio--16-9"
                controls
                preload="metadata"
                {% if posterUrl %}poster="{{ posterUrl }}"{% endif %}
            ></video>
        {% endif %}
    </div>
{% endif %}
