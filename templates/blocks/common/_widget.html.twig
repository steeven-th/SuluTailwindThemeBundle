{# ─────────────────────────────────────────────────────────────────────────
   The second zone of a two-zone block, whatever the editor put in it.

   The widget is a Sulu block type, so the editor picks what the zone holds
   and Sulu shows only that widget's fields. This partial dispatches on the
   choice, which is the only place in the rendering that has to know the list.

   Parameters:
     - widget       : the `widget` block, a one-item list carrying `type`
     - imageRadius  : radius class for the image and video frames
     - imageFormat  : Sulu format key for the images
     - aspectRatio  : ratio token for the image slider
     - blockPrefix  : BEM prefix of the calling block, for the wrapper class

   A block that offers no widget, or an editor who left it empty, renders
   nothing at all rather than an empty box.
   ───────────────────────────────────────────────────────────────────────── #}

{% set item = widget is defined and widget is iterable ? (widget|first) : null %}

{% if item %}
    {% set kind = item.type|default('image') %}

    <div class="iw-widget iw-widget--{{ kind }}{% if blockPrefix|default('') %} {{ blockPrefix }}__widget{% endif %}">
        {% if kind == 'video' %}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/widgets/_video.html.twig' with {
                provider: item.provider|default('youtube'),
                youtubeId: item.youtubeId|default(''),
                vimeoId: item.vimeoId|default(''),
                videoFile: item.videoFile|default(null),
                videoPoster: item.videoPoster|default(null),
                videoRadius: imageRadius|default('')
            } only %}
        {% elseif kind == 'location' %}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/widgets/_location.html.twig' with {
                location: item.location|default(null),
                imageRadius: imageRadius|default('')
            } only %}
        {% elseif kind == 'text' %}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/widgets/_text.html.twig' with {
                text: item.text|default('')
            } only %}
        {% else %}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/widgets/_image.html.twig' with {
                images: item.images|default([]),
                showName: item.showImagesName|default(false),
                imageFormat: imageFormat|default('iw_theme_16_9'),
                aspectRatio: aspectRatio|default('16/9'),
                imageRadius: imageRadius|default('')
            } only %}
        {% endif %}
    </div>
{% endif %}
