{# Gallery block — wide carousel with fullbleed images and centered title overlay #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% if images is defined and images is iterable %}
        {% set isParallax = enableParallax|default(false) %}
        {% set overlayRadius = iw_sulu_tailwind_theme_radius_class('paragraph', paragraphRadius|default('')) %}
        {% set overlayTitleTag = iw_sulu_tailwind_theme_heading_tag(titleTag|default('h2')) %}

        {# Parallax intensity: a 4-level admin select. The slider Stimulus
           controller multiplies its `maxShift` by this value (passed via
           `data-slider-parallax-intensity-value`); the image height/top offset
           follows the same scale via the enumerated `.iw-parallax--{level}`
           classes (app.css) so the image always covers its box at extremes. #}
        {% set parallaxLevels = {'subtle': 7.5, 'medium': 15, 'strong': 22.5, 'extreme': 30} %}
        {% set parallaxKey = parallaxIntensity|default('medium') %}
        {% set parallaxKey = parallaxKey in ['subtle', 'medium', 'strong', 'extreme'] ? parallaxKey : 'medium' %}
        {% set parallaxN = parallaxLevels[parallaxKey] %}

        {# Map imageFilter value to Sulu thumbnail name and CSS aspect-ratio #}
        {% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4', 'original': 'iw_theme_16_9'} %}
        {% set format = formatMap[imageFilter|default('original')]|default('iw_theme_16_9') %}
        {% set ratioMap = {'iw_theme_16_9': '16/9', 'iw_theme_4_3': '4/3', 'iw_theme_1_1': '1/1', 'iw_theme_3_4': '3/4'} %}
        {% set aspectRatio = ratioMap[format]|default('16/9') %}

        <div
            data-controller="slider"
            data-slider-autoplay-value="true"
            data-slider-interval-value="6000"
            data-slider-mode-value="carousel"
            data-slider-fullbleed-value="true"
            {% if isParallax %}data-slider-parallax-value="true" data-slider-parallax-intensity-value="{{ parallaxN / 15 }}"{% endif %}
            class="iw-block-gallery iw-block-gallery--wide-carousel{{ isParallax ? ' iw-block-gallery--wide-carousel-parallax' : '' }}"
        >
            {# Height spacer — aspect-ratio box by default, fixed height for parallax #}
            <div class="{{ isParallax ? 'iw-wide-carousel-spacer--parallax' : ('iw-ratio--' ~ (aspectRatio|replace({'/': '-', ':': '-'}))) }}"></div>

            {# Fullbleed slides — absolute to the section (via fullbleed mode).
               All images use eager loading since carousel can show any slide at any time. #}
            {% for mediaId in images %}
                {% set media = sulu_resolve_media(mediaId, app.request.locale) %}
                <div
                    data-slider-target="slide"
                    class="iw-block-gallery__slide absolute inset-0 w-full h-full {{ not loop.first ? 'hidden' : '' }}"
                >
                    <a
                        href="{{ media.url }}"
                        class="iw-block-gallery__link glightbox block w-full h-full"
                        data-title="{{ (showImagesName|default(false)) and media.title is defined ? media.title : '' }}"
                    >
                        {# Parallax: the image is taller than its box (iw-parallax--{level})
                           and the slider controller translates it on scroll. #}
                        {% set wideImgClasses = isParallax
                            ? ('iw-block-gallery__img cursor-pointer absolute w-full object-cover iw-parallax iw-parallax--' ~ parallaxKey)
                            : 'iw-block-gallery__img cursor-pointer absolute inset-0 w-full h-full object-cover' %}
                        {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                            media: media,
                            format: format,
                            raw: true,
                            loading: 'eager',
                            classes: wideImgClasses,
                        }) }}
                    </a>
                </div>
            {% endfor %}

            {# Centered title overlay #}
            {% if (title is defined and title is not empty) or (subTitle is defined and subTitle is not empty) %}
                <div class="iw-block-gallery__overlay absolute inset-0 flex items-center justify-center z-10 pointer-events-none">
                    <div class="iw-block-gallery__overlay-content text-center px-8 py-6 bg-black/50 backdrop-blur-sm max-w-2xl {{ overlayRadius }}">
                        {% if title is defined and title is not empty %}
                            <{{ overlayTitleTag }} class="iw-block-gallery__overlay-title text-white text-2xl md:text-4xl lg:text-5xl font-bold leading-tight">{{ title }}</{{ overlayTitleTag }}>
                        {% endif %}
                        {% if subTitle is defined and subTitle is not empty %}
                            <p class="iw-block-gallery__overlay-subtitle text-white/80 text-lg md:text-xl mt-3">{{ subTitle }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Navigation buttons + dots only when there is more than one slide #}
            {% if images|length > 1 %}
                <button
                    type="button"
                    data-action="slider#prev"
                    class="iw-gallery-nav iw-block-gallery__nav iw-block-gallery__nav--prev absolute left-6 top-1/2 -translate-y-1/2 z-20"
                    aria-label="Previous"
                >
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button
                    type="button"
                    data-action="slider#next"
                    class="iw-gallery-nav iw-block-gallery__nav iw-block-gallery__nav--next absolute right-6 top-1/2 -translate-y-1/2 z-20"
                    aria-label="Next"
                >
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>

                {# Dot indicators #}
                <div data-slider-target="dots" class="iw-block-gallery__dots absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/30 backdrop-blur-sm z-20">
                    {% for mediaId in images %}
                        <button
                            type="button"
                            data-action="slider#goTo"
                            data-slider-index-param="{{ loop.index0 }}"
                            class="iw-block-gallery__dot w-2.5 h-2.5 rounded-full {{ loop.first ? 'bg-white' : 'bg-white/50' }} transition-colors"
                            aria-label="Slide {{ loop.index }}"
                        ></button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
