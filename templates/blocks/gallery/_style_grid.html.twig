{# Gallery block — responsive CSS grid with lightbox #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}

    {% if images is defined and images is iterable %}
        {# Resolve lateral mode for radius logic #}
        {% set lateralMode = lateralMargins|default('interior') %}
        {% if lateralMode is same as(true) or lateralMode == '1' %}
            {% set lateralMode = 'exterior' %}
        {% elseif lateralMode is same as(false) or lateralMode == '0' or lateralMode == '' %}
            {% set lateralMode = 'interior' %}
        {% endif %}

        {# Image radius from admin selector #}
        {% set imageRadiusVal = iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')) %}

        {# Image spacing: an explicit choice from the admin (Content > Image
           spacing) wins. Otherwise it is deduced from paddingLateral: 0 or
           empty means a seamless layout - no gap - which interior mode
           restores from the sm: breakpoint. #}
        {% set explicitGap = galleryGap|default('') %}
        {% set pxVal = paddingLateral|default('') %}
        {% set noGap = explicitGap is empty and (pxVal is empty or pxVal == 'px-0') %}
        {% if explicitGap is not empty %}
            {% set gapClass = explicitGap %}
        {% elseif noGap and lateralMode == 'interior' %}
            {% set gapClass = 'iw-block-gallery--gap-from-sm' %}
        {% elseif noGap %}
            {% set gapClass = 'iw-block-gallery--gap-none' %}
        {% else %}
            {% set gapClass = '' %}
        {% endif %}

        {# Interior mode: always apply image radius from sm: breakpoint.
           Other modes: radius only when there is a gap (padding). #}
        {% if lateralMode == 'interior' %}
            {% set imageRadiusClass = 'sm:' ~ imageRadiusVal ~ ' sm:overflow-hidden' %}
        {% elseif not noGap %}
            {% set imageRadiusClass = imageRadiusVal ~ ' overflow-hidden' %}
        {% else %}
            {% set imageRadiusClass = '' %}
        {% endif %}

        {# Map imageFilter value to Sulu thumbnail name and CSS aspect-ratio #}
        {% set formatMap = {'16_9': 'iw_theme_16_9', '4_3': 'iw_theme_4_3', '1_1': 'iw_theme_1_1', '3_4': 'iw_theme_3_4', 'original': 'iw_theme_4_3'} %}
        {% set format = formatMap[imageFilter|default('original')]|default('iw_theme_4_3') %}
        {% set ratioMap = {'iw_theme_16_9': '16/9', 'iw_theme_4_3': '4/3', 'iw_theme_1_1': '1/1', 'iw_theme_3_4': '3/4'} %}
        {% set aspectRatio = ratioMap[format]|default('4/3') %}

        <div class="iw-block-gallery iw-block-gallery--grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 {{ gapClass }}">
            {% for mediaId in images %}
                {% set media = sulu_resolve_media(mediaId, app.request.locale) %}
                {# A media deleted from the library resolves to null: skip the item
                   rather than emitting a lightbox link to nowhere. #}
                {% if media is not null %}
                    <figure class="iw-block__image iw-block-gallery__item group{{ imageRadiusClass ? ' ' ~ imageRadiusClass : '' }}">
                        <a
                            href="{{ media.url }}"
                            class="iw-block-gallery__link glightbox"
                            data-title="{{ (showImagesName|default(false)) and media.title is defined ? media.title : '' }}"
                        >
                            {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                                media: media,
                                format: format,
                                ratio: aspectRatio,
                                classes: 'iw-block-gallery__img transition-transform duration-300 group-hover:scale-105 cursor-pointer',
                            }) }}
                        </a>
                    </figure>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
