{# Article list block — 3-column responsive grid with card backgrounds #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}

    {# Each source keeps its own selection, so the block reads the one it is
       set to rather than the articles of another mode. #}
    {% set articleItems = {
        'articles': articles|default([]),
        'upcoming': upcomingEvents|default([]),
        'past': pastEvents|default([]),
    }[source|default('articles')]|default([]) %}

    {# The block's own ratio, else the one of Blocks > Cards. #}
    {% set pickedRatio = iw_sulu_tailwind_theme_image_ratio(imageRatio|default(''), iw_sulu_tailwind_theme.blockCardImageRatio|default('16_9')) %}

    {% set effectiveCardRadius = iw_sulu_tailwind_theme_effective_radius('card', cardRadius|default('')) %}
    {% set hasCardRadius = effectiveCardRadius is not empty and effectiveCardRadius != 'rounded-none' %}
    {# Margin round the image: the block choice, else Blocks > Cards. `auto`
       lays it edge to edge on a card without radius and inside the padding
       otherwise, `padding` follows the padding, `0` lays it edge to edge, which
       is what squares its corners against a border. #}
    {% set imageInset = cardImageInset|default(iw_sulu_tailwind_theme.blockCardImageInset|default('auto'))|default('auto') %}
    {% set imageBleed = imageInset == '0' or (imageInset == 'auto' and not hasCardRadius) %}
    {% set insetClass = (not imageBleed and cardImageInset|default('') not in ['', 'auto', 'padding', '0']) ? 'iw-image-inset--' ~ cardImageInset|replace({'.': '_'}) : '' %}

    {% if articleItems is iterable and articleItems|length > 0 %}
        <div class="iw-block-article-list iw-block-article-list--grid{% if pickedRatio.portrait %} iw-block-article-list--portrait{% endif %}">
            {% for article in articleItems %}
                <div class="iw-block-article-list__item iw-surface--card {{ iw_sulu_tailwind_theme_radius_class('card', cardRadius|default('')) }} {{ insetClass }}">
                    {#- The column count is a CSS variable a project may lower: the image
                        share stops at a half rather than risk a blurry picture. -#}
                    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_card.html.twig' with {
                        article: article,
                        imageRatio: pickedRatio.key,
                        showDate: true,
                        showExcerpt: true,
                        showCategory: true,
                        cardImagePadded: not imageBleed,
                        cardHoverImage: iw_sulu_tailwind_theme.blockCardHoverImage|default('zoom'),
                        cardHoverTransform: iw_sulu_tailwind_theme.blockCardHoverTransform|default('lift'),
                        imageSizes: iw_sulu_tailwind_theme_image_sizes(pickedRatio.portrait ? {0: 1/2, 768: 1/3, 1024: 1/4} : {640: 1/2}),
                    } only %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="iw-block-article-list__empty">
            {{ 'iw_sulu_tailwind_theme.article.no_articles'|trans }}
        </p>
    {% endif %}
{% endblock %}
