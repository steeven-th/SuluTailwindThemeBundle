{# Article list block — full-width list with horizontal cards and card backgrounds #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        variant: variant|default(0)
    } only %}

    {% set articleItems = articles|default([]) %}
    {% set maxCount = articlesCount|default(6) %}

    {# Image collides with the item edges when no inner radius is requested,
       otherwise the L4 card pads the image with its own radius inside. #}
    {% set hasImageRadius = paragraphImageRadius|default('') is not empty and paragraphImageRadius != 'rounded-none' %}

    {% if articleItems is iterable and articleItems|length > 0 %}
        <div class="iw-block-article-list iw-block-article-list--list">
            {% for article in articleItems|slice(0, maxCount) %}
                <div class="iw-block-article-list__item {{ paragraphImageRadius|default('') }}">
                    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_card.html.twig' with {
                        article: article,
                        layout: 'horizontal',
                        imageRatio: '4/3',
                        showDate: true,
                        showExcerpt: true,
                        showCategory: true,
                        cardImagePadded: hasImageRadius,
                    } only %}
                </div>
            {% endfor %}
        </div>

        {% if showPagination is defined and showPagination %}
            {% set articlesView = view.blocks[_key].articles|default({}) %}
            {% include '@ItechWorldSuluTailwindTheme/articles/common/_pagination.html.twig' with {
                currentPage: articlesView.page|default(1),
                totalPages: articlesView.maxPage|default(1),
                baseUrl: app.request.pathInfo,
            } only %}
        {% endif %}
    {% else %}
        <p class="iw-block-article-list__empty">
            {{ 'iw_sulu_tailwind_theme.article.no_articles'|trans }}
        </p>
    {% endif %}
{% endblock %}
