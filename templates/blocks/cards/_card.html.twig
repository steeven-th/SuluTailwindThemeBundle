{# ─────────────────────────────────────────────────────────────────────────
   One card.

   The three layouts share this markup and differ by CSS alone, so a project
   can restyle one or add a layout of its own without touching Twig.

   What frames a card - its background and its border - comes from the variant,
   not from here: a card is an enclosed unit, so it takes the paragraph surface
   like every other one in the bundle. Shadow and numbering are options rather
   than layouts of their own, so they combine with all three.

   A highlighted card carries `--highlighted` and takes the ACCENT surface of
   the variant. That surface owns the colour of the text on it, so the card
   stays legible whatever the accent is - which a plain background could not
   promise.

   Parameters:
     - card          : the item {icon, image, title, text, link, linkStyle,
                       ctaButtons, highlighted}
     - cardView      : the matching view data, carrying resolved links
     - style         : stacked | image_top | horizontal
     - index         : 0-based position, shown when `numbered` is on
     - iconPosition  : inline | above
     - shadow        : bool, lifts the card off the page
     - ctaAlignment  : how the buttons of every card line up
     - ctaDirection  : row | column
     - align         : the text alignment of the grid, used when the buttons
                       follow the title
     - numbered      : bool, shows the position of the card
     - imageMaxWidth : cap on the image width, from the block settings
     - cardRadius    : radius class for the card
     - imageRadius   : radius class for the image
     - clickable     : bool, whole card becomes the link target
   ───────────────────────────────────────────────────────────────────────── #}

{% set icon = card.icon|default(null) %}
{% set image = card.image|default(null) %}
{% set title = card.title|default('') %}
{% set text = card.text|default('') %}
{% set highlighted = card.highlighted|default(false) %}

{# A media picker that was opened and left empty stores `{id: null}`, which is
   truthy in Twig. Only the id says whether anything was chosen. #}
{% set hasIcon = icon.id|default(null) is not null %}
{% set hasImage = image.id|default(null) is not null %}

{#- Either the card leads somewhere as a whole, or it holds buttons leading to
    several places. Never both: an anchor cannot contain anchors, and the admin
    shows one or the other depending on the clickable setting, so the two can
    never be filled at once.

    A clickable card keeps its button styling through `linkStyle`, drawn as a
    span since the card itself is already the anchor. -#}
{% set clickableCard = clickable|default(false) %}

{% set cardLink = card.link is defined and card.link is not iterable ? card.link : '' %}
{% set wholeCardIsLink = clickableCard and cardLink is not empty %}

{% set cardButtons = clickableCard ? [] : card.ctaButtons|default([]) %}
{% set cardButtonsView = cardView.ctaButtons|default([]) %}
{% set hasButtons = cardButtons is iterable and cardButtons|length > 0 %}

<{{ wholeCardIsLink ? 'a' : 'div' }}
    class="iw-card iw-card--{{ style|replace({'_': '-'}) }}{{ shadow|default(false) ? ' iw-card--shadow' : '' }}{{ highlighted ? ' iw-card--highlighted' : '' }} {{ cardRadius|default('') }}"
    {% if wholeCardIsLink %}
        href="{{ cardLink }}"
    {% endif %}
>
    {% if style == 'image_top' and hasImage %}
        <div class="iw-card__banner">
            {#- No image radius here: the banner is flush against the body, so
                rounding its bottom corners would cut a notch out of the card.
                Its top corners follow the card, which clips them. -#}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig' with {
                media: image,
                format: 'iw_theme_16_9',
                ratio: '16-9'
            } only %}
        </div>
    {% endif %}

    <div class="iw-card__body">
        {% if numbered|default(false) %}
            {#- Padded by hand: `format_number` needs the Intl extension of Twig,
                which the bundle does not require. -#}
            {% set position = index|default(0) + 1 %}
            <span class="iw-card__number" aria-hidden="true">{{ position < 10 ? '0' ~ position : position }}</span>
        {% endif %}

        {# The icon leads the title on one line, or sits above it. The
           horizontal layout puts the visual beside the text, so it owns that
           placement and ignores the setting. #}
        {% set iconAbove = style != 'horizontal' and iconPosition|default('inline') == 'above' %}

        <div class="iw-card__head{{ iconAbove ? ' iw-card__head--stacked' : '' }}">
            {% if hasIcon %}
                <span class="iw-card__icon">
                    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig' with {
                        media: icon,
                        format: 'iw_theme_1_1',
                        alt: ''
                    } only %}
                </span>
            {% endif %}

            {% if title is not empty %}
                <h3 class="iw-card__title">{{ iw_sulu_tailwind_theme_title_markup(title) }}</h3>
            {% endif %}
        </div>

        {% if style != 'image_top' and hasImage %}
            <div class="iw-card__image {{ imageMaxWidth|default('') }}">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig' with {
                    media: image,
                    format: 'iw_theme_16_9',
                    radiusClass: imageRadius|default('')
                } only %}
            </div>
        {% endif %}

        {% if text is not empty %}
            <div class="iw-card__text prose">{{ text|raw }}</div>
        {% endif %}

        {#- The card is the anchor, so its action is a span carrying the button
            style. Without a label there is nothing to draw, which is the case
            of a card made clickable with no link yet. -#}
        {%- if wholeCardIsLink -%}
            {#- Same label chain as the CTA partial: the title carried by the
                link, then the title of what it points at. No URL fallback
                here - a card is already clickable as a whole, so a button
                labelled with a raw URL would be worse than none. -#}
            {% set cardLinkView = cardView.link|default({}) %}
            {% set cardLinkLabel = cardLinkView.title|default('') %}
            {% if cardLinkLabel is empty and cardLinkView.provider|default('') == 'page' and cardLinkView.href|default('') is not empty %}
                {% set cardLinkLabel = sulu_page_load(cardLinkView.href, {'title': 'title'}).title|default('') %}
            {% endif %}
            {% if cardLinkLabel is empty and cardLinkView.provider|default('') == 'media' and cardLinkView.href|default('') is not empty %}
                {% set cardLinkLabel = sulu_resolve_media(cardLinkView.href, app.request.locale).title|default('') %}
            {% endif %}

            {% if cardLinkLabel is not empty %}
                <span class="iw-block__actions iw-block__actions--{{ ctaDirection|default('row') }} iw-block__actions--flush">
                    <span class="{{ card.linkStyle|default('') ? 'iw-button--' ~ card.linkStyle : 'iw-button--variant' }} iw-block__action">{{ cardLinkLabel }}</span>
                </span>
            {% endif %}
        {%- elseif hasButtons -%}
            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                buttons: cardButtons,
                buttonsView: cardButtonsView,
                alignment: ctaAlignment|default('title'),
                direction: ctaDirection|default('row'),
                titleAlignment: align|default('left'),
                flush: true
            } only %}
        {%- endif -%}
    </div>
</{{ wholeCardIsLink ? 'a' : 'div' }}>
