{# ─────────────────────────────────────────────────────────────────────────
   The grid of cards, shared by the three layouts.

   The column count is a BEM modifier rather than Tailwind classes, so the
   breakpoints live in app.css and a project can change where the grid folds
   without a safelist.

   Parameters: see _card.html.twig, plus
     - items     : the list of cards
     - itemsView : the matching view data, carrying resolved link targets
     - columns : 2 | 3 | 4
     - align     : left | center - the text inside each card
     - titleScale : normal | medium | large | xlarge - how much the title of a card
                    leads over its text, on top of the theme's own size
     - width     : fill | compact | medium | large - how wide a card may be
     - gridAlign : left | center | right - where a row sits once it no
                   longer fills the block
   ───────────────────────────────────────────────────────────────────────── #}

{# The share of the container one card takes, mirroring the column rules of
   app.css, so the browser downloads an image no wider than the card. #}
{% set cols = columns|default('3')|trim %}
{% set cardShares = style == 'horizontal'
    ? {1024: 1/2}
    : {
        '2': {640: 1/2},
        '3': {640: 1/2, 1024: 1/3},
        '4': {640: 1/2, 1024: 1/4},
        '1-2': {768: 2/3},
        '2-1': {768: 2/3},
        '1-3': {768: 3/4},
        '3-1': {768: 3/4},
    }[cols]|default({640: 1/2, 1024: 1/3}) %}

<div class="iw-block-cards__grid iw-block-cards__grid--cols-{{ columns|default('3') }} iw-block-cards__grid--width-{{ width|default('fill') }} iw-block-cards__grid--place-{{ gridAlign|default('left') }} iw-block-cards__grid--align-{{ align|default('left') }} iw-block-cards__grid--title-{{ titleScale|default('normal') }}">
    {% for card in items|default([]) %}
        {% include '@ItechWorldSuluTailwindTheme/blocks/cards/_card.html.twig' with {
            card: card,
            cardView: itemsView[loop.index0]|default({}),
            style: style,
            index: loop.index0,
            iconPosition: iconPosition|default('inline'),
            shadow: shadow|default(false),
            numbered: numbered|default(false),
            ctaAlignment: ctaAlignment|default('title'),
            ctaDirection: ctaDirection|default('row'),
            imageMaxWidth: imageMaxWidth|default(''),
            cardRadius: cardRadius|default(''),
            imageRadius: imageRadius|default(''),
            clickable: clickable|default(false),
            imageSizes: iw_sulu_tailwind_theme_image_sizes(cardShares)
        } only %}
    {% endfor %}
</div>
