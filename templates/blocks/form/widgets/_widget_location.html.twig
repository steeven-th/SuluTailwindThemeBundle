{# Form widget — interactive Leaflet map centered on a Sulu location field,
   with the structured address (street, postal code, town, country) shown below.
   Rendered through the shared components/_location_map.html.twig partial.
   Expected variables:
     - location: Sulu location object (.lat, .long, .zoom, .street, .number, .code, .town, .country)
     - imageRadius: optional Tailwind radius class
#}
{% if location is defined and location.lat is defined and location.long is defined %}
    {% set formattedAddress = iw_sulu_tailwind_theme_location_address(location) %}

    <div class="iw-block-form__widget iw-block-form__widget--location">
        <div class="iw-block-form__map-wrap{% if imageRadius|default('') %} {{ imageRadius }} overflow-hidden{% endif %}">
            {% include '@ItechWorldSuluTailwindTheme/components/_location_map.html.twig' with {
                location: location,
                title: 'iw_sulu_tailwind_theme.widget_location'|trans,
                address: formattedAddress,
                mapClass: 'iw-block-form__map w-full aspect-[4/3]'
            } only %}
        </div>

        {% if formattedAddress is not empty %}
            <div class="iw-block-form__map-address">
                <svg class="iw-block-form__map-address-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="iw-block-form__map-address-text whitespace-pre-line">{{ formattedAddress }}</p>
            </div>
        {% endif %}
    </div>
{% endif %}
