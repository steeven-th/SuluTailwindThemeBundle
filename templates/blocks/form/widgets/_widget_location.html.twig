{# Form widget — OpenStreetMap embed centered on a Sulu location field,
   with the structured address (street, postal code, town, country)
   shown below since OSM's embed has no clickable marker tooltip.
   Same logic as templates/blocks/cta/accessories/_accessory_location.html.twig.
   Expected variables:
     - location: Sulu location object (.lat, .long, .zoom, .street, .number, .code, .town, .country)
     - paragraphImageRadius: optional Tailwind radius class
#}
{% if location is defined and location.lat is defined and location.long is defined %}
    {% set zoom = location.zoom|default(15) %}
    {% set offset = 0.01 * (2 ** (15 - zoom)) %}

    {# Build formatted address from structured location fields #}
    {% set addressParts = [] %}
    {% if location.street is defined and location.street is not empty %}
        {% set streetLine = location.street %}
        {% if location.number is defined and location.number is not empty %}
            {% set streetLine = location.number ~ ' ' ~ streetLine %}
        {% endif %}
        {% set addressParts = addressParts|merge([streetLine]) %}
    {% endif %}
    {% set cityLine = [location.code|default(''), location.town|default('')]|filter(v => v is not empty)|join(' ') %}
    {% if cityLine is not empty %}
        {% set addressParts = addressParts|merge([cityLine]) %}
    {% endif %}
    {% if location.country is defined and location.country is not empty %}
        {% set addressParts = addressParts|merge([location.country]) %}
    {% endif %}
    {% set formattedAddress = addressParts|join("\n") %}

    <div class="iw-block-form__widget iw-block-form__widget--location">
        <div class="iw-block-form__map-wrap{% if paragraphImageRadius %} {{ paragraphImageRadius }} overflow-hidden{% endif %}">
            <iframe
                src="https://www.openstreetmap.org/export/embed.html?bbox={{ location.long - offset }}%2C{{ location.lat - offset }}%2C{{ location.long + offset }}%2C{{ location.lat + offset }}&amp;layer=mapnik&amp;marker={{ location.lat }}%2C{{ location.long }}"
                class="iw-block-form__map w-full border-0"
                style="aspect-ratio: 4/3;"
                loading="lazy"
                title="{{ 'iw_sulu_tailwind_theme.widget_location'|trans }}"
                allowfullscreen
            ></iframe>
        </div>

        {% if formattedAddress is not empty %}
            <div class="iw-block-form__map-address">
                <svg class="iw-block-form__map-address-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="iw-block-form__map-address-text whitespace-pre-line">{{ formattedAddress }}</p>
            </div>
        {% endif %}
    </div>
{% endif %}
