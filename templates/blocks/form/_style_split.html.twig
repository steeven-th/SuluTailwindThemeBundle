{# Form block — info widget + form side by side.
   The info column renders whichever widget the editor picked, through the
   shared partial: rich text, images, a video or a map. The `formRight` toggle
   controls the column order:
     - formRight = false (default): form LEFT (desktop) / form TOP (mobile)
     - formRight = true:            form RIGHT (desktop) / form BOTTOM (mobile)
   HTML order drives mobile order; CSS grid keeps the columns aligned on lg+. #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}


    {% set isFormRight = formRight|default(false) %}

    {% set splitClass = iw_sulu_tailwind_theme_media_ratio_class(mediaRatio|default(''), '1-2') %}
    {% set alignClass = iw_sulu_tailwind_theme_zones_align_class(zonesAlign|default(''), 'stretch') %}
    <div class="iw-block-form iw-block-form--split iw-split-gap iw-split-cols iw-split-cols--from-lg {{ splitClass }}{{ alignClass ? " " ~ alignClass : "" }}{{ isFormRight ? ' iw-split-cols--reverse' : '' }}">
        {% if isFormRight %}
            {# Widget first (LEFT desktop / TOP mobile), form after #}
            <div class="iw-block-form__info flex flex-col justify-center p-8 rounded-[var(--border-radius,8px)] bg-[var(--color-primary)] text-white">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_widget.html.twig' with {
                    widget: widget|default([]),
                    imageFormat: 'iw_theme_4_3',
                    aspectRatio: '4/3',
                    imageRadius: iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')),
                    blockPrefix: 'iw-block-form'
                } only %}
            </div>

            <div class="iw-block-form__content">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_form_content.html.twig' with {
                    useSuluFormBundle: useSuluFormBundle|default(false),
                    form: form|default(null),
                    twigTemplate: twigTemplate|default(''),
                    colorScheme: iw_sulu_tailwind_theme_color_scheme(variant|default(null), showBackground ?? true)
                } only %}
            </div>
        {% else %}
            {# Form first (LEFT desktop / TOP mobile), widget after #}
            <div class="iw-block-form__content">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_form_content.html.twig' with {
                    useSuluFormBundle: useSuluFormBundle|default(false),
                    form: form|default(null),
                    twigTemplate: twigTemplate|default(''),
                    colorScheme: iw_sulu_tailwind_theme_color_scheme(variant|default(null), showBackground ?? true)
                } only %}
            </div>

            <div class="iw-block-form__info flex flex-col justify-center p-8 rounded-[var(--border-radius,8px)] bg-[var(--color-primary)] text-white">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_widget.html.twig' with {
                    widget: widget|default([]),
                    imageFormat: 'iw_theme_4_3',
                    aspectRatio: '4/3',
                    imageRadius: iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')),
                    blockPrefix: 'iw-block-form'
                } only %}
            </div>
        {% endif %}
    </div>
{% endblock %}
