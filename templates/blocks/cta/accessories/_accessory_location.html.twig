{# CTA accessory — interactive Leaflet map centered on a Sulu location field,
   with the formatted address displayed below for context.
   Rendered through the shared components/_location_map.html.twig partial.
   Expected variables:
     - accessoryLocation: Sulu location object (.lat, .long, .zoom, .street, .number, .code, .town, .country)
     - paragraphImageRadius: optional Tailwind radius class
#}
{% if accessoryLocation is defined and accessoryLocation.lat is defined and accessoryLocation.long is defined %}
    {% set formattedAddress = iw_sulu_tailwind_theme_location_address(accessoryLocation) %}

    <div class="iw-block-cta__accessory iw-block-cta__accessory--location">
        <div class="iw-block-cta__map-wrap{% if paragraphImageRadius %} {{ paragraphImageRadius }} overflow-hidden{% endif %}">
            {% include '@ItechWorldSuluTailwindTheme/components/_location_map.html.twig' with {
                location: accessoryLocation,
                title: 'iw_sulu_tailwind_theme.accessory_location'|trans,
                address: formattedAddress,
                mapClass: 'iw-block-cta__map w-full aspect-[4/3]'
            } only %}
        </div>

        {% if formattedAddress is not empty %}
            <div class="iw-block-cta__map-address">
                <svg class="iw-block-cta__map-address-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="iw-block-cta__map-address-text whitespace-pre-line">{{ formattedAddress }}</p>
            </div>
        {% endif %}
    </div>
{% endif %}
