{# CTA accessory — up to 3 animated counters arranged in a column.
   Animation uses the shared `key-figures` Stimulus controller (same as the
   key_figures block) so the counter "ticks up" when scrolled into view.
   Expected variables:
     - counters: array of { count: string, unit: string, label: string }
#}
{% if counters is defined and counters is iterable and counters|length > 0 %}
    <div data-controller="key-figures" class="iw-block-cta__accessory iw-block-cta__accessory--counter">
        {% for counter in counters %}
            <div class="iw-block-cta__counter">
                {% if counter.count is defined and counter.count is not empty %}
                    <div class="iw-block-cta__counter-value">
                        <span
                            data-key-figures-target="counter"
                            data-key-figures-end-value="{{ counter.count }}"
                            class="iw-block-cta__counter-number"
                        >
                            0
                        </span>
                        {% if counter.unit is defined and counter.unit is not empty %}
                            <span class="iw-block-cta__counter-unit">{{ counter.unit }}</span>
                        {% endif %}
                    </div>
                {% endif %}
                {% if counter.label is defined and counter.label is not empty %}
                    <span class="iw-block-cta__counter-label">{{ counter.label }}</span>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
