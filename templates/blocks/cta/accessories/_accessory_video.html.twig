{# CTA accessory — embedded video (YouTube ID, Vimeo ID, or self-hosted file).
   Expected variables:
     - provider: 'youtube' | 'vimeo' | 'file'
     - youtubeId: YouTube video ID (provider = youtube)
     - vimeoId: Vimeo video ID (provider = vimeo)
     - videoFile: Sulu media object (provider = file)
     - posterImage: Sulu media object (optional, used as <video poster> when file)
     - imageRadius: optional Tailwind radius class
#}
<div class="iw-block-cta__accessory iw-block-cta__accessory--video{% if imageRadius|default('') %} {{ imageRadius }} overflow-hidden{% endif %}">
    {% if provider == 'youtube' and youtubeId is defined and youtubeId is not empty %}
        <iframe
            src="https://www.youtube.com/embed/{{ youtubeId }}"
            class="iw-block-cta__video w-full border-0"
            style="aspect-ratio: 16/9;"
            loading="lazy"
            title="{{ 'iw_sulu_tailwind_theme.accessory_video'|trans }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
        ></iframe>
    {% elseif provider == 'vimeo' and vimeoId is defined and vimeoId is not empty %}
        <iframe
            src="https://player.vimeo.com/video/{{ vimeoId }}"
            class="iw-block-cta__video w-full border-0"
            style="aspect-ratio: 16/9;"
            loading="lazy"
            title="{{ 'iw_sulu_tailwind_theme.accessory_video'|trans }}"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
        ></iframe>
    {% elseif provider == 'file' and videoFile is defined and videoFile.id is defined %}
        {% set resolvedVideo = sulu_resolve_media(videoFile.id, app.request.locale) %}
        {% set posterUrl = '' %}
        {% if posterImage is defined and posterImage.id is defined %}
            {% set resolvedPoster = sulu_resolve_media(posterImage.id, app.request.locale) %}
            {% set posterUrl = resolvedPoster.thumbnails['iw_theme_16_9']|default(resolvedPoster.url) %}
        {% endif %}
        <video
            src="{{ resolvedVideo.url }}"
            class="iw-block-cta__video w-full"
            style="aspect-ratio: 16/9;"
            controls
            preload="metadata"
            {% if posterUrl %}poster="{{ posterUrl }}"{% endif %}
        ></video>
    {% endif %}
</div>
