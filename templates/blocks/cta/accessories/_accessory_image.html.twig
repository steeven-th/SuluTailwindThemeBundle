{# CTA accessory — single image (split layout).
   Expected variables:
     - accessoryImage: Sulu media object (with .id)
     - paragraphImageRadius: optional Tailwind radius class
#}
<div class="iw-block-cta__accessory iw-block-cta__accessory--image{% if paragraphImageRadius %} {{ paragraphImageRadius }} overflow-hidden{% endif %}">
    {% if accessoryImage is defined and accessoryImage.id is defined %}
        {% set resolvedImage = sulu_resolve_media(accessoryImage.id, app.request.locale) %}
        <img
            src="{{ resolvedImage.thumbnails['iw_theme_4_3']|default(resolvedImage.url) }}"
            alt="{{ resolvedImage.title|default('') }}"
            loading="lazy"
            class="iw-block-cta__image w-full object-cover"
            style="aspect-ratio: 4/3;"
        >
    {% endif %}
</div>
