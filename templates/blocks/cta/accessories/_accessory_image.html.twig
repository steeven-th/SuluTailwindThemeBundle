{# CTA accessory — single image (split layout).
   Expected variables:
     - accessoryImage: Sulu media object (with .id)
     - imageRadius: optional Tailwind radius class
#}
<div class="iw-block-cta__accessory iw-block-cta__accessory--image{% if imageRadius|default('') %} {{ imageRadius }} overflow-hidden{% endif %}">
    {% if accessoryImage is defined and accessoryImage.id is defined %}
        {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
            mediaId: accessoryImage.id,
            format: 'iw_theme_4_3',
            ratio: '4/3',
            classes: 'iw-block-cta__image',
        }) }}
    {% endif %}
</div>
