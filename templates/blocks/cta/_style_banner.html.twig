{# CTA block — fullbleed hero banner with optional background image.
   The banner ignores `lateralMargins` / `paddingLateral` / `paddingTop` /
   `paddingBottom` / `blockRadius` / `paragraphRadius` / `imageRadius` (masked in cta.xml)
   and owns its own viewport-wide layout: centered hero typography, large
   internal padding, and background color cascading from the active variant
   (`--iw-variant-block-bg`) with a `--color-primary` fallback. #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {# Alignment (admin: Title alignment). The banner used to hardcode
       `text-center`, so the setting was offered and did nothing. It defaults to
       center here — that is the layout's own identity — and drives the whole
       content column: on a full-bleed hero, a left-aligned heading over centered
       body copy and buttons reads as a mistake rather than a choice. #}
    {% set bannerAlignment = titleAlignment|default('center') %}
    {% set alignMap = {'left': 'text-left', 'center': 'text-center', 'right': 'text-right'} %}
    {% set titleAlignClass = alignMap[bannerAlignment]|default('text-center') %}
    {% set justifyMap = {'left': 'justify-start', 'center': 'justify-center', 'right': 'justify-end'} %}
    {% set actionsJustifyClass = justifyMap[bannerAlignment]|default('justify-center') %}
    {# The prose column is width-capped, so it also needs to be pushed to the
       chosen side — text-align alone would leave the box itself centered. #}
    {# `is defined` rather than `|default()`: the left case is an empty string,
       which `default` would swap back to `mx-auto` and re-center the column. #}
    {% set textInsetMap = {'left': '', 'center': 'mx-auto', 'right': 'ml-auto'} %}
    {% set textInsetClass = textInsetMap[bannerAlignment] is defined ? textInsetMap[bannerAlignment] : 'mx-auto' %}
    {% set titleTag = iw_sulu_tailwind_theme_heading_tag(titleTag|default('h2')) %}
    {% set bannerMediaId = (bannerImage is defined and bannerImage.id is defined) ? bannerImage.id : null %}

    {# Neutralise the wrapper's pt-*/pb-* via negative margins so the banner
       fills the section edge-to-edge vertically. The Hero owns its own padding. #}
    {% set spacingMap = {'0': '0px', '1': '0.25rem', '2': '0.5rem', '3': '0.75rem', '4': '1rem', '5': '1.25rem', '6': '1.5rem', '7': '1.75rem', '8': '2rem', '9': '2.25rem', '10': '2.5rem', '11': '2.75rem', '12': '3rem', '14': '3.5rem', '16': '4rem', '20': '5rem', '24': '6rem'} %}
    {% set ptNum = ptClass|default('pt-0')|split('-')|last %}
    {% set pbNum = pbClass|default('pb-0')|split('-')|last %}

    {# Fullbleed via `position+left+margin-left`: works inside `container mx-auto`
       wrappers too, unlike the older `margin-inline: calc(-50vw + 50%)` trick. #}
    <div class="iw-block-cta iw-block-cta--banner relative overflow-hidden"
         style="margin-top: -{{ spacingMap[ptNum]|default('0px') }}; margin-bottom: -{{ spacingMap[pbNum]|default('0px') }}; position: relative; left: 50%; margin-left: -50vw; width: 100vw;">
        {% if bannerMediaId %}
            {# Background image — cropped around the media focus point. #}
            {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                mediaId: bannerMediaId,
                format: 'iw_theme_16_9',
                cover: true,
                alt: '',
                classes: 'iw-block-cta__background',
                pictureClasses: 'absolute inset-0 w-full h-full',
            }) }}
            <div class="iw-block-cta__overlay absolute inset-0 bg-black/50"></div>
        {% endif %}

        <div class="iw-block-cta__content relative z-10 container mx-auto py-16 md:py-20 lg:py-24 px-6 md:px-8 {{ titleAlignClass }} text-white">
            {% if title is defined and title is not empty %}
                <{{ titleTag }} class="iw-block__title iw-block-cta__title text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-[var(--font-h2-weight)] {{ titleAlignClass }} text-white">{{ iw_sulu_tailwind_theme_title_markup(title, false) }}</{{ titleTag }}>
            {% endif %}
            {% if subTitle is defined and subTitle is not empty %}
                <p class="iw-block__subtitle iw-block-cta__subtitle text-xl md:text-2xl mt-4 {{ titleAlignClass }} text-white/80">{{ iw_sulu_tailwind_theme_title_markup(subTitle, false) }}</p>
            {% endif %}
            {% if text is defined and text is not empty %}
                <div class="iw-block__text iw-block-cta__text prose prose-invert max-w-2xl {{ textInsetClass }} mt-8">
                    {{ text|raw }}
                </div>
            {% endif %}

            <div class="iw-block-cta__actions-wrap flex {{ actionsJustifyClass }}">
                {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                    primaryButtonLink: primaryButtonLink|default(''),
                    primaryButtonView: view.blocks[_key].primaryButtonLink|default({}),
                    primaryButtonStyle: primaryButtonStyle|default('primary'),
                    secondaryButtonLink: secondaryButtonLink|default(''),
                    secondaryButtonView: view.blocks[_key].secondaryButtonLink|default({}),
                    secondaryButtonStyle: secondaryButtonStyle|default('secondary')
                } only %}
            </div>
        </div>
    </div>
{% endblock %}
