{# CTA block — split layout: content (text + actions) on one side, accessory on the other.
   The accessory column renders one of 4 widget types based on `accessoryType`:
   image, video, location, or counter (1-3 animated numbers). #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% set alignMap = {'left': 'text-left', 'center': 'text-center', 'right': 'text-right'} %}
    {% set titleAlignClass = alignMap[titleAlignment|default('left')]|default('text-left') %}
    {% set isContentRight = contentRight|default(false) %}
    {% set accessoryKind = accessoryType|default('image') %}
    {% set titleTag = iw_sulu_tailwind_theme_heading_tag(titleTag|default('h2')) %}
    {# Media accessories (image, video, map) follow the image radius context #}
    {% set accessoryRadiusClass = iw_sulu_tailwind_theme_radius_class('image', imageRadius|default('')) %}

    {# HTML order determines mobile order:
       contentRight=false → text first, accessory below (mobile) / accessory right (desktop)
       contentRight=true  → accessory first, accessory above (mobile) / accessory left (desktop) #}
    <div class="iw-block-cta iw-block-cta--split iw-split-gap grid grid-cols-1 lg:grid-cols-2 items-center">
        {% if isContentRight %}
            {# Accessory LEFT (desktop) / Accessory TOP (mobile) #}
            {% include '@ItechWorldSuluTailwindTheme/blocks/cta/accessories/_accessory_' ~ accessoryKind ~ '.html.twig' with {
                accessoryImage: accessoryImage|default(null),
                provider: accessoryVideoProvider|default('youtube'),
                youtubeId: accessoryYoutubeId|default(''),
                vimeoId: accessoryVimeoId|default(''),
                videoFile: accessoryVideoFile|default(null),
                posterImage: accessoryVideoPoster|default(null),
                accessoryLocation: accessoryLocation|default(null),
                counters: accessoryCounters|default([]),
                imageRadius: accessoryRadiusClass
            } only %}

            <div class="iw-block-cta__content">
        {% else %}
            <div class="iw-block-cta__content">
        {% endif %}
            {% if title is defined and title is not empty %}
                <{{ titleTag }} class="iw-block__title iw-block-cta__title text-2xl md:text-3xl lg:text-4xl font-[var(--font-h2-weight)] {{ titleAlignClass }}">{{ iw_sulu_tailwind_theme_title_markup(title, false) }}</{{ titleTag }}>
            {% endif %}
            {% if subTitle is defined and subTitle is not empty %}
                <p class="iw-block__subtitle iw-block-cta__subtitle text-lg md:text-xl mt-2 opacity-75 {{ titleAlignClass }}">{{ iw_sulu_tailwind_theme_title_markup(subTitle, false) }}</p>
            {% endif %}
            {% if text is defined and text is not empty %}
                <div class="iw-block__text iw-block-cta__text prose max-w-none mt-6 {{ resolvedParagraphRadius|default('') }}">
                    {{ text|raw }}
                </div>
            {% endif %}

            {% include '@ItechWorldSuluTailwindTheme/blocks/common/_cta_buttons.html.twig' with {
                primaryButtonLink: primaryButtonLink|default(''),
                primaryButtonView: view.blocks[_key].primaryButtonLink|default({}),
                primaryButtonStyle: primaryButtonStyle|default('primary'),
                secondaryButtonLink: secondaryButtonLink|default(''),
                secondaryButtonView: view.blocks[_key].secondaryButtonLink|default({}),
                secondaryButtonStyle: secondaryButtonStyle|default('secondary')
            } only %}
        </div>

        {% if not isContentRight %}
            {# Accessory RIGHT (desktop) / Accessory BOTTOM (mobile) #}
            {% include '@ItechWorldSuluTailwindTheme/blocks/cta/accessories/_accessory_' ~ accessoryKind ~ '.html.twig' with {
                accessoryImage: accessoryImage|default(null),
                provider: accessoryVideoProvider|default('youtube'),
                youtubeId: accessoryYoutubeId|default(''),
                vimeoId: accessoryVimeoId|default(''),
                videoFile: accessoryVideoFile|default(null),
                posterImage: accessoryVideoPoster|default(null),
                accessoryLocation: accessoryLocation|default(null),
                counters: accessoryCounters|default([]),
                imageRadius: accessoryRadiusClass
            } only %}
        {% endif %}
    </div>
{% endblock %}
