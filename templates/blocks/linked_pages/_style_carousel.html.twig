{# Linked pages — auto-playing carousel of single-card slides #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}

    {% if links is defined and links is iterable and links|length > 0 %}
        {# Capture the parent block index before entering the loop — `_key` may be
           rebound to the sub-block index inside the loop scope. #}
        {% set parentBlockKey = _key %}
        {% set linksView = view.blocks[parentBlockKey].links|default([]) %}
        <div
            data-controller="slider"
            data-slider-mode-value="carousel"
            data-slider-autoplay-value="true"
            data-slider-interval-value="5000"
            class="iw-block-linked-pages iw-block-linked-pages--carousel"
        >
            {# Slides — the `hidden` class is toggled by the slider controller. #}
            <div class="iw-block-linked-pages__slides">
                {% for link in links %}
                    {% set linkView = linksView[loop.index0].link|default({}) %}
                    {% set linkUrl = link.link|default('') %}
                    {% if linkUrl is not empty %}
                        {% set linkTarget = linkView.target|default('_self') %}
                        {% set linkRel = linkView.rel|default('') %}
                        {% set linkLabel = linkView.title|default('') %}
                        {% set linkExcerpt = link.excerpt|default('') %}
                        {# Fallback: pull title and/or excerpt from the linked page when not explicitly provided #}
                        {% set isPage = linkView.provider|default('') == 'page' and linkView.href|default('') is not empty %}
                        {% if isPage and (linkLabel is empty or linkExcerpt is empty) %}
                            {% set linkedPage = sulu_page_load(linkView.href, {'title': 'title', 'excerpt': 'excerpt'}) %}
                            {% if linkLabel is empty %}{% set linkLabel = linkedPage.title|default('') %}{% endif %}
                            {% if linkExcerpt is empty %}{% set linkExcerpt = linkedPage.excerpt.description|default('') %}{% endif %}
                        {% endif %}
                        {# Fallback: pull the media title (or filename) when linking to a media asset #}
                        {% if linkLabel is empty and linkView.provider|default('') == 'media' and linkView.href|default('') is not empty %}
                            {% set linkedMedia = sulu_resolve_media(linkView.href, app.request.locale) %}
                            {% set linkLabel = linkedMedia.title|default(linkedMedia.name|default('')) %}
                        {% endif %}
                        {# Last-resort fallback: show the URL itself if no label could be resolved #}
                        {% if linkLabel is empty %}{% set linkLabel = linkUrl %}{% endif %}

                        <div
                            data-slider-target="slide"
                            class="iw-block-linked-pages__slide {{ loop.first ? '' : 'hidden' }}"
                        >
                            <a
                                href="{{ linkUrl }}"
                                {% if linkTarget != '_self' %}target="{{ linkTarget }}"{% endif %}
                                {% if linkRel is not empty %}rel="{{ linkRel }}"{% elseif linkTarget == '_blank' %}rel="noopener noreferrer"{% endif %}
                                class="iw-block-linked-pages__slide-link"
                            >
                                <span class="iw-block-linked-pages__slide-title">{{ linkLabel }}</span>
                                {% if linkExcerpt is not empty %}
                                    <p class="iw-block-linked-pages__slide-excerpt">{{ linkExcerpt }}</p>
                                {% endif %}
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            {# Navigation arrows #}
            <button
                type="button"
                data-action="slider#prev"
                class="iw-block-linked-pages__nav iw-block-linked-pages__nav--prev"
                aria-label="Previous"
            >
                <svg class="iw-block-linked-pages__nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <button
                type="button"
                data-action="slider#next"
                class="iw-block-linked-pages__nav iw-block-linked-pages__nav--next"
                aria-label="Next"
            >
                <svg class="iw-block-linked-pages__nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>

            {# Dots — the slider controller drives the active state via inline opacity. #}
            <div data-slider-target="dots" class="iw-block-linked-pages__dots">
                {% for link in links %}
                    {% if (link.link|default('')) is not empty %}
                        <button
                            type="button"
                            data-action="slider#goTo"
                            data-slider-index-param="{{ loop.index0 }}"
                            class="iw-block-linked-pages__dot {{ loop.first ? 'iw-block-linked-pages__dot--active' : '' }}"
                            aria-label="Slide {{ loop.index }}"
                        ></button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
