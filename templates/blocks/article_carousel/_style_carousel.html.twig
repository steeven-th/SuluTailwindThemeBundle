{# Article carousel block — horizontal scrollable article cards using slider_controller #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        titleTag: titleTag|default('h2'),
        variant: variant|default(0)
    } only %}

    {% set articleItems = articles|default([]) %}
    {% set isAutoplay = autoplay is defined ? autoplay : false %}
    {% set autoplayInterval = interval|default(5000) %}

    {# Image collides with the item edges when no inner radius is requested,
       otherwise the L4 card pads the image with its own radius inside. #}
    {% set effectiveCardRadius = iw_sulu_tailwind_theme_effective_radius('card', cardRadius|default('')) %}
    {% set hasCardRadius = effectiveCardRadius is not empty and effectiveCardRadius != 'rounded-none' %}

    {# Resolve the variant's button style so the carousel arrows use the same
       color as the buttons configured for this variant. #}
    {% set allVariants = iw_sulu_tailwind_theme.blockVariants|default([]) %}
    {% set variantConfig = iw_sulu_tailwind_theme_variant_config(variant|default(null), allVariants) %}
    {% set carouselButtonStyle = variantConfig.buttonStyle|default('primary') %}

    {% if articleItems is iterable and articleItems|length > 0 %}
        {% set displayedArticles = articleItems %}

        <div
            data-controller="slider"
            data-slider-mode-value="scroll"
            data-slider-autoplay-value="{{ isAutoplay ? 'true' : 'false' }}"
            data-slider-interval-value="{{ autoplayInterval }}"
            class="iw-block-article-carousel iw-block-article-carousel--button-{{ carouselButtonStyle }}"
        >
            {# Navigation arrows — positioned above the track #}
            <div class="iw-block-article-carousel__nav">
                <button
                    type="button"
                    data-action="slider#prev"
                    class="iw-block-article-carousel__nav-button iw-block-article-carousel__nav-button--prev"
                    aria-label="{{ 'iw_sulu_tailwind_theme.article.pagination_previous'|trans }}"
                >
                    <svg class="iw-block-article-carousel__nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                </button>
                <button
                    type="button"
                    data-action="slider#next"
                    class="iw-block-article-carousel__nav-button iw-block-article-carousel__nav-button--next"
                    aria-label="{{ 'iw_sulu_tailwind_theme.article.pagination_next'|trans }}"
                >
                    <svg class="iw-block-article-carousel__nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
            </div>

            {# Scrollable track — cards fill full width with calculated sizes #}
            <div
                data-slider-target="track"
                class="iw-block-article-carousel__track scrollbar-hide"
            >
                {% for article in displayedArticles %}
                    <div class="iw-block-article-carousel__slide">
                        <div class="iw-block-article-carousel__item {{ iw_sulu_tailwind_theme_radius_class('card', cardRadius|default('')) }}">
                            {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_card.html.twig' with {
                                article: article,
                                imageRatio: '16/9',
                                showDate: true,
                                showExcerpt: true,
                                showCategory: true,
                                cardImagePadded: hasCardRadius,
                            } only %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <p class="iw-block-article-list__empty">
            {{ 'iw_sulu_tailwind_theme.article.no_articles'|trans }}
        </p>
    {% endif %}
{% endblock %}
