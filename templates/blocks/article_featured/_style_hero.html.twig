{# Article featured block — hero style: single article, full-width image with overlay text #}
{% extends '@ItechWorldSuluTailwindTheme/blocks/common/_block_wrapper.html.twig' %}

{% block block_content %}
    {% include '@ItechWorldSuluTailwindTheme/blocks/common/_titles.html.twig' with {
        title: title|default(''),
        subTitle: subTitle|default(''),
        titleAlignment: titleAlignment|default('left'),
        variant: variant|default(0)
    } only %}

    {# Hero style: 1 article. Use the style-specific smart_content property,
       fall back to the legacy `articles` (max 3) for blocks created before
       the multi-property XML was introduced. #}
    {% set articleItems = articles_hero is defined and articles_hero is not empty
        ? articles_hero
        : articles|default([]) %}

    {% if articleItems is iterable and articleItems|length > 0 %}
        {% set article = articleItems|first %}

        {% set articleTitle = article.title|default('') %}
        {% set articleUrl = article.routePath|default(article.url|default('#')) %}
        {% if articleUrl != '#' %}
            {% set articleUrl = sulu_content_path(articleUrl) %}
        {% endif %}
        {% set articleExcerpt = article.excerptDescription|default(article.excerpt.description|default('')) %}
        {% set articleDate = article.authored|default(null) %}
        {% set articleImage = article.excerptImages|default(article.excerpt.images|default(article.heroImage|default(null))) %}
        {% set articleCategories = article.excerptCategories|default(article.excerpt.categories|default([])) %}

        {# Resolve image #}
        {% set imgMedia = null %}
        {% set imgId = null %}
        {% if articleImage is iterable and articleImage|length > 0 %}
            {% set imgId = articleImage.ids|default(articleImage)|first %}
        {% elseif articleImage is not empty %}
            {# single_media_selection scalar (heroImage fallback) #}
            {% set imgId = articleImage %}
        {% endif %}
        {% if imgId %}
            {% set imgMedia = sulu_resolve_media(imgId, app.request.locale) %}
        {% endif %}

        <div class="iw-block-article-featured iw-block-article-featured--hero">
            <a href="{{ articleUrl }}" class="iw-featured-article-card iw-featured-article-card--hero {{ iw_sulu_tailwind_theme_radius_class('card', cardRadius|default('')) }}">
                {# Image with aspect-ratio — gives height to the card #}
                {% if imgMedia %}
                    <img
                        src="{{ imgMedia.thumbnails['iw_theme_16_9']|default(imgMedia.url) }}"
                        alt="{{ imgMedia.title|default(articleTitle) }}"
                        class="iw-featured-article-card__image iw-featured-article-card__image--hero"
                        loading="lazy"
                    >
                {% else %}
                    {# Fallback when no image: colored placeholder #}
                    <div class="iw-featured-article-card__image-placeholder iw-featured-article-card__image-placeholder--hero"></div>
                {% endif %}

                {# Gradient overlay + text #}
                <div class="iw-featured-article-card__overlay">
                    {% if articleCategories is iterable and articleCategories|length > 0 %}
                        <div class="iw-featured-article-card__category-wrap">
                            {% for category in articleCategories|slice(0, 1) %}
                                <span class="iw-featured-article-card__category iw-featured-article-card__category--overlay">
                                    {{ category.name|default(category.title|default('')) }}
                                </span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <h3 class="iw-featured-article-card__title iw-featured-article-card__title--hero">
                        {{ articleTitle }}
                    </h3>

                    {% if articleExcerpt is not empty %}
                        <p class="iw-featured-article-card__excerpt iw-featured-article-card__excerpt--hero">
                            {{ articleExcerpt|striptags|trim }}
                        </p>
                    {% endif %}

                    {% if articleDate is not empty %}
                        <time datetime="{{ articleDate|date('c') }}" class="iw-featured-article-card__date iw-featured-article-card__date--hero">
                            {{ iw_sulu_tailwind_theme_format_date(articleDate, 'medium') }}
                        </time>
                    {% endif %}
                </div>
            </a>
        </div>
    {% else %}
        <p class="iw-block-article-list__empty">
            {{ 'iw_sulu_tailwind_theme.article.no_articles'|trans }}
        </p>
    {% endif %}
{% endblock %}
