<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ content.title|default('') }}{% endblock %}</title>

    {% block meta %}
        {{ include('@SuluWebsite/Extension/seo.html.twig', {
            seo: extension.seo|default([]),
            content: content|default([]),
            localizations: localizations|default([]),
            shadowBaseLocale: shadowBaseLocale|default(),
        }) }}
    {% endblock %}

    {# SEO: Open Graph + Twitter Cards #}
    {% include '@ItechWorldSuluTailwindTheme/seo/_opengraph.html.twig' ignore missing %}
    {% include '@ItechWorldSuluTailwindTheme/seo/_twitter_card.html.twig' ignore missing %}

    {# SEO: JSON-LD — filled automatically by article templates #}
    {% block seo_structured_data %}{% endblock %}

    {# Theme: Google Fonts #}
    {{ iw_sulu_tailwind_theme_fonts_link()|raw }}

    {# Theme: compiled CSS custom properties #}
    {% set themeCssPath = iw_sulu_tailwind_theme_css_path() %}
    {% if themeCssPath is not empty %}
        <link rel="stylesheet" href="{{ themeCssPath }}">
    {% endif %}

    {% block style %}{% endblock %}
    {{ encore_entry_link_tags('app') }}
</head>
<body class="bg-[var(--color-background)] text-[var(--color-text)]">
    {# Theme: dynamic menu #}
    {% set menuConfig = iw_sulu_tailwind_theme_menu_config() %}
    {% block header %}
        {% if menuConfig is not empty and menuConfig.type is defined %}
            {% include '@ItechWorldSuluTailwindTheme/menu/_' ~ menuConfig.type ~ '.html.twig' with {config: menuConfig} %}
        {% else %}
            <header>
                <nav class="container mx-auto px-4 py-4">
                    <ul class="flex gap-4">
                        <li><a href="{{ sulu_content_root_path() }}">Home</a></li>
                        {% for item in sulu_page_navigation_root_tree('main', 1, {title: 'title', url: 'url'}) %}
                            <li>
                                <a href="{{ sulu_content_path(item.url) }}" title="{{ item.title }}">{{ item.title }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </header>
        {% endif %}
    {% endblock %}

    <main>
        {% block content %}{% endblock %}
    </main>

    {# Theme: dynamic footer — ready-made layouts colored by a theme variant.
       Configure it in the admin (Settings > Themes > Footer). Each partial
       renders its own <footer>. To disable the bundle footer, simply remove
       this block from your own base template (like the menu). #}
    {% block footer %}
        {% set footerConfig = iw_sulu_tailwind_theme_footer_config() %}
        {% if footerConfig.type is defined and footerConfig.type is not empty %}
            {% include '@ItechWorldSuluTailwindTheme/footer/_' ~ footerConfig.type ~ '.html.twig' with {config: footerConfig} %}
        {% endif %}
    {% endblock %}

    {# Site-wide back-to-top button, opt-in via Components > Site-wide. If you use
       your own base template, copy this include into it. #}
    {% if iw_sulu_tailwind_theme.components_backToTopEnabled|default(false) %}
        {% include '@ItechWorldSuluTailwindTheme/components/_back_to_top.html.twig' with {
            threshold: iw_sulu_tailwind_theme.components_backToTopThreshold|default(400),
        } only %}
    {% endif %}

    {% block javascripts %}{% endblock %}
    {{ encore_entry_script_tags('app') }}
</body>
</html>
