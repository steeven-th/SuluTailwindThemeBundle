{#
    Shared content-block dispatcher.
    Renders a list of Sulu content blocks through the per-type style templates
    (blocks/<type>/_style_<style>.html.twig) with a single default-style map,
    so blocks behave exactly the same wherever they are rendered (pages and
    article pages alike — no extra container: each block template owns its own
    layout and width).

    Include WITHOUT `only` so the block templates keep access to the rendering
    context, exactly as when dispatched from a page template.

    Parameters:
    - blocks: the list of content blocks (content.blocks)
#}
{% if blocks is defined and blocks is iterable %}
    {% for contentBlock in blocks %}
        {% set blockType = contentBlock.type|default('text') %}

        {# Resolve to a guaranteed-existing style template: explicit style →
           curated per-type default → first available style on disk. Returns
           null only when the block type has no renderable style at all, so a
           block without a style (imports, programmatic/AI-generated content)
           or with a legacy value never breaks the whole page. #}
        {% set templatePath = iw_sulu_tailwind_theme_block_template(blockType, contentBlock.style|default('')) %}

        {% if templatePath is not null %}
            {% include templatePath with contentBlock %}
        {% endif %}
    {% endfor %}
{% endif %}
