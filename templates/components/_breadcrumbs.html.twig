{#
    Breadcrumbs component with schema.org BreadcrumbList microdata.

    Parameters:
    - items: array of {title, url} objects (breadcrumb trail)
              If not provided, uses Sulu navigation.
#}
{% if items is defined and items is iterable and items|length > 0 %}
    <nav aria-label="Breadcrumb" class="iw-breadcrumbs">
        <ol class="iw-breadcrumbs__list"
            itemscope itemtype="https://schema.org/BreadcrumbList">
            {% for item in items %}
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"
                    class="iw-breadcrumbs__item">
                    {% if not loop.last %}
                        <a href="{{ item.url }}" itemprop="item" class="iw-breadcrumbs__link">
                            <span itemprop="name">{{ item.title }}</span>
                        </a>
                        <meta itemprop="position" content="{{ loop.index }}">
                        <svg class="iw-breadcrumbs__separator" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    {% else %}
                        <span itemprop="name" class="iw-breadcrumbs__current">{{ item.title }}</span>
                        <meta itemprop="position" content="{{ loop.index }}">
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
