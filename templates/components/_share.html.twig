{#
    Share buttons (F5 reading component).
    A row of share actions for the current page: native share (Web Share API),
    copy link, and email. Pure progressive enhancement: the native and copy
    buttons need JavaScript and are hidden in markup, revealed by the Stimulus
    controller; the email link works without JS.

    When the Web Share API is unavailable, the native button falls back to
    copying the link — or hides itself when a dedicated copy button is shown.

    Rendered on article pages by _article_base.html.twig when enabled
    (Articles > Reading components). Reusable: include it in your own templates
    to share any URL.

    Appearance: by default the buttons wear the neutral surface skin (adapts to
    light/dark themes, tunable via --iw-share-*); when a theme button style is
    configured (Articles > Reading components), iw-button--<style> owns the
    colors instead.

    Parameters (all optional):
    - url: URL to share (default: current request URI)
    - title: title passed to the share sheet / email subject (default: content.title)
    - native: show the native share button (default true)
    - copy: show the copy-link button (default true)
    - email: show the email link (default true)
    - buttonStyle: theme button variant (primary/secondary/accent; empty = neutral surface style)
#}
{% set shareUrl = url ?? app.request.uri %}
{% set shareTitle = title ?? content.title|default('') %}
{% set showNative = native ?? true %}
{% set showCopy = copy ?? true %}
{% set showEmail = email ?? true %}
{% set buttonClass = 'iw-share__button' ~ ((buttonStyle ?? '') is not empty ? ' iw-button--' ~ buttonStyle : '') %}

{% if showNative or showCopy or showEmail %}
    <div class="iw-share"
         role="group"
         aria-label="{{ 'iw_sulu_tailwind_theme.share'|trans }}"
         data-controller="share"
         data-share-url-value="{{ shareUrl }}"
         data-share-title-value="{{ shareTitle }}"
         data-share-copied-text-value="{{ 'iw_sulu_tailwind_theme.share_copied'|trans }}">
        {% if showNative %}
            <button type="button" class="{{ buttonClass }}" hidden
                    data-share-target="native"
                    data-action="share#share">
                <svg class="iw-share__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                    <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98"/>
                </svg>
                {{ 'iw_sulu_tailwind_theme.share'|trans }}
            </button>
        {% endif %}

        {% if showCopy %}
            <button type="button" class="{{ buttonClass }}" hidden
                    data-share-target="copy"
                    data-action="share#copy">
                <svg class="iw-share__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                {{ 'iw_sulu_tailwind_theme.share_copy'|trans }}
            </button>
        {% endif %}

        {% if showEmail %}
            <a class="{{ buttonClass }}"
               href="mailto:?subject={{ shareTitle|url_encode }}&body={{ shareUrl|url_encode }}">
                <svg class="iw-share__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <path d="M22 6l-10 7L2 6"/>
                </svg>
                {{ 'iw_sulu_tailwind_theme.share_email'|trans }}
            </a>
        {% endif %}

        {# Live region announcing the copy feedback; filled then cleared by the controller. #}
        <span class="iw-share__feedback" role="status" data-share-target="feedback"></span>
    </div>
{% endif %}
