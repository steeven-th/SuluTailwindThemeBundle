{#
    Pagination component with previous/next, page numbers, and ellipsis.

    Parameters:
    - currentPage: int (current page number, 1-based)
    - totalPages: int (total number of pages)
    - baseUrl: string (URL pattern, the page query param is appended)
    - queryParams: hash (optional) extra query params to preserve in every link
      (e.g. the active article filters), merged with the page number.
#}
{% set currentPage = currentPage|default(1) %}
{% set totalPages = totalPages|default(1) %}
{% set queryParams = queryParams|default({}) %}

{# Build a page URL preserving the active query params (filters, sort, search). #}
{% macro page_url(baseUrl, queryParams, page) -%}
    {{- baseUrl }}?{{ queryParams|merge({page: page})|url_encode -}}
{%- endmacro %}
{% import _self as iw_pagination %}

{% if totalPages > 1 %}
    <nav aria-label="Pagination" class="iw-pagination">
        {# Previous button #}
        {% if currentPage > 1 %}
            <a href="{{ iw_pagination.page_url(baseUrl, queryParams, currentPage - 1) }}"
               class="iw-pagination__arrow iw-pagination__arrow--prev"
               aria-label="{{ 'iw_sulu_tailwind_theme.article.pagination_previous'|trans }}">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>
        {% endif %}

        {# Page numbers with ellipsis #}
        {% for page in 1..totalPages %}
            {% if page == 1 or page == totalPages or (page >= currentPage - 2 and page <= currentPage + 2) %}
                {% if page == currentPage %}
                    <span class="iw-pagination__link iw-pagination__link--current" aria-current="page">
                        {{ page }}
                    </span>
                {% else %}
                    <a href="{{ iw_pagination.page_url(baseUrl, queryParams, page) }}" class="iw-pagination__link">
                        {{ page }}
                    </a>
                {% endif %}
            {% elseif page == 2 or page == totalPages - 1 %}
                <span class="iw-pagination__ellipsis">&hellip;</span>
            {% endif %}
        {% endfor %}

        {# Next button #}
        {% if currentPage < totalPages %}
            <a href="{{ iw_pagination.page_url(baseUrl, queryParams, currentPage + 1) }}"
               class="iw-pagination__arrow iw-pagination__arrow--next"
               aria-label="{{ 'iw_sulu_tailwind_theme.article.pagination_next'|trans }}">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        {% endif %}
    </nav>
{% endif %}
