{#
    Tags component — renders a list of tags as pills. Generic and reusable
    anywhere (article excerpts, taxonomies, etc.).

    Parameters:
    - tags: array of tag objects (each with a `name`, or a plain string)
    - size: 'sm' for the compact variant (e.g. article headers)

    Public CSS API:
    - .iw-tags (block — flex row wrapper)
    - .iw-tags--sm (compact modifier — smaller pills)
    - .iw-tag (single tag pill with hover state)
    - .iw-tag--variant-{primary|secondary|accent} (color variants)

    Override via --iw-tag-{padding,font-size,font-weight,border,radius,text,hover-bg,hover-text,hover-border}
    and --iw-tags-gap. See doc/css-api/transverse.md.
#}
{% if tags is defined and tags is iterable and tags|length > 0 %}
    <div class="iw-tags{% if size|default('') == 'sm' %} iw-tags--sm{% endif %}">
        {% for tag in tags %}
            <span class="iw-tag">
                {{ tag.name|default(tag) }}
            </span>
        {% endfor %}
    </div>
{% endif %}
