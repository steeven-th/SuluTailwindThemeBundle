{#
    Back-to-top button (F5 reading component).
    A floating button that fades in once the page is scrolled past a threshold
    and smoothly scrolls back to the top on click. Pure progressive enhancement:
    hidden in markup, revealed by the Stimulus controller.

    Site-wide component: the bundle's base.html.twig renders it when enabled
    (Components > Site-wide components). If you use your own base template, copy
    the include below into it (before the closing body tag).

    Appearance (shape, size, colors) comes from --iw-back-to-top-* generated by
    the ThemeCompiler. The icon is a preset SVG, or a custom image from the media
    library when one is selected — both read from the theme config globals.

    Parameters:
    - threshold: scroll distance in px before the button appears (default 400)
#}
{% set btIconMedia = iw_sulu_tailwind_theme.components_backToTopIconMedia|default(null) %}
{% set btIconKey = iw_sulu_tailwind_theme.components_backToTopIcon|default('arrow') %}
{% set btCustomIconUrl = null %}
{% if btIconMedia is not null and btIconMedia.id|default(null) is not null %}
    {% set btResolvedIcon = sulu_resolve_media(btIconMedia.id, app.request.locale) %}
    {% if btResolvedIcon is not null %}
        {% set btCustomIconUrl = btResolvedIcon.url|default(null) %}
    {% endif %}
{% endif %}

<button type="button"
        class="iw-back-to-top"
        hidden
        data-controller="back-to-top"
        data-back-to-top-threshold-value="{{ threshold|default(400) }}"
        data-action="back-to-top#toTop"
        aria-label="{{ 'iw_sulu_tailwind_theme.back_to_top'|trans }}">
    {% if btCustomIconUrl %}
        <img class="iw-back-to-top__icon" src="{{ btCustomIconUrl }}" alt="" aria-hidden="true">
    {% else %}
        <svg class="iw-back-to-top__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {% if btIconKey == 'chevron' %}
                <path d="M6 15l6-6 6 6"/>
            {% elseif btIconKey == 'chevron_double' %}
                <path d="M6 17l6-6 6 6M6 11l6-6 6 6"/>
            {% elseif btIconKey == 'arrow_line' %}
                <path d="M12 21V3M6 9l6-6 6 6"/>
            {% else %}
                <path d="M12 19V5M5 12l7-7 7 7"/>
            {% endif %}
        </svg>
    {% endif %}
</button>
