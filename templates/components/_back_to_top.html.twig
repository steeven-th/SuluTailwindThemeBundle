{#
    Back-to-top button (F5 reading component).
    A floating button that fades in once the page is scrolled past a threshold
    and smoothly scrolls back to the top on click. Pure progressive enhancement:
    hidden in markup, revealed by the Stimulus controller.

    Site-wide component: the bundle's base.html.twig renders it when enabled
    (Default settings > Navigation). If you use your own base template, copy the
    include below into it (before the closing body tag).

    Appearance (shape, size, colors) comes from --iw-back-to-top-* generated by
    the ThemeCompiler. The icon comes from the theme library, or is a custom
    image from the media library when one is selected — both read from the theme
    config globals.

    Parameters:
    - threshold: scroll distance in px before the button appears (default 400)
#}
{# The media only counts when the toggle asks for it, as everywhere else the
   bundle offers this pair: leaving a media behind after switching back would
   otherwise keep overriding the icon. #}
{% set btIconCustom = iw_sulu_tailwind_theme.components_backToTopIconCustom|default(false) %}
{% set btIconMedia = btIconCustom ? iw_sulu_tailwind_theme.components_backToTopIconMedia|default(null) : null %}
{#  The field offered four shapes before it offered the whole library, and
    those four are still stored on existing themes. Each has an exact
    equivalent, so they are read through this table rather than migrated: the
    old set of values is finite and known, which is precisely when a table
    beats a migration command - nothing to run, nothing that can half-run. #}
{% set btLegacyIcons = {
    'arrow': 'arrow-up',
    'chevron': 'chevron-up',
    'chevron_double': 'chevron-double-up',
    'arrow_line': 'arrow-long-up',
} %}
{% set btStoredIcon = iw_sulu_tailwind_theme.components_backToTopIcon|default('arrow-up') %}
{% set btIconName = btLegacyIcons[btStoredIcon]|default(btStoredIcon) %}
{% set btCustomIconUrl = null %}
{% if btIconMedia is not null and btIconMedia.id|default(null) is not null %}
    {% set btResolvedIcon = sulu_resolve_media(btIconMedia.id, app.request.locale) %}
    {% if btResolvedIcon is not null %}
        {% set btCustomIconUrl = btResolvedIcon.url|default(null) %}
    {% endif %}
{% endif %}

<button type="button"
        class="iw-back-to-top"
        hidden
        data-controller="back-to-top"
        data-back-to-top-threshold-value="{{ threshold|default(400) }}"
        data-action="back-to-top#toTop"
        aria-label="{{ 'iw_sulu_tailwind_theme.back_to_top'|trans }}">
    {% if btCustomIconUrl %}
        <img class="iw-back-to-top__icon" src="{{ btCustomIconUrl }}" alt="" aria-hidden="true">
    {% else %}
        {{ iw_sulu_tailwind_theme_icon(btIconName, 'outline', {
            'class': 'iw-back-to-top__icon',
            'aria-hidden': 'true',
        }) }}
    {% endif %}
</button>
