{# One button, from an `iw_theme_button` field.

   {% set button = iw_sulu_tailwind_theme_button(content.cta, view.cta) %}
   {% include '@ItechWorldSuluTailwindTheme/components/_button.html.twig' with {
       button: button,
       class: 'iw-menu__button',
   } only %}

   Expected variables:
     - button   : what iw_sulu_tailwind_theme_button() returns. Null renders
                  nothing, so a button whose page was unpublished leaves no
                  dead link behind.
     - class    : extra classes on the anchor
     - tag      : 'span' to draw the button inside an element that is already
                  the link (a clickable card), 'a' otherwise. A span carries no
                  link attributes, the element around it does.
     - iconOnly : force the pictogram alone (true), or the label back (false),
                  whatever the field says. A button without a pictogram always
                  shows its label.

   The style is the button style of the theme, read per site. Shown as its
   pictogram alone, the pictogram is the button: no background, no border, the
   colour of the style (`.iw-button--icon-only`). The label stays in the
   anchor for assistive technologies, never in an aria-label on the icon: one
   accessible name, the same one a sighted user reads elsewhere. #}
{% import '@ItechWorldSuluTailwindTheme/components/_link_macros.html.twig' as links %}

{% if button is defined and button is not null %}
    {% set buttonStyle = iw_sulu_tailwind_theme_site_value(button.style|default('')) %}
    {% set buttonIcon %}
        {%- if button.icon -%}
            {%- include '@ItechWorldSuluTailwindTheme/blocks/common/_icon.html.twig' with {
                icon: button.icon,
                class: 'iw-button__icon',
                recolor: true,
            } only -%}
        {%- endif -%}
    {% endset %}
    {% set buttonHasIcon = buttonIcon|trim is not empty %}
    {% set buttonIconOnly = buttonHasIcon and (iconOnly ?? button.iconOnly) %}
    {% set buttonIconLeft = button.icon.position|default('right') == 'left' %}
    {# The gap between the icon and the label, from the spacing scale: a class
       per step rather than an inline style. #}
    {% set buttonGap = button.icon.gap|default('') matches '/^gap-\\d+$/' ? ' iw-button--icon-' ~ button.icon.gap : '' %}

    {% set buttonTag = tag|default('a') == 'span' ? 'span' : 'a' %}
    <{{ buttonTag }} {% if buttonTag == 'a' %}{{ links.attrs({url: button.url, target: button.target, rel: button.rel}) }}{% endif %}
       class="{{ buttonStyle ? 'iw-button--' ~ buttonStyle : 'iw-button--variant' }}{{ buttonHasIcon ? ' iw-button--with-icon' ~ buttonGap : '' }}{{ buttonIconOnly ? ' iw-button--icon-only' : '' }}{{ class|default('') ? ' ' ~ class : '' }}">
        {%- if buttonHasIcon and (buttonIconLeft or buttonIconOnly) %}{{ buttonIcon }}{% endif -%}
        <span class="{{ buttonIconOnly ? 'sr-only' : 'iw-button__label' }}">{{ button.label }}</span>
        {%- if buttonTag == 'a' %}{{ links.new_tab_hint({newTab: button.newTab}) }}{% endif -%}
        {%- if buttonHasIcon and not buttonIconLeft and not buttonIconOnly %}{{ buttonIcon }}{% endif -%}
    </{{ buttonTag }}>
{% endif %}
