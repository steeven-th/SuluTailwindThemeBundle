{# Consent placeholder - what a third-party embed shows until it is allowed.
   Shared by the embedded frame (iframe and code blocks, video widget) and the
   location map. Must sit inside an element carrying the `consent` controller.

   Expected variables:
     - service: the service key, `embed` when empty
     - serviceLabel: name shown to the visitor, the one of the third-party
       services inventory when omitted (doc/consent.md)
     - consentMode: 'placeholder' or 'delegated', picks the button label
     - consentText: editor text replacing the default one
     - consentImage: optional media `{id}`, a decorative background. Falls
       back to the picture set for the whole site in the theme (Default
       settings > Blocks), then to none
     - consentButtonStyle: theme button style, the variant one by default
     - details: optional line under the text (the address of a map)
#}
{# What the visitor is owed before agreeing: who receives their data, and
   under which policy. A generic embed names no one, there is no one to name,
   but it is looked up all the same: a cookie manager can only grant it once
   the inventory declares it. #}
{% set service = service|default('') is not empty ? service : 'embed' %}
{% set isGeneric = service == 'embed' %}
{% set serviceInfo = iw_sulu_tailwind_theme_third_party_service(service) %}
{% set serviceLabel = serviceLabel|default('') is not empty
    ? serviceLabel
    : (isGeneric ? 'iw_sulu_tailwind_theme.consent_generic_provider'|trans : serviceInfo.label) %}
{% set consentImage = consentImage.id|default(null) is not null
    ? consentImage
    : iw_sulu_tailwind_theme.components_consentImage|default(null) %}
{# data-consent-declared tells the controller whether the inventory lists
   the service, so it can report one a cookie manager will never grant.
   Absent when the site keeps no inventory. #}
<div class="iw-embed__consent" data-consent-target="placeholder"
     {%- if serviceInfo.declared is not null %} data-consent-declared="{{ serviceInfo.declared ? 'true' : 'false' }}"{% endif %}>
    {% if consentImage|default(null) is not null and consentImage.id|default(null) is not null %}
        {% set consentMedia = sulu_resolve_media(consentImage.id, app.request.locale) %}
        {# A media deleted from the library resolves to null: the consent
           panel stays, it just loses its illustration. #}
        {% if consentMedia is not null %}
            <img src="{{ consentMedia.url }}" alt="" loading="lazy" class="iw-embed__consent-image">
        {% endif %}
    {% endif %}

    <div class="iw-embed__consent-body">
        <p class="iw-embed__consent-text">
            {{ consentText|default('') is not empty
                ? consentText
                : 'iw_sulu_tailwind_theme.consent_default_text'|trans({'%service%': serviceLabel}) }}
        </p>
        {% if details|default('') is not empty %}
            <p class="iw-embed__consent-details">{{ details|nl2br }}</p>
        {% endif %}
        {% if not isGeneric and (serviceInfo.company is not empty or serviceInfo.policy is not empty) %}
            <p class="iw-embed__consent-provider">
                {% if serviceInfo.company is not empty %}
                    <span class="iw-embed__consent-company">{{ 'iw_sulu_tailwind_theme.consent_data_recipient'|trans({'%company%': serviceInfo.company}) }}</span>
                {% endif %}
                {% if serviceInfo.policy is not empty %}
                    <a class="iw-embed__consent-policy" href="{{ serviceInfo.policy }}" target="_blank" rel="noopener noreferrer">{{ 'iw_sulu_tailwind_theme.consent_privacy_policy'|trans }}</a>
                {% endif %}
            </p>
        {% endif %}
        {# Reuses the theme's button style so the placeholder matches
           every other button on the site, variant included. #}
        <button type="button" class="iw-embed__consent-button {{ consentButtonStyle|default('') ? 'iw-button--' ~ consentButtonStyle : 'iw-button--variant' }}" data-action="consent#accept">
            {{ (consentMode|default('placeholder') == 'delegated'
                ? 'iw_sulu_tailwind_theme.consent_open_preferences'
                : 'iw_sulu_tailwind_theme.consent_load')|trans }}
        </button>
    </div>
</div>
