{#
    Auto breadcrumb — reads the theme "Components" config, builds the trail from
    Sulu's native page breadcrumb, and renders the generic _breadcrumbs component.

    Parameters:
    - context: 'page' (default) or 'article' — gates display via breadcrumbs_enabled.
    - pageUuid: UUID used to resolve the page trail.
        · pages:    resource.uuid
        · articles: view.url.page.uuid (parent page of a page_tree_route article)
    - currentTitle: appended as the current (non-link) item — used for articles
        whose own title is not part of the page trail.
    - align: override the global horizontal alignment (left | center | right).
        Defaults to the theme config; used by the page hero to follow the title.
    - output: 'html' (default) renders the visible trail, 'jsonld' renders the
        schema.org BreadcrumbList for the <head>. Search engines get the trail
        whatever the display settings say: 'jsonld' ignores breadcrumbs_enabled
        and always starts from the home page. An item without a name is
        skipped (Google rejects an empty "name"), and a trail of a single item,
        the home page itself, emits nothing.

    Config (theme tokens, Components tab):
    - breadcrumbs_enabled: off | pages | articles | both (default both)
    - breadcrumbs_homeLink: prepend a Home link (default true)
    - breadcrumbs_homeLabel: custom Home label (falls back to a translation)
    - breadcrumbs_separator: chevron | slash | dot (default chevron)
    - breadcrumbs_align: left | center | right (default left)
#}
{% set cfg = iw_sulu_tailwind_theme|default({}) %}
{% set jsonld = output|default('html') == 'jsonld' %}
{% set enabled = cfg.breadcrumbs_enabled|default('both') %}
{% set ctx = context|default('page') %}
{% set show = jsonld or enabled == 'both' or enabled == (ctx == 'article' ? 'articles' : 'pages') %}

{% set hasUuid = pageUuid is defined and pageUuid %}
{% set hasTitle = currentTitle is defined and currentTitle|trim is not empty %}

{% if show and (hasUuid or (ctx == 'article' and hasTitle)) %}
    {% set items = [] %}
    {% set homeLink = jsonld or cfg.breadcrumbs_homeLink|default(true) %}
    {% set homeLabel = cfg.breadcrumbs_homeLabel|default('')|trim %}
    {% set homeFallback = 'iw_sulu_tailwind_theme.breadcrumbs_home'|trans({}, 'messages') %}

    {% if hasUuid %}
        {# Native Sulu trail (homepage → … → current page). The FIRST item is the
           webspace homepage: the Home toggle keeps/hides it, the label renames it. #}
        {% for item in sulu_page_breadcrumb(pageUuid) %}
            {% set itemTitle = item.title|default('')|trim %}
            {% if loop.first %}
                {% if homeLink %}
                    {% set items = items|merge([{ title: homeLabel ?: (itemTitle ?: homeFallback), url: sulu_content_path(item.url) }]) %}
                {% endif %}
            {% elseif itemTitle is not empty %}
                {% set items = items|merge([{ title: itemTitle, url: sulu_content_path(item.url) }]) %}
            {% endif %}
        {% endfor %}
    {% elseif homeLink %}
        {# Article without a page trail → a single manual Home item #}
        {% set items = items|merge([{
            title: homeLabel ?: homeFallback,
            url: sulu_content_root_path(),
        }]) %}
    {% endif %}

    {# Article: append its own title as the current item #}
    {% if ctx == 'article' and hasTitle %}
        {% set items = items|merge([{ title: currentTitle|trim, url: '' }]) %}
    {% endif %}

    {% if jsonld %}
        {% if items|length > 1 %}
            {% include '@ItechWorldSuluTailwindTheme/seo/_jsonld_breadcrumb.html.twig' with { items: items } only %}
        {% endif %}
    {% else %}
        {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumbs.html.twig' with {
            items: items,
            separator: cfg.breadcrumbs_separator|default('chevron'),
            align: align|default(cfg.breadcrumbs_align|default('left')),
        } only %}
    {% endif %}
{% endif %}
