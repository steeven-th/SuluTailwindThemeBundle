{#
    Event style: Timeline
    Two columns: sidebar left (dates/location/organizer) + main content right.
    Sidebar becomes top section on mobile.
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{% block article_hero %}
    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_hero.html.twig' with {
        image: content.heroImage|default(null),
        style: 'contained',
    } only %}
{% endblock %}

{% block article_header %}
    <header class="iw-article-page__header mb-6">
        {% if articleConfig.showCategories|iw_article_visible('page') %}
            {% include '@ItechWorldSuluTailwindTheme/components/_categories.html.twig' with {
                categories: extension.excerpt.categories|default([]),
            } only %}
        {% endif %}

        <h1 class="font-[var(--font-h1-family)] text-[var(--font-size-h1)] font-[var(--font-h1-weight)] leading-[var(--line-height-h1)] mt-3 mb-4" itemprop="headline">
            {{ content.title }}
        </h1>

        {% set articleExcerpt = extension.excerpt.description|default('')|striptags|trim %}
        {% if articleConfig.showExcerpts|iw_article_visible('page') and articleExcerpt %}
            <p class="iw-article-page__excerpt">{{ articleExcerpt }}</p>
        {% endif %}

        {% if articleConfig.showTags|iw_article_visible('page') %}
            {% include '@ItechWorldSuluTailwindTheme/components/_tags.html.twig' with {
                tags: extension.excerpt.tags|default([]),
                size: 'sm',
            } only %}
        {% endif %}
    </header>
{% endblock %}

{% block article_meta %}{% endblock %}

{# A floating TOC would overlap the column layout — when "sticky" is chosen it
   is rendered inside the sticky column instead (see below); the inline
   placement keeps the default behavior. #}
{% block article_toc %}
    {% if articleConfig.tocPosition|default('inline') == 'inline' %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Column layout exception (like blog sidebar): the blocks stay constrained to
   the main column next to the sticky event card. article_content sits outside
   the page container in _article_base, so this style brings its own. #}
{% block article_content %}
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mt-8">
        {# Sidebar: event details #}
        <aside class="md:col-span-1">
            {# flex+gap (not space-y): the gap spaces the widgets regardless of
               their own margins (the TOC resets its margin inside an aside). #}
            <div class="md:sticky md:top-24 flex flex-col gap-6">
                {% include '@ItechWorldSuluTailwindTheme/articles/common/_event_info_card.html.twig' with {
                    startDate: content.startDate|default(null),
                    endDate: content.endDate|default(null),
                    isOnline: content.isOnline|default(false),
                    location: content.location|default(''),
                    locationUrl: content.locationUrl|default(''),
                    organizer: content.organizer|default([]),
                } only %}

                {# Table of contents — the "sticky" position materializes here,
                   inside the sticky column (a viewport-pinned panel would
                   overlap the layout). #}
                {% if articleConfig.tocEnabled and articleConfig.tocPosition == 'sticky' %}
                    {% include '@ItechWorldSuluTailwindTheme/components/_toc.html.twig' with {
                        position: 'inline',
                        depth: articleConfig.tocDepth,
                    } only %}
                {% endif %}
            </div>
        </aside>

        {# Main content #}
        <div class="md:col-span-3">
            {% include '@ItechWorldSuluTailwindTheme/components/_blocks.html.twig' with {
                blocks: content.blocks|default([]),
            } %}
        </div>
    </div>
    </div>
{% endblock %}

