{#
    Blog Post style: Classic
    Hero image → title → prominent author avatar + date + reading time → content → tags → related
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{# The hero hosts the breadcrumb as a bottom overlay; without a hero image,
   fall back to the default placement (before the <article>). #}
{% block article_breadcrumb %}
    {% if content.heroImage is not defined or content.heroImage is empty %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block article_hero %}
    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_hero.html.twig' with {
        image: content.heroImage|default(null),
        style: 'fullwidth',
        breadcrumb: true,
        breadcrumbPageUuid: view.url.page.uuid|default(null),
        breadcrumbCurrentTitle: content.title|default(''),
    } only %}
{% endblock %}

{% block article_header %}
    <header class="iw-article-page__header mt-8 mb-6">
        <h1 class="font-[var(--font-h1-family)] text-[var(--font-size-h1)] font-[var(--font-h1-weight)] leading-[var(--line-height-h1)] mb-6" itemprop="headline">
            {{ content.title }}
        </h1>
        {% if content.subtitle is defined and content.subtitle is not empty %}
            <p class="iw-article-page__subtitle">
                {{ content.subtitle }}
            </p>
        {% endif %}

        {# Prominent author display #}
        {% if articleConfig.showAuthors|iw_article_visible('page') and articleAuthors is defined and articleAuthors|length > 0 %}
            <div class="flex items-center gap-4 mb-4">
                {% for author in articleAuthors %}
                    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_author.html.twig' with {
                        author: author,
                        size: 'lg',
                    } only %}
                {% endfor %}
            </div>
        {% endif %}

        {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_meta.html.twig' with {
            date: authored|default(null),
            readingTime: content.readingTime|default(null),
            categories: extension.excerpt.categories|default([]),
            showDate: articleConfig.showDates|iw_article_visible('page'),
            showAuthors: false,
            showCategories: articleConfig.showCategories|iw_article_visible('page'),
        } only %}

        {% set articleExcerpt = extension.excerpt.description|default('')|striptags|trim %}
        {% if articleConfig.showExcerpts|iw_article_visible('page') and articleExcerpt %}
            <p class="iw-article-page__excerpt">{{ articleExcerpt }}</p>
        {% endif %}

        {% if articleConfig.showTags|iw_article_visible('page') %}
            {% include '@ItechWorldSuluTailwindTheme/components/_tags.html.twig' with {
                tags: extension.excerpt.tags|default([]),
                size: 'sm',
            } only %}
        {% endif %}
    </header>
    <hr class="mb-8 border-[var(--color-border)]">
{% endblock %}

{% block article_meta %}{% endblock %}

