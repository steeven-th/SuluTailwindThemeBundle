{#
    Blog Post style: Editorial
    Large title as hero text with background image overlay → drop cap on first paragraph → content → related.
    No inline style — uses a Twig <style> block for the background image.
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{% block article_hero %}
    {# Resolve hero image for background (iw_theme_hero — `iw_hero_lg` is not a
       defined format; the avif/webp keys only exist when the driver supports them). #}
    {% set heroFormat = 'iw_theme_hero' %}
    {% set heroBgUrl = null %}
    {% set heroBgAvif = null %}
    {% set heroBgWebp = null %}
    {% set heroFocus = '' %}
    {% if content.heroImage is defined and content.heroImage is not empty %}
        {% set heroId = content.heroImage %}
        {% if heroId %}
            {% set heroMedia = sulu_resolve_media(heroId, app.request.locale) %}
            {# A media deleted from the library resolves to null: the header keeps
               its layout, only the background image is dropped. #}
            {% if heroMedia is not null %}
                {% set avifEnabled = iw_sulu_tailwind_theme.imageAvif is defined ? iw_sulu_tailwind_theme.imageAvif : true %}
                {% set heroBgUrl = heroMedia.thumbnails[heroFormat]|default(heroMedia.url) %}
                {% set heroBgAvif = avifEnabled ? heroMedia.thumbnails[heroFormat ~ '.avif']|default(null) : null %}
                {% set heroBgWebp = heroMedia.thumbnails[heroFormat ~ '.webp']|default(null) %}
                {% set heroFocus = iw_sulu_tailwind_theme_focus_class(heroMedia.focusPointX|default(null), heroMedia.focusPointY|default(null), 'bg') %}
            {% endif %}
        {% endif %}
    {% endif %}

    <div class="iw-article-hero iw-article-hero--editorial relative flex items-end min-h-[60vh] {{ heroBgUrl ? ('bg-cover ' ~ (heroFocus ?: 'bg-center')) : 'bg-[var(--color-primary-900)]' }}" itemprop="image" content="{{ heroBgUrl|default('') }}">
        {% if heroBgUrl %}
            {# Background image; avif/webp offered via image-set() with the base url as fallback. #}
            <style>
                .iw-article-hero--editorial { background-image: url('{{ heroBgUrl }}'); }
                {% if heroBgAvif or heroBgWebp %}
                .iw-article-hero--editorial {
                    background-image: image-set(
                        {%- if heroBgAvif %} url('{{ heroBgAvif }}') type('image/avif'),{% endif %}
                        {%- if heroBgWebp %} url('{{ heroBgWebp }}') type('image/webp'),{% endif %}
                        url('{{ heroBgUrl }}'));
                }
                {% endif %}
            </style>
        {% endif %}
        {# Dark overlay for text readability #}
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>

        {# Same structure as the content-block wrappers (px-5 outside, container
           inside): the text never touches the window edge on narrow viewports,
           and stays aligned with the blocks' container on desktop. #}
        <div class="relative z-10 w-full px-5 pb-12 pt-32">
        <div class="container mx-auto">
            {% if articleConfig.showCategories|iw_article_visible('page') %}
                {% include '@ItechWorldSuluTailwindTheme/components/_categories.html.twig' with {
                    categories: extension.excerpt.categories|default([]),
                } only %}
            {% endif %}

            <h1 class="font-[var(--font-h1-family)] text-4xl md:text-5xl lg:text-6xl font-[var(--font-h1-weight)] leading-tight text-white mt-4 mb-4" itemprop="headline">
                {{ content.title }}
            </h1>
            {% if content.subtitle is defined and content.subtitle is not empty %}
                <p class="iw-article-page__subtitle iw-article-page__subtitle--light">
                    {{ iw_sulu_tailwind_theme_title_markup(content.subtitle) }}
                </p>
            {% endif %}

            {% set articleExcerpt = extension.excerpt.description|default('')|striptags|trim %}
            {% if articleConfig.showExcerpts|iw_article_visible('page') and articleExcerpt %}
                <p class="iw-article-page__excerpt iw-article-page__excerpt--light">{{ articleExcerpt }}</p>
            {% endif %}

            <div class="flex flex-wrap items-center gap-4 text-white/80 text-sm">
                {% if articleConfig.showAuthors|iw_article_visible('page') and articleAuthors is defined and articleAuthors|length > 0 %}
                    {# Same component as the other blog styles, so this one also
                       shows the author's picture instead of a bare name. #}
                    {% for author in articleAuthors %}
                        {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_author.html.twig' with {
                            author: author,
                            size: 'sm',
                            light: true,
                        } only %}
                    {% endfor %}
                {% endif %}
                {% if articleConfig.showDates|iw_article_visible('page') and authored is defined and authored is not empty %}
                    <span>&middot;</span>
                    <time datetime="{{ authored|date('c') }}">{{ iw_sulu_tailwind_theme_format_date(authored) }}</time>
                {% endif %}
                {% if content.readingTime is defined and content.readingTime is not empty %}
                    <span>&middot;</span>
                    <span>{{ content.readingTime }}</span>
                {% endif %}
            </div>

            {% if articleConfig.showTags|iw_article_visible('page') %}
                {% include '@ItechWorldSuluTailwindTheme/components/_tags.html.twig' with {
                    tags: extension.excerpt.tags|default([]),
                    size: 'sm',
                } only %}
            {% endif %}

            {% include '@ItechWorldSuluTailwindTheme/components/_article_share.html.twig' with {
                articleConfig: articleConfig,
                content: content,
                position: 'header',
            } only %}

            {# Breadcrumb inside the hero flow — the hero's own overlay already
               darkens the image, so the inline variant drops the gradient. #}
            {% if iw_sulu_tailwind_theme.breadcrumbs_enabled|default('both') in ['both', 'articles'] %}
                <div class="iw-article-hero__breadcrumb iw-article-hero__breadcrumb--inline">
                    {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                        context: 'article',
                        pageUuid: view.url.page.uuid|default(null),
                        currentTitle: content.title|default(''),
                    } only %}
                </div>
            {% endif %}
        </div>
        </div>
    </div>
{% endblock %}

{# Breadcrumb and header share row live inside the hero (above) — the hero is
   always rendered (dark background without an image), so no fallback needed. #}
{% block article_breadcrumb %}{% endblock %}
{% block article_share_header %}{% endblock %}

{% block article_header %}{% endblock %}
{% block article_meta %}{% endblock %}

{% block article_content %}
    {# Bare wrapper: carries only the drop cap on the first block (style in
       app.css), without constraining the blocks' own layout/width. #}
    <div class="iw-article-page__body--dropcap">
        {% include '@ItechWorldSuluTailwindTheme/components/_blocks.html.twig' with {
            blocks: content.blocks|default([]),
        } %}
    </div>
{% endblock %}

