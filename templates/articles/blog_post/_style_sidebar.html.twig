{#
    Blog Post style: Sidebar
    Two columns: content left (70%) + sidebar right (30%) with author, categories, tags.
    Sidebar becomes bottom section on mobile.
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{% block article_hero %}
    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_hero.html.twig' with {
        image: content.heroImage|default(null),
        style: 'contained',
    } only %}
{% endblock %}

{% block article_header %}
    <header class="iw-article-page__header mb-6">
        <h1 class="font-[var(--font-h1-family)] text-[var(--font-size-h1)] font-[var(--font-h1-weight)] leading-[var(--line-height-h1)] mb-4" itemprop="headline">
            {{ content.title }}
        </h1>
        {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_meta.html.twig' with {
            date: authored|default(null),
            authors: articleAuthors|default([]),
            readingTime: content.readingTime|default(null),
            showDate: articleConfig.showDates|iw_article_visible('page'),
            showAuthors: articleConfig.showAuthors|iw_article_visible('page'),
            showCategories: false,
            compact: true,
        } only %}

        {% set articleExcerpt = extension.excerpt.description|default('')|striptags|trim %}
        {% if articleConfig.showExcerpts|iw_article_visible('page') and articleExcerpt %}
            <p class="iw-article-page__excerpt">{{ articleExcerpt }}</p>
        {% endif %}
    </header>
{% endblock %}

{% block article_meta %}{% endblock %}

{# A floating TOC would overlap the side column — when "sticky" is chosen it
   is rendered at the top of the sticky column instead (see below); the
   inline placement keeps the default behavior. #}
{% block article_toc %}
    {% if articleConfig.tocPosition|default('inline') == 'inline' %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Sidebar layout exception: the blocks stay constrained to the main column.
   article_content sits outside the page container in _article_base, so this
   style brings its own container around the two-column grid. #}
{% block article_content %}
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-10 mt-8">
        {# Main content (70%) #}
        <div class="lg:col-span-7">
            {% include '@ItechWorldSuluTailwindTheme/components/_blocks.html.twig' with {
                blocks: content.blocks|default([]),
            } %}
        </div>

        {# Sidebar (30%) #}
        <aside class="lg:col-span-3">
            {# flex+gap (not space-y): the gap spaces the widgets regardless of
               their own margins (the TOC resets its margin inside an aside). #}
            <div class="lg:sticky lg:top-24 flex flex-col gap-8">
                {# Table of contents — the "sticky" position materializes here,
                   inside the sticky column (a viewport-pinned panel would
                   overlap it). #}
                {% if articleConfig.tocEnabled and articleConfig.tocPosition == 'sticky' %}
                    {% include '@ItechWorldSuluTailwindTheme/components/_toc.html.twig' with {
                        position: 'inline',
                        depth: articleConfig.tocDepth,
                    } only %}
                {% endif %}

                {# Author card #}
                {% if articleConfig.showAuthors|iw_article_visible('page') and articleAuthors is defined and articleAuthors|length > 0 %}
                    <div class="p-5 rounded-[var(--border-radius)] bg-[var(--color-background-100)]">
                        <h3 class="text-xs uppercase tracking-wide text-[var(--color-secondary-500)] font-semibold mb-4">
                            {{ 'iw_sulu_tailwind_theme.article.about_author'|trans }}
                        </h3>
                        {% for author in articleAuthors %}
                            {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_author.html.twig' with {
                                author: author,
                                size: 'lg',
                            } only %}
                        {% endfor %}
                    </div>
                {% endif %}

                {# Categories #}
                {% if articleConfig.showCategories|iw_article_visible('page') and extension.excerpt.categories is defined and extension.excerpt.categories|length > 0 %}
                    <div>
                        <h3 class="text-xs uppercase tracking-wide text-[var(--color-secondary-500)] font-semibold mb-3">
                            {{ 'iw_sulu_tailwind_theme.article.sidebar_categories'|trans }}
                        </h3>
                        {% include '@ItechWorldSuluTailwindTheme/components/_categories.html.twig' with {
                            categories: extension.excerpt.categories,
                        } only %}
                    </div>
                {% endif %}

                {# Tags #}
                {% if articleConfig.showTags|iw_article_visible('page') and extension.excerpt.tags is defined and extension.excerpt.tags|length > 0 %}
                    <div>
                        <h3 class="text-xs uppercase tracking-wide text-[var(--color-secondary-500)] font-semibold mb-3">
                            {{ 'iw_sulu_tailwind_theme.article.sidebar_tags'|trans }}
                        </h3>
                        {% include '@ItechWorldSuluTailwindTheme/components/_tags.html.twig' with {
                            tags: extension.excerpt.tags,
                        } only %}
                    </div>
                {% endif %}
            </div>
        </aside>
    </div>
    </div>
{% endblock %}

{% block article_footer %}{% endblock %}
