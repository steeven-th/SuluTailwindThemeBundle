{#
    Article author component — avatar + name + role.

    Parameters:
    - author: a single author entry (type: sulu_user|custom|contact|organization)
    - showAvatar: bool (default true)
    - size: 'sm' | 'md' (default) | 'lg'

    For sulu_user type, the author name is resolved from the Sulu user's contact.

    Public CSS API:
    - .iw-article-author (block — flex row)
    - .iw-article-author--sm / --md / --lg (size modifiers)
    - .iw-article-author__avatar (avatar <img> or initials fallback span)
    - .iw-article-author__avatar--initials (modifier on the initials fallback)
    - .iw-article-author__details (name + role wrapper)
    - .iw-article-author__name (author display name)
    - .iw-article-author__role (optional role/title)

    Override via --iw-article-author-{gap,name-color,role-color,avatar-bg,avatar-text}.
#}
{# Avatars are a site-wide decision (Articles tab → author avatars) that an
   article can override in its Meta section; both are already resolved into
   author.showAvatar. With them off, every author falls back to initials even
   when a picture exists. An explicit showAvatar passed by a caller still wins,
   for a style that has no room for one. #}
{% set showAvatar = showAvatar is defined
    ? showAvatar
    : (author.showAvatar ?? (iw_sulu_tailwind_theme.articles_showAuthorAvatars ?? true)) %}
{% set size = size in ['sm', 'md', 'lg'] ? size : 'md' %}
{# `light` flips the name and role to light tones, for a style that puts the
   author over a dark hero (blog editorial). #}
{% set light = light|default(false) %}

{% set authorType = author.type|default('custom') %}
{% set authorRole = author.role|default('') %}

{# Resolve author name — handles all types: sulu_user, custom, contact, organization #}
{% set authorName = iw_sulu_tailwind_theme_author_name(author) %}

{% if authorName is not empty %}
    <div class="iw-article-author iw-article-author--{{ size }}{{ light ? ' iw-article-author--light' : '' }}" itemprop="author" itemscope itemtype="https://schema.org/Person">
        {% if showAvatar %}
            {% set avatarMedia = null %}
            {# avatarId is resolved for every author type that has one — a Sulu
               user and a contact both carry an avatar on their contact record,
               not just a "custom" author. Reading it only for the custom type
               is what used to leave the primary author of an article showing
               initials while their picture sat unused in the media library. #}
            {% if author.avatarId is defined and author.avatarId is not empty %}
                {% set avatarMedia = sulu_resolve_media(author.avatarId, app.request.locale) %}
            {% elseif authorType == 'custom' and author.avatar is defined and author.avatar is not empty %}
                {# Direct include, outside iw_sulu_tailwind_theme_article_authors(). #}
                {% set avatarMedia = sulu_resolve_media(author.avatar, app.request.locale) %}
            {% endif %}

            {% if avatarMedia %}
                {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                    media: avatarMedia,
                    format: 'sulu-100x100',
                    alt: authorName,
                    raw: true,
                    classes: 'iw-article-author__avatar',
                }) }}
            {% else %}
                {# Initials fallback #}
                {% set initials = authorName|split(' ')|map(w => w|first|upper)|join('')|slice(0, 2) %}
                <span class="iw-article-author__avatar iw-article-author__avatar--initials" aria-hidden="true">
                    {{ initials }}
                </span>
            {% endif %}
        {% endif %}

        <div class="iw-article-author__details">
            <span class="iw-article-author__name" itemprop="name">{{ authorName }}</span>
            {% if authorRole is not empty %}
                <span class="iw-article-author__role">{{ authorRole }}</span>
            {% endif %}
        </div>
    </div>
{% endif %}
