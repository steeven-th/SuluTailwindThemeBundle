{#
    Article author component — avatar + name + role.

    Parameters:
    - author: a single author entry (type: sulu_user|custom|contact|organization)
    - showAvatar: bool (default true)
    - size: 'sm' | 'md' (default) | 'lg'

    For sulu_user type, the author name is resolved from the Sulu user's contact.

    Public CSS API:
    - .iw-article-author (block — flex row)
    - .iw-article-author--sm / --md / --lg (size modifiers)
    - .iw-article-author__avatar (avatar <img> or initials fallback span)
    - .iw-article-author__avatar--initials (modifier on the initials fallback)
    - .iw-article-author__details (name + role wrapper)
    - .iw-article-author__name (author display name)
    - .iw-article-author__role (optional role/title)

    Override via --iw-article-author-{gap,name-color,role-color,avatar-bg,avatar-text}.
#}
{% set showAvatar = showAvatar is defined ? showAvatar : true %}
{% set size = size in ['sm', 'md', 'lg'] ? size : 'md' %}

{% set authorType = author.type|default('custom') %}
{% set authorRole = author.role|default('') %}

{# Resolve author name — handles all types: sulu_user, custom, contact, organization #}
{% set authorName = iw_sulu_tailwind_theme_author_name(author) %}

{% if authorName is not empty %}
    <div class="iw-article-author iw-article-author--{{ size }}" itemprop="author" itemscope itemtype="https://schema.org/Person">
        {% if showAvatar %}
            {% set avatarMedia = null %}
            {% if authorType == 'custom' and author.avatar is defined and author.avatar is not empty %}
                {# single_media_selection stores a scalar media id #}
                {% set avatarMedia = sulu_resolve_media(author.avatar, app.request.locale) %}
            {% endif %}

            {% if avatarMedia %}
                {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                    media: avatarMedia,
                    format: 'sulu-100x100',
                    alt: authorName,
                    raw: true,
                    classes: 'iw-article-author__avatar',
                }) }}
            {% else %}
                {# Initials fallback #}
                {% set initials = authorName|split(' ')|map(w => w|first|upper)|join('')|slice(0, 2) %}
                <span class="iw-article-author__avatar iw-article-author__avatar--initials" aria-hidden="true">
                    {{ initials }}
                </span>
            {% endif %}
        {% endif %}

        <div class="iw-article-author__details">
            <span class="iw-article-author__name" itemprop="name">{{ authorName }}</span>
            {% if authorRole is not empty %}
                <span class="iw-article-author__role">{{ authorRole }}</span>
            {% endif %}
        </div>
    </div>
{% endif %}
