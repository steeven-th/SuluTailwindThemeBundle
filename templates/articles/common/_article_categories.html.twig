{#
    Article categories component — renders categories as colored badges.
    Categories come from Sulu's Excerpt tab.

    Parameters:
    - categories: array of category objects (from excerpt)

    Public CSS API:
    - .iw-article-categories (block — flex row of badges)
    - .iw-article-categories__item (single category badge)

    Override via --iw-article-categories-{gap,item-bg,item-text,item-radius,item-padding}.
#}
{% if categories is defined and categories is iterable and categories|length > 0 %}
    <div class="iw-article-categories">
        {% for category in categories %}
            <span class="iw-article-categories__item">
                {{ category.name|default(category.title|default('')) }}
            </span>
        {% endfor %}
    </div>
{% endif %}
