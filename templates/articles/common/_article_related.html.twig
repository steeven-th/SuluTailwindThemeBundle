{#
    Related articles section — renders a grid of article cards.

    Parameters:
    - articles: array of resolved article objects (from smart_content)
    - title: section title (default: translation key)
    - columns: number of grid columns (default: 3) — must be 2, 3 or 4
    - maxItems: maximum items to show (default: 3)

    Public CSS API:
    - .iw-article-related (block — wrapping <section>)
    - .iw-article-related__title (section title <h2>)
    - .iw-article-related__grid (grid of cards)
    - .iw-article-related--cols-2 / --cols-3 / --cols-4 (column count modifier)

    Override via --iw-article-related-{gap,title-color,title-size,margin}.
#}
{% set columns = columns|default(3) %}
{% set cols = columns in [2, 3, 4] ? columns : 3 %}
{% set maxItems = maxItems|default(3) %}
{% set sectionTitle = title|default('iw_sulu_tailwind_theme.article.related_articles'|trans) %}

{# Cards wear the site-wide card appearance (Components > Cards), exactly like
   the article listings: surface, border, image ratio and hover effects. #}
{% set config = iw_sulu_tailwind_theme_article_config() %}
{% set cardRatio = config.cardImageRatio|default('16:9')|replace({':': '/'}) %}

{% if articles is defined and articles is iterable and articles|length > 0 %}
    <section class="iw-article-related iw-article-related--cols-{{ cols }}">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="iw-article-related__title">
                {{ sectionTitle }}
            </h2>
            <div class="iw-article-related__grid">
                {% for article in articles|slice(0, maxItems) %}
                    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_card.html.twig' with {
                        article: article,
                        imageRatio: cardRatio,
                        cardSurface: config.cardSurface,
                        cardBorder: config.cardBorder,
                        cardImagePadded: config.cardImagePadded,
                        cardHoverTransform: config.cardHoverTransform,
                        cardHoverImage: config.cardHoverImage,
                        cardHoverShadow: config.cardHoverShadow,
                        cardHoverBorder: config.cardHoverBorder,
                    } only %}
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
