{#
    Event info card — floating card with dates, location, organizer.

    Parameters:
    - startDate: DateTimeInterface (required)
    - endDate: DateTimeInterface or null
    - isOnline: bool
    - venue: string, the name of the place
    - location: Sulu location value (title, street, number, code, town, country, lat, long, zoom) or null
    - locationUrl: string (online event URL)
    - showMapLink: bool, adds a "View on the map" link when the location has coordinates
    - isPaid: bool, unticked means free
    - priceLabel: string, the formatted price of a paid event (iw_sulu_tailwind_theme_event_price)
    - ticketUrl: string, registration or ticketing link
    - organizer: array (organizer block entry) or null
    - performers: array (performers block entries)

    Public CSS API:
    - .iw-event-info (block — floating card)
    - .iw-event-info__row (one info row, e.g. date row, location row, organizer row)
    - .iw-event-info__icon (leading icon, 1.25rem)
    - .iw-event-info__content (text wrapper next to the icon)
    - .iw-event-info__date (primary date line)
    - .iw-event-info__date-end (optional "until ..." secondary line)
    - .iw-event-info__online-badge (green pill for online events)
    - .iw-event-info__online-link (CTA link to join the event)
    - .iw-event-info__location (name of the physical location)
    - .iw-event-info__address (postal address under the name)
    - .iw-event-info__map-link (link to the location on OpenStreetMap)
    - .iw-event-info__price (price, or "Free")
    - .iw-event-info__register-link (registration or ticketing link)
    - .iw-event-info__organizer-label (small caps "organized by")
    - .iw-event-info__organizer-name (organizer display name)
    - .iw-event-info__performers (names of the performers, "With ..." row)

    Override via --iw-event-info-{bg,blur,padding,radius,shadow,gap,icon-color,online-badge-bg,online-badge-text}.
#}
{% set isOnline = isOnline is defined ? isOnline : false %}
{# The venue field names the place. The title of the location stands in for
   it on an event typed before that field existed. #}
{% set place = location is defined and location is iterable ? location : {} %}
{% set placeName = venue|default('')|trim ?: place.title|default('')|trim %}
{% set placeAddress = iw_sulu_tailwind_theme_location_address(place) %}
{% set placeHasCoordinates = place.lat|default(null) is not null and place.long|default(null) is not null %}

<div class="iw-event-info">
    {# Dates #}
    {% if startDate is defined and startDate is not empty %}
        <div class="iw-event-info__row">
            <svg class="iw-event-info__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <div class="iw-event-info__content">
                <div class="iw-event-info__date">
                    {{ iw_sulu_tailwind_theme_format_date(startDate, 'd MMMM yyyy, HH:mm') }}
                </div>
                {% if endDate is defined and endDate is not empty %}
                    <div class="iw-event-info__date-end">
                        {{ 'iw_sulu_tailwind_theme.article.event_until'|trans }} {{ iw_sulu_tailwind_theme_format_date(endDate, 'd MMMM yyyy, HH:mm') }}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# Location / Online badge #}
    <div class="iw-event-info__row">
        {% if isOnline %}
            <svg class="iw-event-info__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <div class="iw-event-info__content">
                <span class="iw-event-info__online-badge">
                    {{ 'iw_sulu_tailwind_theme.article.event_online_badge'|trans }}
                </span>
                {% if locationUrl is defined and locationUrl is not empty %}
                    <a href="{{ locationUrl }}" target="_blank" rel="noopener" class="iw-event-info__online-link">
                        {{ 'iw_sulu_tailwind_theme.article.event_join_link'|trans }}
                    </a>
                {% endif %}
            </div>
        {% elseif placeName is not empty or placeAddress is not empty %}
            <svg class="iw-event-info__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div class="iw-event-info__content">
                {% if placeName is not empty %}
                    <span class="iw-event-info__location">{{ placeName }}</span>
                {% endif %}
                {% if placeAddress is not empty %}
                    <address class="iw-event-info__address">{{ placeAddress|nl2br }}</address>
                {% endif %}
                {% if showMapLink|default(false) and placeHasCoordinates %}
                    {% set mapZoom = place.zoom|default(15) %}
                    <a href="https://www.openstreetmap.org/?mlat={{ place.lat }}&amp;mlon={{ place.long }}#map={{ mapZoom }}/{{ place.lat }}/{{ place.long }}"
                       target="_blank" rel="noopener noreferrer" class="iw-event-info__map-link">
                        {{ 'iw_sulu_tailwind_theme.article.event_view_on_map'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {# Price and registration. A paid event with no amount typed shows no price,
       rather than a misleading "Free". #}
    {% set priceText = isPaid|default(false) ? priceLabel|default('') : 'iw_sulu_tailwind_theme.article.event_free'|trans %}
    {% if priceText is not empty or ticketUrl|default('') is not empty %}
        <div class="iw-event-info__row">
            <svg class="iw-event-info__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
            <div class="iw-event-info__content">
                {% if priceText is not empty %}
                    <span class="iw-event-info__price">{{ priceText }}</span>
                {% endif %}
                {% if ticketUrl|default('') is not empty %}
                    <a href="{{ ticketUrl }}" target="_blank" rel="noopener" class="iw-event-info__register-link">
                        {{ 'iw_sulu_tailwind_theme.article.event_register'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# Organizer #}
    {% if organizer is defined and organizer is iterable and organizer|length > 0 %}
        {% set org = organizer|first %}
        {% set orgName = iw_sulu_tailwind_theme_author_name(org) %}
        {% if orgName is not empty %}
            <div class="iw-event-info__row">
                <svg class="iw-event-info__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <div class="iw-event-info__content">
                    <span class="iw-event-info__organizer-label">
                        {{ 'iw_sulu_tailwind_theme.article.organized_by'|trans }}
                    </span>
                    <span class="iw-event-info__organizer-name">{{ orgName }}</span>
                </div>
            </div>
        {% endif %}
    {% endif %}
    {# Performers: who leads the event, distinct from the organizer #}
    {% set performerNames = [] %}
    {% for performer in performers|default([]) %}
        {% set performerName = performer is iterable ? iw_sulu_tailwind_theme_author_name(performer) : '' %}
        {% if performerName is not empty %}
            {% set performerNames = performerNames|merge([performerName]) %}
        {% endif %}
    {% endfor %}
    {% if performerNames is not empty %}
        <div class="iw-event-info__row">
            <svg class="iw-event-info__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <div class="iw-event-info__content">
                <span class="iw-event-info__organizer-label">
                    {{ 'iw_sulu_tailwind_theme.article.event_with'|trans }}
                </span>
                <span class="iw-event-info__performers">{{ performerNames|join(', ') }}</span>
            </div>
        </div>
    {% endif %}
</div>
