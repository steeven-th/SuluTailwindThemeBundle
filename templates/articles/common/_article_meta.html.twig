{#
    Article meta information (date, authors, categories, reading time).

    Parameters:
    - date: DateTimeInterface or string (publication date)
    - authors: array of author block entries
    - categories: array of Sulu category objects (from excerpt)
    - readingTime: string or null (e.g. "5 min")
    - showDate: bool (default true)
    - showAuthors: bool (default true)
    - showCategories: bool (default true)
    - showReadingTime: bool (default true)
    - compact: bool (default false) — uses smaller layout

    Public CSS API:
    - .iw-article-meta (block — flex row of meta entries)
    - .iw-article-meta--compact (modifier — smaller text scale)
    - .iw-article-meta__date / __authors / __categories / __reading-time (entries)
    - .iw-article-meta__separator (vertical pipe between entries)
    - .iw-article-meta__icon (inline SVG icon, one per entry)
    - .iw-article-meta__category (single category badge inside __categories)

    Override via --iw-article-meta-{gap,color,icon-size,icon-opacity,separator-color,category-bg,category-text}.
#}
{% set showDate = showDate is defined ? showDate : true %}
{% set showAuthors = showAuthors is defined ? showAuthors : true %}
{% set showCategories = showCategories is defined ? showCategories : true %}
{% set showReadingTime = showReadingTime is defined ? showReadingTime : true %}
{% set compact = compact is defined ? compact : false %}

{% set metaClasses = ['iw-article-meta'] %}
{% if compact %}{% set metaClasses = metaClasses|merge(['iw-article-meta--compact']) %}{% endif %}

<div class="{{ metaClasses|join(' ') }}">
    {% if showDate and date is defined and date is not empty %}
        <time datetime="{{ date|date('c') }}" itemprop="datePublished" class="iw-article-meta__date">
            <svg class="iw-article-meta__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {{ iw_sulu_tailwind_theme_format_date(date) }}
        </time>
    {% endif %}

    {% if showAuthors and authors is defined and authors is iterable and authors|length > 0 %}
        {# Show real faces when there are any: the generic person icon is only a
           stand-in for a missing picture, and every article style deserves the
           avatar — not just the two that use the full author component.
           Site-wide switch: Articles tab → author avatars. #}
        {% set metaAvatars = (iw_sulu_tailwind_theme.articles_showAuthorAvatars ?? true)
            and authors|filter(a => a.avatarId is defined and a.avatarId is not empty)|length > 0 %}

        <span class="iw-article-meta__separator" aria-hidden="true">|</span>
        <span class="iw-article-meta__authors" itemprop="author" itemscope itemtype="https://schema.org/Person">
            {% if not metaAvatars %}
                <svg class="iw-article-meta__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            {% endif %}
            {% for author in authors %}
                {% set authorDisplayName = iw_sulu_tailwind_theme_author_name(author) %}
                {% if metaAvatars and author.avatarId is defined and author.avatarId is not empty %}
                    {% set metaAvatarMedia = sulu_resolve_media(author.avatarId, app.request.locale) %}
                    {% if metaAvatarMedia %}
                        {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                            media: metaAvatarMedia,
                            format: 'sulu-100x100',
                            alt: authorDisplayName,
                            raw: true,
                            classes: 'iw-article-meta__avatar',
                        }) }}
                    {% endif %}
                {% endif %}
                <span itemprop="name">{{ authorDisplayName }}</span>
                {% if not loop.last %}, {% endif %}
            {% endfor %}
        </span>
    {% endif %}

    {% if showCategories and categories is defined and categories is iterable and categories|length > 0 %}
        <span class="iw-article-meta__separator" aria-hidden="true">|</span>
        <span class="iw-article-meta__categories">
            {% for category in categories %}
                <span class="iw-category-badge iw-article-meta__category">
                    {{ category.name|default(category.title|default('')) }}
                </span>
            {% endfor %}
        </span>
    {% endif %}

    {% if showReadingTime and readingTime is defined and readingTime is not empty %}
        <span class="iw-article-meta__separator" aria-hidden="true">|</span>
        <span class="iw-article-meta__reading-time">
            <svg class="iw-article-meta__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {{ readingTime }}
        </span>
    {% endif %}
</div>
