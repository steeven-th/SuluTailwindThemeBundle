{#
    Article tags component — renders tags as badges.
    Tags come from Sulu's Excerpt tab.

    Parameters:
    - tags: array of tag objects (from excerpt)

    Public CSS API:
    - .iw-article-tags (block — flex row of tag pills)
    - .iw-article-tags__item (single tag pill with hover state)

    Override via --iw-article-tags-{gap,item-border,item-text,item-hover-bg,item-hover-text,item-hover-border,item-radius,item-padding}.
#}
{% if tags is defined and tags is iterable and tags|length > 0 %}
    <div class="iw-article-tags">
        {% for tag in tags %}
            <span class="iw-article-tags__item">
                {{ tag.name|default(tag) }}
            </span>
        {% endfor %}
    </div>
{% endif %}
