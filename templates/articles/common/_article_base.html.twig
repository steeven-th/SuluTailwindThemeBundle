{#
    Base layout for all article pages.
    Extends the bundle's base template and defines article-specific blocks.

    Blocks available for override:
    - article_breadcrumb: site breadcrumb rendered before the <article> landmark
      (override when the style hosts the trail elsewhere, e.g. as a hero overlay)
    - article_reading_progress: viewport-fixed reading progress bar
    - article_hero: hero image area
    - article_header: title + subtitle
    - article_meta: date, authors, categories, reading time
    - article_share_header: share buttons below the header (override to empty
      when the style renders _article_share.html.twig inside its own header)
    - article_content: main content blocks — rendered OUTSIDE the page container
      through the shared dispatcher (components/_blocks.html.twig), so blocks
      behave exactly as on regular pages (each block owns its own layout/width)
    - article_footer: tags
    - article_share_footer: share buttons at the end of the article
    - article_related: related articles section

    Variables expected:
    - content: the article content object (from Sulu)
#}
{% extends 'base.html.twig' %}

{% block seo_structured_data %}
    {# Auto-detect article type and include matching JSON-LD #}
    {% set articleAuthors = iw_sulu_tailwind_theme_article_authors(author|default(null), content.additionalAuthors|default([])) %}
    {% if content.startDate is defined %}
        {% include '@ItechWorldSuluTailwindTheme/seo/_jsonld_event.html.twig' %}
    {% elseif content.readingTime is defined %}
        {% include '@ItechWorldSuluTailwindTheme/seo/_jsonld_article.html.twig' with { type: 'BlogPosting' } %}
    {% elseif template is defined and template == 'iw_news' %}
        {% include '@ItechWorldSuluTailwindTheme/seo/_jsonld_article.html.twig' with { type: 'NewsArticle' } %}
    {% endif %}
{% endblock %}

{% block content %}
{# Load article config + authors — must be inside block content for child template access #}
{% set articleConfig = iw_sulu_tailwind_theme_article_config() %}
{% set articleAuthors = iw_sulu_tailwind_theme_article_authors(author|default(null), content.additionalAuthors|default([])) %}

{# Site breadcrumb — navigation, so it lives before the <article> landmark
   (not inside the redistributable article content). Styles whose fullwidth
   hero hosts the trail as a bottom overlay override this block to fall back
   to this default only when the article has no hero image (see news classic). #}
{% block article_breadcrumb %}
    {% if iw_sulu_tailwind_theme.breadcrumbs_enabled|default('both') in ['both', 'articles'] %}
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 iw-article-page__breadcrumb">
            {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                context: 'article',
                pageUuid: view.url.page.uuid|default(null),
                currentTitle: content.title|default(''),
            } only %}
        </div>
    {% endif %}
{% endblock %}

<article class="iw-article-page" itemscope itemtype="https://schema.org/Article">
    {# Reading progress bar (Articles > Reading components) — fixed to the
       viewport, so its DOM position here is only logical. #}
    {% block article_reading_progress %}
        {% if articleConfig.readingProgressEnabled %}
            {% include '@ItechWorldSuluTailwindTheme/components/_reading_progress.html.twig' only %}
        {% endif %}
    {% endblock %}

    {% block article_hero %}{% endblock %}

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        {% block article_header %}
            <header class="iw-article-page__header">
                <h1 class="iw-article-page__title" itemprop="headline">
                    {{ content.title }}
                </h1>
                {% if content.subtitle is defined and content.subtitle is not empty %}
                    <p class="iw-article-page__subtitle">
                        {{ content.subtitle }}
                    </p>
                {% endif %}
            </header>
        {% endblock %}

        {% block article_meta %}{% endblock %}

        {# Share buttons under the header (Articles > Reading components).
           Styles that render the row inside their own header override this
           block to empty and include _article_share.html.twig themselves. #}
        {% block article_share_header %}
            {% include '@ItechWorldSuluTailwindTheme/components/_article_share.html.twig' with {
                articleConfig: articleConfig,
                content: content,
                position: 'header',
            } only %}
        {% endblock %}
    </div>

    {# Content blocks — outside the page container, dispatched exactly like on
       regular pages: each block template owns its own layout and width. #}
    {% block article_content %}
        {% include '@ItechWorldSuluTailwindTheme/components/_blocks.html.twig' with {
            blocks: content.blocks|default([]),
        } %}
    {% endblock %}

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        {% block article_footer %}{% endblock %}

        {# Share buttons at the end of the article (Articles > Reading components). #}
        {% block article_share_footer %}
            {% include '@ItechWorldSuluTailwindTheme/components/_article_share.html.twig' with {
                articleConfig: articleConfig,
                content: content,
                position: 'footer',
            } only %}
        {% endblock %}
    </div>

    {% block article_related %}{% endblock %}
</article>
{% endblock %}
