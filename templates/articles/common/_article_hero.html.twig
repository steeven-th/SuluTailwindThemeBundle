{#
    Article hero image component.

    Parameters:
    - image: media ID or resolved media object
    - style: 'fullwidth' (default) | 'contained' | 'parallax'
    - maxHeight: optional CSS max-height value — emitted as an inline
                 `--iw-article-hero-max-height` only when explicitly passed;
                 otherwise the CSS fallback (500px) applies.
    - breadcrumb: render the site breadcrumb as an overlay pinned to the bottom
                  of the image, over a dark gradient (designed for the fullwidth
                  style). The caller should override the article_breadcrumb
                  block accordingly (see news classic). Requires:
    - breadcrumbPageUuid: UUID for the page trail (view.url.page.uuid)
    - breadcrumbCurrentTitle: current item label (content.title)

    Public CSS API:
    - .iw-article-hero (block)
    - .iw-article-hero--fullwidth (default modifier — full viewport width, no radius)
    - .iw-article-hero--contained (inside the page container, with image radius)
    - .iw-article-hero--parallax (parallax scroll effect, no radius)
    - .iw-article-hero--editorial (background-image cover, used by blog editorial style)
    - .iw-article-hero__inner (used only by the `contained` modifier to clip the image with radius)
    - .iw-article-hero__image (the rendered <img>)
    - .iw-article-hero__breadcrumb (bottom overlay hosting the breadcrumb trail)

    Override via --iw-article-hero-max-height / --iw-article-hero-radius /
    --iw-article-hero-contained-max-width / --iw-article-hero-breadcrumb-*.
#}

{% if image is defined and image is not empty %}
    {% if image is iterable and image.url is defined %}
        {% set media = image %}
    {% else %}
        {# single_media_selection stores a scalar media id #}
        {% set media = sulu_resolve_media(image, app.request.locale) %}
    {% endif %}

    {% if media is not null %}
        {% set imgUrl = media.thumbnails['iw_hero_lg']|default(media.thumbnails['iw_theme_16_9']|default(media.url)) %}
        {% set imgAlt = media.title|default('') %}

        {# Whitelist the modifier so legacy values fall back to fullwidth #}
        {% set heroStyle = style|default('fullwidth') %}
        {% set modifier = heroStyle in ['fullwidth', 'contained', 'parallax'] ? heroStyle : 'fullwidth' %}
        {% set imgClass = 'iw-article-hero__image' ~ (modifier == 'parallax' ? ' parallax-slide-img' : '') %}

        {# Breadcrumb overlay: only when requested AND breadcrumbs are enabled
           for articles in the admin — avoids rendering an empty gradient. #}
        {% set showBreadcrumb = breadcrumb|default(false)
            and iw_sulu_tailwind_theme.breadcrumbs_enabled|default('both') in ['both', 'articles'] %}

        <div class="iw-article-hero iw-article-hero--{{ modifier }}"{% if maxHeight is defined and maxHeight is not empty %} style="--iw-article-hero-max-height: {{ maxHeight }};"{% endif %}>
            {% if modifier == 'contained' %}
                <div class="iw-article-hero__inner">
                    <img src="{{ imgUrl }}" alt="{{ imgAlt }}" class="{{ imgClass }}" loading="eager" itemprop="image">
                </div>
            {% else %}
                <img src="{{ imgUrl }}" alt="{{ imgAlt }}" class="{{ imgClass }}" loading="eager" itemprop="image">
            {% endif %}

            {% if showBreadcrumb %}
                <div class="iw-article-hero__breadcrumb">
                    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                        {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
                            context: 'article',
                            pageUuid: breadcrumbPageUuid|default(null),
                            currentTitle: breadcrumbCurrentTitle|default(''),
                        } only %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endif %}
