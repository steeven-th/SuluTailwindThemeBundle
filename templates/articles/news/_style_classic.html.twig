{#
    News style: Classic
    Full-width hero → title → meta (date/author/category) → content blocks → tags
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{% block article_hero %}
    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_hero.html.twig' with {
        image: content.heroImage|default(null),
        style: 'fullwidth',
    } only %}
{% endblock %}

{% block article_header %}
    <header class="iw-article-page__header">
        {% if articleConfig.showBreadcrumbs|iw_article_visible('page') %}
            {% include '@ItechWorldSuluTailwindTheme/articles/common/_breadcrumbs.html.twig' with {
                items: breadcrumb|default([]),
            } only %}
        {% endif %}

        <h1 class="iw-article-page__title" itemprop="headline">
            {{ content.title }}
        </h1>
        {% if content.subtitle is defined and content.subtitle is not empty %}
            <p class="iw-article-page__subtitle">
                {{ content.subtitle }}
            </p>
        {% endif %}
    </header>
{% endblock %}

{% block article_meta %}
    {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_meta.html.twig' with {
        date: authored|default(null),
        authors: articleAuthors|default([]),
        categories: content.excerptCategories|default([]),
        showDate: articleConfig.showDates|iw_article_visible('page'),
        showAuthors: articleConfig.showAuthors|iw_article_visible('page'),
        showCategories: articleConfig.showCategories|iw_article_visible('page'),
    } only %}
    <hr class="iw-article-page__separator">
{% endblock %}

{% block article_footer %}
    <footer class="iw-article-page__footer">
        {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_tags.html.twig' with {
            tags: content.excerptTags|default([]),
        } only %}
    </footer>
{% endblock %}
