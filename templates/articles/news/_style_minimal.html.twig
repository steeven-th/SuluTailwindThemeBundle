{#
    News style: Minimal
    No hero image, large title, discreet meta, focus on text content
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{% block article_hero %}{% endblock %}

{% block article_header %}
    <header class="iw-article-page__header iw-article-page__header--centered">
        {% include '@ItechWorldSuluTailwindTheme/components/_breadcrumb_auto.html.twig' with {
            context: 'article',
            pageUuid: view.url.page.uuid|default(null),
            currentTitle: content.title|default(''),
        } only %}

        {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_meta.html.twig' with {
            date: authored|default(null),
            authors: articleAuthors|default([]),
            categories: content.excerptCategories|default([]),
            showDate: articleConfig.showDates|iw_article_visible('page'),
            showAuthors: articleConfig.showAuthors|iw_article_visible('page'),
            showCategories: articleConfig.showCategories|iw_article_visible('page'),
            compact: true,
        } only %}

        <h1 class="iw-article-page__title iw-article-page__title--minimal" itemprop="headline">
            {{ content.title }}
        </h1>

        {% if content.subtitle is defined and content.subtitle is not empty %}
            <p class="iw-article-page__subtitle iw-article-page__subtitle--lg">
                {{ content.subtitle }}
            </p>
        {% endif %}
    </header>
    <hr class="iw-article-page__separator iw-article-page__separator--centered">
{% endblock %}

{% block article_meta %}{% endblock %}

{% block article_footer %}
    <footer class="iw-article-page__footer">
        {% include '@ItechWorldSuluTailwindTheme/components/_tags.html.twig' with {
            tags: content.excerptTags|default([]),
        } only %}
    </footer>
{% endblock %}
