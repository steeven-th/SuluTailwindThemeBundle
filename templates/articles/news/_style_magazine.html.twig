{#
    News style: Magazine
    Image left (40%) + title/meta/excerpt right (60%), content below full width
#}
{% extends '@ItechWorldSuluTailwindTheme/articles/common/_article_base.html.twig' %}

{% block article_hero %}{% endblock %}

{% block article_header %}
    <header class="iw-article-page__header iw-article-page__header--inline">
        <div class="iw-article-page__hero-inline">
            {# Image left (40%) #}
            {% if content.heroImage is defined and content.heroImage is not empty %}
                {% set heroIds = content.heroImage %}
                {% if heroIds is iterable %}
                    {% set heroId = heroIds|first %}
                {% else %}
                    {% set heroId = heroIds %}
                {% endif %}
                {% if heroId %}
                    {% set heroMedia = sulu_resolve_media(heroId, app.request.locale) %}
                    <div class="iw-article-page__hero-inline-image">
                        <img
                            src="{{ heroMedia.thumbnails['iw_hero_md']|default(heroMedia.thumbnails['iw_theme_16_9']|default(heroMedia.url)) }}"
                            alt="{{ heroMedia.title|default(content.title) }}"
                            class="iw-article-page__hero-inline-image-img"
                            loading="eager"
                            itemprop="image"
                        >
                    </div>
                {% endif %}
            {% endif %}

            {# Title + meta right (60%) #}
            <div class="iw-article-page__hero-inline-content">
                {% if articleConfig.showCategories|iw_article_visible('page') %}
                    {% include '@ItechWorldSuluTailwindTheme/components/_categories.html.twig' with {
                        categories: content.excerptCategories|default([]),
                    } only %}
                {% endif %}

                <h1 class="iw-article-page__title" itemprop="headline">
                    {{ content.title }}
                </h1>

                {% if content.subtitle is defined and content.subtitle is not empty %}
                    <p class="iw-article-page__subtitle iw-article-page__subtitle--sm">
                        {{ content.subtitle }}
                    </p>
                {% endif %}

                {% include '@ItechWorldSuluTailwindTheme/articles/common/_article_meta.html.twig' with {
                    date: authored|default(null),
                    authors: articleAuthors|default([]),
                    showDate: articleConfig.showDates|iw_article_visible('page'),
                    showAuthors: articleConfig.showAuthors|iw_article_visible('page'),
                    showCategories: false,
                } only %}
            </div>
        </div>
    </header>
    <hr class="iw-article-page__separator">
{% endblock %}

{% block article_meta %}{% endblock %}

{% block article_footer %}
    <footer class="iw-article-page__footer">
        {% include '@ItechWorldSuluTailwindTheme/components/_tags.html.twig' with {
            tags: content.excerptTags|default([]),
        } only %}
    </footer>
{% endblock %}
