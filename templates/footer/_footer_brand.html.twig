{# Footer brand block: optional logo, site name and tagline.

   Params:
   - config: footerConfig
   - align:  'left' (default) or 'center' — alignment within the block

   Typography/muting is handled by the compiled `.iw-footer*` classes; only
   layout stays on Tailwind utilities here. #}

{% set align = align|default('left') %}
{% set namePosition = config.siteNamePosition|default('beside') %}

{# A raw SVG logo (no thumbnail, no intrinsic size) collapses to zero width
   under a bare max-height, so it gets the --vector modifier and an explicit
   height. See _logo_images.html.twig for the full rationale. #}
{% set logoUrl = null %}
{% set logoVector = false %}
{% if config.displayLogo|default(false) and config.logo is defined and config.logo.id|default(null) is not null %}
    {% set logoMedia = sulu_resolve_media(config.logo.id, app.request.locale) %}
    {% if logoMedia is not null %}
        {% set logoThumbnail = logoMedia.thumbnails['iw_theme_logo_desktop']|default(null) %}
        {% set logoUrl = logoThumbnail|default(logoMedia.url)|default(null) %}
        {% set logoVector = logoThumbnail is null and 'image/svg+xml' == logoMedia.mimeType|default('') %}
    {% endif %}
{% endif %}

{% set showName = config.displaySiteName|default(false) and config.siteName|default('') is not empty %}
{# The logo has an empty alt: with the site name hidden, the link is named
   by an aria-label, the same one as the menu logo. #}
{% if logoUrl and not showName %}
    {% set homeLabel = config.siteName|default('')|trim is not empty
        ? 'iw_sulu_tailwind_theme.menu_home'|trans({'%site%': config.siteName|trim}, 'messages')
        : 'iw_sulu_tailwind_theme.menu_home_untitled'|trans({}, 'messages') %}
{% endif %}
{% set stacked = namePosition == 'below' or not logoUrl %}

{% if logoUrl or showName or config.tagline|default('') is not empty %}
    <div class="iw-footer__brand flex flex-col gap-4 {{ align == 'center' ? 'items-center text-center' : 'items-start' }}">
        {% if logoUrl or showName %}
            <a href="{{ sulu_content_path('/') }}"{% if homeLabel is defined %} aria-label="{{ homeLabel }}"{% endif %}
               class="iw-footer__brand-link inline-flex no-underline {{ stacked
                    ? 'flex-col gap-2 ' ~ (align == 'center' ? 'items-center' : 'items-start')
                    : 'items-center gap-2.5' }}">
                {% if logoUrl %}
                    <img src="{{ logoUrl }}" alt="" class="iw-footer__logo{{ logoVector ? ' iw-footer__logo--vector' }}">
                {% endif %}
                {% if showName %}
                    <span class="iw-footer__site-name">{{ config.siteName }}</span>
                {% endif %}
            </a>
        {% endif %}
        {% if config.tagline|default('') is not empty %}
            <p class="iw-footer__tagline max-w-xs">{{ config.tagline }}</p>
        {% endif %}
    </div>
{% endif %}
