{# Footer social media icons.

   Loaded from the `iw_theme_footer_social_media_links` snippet area (declared in
   config/templates/snippets/social_media.xml). Reuses the `.iw-social-icon`
   mask-image technique. The compiled `.iw-footer` rules recolor the icons from
   the footer social colors (`--iw-footer-social`, then the link color) instead
   of the menu ones. #}

{% set socialLinks = [] %}
{% set socialSnippet = sulu_snippet_load_by_area('iw_theme_footer_social_media_links') %}
{% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
    {% set socialLinks = socialSnippet.content.blocks_social_medias %}
{% endif %}

{% if socialLinks|length > 0 %}
    {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
        links: socialLinks,
        class: 'iw-footer__social',
        textClass: 'text-sm',
    } only %}
{% endif %}
