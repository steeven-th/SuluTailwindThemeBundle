{#
    Mobile and burger navigation: the page tree as nested accordions.

    Params:
    - navItems: the resolved navigation tree (up to four levels)
    - clickMode: what a parent page does
        'none'     the row only opens its branch
        'selflink' the branch starts with a link to the parent page
        'split'    the title is a link, a separate chevron opens the branch

    Every level is a list, so a screen reader announces how many entries it
    holds. The link of the page being displayed carries aria-current, the
    branches leading to it only a class (see _nav_macros.html.twig).

    The levels are rendered by one recursive macro. Each level has its own
    sizes (STYLES below): the first reads as a title, the deeper ones step
    down, and the fourth one takes the look of the third.
#}

{# Text class of a level: iw-menu__text, then iw-menu__text--level-N. #}
{% macro text_class(depth) -%}
    {{- depth == 1 ? 'iw-menu__text' : 'iw-menu__text--level-' ~ depth -}}
{%- endmacro %}

{# The entries of one level, each with its branch below it. #}
{% macro level(items, depth, clickMode) %}
    {% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}
    {% import _self as accordion %}
    {% set styles = {
        1: {li: 'iw-menu__divider border-b', leaf: 'block py-4 text-lg font-medium no-underline', split: 'flex-1 py-4 text-lg font-medium no-underline', toggle: 'p-2 cursor-pointer', arrow: 'w-5 h-5 flex-shrink-0', button: 'flex items-center justify-between w-full py-4 text-left cursor-pointer', label: 'text-lg font-medium', list: 'hidden pb-3 mt-1 px-4'},
        2: {li: '', leaf: 'block py-2.5 opacity-80 hover:opacity-100 no-underline', split: 'flex-1 py-2.5 no-underline', toggle: 'p-1 cursor-pointer', arrow: 'w-4 h-4 flex-shrink-0', button: 'flex items-center justify-between w-full py-2.5 text-left cursor-pointer', label: '', list: 'hidden pb-2 mt-1 px-4'},
        3: {li: '', leaf: 'block py-2 text-sm opacity-70 hover:opacity-100 no-underline', split: 'flex-1 py-2 text-sm no-underline', toggle: 'p-1 cursor-pointer', arrow: 'w-4 h-4 flex-shrink-0', button: 'flex items-center justify-between w-full py-2 text-sm text-left cursor-pointer', label: '', list: 'hidden pb-2 mt-1 px-4'},
    } %}
    {% set style = styles[min(depth, 3)] %}
    {% set sub = styles[min(depth + 1, 3)] %}
    {% set text = accordion.text_class(depth) %}
    {% set subText = accordion.text_class(depth + 1) %}
    {% for item in items %}
        {% set itemHref = sulu_content_path(item.url) %}
        {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
        {% if item.children is defined and item.children|length > 0 %}
            {% set submenuId = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
            <li class="{{ style.li ? style.li ~ ' ' : '' }}iw-menu__parent-item">
                {% if clickMode == 'split' %}
                    {# Split button: link + separate chevron toggle #}
                    <div class="flex items-center justify-between w-full">
                        <a
                            href="{{ itemHref }}"{{ nav.current(itemState) }}
                            class="{{ text }}{{ nav.state_class(itemState) }} {{ style.split }}"
                        >
                            {{ item.title }}
                        </a>
                        <button
                            type="button"
                            data-action="menu#toggleDisclosure"
                            aria-expanded="false"
                            aria-controls="{{ submenuId }}"
                            aria-label="{{ 'iw_sulu_tailwind_theme.menu_submenu_toggle'|trans({'%title%': item.title}, 'messages') }}"
                            class="{{ text }} {{ style.toggle }}"
                        >
                            {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': style.arrow} only %}
                        </button>
                    </div>
                {% else %}
                    <button
                        type="button"
                        data-action="menu#toggleDisclosure"
                        aria-expanded="false"
                        aria-controls="{{ submenuId }}"
                        class="{{ text }}{{ nav.branch_class(itemState) }} {{ style.button }}"
                    >
                        <span{% if style.label %} class="{{ style.label }}"{% endif %}>{{ item.title }}</span>
                        {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': style.arrow} only %}
                    </button>
                {% endif %}
                <ul id="{{ submenuId }}" class="iw-menu__list iw-menu__dropdown--level-{{ depth + 1 }} {{ style.list }}">
                    {% if clickMode == 'selflink' %}
                        <li>
                            <a
                                href="{{ itemHref }}"{{ nav.current(itemState) }}
                                class="{{ subText }}{{ nav.state_class(itemState) }} {{ sub.leaf }} italic"
                            >
                                {{ item.title }}
                            </a>
                        </li>
                    {% endif %}
                    {{ accordion.level(item.children, depth + 1, clickMode) }}
                </ul>
            </li>
        {% else %}
            <li{% if style.li %} class="{{ style.li }}"{% endif %}>
                <a
                    href="{{ itemHref }}"{{ nav.current(itemState) }}
                    class="{{ text }}{{ nav.state_class(itemState) }} {{ style.leaf }}"
                >
                    {{ item.title }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% import _self as accordion %}

{% if navItems is not empty %}
<ul class="iw-menu__list">
    {{ accordion.level(navItems, 1, clickMode|default('none')) }}
</ul>
{% endif %}
