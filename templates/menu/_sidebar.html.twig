{# Menu — sidebar navigation #}
{% set position = config.sidebarPosition|default('left') %}
{% set isLeft = position == 'left' %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(2), {title: 'title', url: 'url'}) %}

{# Parent page click mode: none, split, or selflink (backward compat: boolean → string) #}
{% set clickMode = config.clickParentPage|default('none') %}
{% if clickMode is same as(true) %}{% set clickMode = 'selflink' %}{% endif %}
{% if clickMode is same as(false) %}{% set clickMode = 'none' %}{% endif %}

{# Macro: navigation items L1/L2/L3 accordion #}
{% macro render_nav_items(navItems, clickMode) %}
    {% for item in navItems %}
        {% if item.children is defined and item.children|length > 0 %}
            <div class="iw-menu__parent-item">
                {# L1 with children — depends on clickMode #}
                {% if clickMode == 'split' %}
                    {# Split button: link text + separate chevron toggle #}
                    <div class="flex items-center justify-between w-full">
                        <a
                            href="{{ sulu_content_path(item.url) }}"
                            class="iw-menu__text flex-1 py-2.5 px-3 text-sm font-semibold rounded-md hover:opacity-80 transition-opacity no-underline"
                        >
                            {{ item.title }}
                        </a>
                        <button
                            type="button"
                            data-action="menu#toggleMobileSubmenu"
                            class="iw-menu__text p-2 rounded-md hover:opacity-80 transition-opacity cursor-pointer"
                        >
                            <svg class="w-4 h-4 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                    </div>
                {% else %}
                    {# Default accordion button (none + selflink) #}
                    <button
                        type="button"
                        data-action="menu#toggleMobileSubmenu"
                        class="iw-menu__text flex items-center justify-between w-full py-2.5 px-3 text-sm font-semibold rounded-md hover:opacity-80 transition-opacity text-left cursor-pointer"
                    >
                        {{ item.title }}
                        <svg class="w-4 h-4 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                {% endif %}
                <div data-menu-target="submenu" class="hidden pl-3 space-y-0.5">
                    {% if clickMode == 'selflink' %}
                        {# Self-link to parent page as first item #}
                        <a
                            href="{{ sulu_content_path(item.url) }}"
                            class="iw-menu__text--level-2 block py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity no-underline italic"
                        >
                            {{ item.title }}
                        </a>
                    {% endif %}
                    {% for child in item.children %}
                        {% if child.children is defined and child.children|length > 0 %}
                            {# L2 with L3 children — nested accordion #}
                            <div class="iw-menu__parent-item">
                                {% if clickMode == 'split' %}
                                    <div class="flex items-center justify-between w-full">
                                        <a
                                            href="{{ sulu_content_path(child.url) }}"
                                            class="iw-menu__text--level-2 flex-1 py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity no-underline"
                                        >
                                            {{ child.title }}
                                        </a>
                                        <button
                                            type="button"
                                            data-action="menu#toggleMobileSubmenu"
                                            class="iw-menu__text--level-2 p-1 opacity-70 hover:opacity-100 cursor-pointer"
                                        >
                                            <svg class="w-3.5 h-3.5 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                            </svg>
                                        </button>
                                    </div>
                                {% else %}
                                    <button
                                        type="button"
                                        data-action="menu#toggleMobileSubmenu"
                                        class="iw-menu__text--level-2 flex items-center justify-between w-full py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity text-left cursor-pointer"
                                    >
                                        <span>{{ child.title }}</span>
                                        <svg class="w-3.5 h-3.5 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                    </button>
                                {% endif %}
                                <div data-menu-target="submenu" class="hidden pl-3 space-y-0.5">
                                    {% if clickMode == 'selflink' %}
                                        {# Self-link to L2 page itself #}
                                        <a
                                            href="{{ sulu_content_path(child.url) }}"
                                            class="iw-menu__text--level-3 block py-1.5 px-3 text-xs opacity-50 hover:opacity-100 transition-opacity no-underline italic"
                                        >
                                            {{ child.title }}
                                        </a>
                                    {% endif %}
                                    {# L3 grandchildren #}
                                    {% for grandchild in child.children %}
                                        <a
                                            href="{{ sulu_content_path(grandchild.url) }}"
                                            class="iw-menu__text--level-3 block py-1.5 px-3 text-xs opacity-60 hover:opacity-100 transition-opacity no-underline"
                                        >
                                            {{ grandchild.title }}
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            {# L2 without children — simple link #}
                            <a
                                href="{{ sulu_content_path(child.url) }}"
                                class="iw-menu__text--level-2 block py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity no-underline"
                            >
                                {{ child.title }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% else %}
            {# L1 without children — simple link #}
            <a
                href="{{ sulu_content_path(item.url) }}"
                class="iw-menu__text block py-2.5 px-3 text-sm font-semibold rounded-md hover:opacity-80 transition-opacity no-underline"
            >
                {{ item.title }}
            </a>
        {% endif %}
    {% endfor %}
{% endmacro %}

{# Macro: logo display #}
{% macro render_logo(config) %}
    {% set displayDesktop = config.displayLogoDesktop|default(false) %}
    {% set displayMobile = config.displayLogoMobile|default(false) %}
    {% set displaySiteName = config.displaySiteName|default(false) %}
    {% set siteName = config.siteName|default('') %}
    <a href="{{ sulu_content_path('/') }}" class="iw-menu__text flex items-center gap-2 no-underline">
        {% include '@ItechWorldSuluTailwindTheme/menu/_logo_images.html.twig'
            with { config: config } only %}
        {% if displaySiteName %}
            <span class="text-lg font-bold">{{ siteName }}</span>
        {% endif %}
        {# Fallback: show site name if nothing else is configured #}
        {% if not displayDesktop and not displayMobile and not displaySiteName %}
            <span class="text-lg font-bold">{{ siteName|default('Site') }}</span>
        {% endif %}
    </a>
{% endmacro %}

<header data-controller="menu"
        data-menu-animation-value="slide"
        data-menu-slide-direction-value="{{ position }}"
        class="iw-menu iw-menu--sidebar {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }}">

    {# ═══ NAVBAR: always visible (mobile + desktop) ═══
       Unlike the other menu types, the sticky element here is this <nav>, not
       the <header> (which also wraps the sliding panel). The bar chrome
       therefore lives on the <nav>, driven by .iw-menu--sidebar. #}
    <nav class="sticky top-0 z-50 w-full">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 md:h-20">
            {# LEFT — Logo + Site Name #}
            <div class="flex-shrink-0 flex items-center">
                {{ _self.render_logo(config) }}
            </div>

            {# RIGHT — Social media + Burger #}
            <div class="flex items-center gap-3">
                {# Social media icons — shown on every breakpoint #}
                {% if socialLinks|length > 0 %}
                    <div class="flex items-center gap-2">
                        {% for link in socialLinks %}
                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center">
                                {% if link.icon is defined and link.icon.id is defined %}
                                    {% set iconMedia = sulu_resolve_media(link.icon.id, app.request.locale) %}
                                    {% if iconMedia is not null and iconMedia.url is defined %}
                                        {% set iconUrl = iconMedia.thumbnails['50x50']|default(iconMedia.url) %}
                                        <span class="iw-social-icon w-5 h-5"
                                              style="-webkit-mask-image: url('{{ iconUrl }}'); mask-image: url('{{ iconUrl }}');"
                                              aria-label="{{ link.name|default('') }}"></span>
                                    {% else %}
                                        <span class="iw-social-text text-sm">{{ link.name|default('') }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="iw-social-text text-sm">{{ link.name|default('') }}</span>
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Burger — toggles the sidebar on every breakpoint, animates into an X #}
                <button type="button"
                        data-action="menu#toggleSidebar"
                        data-menu-target="sidebarBurger"
                        class="iw-menu__burger w-10 h-10 flex flex-col items-center justify-center gap-1.5"
                        aria-label="Menu">
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                </button>
            </div>
        </div>
    </nav>

    {# Backdrop — dims the page behind the sidebar (below the navbar + sidebar),
       click to close. Visibility driven by the .iw-menu__backdrop--visible class. #}
    <div data-menu-target="backdrop"
         data-action="click->menu#toggleSidebar"
         class="iw-menu__backdrop fixed inset-0 z-30"></div>

    {# ═══ Sidebar — slides in from the configured side on every breakpoint ═══ #}
    {# Full width on mobile, 288px on desktop (where the backdrop dims the rest of
       the page). Stack: navbar (z-50) > sidebar (z-40) > backdrop (z-30) > page. #}
    <aside data-menu-target="sidebar"
           class="fixed top-0 {{ isLeft ? 'left-0' : 'right-0' }} h-screen z-40
                  iw-menu__sidebar w-full lg:w-72 flex flex-col transition-transform duration-300
                  {{ isLeft ? '-translate-x-full' : 'translate-x-full' }}">

        {% if config.subMenuPanels|default(false) %}
            {# Drill-down panels mode — the partial fills the aside and clears the
               navbar itself (like the burger), so no spacer here. #}
            {% if navItems is not empty %}
                {% include '@ItechWorldSuluTailwindTheme/menu/_nav_panels.html.twig' with {
                    navItems: navItems,
                    parentLinkable: config.clickParentPagePanels|default(false),
                    direction: position,
                    animation: 'slide',
                    socialLinks: [],
                    context: 'sidebar',
                } only %}
            {% endif %}
        {% else %}
            {# Accordion mode: a spacer clears the navbar, then the nav. #}
            <div class="h-16 md:h-20 flex-shrink-0"></div>
            {% if navItems is not empty %}
                <nav class="flex-1 overflow-y-auto px-4 py-2 space-y-1">
                    {{ _self.render_nav_items(navItems, clickMode) }}
                </nav>
            {% endif %}
        {% endif %}
    </aside>
</header>
