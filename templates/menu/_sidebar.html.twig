{# Menu — sidebar navigation #}
{% set position = config.sidebarPosition|default('left') %}
{% set isLeft = position == 'left' %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(2), {title: 'title', url: 'url'}) %}

{# Parent page click mode: none, split, or selflink (backward compat: boolean → string) #}
{% set clickMode = config.clickParentPage|default('none') %}
{% if clickMode is same as(true) %}{% set clickMode = 'selflink' %}{% endif %}
{% if clickMode is same as(false) %}{% set clickMode = 'none' %}{% endif %}

{# Macro: navigation items L1/L2/L3 accordion, one list per level #}
{% macro render_nav_items(navItems, clickMode) %}
    {% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}
    <ul class="iw-menu__list space-y-1">
    {% for item in navItems %}
        {% set itemHref = sulu_content_path(item.url) %}
        {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
        {% if item.children is defined and item.children|length > 0 %}
            {% set submenuId = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
            <li class="iw-menu__parent-item">
                {# L1 with children - depends on clickMode #}
                {% if clickMode == 'split' %}
                    {# Split button: link text + separate chevron toggle #}
                    <div class="flex items-center justify-between w-full">
                        <a
                            href="{{ itemHref }}"{{ nav.current(itemState) }}
                            class="iw-menu__text{{ nav.state_class(itemState) }} flex-1 py-2.5 px-3 text-sm font-semibold rounded-md hover:opacity-80 transition-opacity no-underline"
                        >
                            {{ item.title }}
                        </a>
                        <button
                            type="button"
                            data-action="menu#toggleDisclosure"
                            aria-expanded="false"
                            aria-controls="{{ submenuId }}"
                            aria-label="{{ 'iw_sulu_tailwind_theme.menu_submenu_toggle'|trans({'%title%': item.title}, 'messages') }}"
                            class="iw-menu__text p-2 rounded-md hover:opacity-80 transition-opacity cursor-pointer"
                        >
                            {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                        </button>
                    </div>
                {% else %}
                    {# Default accordion button (none + selflink) #}
                    <button
                        type="button"
                        data-action="menu#toggleDisclosure"
                        aria-expanded="false"
                        aria-controls="{{ submenuId }}"
                        class="iw-menu__text{{ nav.branch_class(itemState) }} flex items-center justify-between w-full py-2.5 px-3 text-sm font-semibold rounded-md hover:opacity-80 transition-opacity text-left cursor-pointer"
                    >
                        {{ item.title }}
                        {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                    </button>
                {% endif %}
                <ul id="{{ submenuId }}" class="iw-menu__list iw-menu__dropdown--level-2 hidden pl-3 space-y-0.5">
                    {% if clickMode == 'selflink' %}
                        {# Self-link to parent page as first item #}
                        <li>
                            <a
                                href="{{ itemHref }}"{{ nav.current(itemState) }}
                                class="iw-menu__text--level-2{{ nav.state_class(itemState) }} block py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity no-underline italic"
                            >
                                {{ item.title }}
                            </a>
                        </li>
                    {% endif %}
                    {% for child in item.children %}
                        {% set childHref = sulu_content_path(child.url) %}
                        {% set childState = iw_sulu_tailwind_theme_nav_state(childHref) %}
                        {% if child.children is defined and child.children|length > 0 %}
                            {# L2 with L3 children - nested accordion #}
                            {% set subSubmenuId = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
                            <li class="iw-menu__parent-item">
                                {% if clickMode == 'split' %}
                                    <div class="flex items-center justify-between w-full">
                                        <a
                                            href="{{ childHref }}"{{ nav.current(childState) }}
                                            class="iw-menu__text--level-2{{ nav.state_class(childState) }} flex-1 py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity no-underline"
                                        >
                                            {{ child.title }}
                                        </a>
                                        <button
                                            type="button"
                                            data-action="menu#toggleDisclosure"
                                            aria-expanded="false"
                                            aria-controls="{{ subSubmenuId }}"
                                            aria-label="{{ 'iw_sulu_tailwind_theme.menu_submenu_toggle'|trans({'%title%': child.title}, 'messages') }}"
                                            class="iw-menu__text--level-2 p-1 opacity-70 hover:opacity-100 cursor-pointer"
                                        >
                                            {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-3.5 h-3.5 flex-shrink-0'} only %}
                                        </button>
                                    </div>
                                {% else %}
                                    <button
                                        type="button"
                                        data-action="menu#toggleDisclosure"
                                        aria-expanded="false"
                                        aria-controls="{{ subSubmenuId }}"
                                        class="iw-menu__text--level-2{{ nav.branch_class(childState) }} flex items-center justify-between w-full py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity text-left cursor-pointer"
                                    >
                                        <span>{{ child.title }}</span>
                                        {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-3.5 h-3.5 flex-shrink-0'} only %}
                                    </button>
                                {% endif %}
                                <ul id="{{ subSubmenuId }}" class="iw-menu__list iw-menu__dropdown--level-3 hidden pl-3 space-y-0.5">
                                    {% if clickMode == 'selflink' %}
                                        {# Self-link to L2 page itself #}
                                        <li>
                                            <a
                                                href="{{ childHref }}"{{ nav.current(childState) }}
                                                class="iw-menu__text--level-3{{ nav.state_class(childState) }} block py-1.5 px-3 text-xs opacity-50 hover:opacity-100 transition-opacity no-underline italic"
                                            >
                                                {{ child.title }}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {# L3 grandchildren #}
                                    {% for grandchild in child.children %}
                                        {% set grandchildHref = sulu_content_path(grandchild.url) %}
                                        {% set grandchildState = iw_sulu_tailwind_theme_nav_state(grandchildHref) %}
                                        <li>
                                            <a
                                                href="{{ grandchildHref }}"{{ nav.current(grandchildState) }}
                                                class="iw-menu__text--level-3{{ nav.state_class(grandchildState) }} block py-1.5 px-3 text-xs opacity-60 hover:opacity-100 transition-opacity no-underline"
                                            >
                                                {{ grandchild.title }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% else %}
                            {# L2 without children - simple link #}
                            <li>
                                <a
                                    href="{{ childHref }}"{{ nav.current(childState) }}
                                    class="iw-menu__text--level-2{{ nav.state_class(childState) }} block py-2 px-3 text-sm rounded-md opacity-70 hover:opacity-100 transition-opacity no-underline"
                                >
                                    {{ child.title }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </li>
        {% else %}
            {# L1 without children - simple link #}
            <li>
                <a
                    href="{{ itemHref }}"{{ nav.current(itemState) }}
                    class="iw-menu__text{{ nav.state_class(itemState) }} block py-2.5 px-3 text-sm font-semibold rounded-md hover:opacity-80 transition-opacity no-underline"
                >
                    {{ item.title }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
    </ul>
{% endmacro %}

{# Macro: logo display #}
{% macro render_logo(config) %}
    {% include '@ItechWorldSuluTailwindTheme/menu/_logo_link.html.twig'
        with {config: config, nameClass: 'text-lg font-bold'} only %}
{% endmacro %}

{% set sidebarId = iw_sulu_tailwind_theme_unique_id('menu-sidebar') %}

<header data-controller="menu"
        data-menu-open-label-value="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
        data-menu-close-label-value="{{ 'iw_sulu_tailwind_theme.menu_close'|trans({}, 'messages') }}"
        data-menu-scroll-bg-value="{{ (config.scrollBg ?? true) ? 'true' : 'false' }}"
        class="iw-menu iw-menu--sidebar {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }}">

    {# ═══ NAVBAR: always visible (mobile + desktop) ═══
       Unlike the other menu types, the sticky element here is this frame, not
       the <header> (which also wraps the sliding panel). The bar chrome
       therefore lives on the frame, driven by .iw-menu--sidebar. #}
    <div class="iw-menu__frame sticky top-0 z-50 w-full">
        <div class="iw-menu__bar container mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
            {# LEFT — Logo + Site Name #}
            <div class="flex-shrink-0 flex items-center">
                {{ _self.render_logo(config) }}
            </div>

            {# RIGHT — Language switcher + Social media + Burger #}
            <div class="flex items-center gap-3">
                {# Language switcher — in the bar, so it is reachable in both
                   the accordion and the drill-down panels mode. #}
                {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                    with {config: config, align: 'right', slot: 'bar'} %}

                {# Social media icons — shown on every breakpoint #}
                {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                    links: socialLinks,
                    class: 'flex items-center gap-2',
                    textClass: 'text-sm',
                } only %}

                {# Burger — toggles the sidebar on every breakpoint, animates into an X #}
                <button type="button"
                        data-action="menu#toggleSidebar"
                        data-menu-target="sidebarBurger"
                        aria-expanded="false"
                        aria-controls="{{ sidebarId }}"
                        aria-label="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
                        class="iw-menu__burger w-10 h-10 flex flex-col items-center justify-center gap-1.5">
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                </button>
            </div>
        </div>
    </div>

    {# Backdrop — dims the page behind the sidebar (below the navbar + sidebar),
       click to close. Visibility driven by the .iw-menu__backdrop--visible class. #}
    <div data-menu-target="backdrop"
         data-action="click->menu#toggleSidebar"
         class="iw-menu__backdrop fixed inset-0 z-30"></div>

    {# ═══ Sidebar — slides in from the configured side on every breakpoint ═══ #}
    {# Full width on mobile, 288px on desktop (where the backdrop dims the rest of
       the page). Stack: navbar (z-50) > sidebar (z-40) > backdrop (z-30) > page. #}
    {# A dialog: the controller makes the page it hides inert while it is
       open. A <div>, not an <aside>: it is not complementary content, and
       `dialog` is not an allowed role on <aside>. The slide and the hidden
       state come from .iw-menu__sidebar--{side} and --open. #}
    <div id="{{ sidebarId }}"
           data-menu-target="sidebar"
           role="dialog"
           aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
           class="fixed top-0 {{ isLeft ? 'left-0' : 'right-0' }} h-screen z-40
                  iw-menu__sidebar iw-menu__sidebar--{{ isLeft ? 'left' : 'right' }} w-full flex flex-col">

        {% if config.subMenuPanels|default(false) %}
            {# Drill-down panels mode: the partial fills the panel and clears the
               navbar itself (like the burger), so no spacer here. #}
            {% if navItems is not empty %}
                {% include '@ItechWorldSuluTailwindTheme/menu/_nav_panels.html.twig' with {
                    navItems: navItems,
                    parentLinkable: config.clickParentPagePanels|default(false),
                    direction: position,
                    animation: 'slide',
                    socialLinks: [],
                    config: config,
                    localizations: localizations|default([]),
                    context: 'sidebar',
                } only %}
            {% endif %}
        {% else %}
            {# Accordion mode: a spacer clears the navbar, then the nav. #}
            <div class="iw-menu__bar-spacer"></div>
            {% if navItems is not empty %}
                <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="flex-1 overflow-y-auto px-4 py-2">
                    {{ _self.render_nav_items(navItems, clickMode) }}
                </nav>
            {% endif %}
            {# Also inline at the foot of the panel: once the sidebar is open it
               covers the bar on mobile. Inset like the text of the links
               (panel px-4 plus entry px-3). #}
            <div class="px-7 py-3">
                {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                    with {config: config, display: 'inline', slot: 'panel'} %}
            </div>
        {% endif %}
    </div>
</header>
