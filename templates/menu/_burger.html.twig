{# Menu - always a burger, which opens the navigation in a dialog.

   The panel either covers the screen (panelLayout 'full', the default) or
   slides in from a side (panelLayout 'side'), panelWidth wide from 1024px
   with a dimmed page behind it. panelSide places the burger in the bar: a
   side panel opens on that side, a full-screen panel puts its links there
   and its optional picture on the other side, from panelImageFrom up: the
   links zone is then panelWidth wide, the picture takes the rest. The
   former `sidebar` and `fullscreen` menu types are these two panels (see
   MenuConfigNormalizer). #}

{% set isSide = config.panelLayout|default('full') == 'side' %}
{% set side = config.panelSide|default('right') == 'left' ? 'left' : 'right' %}

{# Full screen: the picture, the place of the links, the first level size. #}
{% set panelMedia = not isSide and config.panelImage.id|default(null)
    ? sulu_resolve_media(config.panelImage.id, app.request.locale)
    : null %}
{% set imageFrom = config.panelImageFrom|default('lg') in ['md', 'lg', 'xl'] ? config.panelImageFrom|default('lg') : 'lg' %}
{% set position = config.panelContentPosition|default('auto') in ['auto', 'image', 'center', 'bar'] ? config.panelContentPosition|default('auto') : 'auto' %}
{% if position == 'auto' %}{% set position = panelMedia ? 'image' : 'center' %}{% endif %}
{% if position == 'image' and not panelMedia %}{% set position = 'bar' %}{% endif %}
{# The side the links hug in their zone. Against the edge: under the logo, or
   under the burger beside a picture. Against the picture: the other side. #}
{% set burgerSide = side == 'right' ? 'end' : 'start' %}
{% set imageSide = side == 'right' ? 'start' : 'end' %}
{% set contentEdge = position == 'center' ? 'center' : (position == 'image' ? imageSide : (panelMedia ? burgerSide : 'start')) %}
{% set panelClasses = isSide
    ? 'iw-menu__overlay--side iw-menu__overlay--' ~ side
    : 'iw-menu__overlay--full iw-menu__overlay--content-' ~ contentEdge
        ~ (panelMedia ? ' iw-menu__overlay--image iw-menu__overlay--image-' ~ (side == 'right' ? 'left' : 'right') ~ ' iw-menu__overlay--image-from-' ~ imageFrom : '') %}
{% if config.panelL1Size|default('normal') == 'large' %}{% set panelClasses = panelClasses ~ ' iw-menu__overlay--l1-large' %}{% endif %}
{% set animation = config.animation|default('none') %}
{# A side panel comes from its side. #}
{% set slideDirection = isSide ? side : config.slideDirection|default('top') %}

{# Parent page click mode: none, split, or selflink (backward compat: boolean → string) #}
{% set clickMode = config.clickParentPage|default('none') %}
{% if clickMode is same as(true) %}{% set clickMode = 'selflink' %}{% endif %}
{% if clickMode is same as(false) %}{% set clickMode = 'none' %}{% endif %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% set panelId = iw_sulu_tailwind_theme_unique_id('menu-panel') %}
{# The width under which the bar actions move to the panel. #}
{% set actionsAt = config.barActionsBreakpoint|default('lg') in ['md', 'lg', 'xl'] ? config.barActionsBreakpoint|default('lg') : 'lg' %}
{# The language switcher set to "both" moves from the bar to the open menu at
   that same width, rather than showing twice. #}
{% set langBoth = config.displayLanguageSwitcher|default(false) and config.languageSwitcherPosition|default('both') == 'both' %}

{# The burger turns into the close button. On the left side it opens the
   bar, before the logo. #}
{% set burgerButton %}
    <button
        type="button"
        data-action="menu#toggle"
        data-menu-target="burger"
        aria-expanded="false"
        aria-controls="{{ panelId }}"
        aria-label="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
        class="iw-menu__burger w-10 h-10 flex flex-col items-center justify-center gap-1.5 flex-shrink-0"
    >
        <span class="iw-menu__burger-line"></span>
        <span class="iw-menu__burger-line"></span>
        <span class="iw-menu__burger-line"></span>
    </button>
{% endset %}
{% set burgerFirst = side == 'left' %}

{# Where the bar actions sit on a wide screen. Right, the default, keeps them
   in the right-hand group as they always were. Left and centre take them out
   into a group of their own, which the bar places (see ThemeCompiler). A key
   of its own rather than `navPosition`: a burger theme stores the navbar
   default `center` for that one, so reading it would move every existing
   burger bar to the middle. #}
{% set actionsPosition = config.barActionsPosition|default('right') in ['left', 'center', 'right'] ? config.barActionsPosition|default('right') : 'right' %}
{% set barActions %}{% include '@ItechWorldSuluTailwindTheme/menu/_bar_actions.html.twig' with {config: config, slot: 'bar'} only %}{% endset %}
{% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}

<header
    data-controller="menu"
    data-menu-open-label-value="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
    data-menu-close-label-value="{{ 'iw_sulu_tailwind_theme.menu_close'|trans({}, 'messages') }}"
    data-menu-scroll-bg-value="{{ (config.scrollBg ?? true) ? 'true' : 'false' }}"
    data-menu-scroll-hide-value="{{ (config.scrollHide ?? false) ? 'true' : 'false' }}"
    class="iw-menu{{ config.displayBarActions|default(false) or langBoth ? ' iw-menu--actions-at-' ~ actionsAt : '' }}{{ nav.bar_layout_class(config, actionsPosition) }} {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }} sticky top-0 z-40 w-full"
>
    <div class="iw-menu__frame relative z-50 iw-menu__container container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="iw-menu__bar flex items-center justify-between">

            {# LEFT - (Burger) + Logo + Site Name #}
            <div class="iw-menu__bar-start flex-shrink-0 flex items-center gap-3">
                {% if burgerFirst %}{{ burgerButton }}{% endif %}
                {% include '@ItechWorldSuluTailwindTheme/menu/_logo_link.html.twig'
                    with {config: config, nameClass: 'text-xl font-bold'} only %}
            </div>

            {# Bar actions, placed on their own after the logo or in the
               middle of the page. Pushed to the right below the md breakpoint,
               where the bar is a plain row. #}
            {% if actionsPosition != 'right' and barActions|trim is not empty %}
                <div class="iw-menu__bar-links flex items-center ml-auto{{ actionsPosition == 'left' ? ' md:ml-0 md:mr-auto' : '' }}">
                    {{ barActions }}
                </div>
            {% endif %}

            {# RIGHT - (Bar actions) + Language switcher + Social media + (Burger) #}
            <div class="iw-menu__bar-end flex items-center gap-3">
                {% if actionsPosition == 'right' %}{{ barActions }}{% endif %}

                {# Language switcher - in the bar, reachable without opening the
                   menu. Hidden when the theme places it in the panel only. #}
                {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                    with {config: config, align: 'right', slot: 'bar'} %}

                {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                    links: socialLinks,
                    class: 'hidden md:flex items-center gap-2',
                    textClass: 'text-sm',
                } only %}

                {% if not burgerFirst %}{{ burgerButton }}{% endif %}
            </div>
        </div>
    </div>

    {% if isSide %}
        {# The page behind a side panel is dimmed, a click on it closes the
           panel. Stack: bar (z-50) > panel (z-30) > backdrop (z-20). #}
        <div data-menu-target="backdrop"
             data-action="click->menu#toggle"
             class="iw-menu__backdrop fixed inset-0 z-20"></div>
    {% endif %}

    {# The dialog. Full: it covers the screen and its content clears the bar.
       Side: it starts under the bar. #}
    {% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(2), {title: 'title', url: 'url'}) %}
    <div
        id="{{ panelId }}"
        data-menu-target="panel"
        role="dialog"
        aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
        class="iw-menu__overlay {{ panelClasses }} iw-menu__dialog iw-menu__dialog--{{ animation }} iw-menu__dialog--from-{{ slideDirection }} fixed z-30"
    >
        {% if panelMedia %}
            {# The picture waits in a <template> the controller unpacks when
               the panel opens and this zone is shown: no request before, none
               below panelImageFrom. Decorative, the links carry the menu. #}
            <div class="iw-menu__panel-media" aria-hidden="true">
                <template data-menu-deferred>
                    {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                        media: panelMedia,
                        format: 'iw_theme_menu_curtain',
                        alt: '',
                        raw: true,
                        loading: 'eager',
                        classes: 'w-full h-full object-cover',
                    }) }}
                </template>
            </div>
            <div class="iw-menu__panel-main">
        {% endif %}
        {% if config.subMenuPanels|default(false) %}
        {# Drill-down panels mode (opt-in) - separate partial for maintainability. #}
        {% include '@ItechWorldSuluTailwindTheme/menu/_nav_panels.html.twig' with {
            navItems: navItems,
            parentLinkable: config.clickParentPagePanels|default(false),
            parentLinkPosition: config.panelsParentLinkPosition|default('header'),
            direction: slideDirection,
            animation: animation,
            socialLinks: socialLinks,
            config: config,
            localizations: localizations|default([]),
        } only %}
        {% else %}
        <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="iw-menu__overlay-nav{{ isSide ? '' : ' iw-menu__overlay-nav--below-bar' }} overflow-y-auto h-full">
            {% include '@ItechWorldSuluTailwindTheme/menu/_nav_accordion.html.twig'
                with {navItems: navItems, clickMode: clickMode} only %}

            {% include '@ItechWorldSuluTailwindTheme/menu/_bar_actions.html.twig'
                with {config: config, slot: 'panel'} only %}

            {# Language switcher - inline: the overlay already covers the page,
               a dropdown on top of it would read badly. The vertical padding
               keeps it off the last nav item and the social row. #}
            <div class="pt-6 pb-2{{ langBoth ? ' iw-menu__narrow-only' : '' }}">
                {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                    with {config: config, display: 'inline', slot: 'panel'} %}
            </div>

            {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                links: socialLinks,
                class: 'flex items-center gap-3 pt-6 pb-4',
                size: 'md',
                textClass: '',
            } only %}
        </nav>
        {% endif %}
        {% if panelMedia %}
            </div>
        {% endif %}
    </div>
</header>
