{# Menu — classic horizontal navbar with fullscreen mobile overlay #}

{# Animation config for mobile menu #}
{% set animation = config.animation|default('none') %}
{% set slideDirection = config.slideDirection|default('top') %}

{# Navigation position: left, center (default), right #}
{% set navPosition = config.navPosition|default('center') %}

{# Parent page self-link for navbar (simple boolean toggle) #}
{% set clickNavbar = config.clickParentPageNavbar|default(false) %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}

{# Width under which the links give way to the burger (see ThemeCompiler). #}
{% set collapseAt = config.collapseAt|default('auto') in ['md', 'lg', 'xl', 'auto'] ? config.collapseAt|default('auto') : 'auto' %}

{# Ids tie each trigger to what it opens (aria-controls). #}
{% set panelId = iw_sulu_tailwind_theme_unique_id('menu-panel') %}

<header
    data-controller="menu"
    data-menu-open-label-value="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
    data-menu-close-label-value="{{ 'iw_sulu_tailwind_theme.menu_close'|trans({}, 'messages') }}"
    data-menu-scroll-bg-value="{{ (config.scrollBg ?? true) ? 'true' : 'false' }}"
    data-menu-scroll-hide-value="{{ (config.scrollHide ?? false) ? 'true' : 'false' }}"
    class="iw-menu iw-menu--collapse-{{ collapseAt }} {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }} sticky top-0 z-40 w-full"
>
    <div class="iw-menu__frame relative z-50 md:container md:mx-auto px-4 sm:px-6 lg:px-8">
        <div class="iw-menu__bar flex items-center justify-between">

            {# LEFT — Logo + Site Name #}
            <div class="flex-shrink-0 flex items-center {{ navPosition == 'left' ? 'mr-0' : '' }}">
                {% include '@ItechWorldSuluTailwindTheme/menu/_logo_link.html.twig'
                    with {config: config, nameClass: 'text-xl font-bold'} only %}
            </div>

            {# Desktop navigation — position depends on navPosition setting #}
            {% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(2), {title: 'title', url: 'url'}) %}
            {% set navPositionClass = {
                'left': 'md:ml-6 md:mr-auto',
                'center': 'md:mx-auto',
                'right': 'md:ml-auto md:mr-6'
            } %}
            <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="iw-menu__desktop-nav iw-menu__desktop-only {{ navPositionClass[navPosition]|default('md:mx-auto') }}">
                <ul class="iw-menu__list flex items-center gap-1">
                {% for item in navItems %}
                    {% set itemHref = sulu_content_path(item.url) %}
                    {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
                    {% if item.children is defined and item.children|length > 0 %}
                        {# Dropdown parent: the item is the hover and focus zone #}
                        {% set dropdownId = iw_sulu_tailwind_theme_unique_id('menu-dropdown') %}
                        {# A long list scrolls, unless a level 3 opens beside it:
                           the scroll box would clip that flyout. #}
                        {% set hasLevel3 = item.children|filter(child => child.children is defined and child.children|length > 0)|length > 0 %}
                        <li class="relative">
                            <button
                                type="button"
                                data-action="menu#toggleDisclosure"
                                data-menu-target="popupTrigger"
                                aria-expanded="false"
                                aria-controls="{{ dropdownId }}"
                                class="iw-menu__text{{ nav.branch_class(itemState) }} flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-md transition-opacity"
                            >
                                {{ item.title }}
                                {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                            </button>
                            <ul
                                id="{{ dropdownId }}"
                                class="iw-menu__list iw-menu__dropdown--level-2 iw-menu__bar-dropdown{{ hasLevel3 ? '' : ' iw-menu__dropdown--scroll' }} hidden absolute w-48 shadow-lg py-1 z-50"
                            >
                                {% if clickNavbar %}
                                    <li>
                                        <a
                                            href="{{ itemHref }}"{{ nav.current(itemState) }}
                                            class="iw-menu__text--level-2{{ nav.state_class(itemState) }} block px-4 py-2 text-sm font-medium transition-opacity no-underline hover:opacity-80 italic"
                                        >
                                            {{ item.title }}
                                        </a>
                                    </li>
                                {% endif %}
                                {% for child in item.children %}
                                    {% set childHref = sulu_content_path(child.url) %}
                                    {% set childState = iw_sulu_tailwind_theme_nav_state(childHref) %}
                                    {% if child.children is defined and child.children|length > 0 %}
                                        {# Level 2 item with children: opens level 3 on the side #}
                                        {% set subdropdownId = iw_sulu_tailwind_theme_unique_id('menu-dropdown') %}
                                        <li class="relative">
                                            <button
                                                type="button"
                                                data-action="menu#toggleDisclosure"
                                                data-menu-target="popupTrigger"
                                                aria-expanded="false"
                                                aria-controls="{{ subdropdownId }}"
                                                class="iw-menu__text--level-2{{ nav.branch_class(childState) }} flex items-center justify-between w-full px-4 py-2 text-sm transition-opacity hover:opacity-80 text-left cursor-pointer"
                                            >
                                                {{ child.title }}
                                                {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'next', 'class': 'w-3 h-3 ml-2'} only %}
                                            </button>
                                            <ul
                                                id="{{ subdropdownId }}"
                                                data-menu-placement="side"
                                                class="iw-menu__list iw-menu__dropdown--level-3 iw-menu__dropdown--scroll hidden absolute left-full top-0 ml-0.5 w-48 shadow-lg py-1 z-50"
                                            >
                                                {% if clickNavbar %}
                                                    <li>
                                                        <a
                                                            href="{{ childHref }}"{{ nav.current(childState) }}
                                                            class="iw-menu__text--level-3{{ nav.state_class(childState) }} block px-4 py-2 text-sm font-medium transition-opacity no-underline hover:opacity-80 italic"
                                                        >
                                                            {{ child.title }}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                                {% for grandchild in child.children %}
                                                    {% set grandchildHref = sulu_content_path(grandchild.url) %}
                                                    {% set grandchildState = iw_sulu_tailwind_theme_nav_state(grandchildHref) %}
                                                    <li>
                                                        <a
                                                            href="{{ grandchildHref }}"{{ nav.current(grandchildState) }}
                                                            class="iw-menu__text--level-3{{ nav.state_class(grandchildState) }} block px-4 py-2 text-sm transition-opacity no-underline hover:opacity-80"
                                                        >
                                                            {{ grandchild.title }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                                    {% else %}
                                        <li>
                                            <a
                                                href="{{ childHref }}"{{ nav.current(childState) }}
                                                class="iw-menu__text--level-2{{ nav.state_class(childState) }} block px-4 py-2 text-sm transition-opacity no-underline hover:opacity-80"
                                            >
                                                {{ child.title }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                    {% else %}
                        <li>
                            <a
                                href="{{ itemHref }}"{{ nav.current(itemState) }}
                                class="iw-menu__text{{ nav.state_class(itemState) }} block px-4 py-2 text-sm font-medium rounded-md transition-opacity no-underline hover:opacity-80"
                            >
                                {{ item.title }}
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}
                </ul>
            </nav>

            {# RIGHT — Language switcher + Social media (desktop + mobile) + Burger #}
            <div class="flex items-center gap-3">
                {# Language switcher — desktop. Anchored right: it sits at the
                   end of the bar, so a left-anchored panel would overflow. #}
                <div class="iw-menu__desktop-only">
                    {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                        with {config: config, align: 'right'} %}
                </div>

                {# Social media icons — desktop #}
                {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                    links: socialLinks,
                    class: 'flex items-center gap-2 iw-menu__desktop-only',
                    textClass: 'text-sm',
                } only %}

                {# Animated burger button — mobile only (3 lines → X) #}
                <button
                    type="button"
                    data-action="menu#toggle"
                    data-menu-target="burger"
                    aria-expanded="false"
                    aria-controls="{{ panelId }}"
                    aria-label="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
                    class="iw-menu__burger iw-menu__mobile-only w-10 h-10 flex flex-col items-center justify-center gap-1.5"
                >
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                </button>
            </div>
        </div>

    </div>

    {# Mobile overlay panel — positioned below the navbar #}
    <div
        id="{{ panelId }}"
        data-menu-target="panel"
        role="dialog"
        aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
        class="iw-menu__overlay iw-menu__dialog iw-menu__dialog--{{ animation }} iw-menu__dialog--from-{{ slideDirection }} iw-menu__below-bar fixed left-0 right-0 bottom-0 z-30 iw-menu__mobile-only"
    >
        {# Navigation links #}
        <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="iw-menu__overlay-nav overflow-y-auto h-full">
            {% include '@ItechWorldSuluTailwindTheme/menu/_nav_accordion.html.twig'
                with {navItems: navItems, clickMode: clickNavbar ? 'selflink' : 'none'} only %}

            {# Language switcher — mobile overlay, inline: a popup inside a
               panel that already covers the page reads badly. #}
            {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                with {config: config, display: 'inline'} %}

            {# Social media icons in mobile overlay #}
            {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                links: socialLinks,
                class: 'flex items-center gap-3 pt-6 pb-4',
                size: 'md',
                textClass: '',
            } only %}
        </nav>
    </div>
</header>
