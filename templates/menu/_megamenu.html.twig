{# Menu — mega menu with full-width dropdowns (native or snippet mode) #}

{# Data source: native (page tree) or snippet (manual structure) #}
{% set megaSource = config.megamenuSource|default('native') %}

{# Navigation position: left, center (default), right #}
{% set navPosition = config.navPosition|default('center') %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% import '@ItechWorldSuluTailwindTheme/components/_link_macros.html.twig' as links %}
{% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}

{# Load menu data based on source mode #}
{% if megaSource == 'snippet' %}
    {# Sulu 3 resolves a link field in two halves: the URL in `content`, the
       target, rel and title in `view` at the same path. Both are walked side
       by side below, with the same indexes. #}
    {% set megaSnippet = sulu_snippet_load_by_area('iw_theme_mega_menu') %}
    {% set megaContent = megaSnippet is not null and megaSnippet.content is defined ? megaSnippet.content : {} %}
    {% set megaView = megaSnippet is not null and megaSnippet.view is defined ? megaSnippet.view : {} %}
    {% set menuItems = megaContent.menu_items|default([]) %}
    {% set menuItemsView = megaView.menu_items|default([]) %}
    {% set ctaLink = iw_sulu_tailwind_theme_button(megaContent.cta ?? null, megaView.cta ?? null) %}
{% else %}
    {% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(3), {title: 'title', url: 'url'}) %}
    {# The parent of a dropdown is a button, so its own page is reached through
       a link at the top of its panel. Shares the navbar setting. #}
    {% set parentLinkable = config.clickParentPageNavbar|default(false) %}
{% endif %}

{# A mega panel sits right after its button in the markup, so the keyboard
   reaches it in reading order. It is positioned against the full-width frame. #}
{% macro snippet_panel(item, itemView, panelId) %}
    {% import '@ItechWorldSuluTailwindTheme/components/_link_macros.html.twig' as links %}
    {% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}
    {% set columnsView = itemView.columns|default([]) %}
    {% set parentLink = iw_sulu_tailwind_theme_link(item.link|default(null), itemView.link|default(null)) %}
    <div id="{{ panelId }}" class="iw-mega-menu__dropdown hidden absolute left-0 right-0 top-full z-40 shadow-lg">
        <div class="md:container md:mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {# The dropdown's own page, when the editor linked one #}
            {% if parentLink %}
                <a {{ links.attrs(parentLink) }}
                   class="iw-mega-menu__parent-link iw-menu__text--level-2 inline-flex items-center gap-2 mb-6 font-semibold no-underline hover:opacity-80 transition-opacity">
                    {{ item.title }}{{ links.new_tab_hint(parentLink) }}
                    <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5-5 5M6 12h12"/></svg>
                </a>
            {% endif %}
            <div class="iw-mega-menu__grid--cols-{{ min(item.columns|default([])|length|default(1), 5) }}">
                {% for column in item.columns|default([]) %}
                    {% set columnView = columnsView[loop.index0]|default({}) %}
                    {% if column.type == 'link_column' %}
                        {# Link column: title + list of links #}
                        {% set linksView = columnView.links|default([]) %}
                        <div>
                            {% if column.column_title|default(null) %}
                                <span class="iw-menu__text--level-2 font-semibold mb-3 block text-sm uppercase tracking-wider">
                                    {{ column.column_title }}
                                </span>
                            {% endif %}
                            <ul class="iw-menu__list space-y-2 mt-2">
                                {% for linkItem in column.links|default([]) %}
                                    {# An unresolved link - deleted or unpublished target - is left out #}
                                    {% set itemLink = iw_sulu_tailwind_theme_link(linkItem.link|default(null), linksView[loop.index0].link|default(null)) %}
                                    {% if itemLink %}
                                        {% set itemState = iw_sulu_tailwind_theme_nav_state(itemLink.url) %}
                                        <li>
                                            <a {{ links.attrs(itemLink) }}{{ nav.current(itemState) }}
                                               class="iw-menu__text--level-2{{ nav.state_class(itemState) }} block no-underline hover:opacity-80 transition-opacity">
                                                <span class="text-sm">{{ linkItem.title }}</span>{{ links.new_tab_hint(itemLink) }}
                                                {% if linkItem.description|default(null) %}
                                                    <span class="block text-xs opacity-60 mt-0.5">{{ linkItem.description }}</span>
                                                {% endif %}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% elseif column.type == 'image_column' %}
                        {# Image column: title + image cards (vertical or horizontal layout) #}
                        {% set cardLayout = column.layout|default('vertical') %}
                        {% set imgPos = column.image_position|default('left') %}
                        {% set cardsView = columnView.cards|default([]) %}
                        <div>
                            {% if column.column_title|default(null) %}
                                <span class="iw-menu__text--level-2 font-semibold mb-3 block text-sm uppercase tracking-wider">
                                    {{ column.column_title }}
                                </span>
                            {% endif %}
                            <ul class="iw-menu__list grid gap-3 mt-2">
                                {% set ratioClasses = {'1-1': 'aspect-square', '9-16': 'aspect-[9/16]', '16-9': 'aspect-video'} %}
                                {% for card in column.cards|default([]) %}
                                    {% set cardRatioClass = ratioClasses[card.image_ratio|default('auto')]|default('') %}
                                    {% set cardHasBg = card.show_background|default(false) %}
                                    {# The link is optional: a card without one, or whose
                                       target is gone, stays visible but is not clickable. #}
                                    {% set cardLink = iw_sulu_tailwind_theme_link(card.link|default(null), cardsView[loop.index0].link|default(null)) %}
                                    {% set cardTag = cardLink ? 'a' : 'div' %}
                                    <li>
                                        <{{ cardTag }} {% if cardLink %}{{ links.attrs(cardLink) }}{{ nav.current(iw_sulu_tailwind_theme_nav_state(cardLink.url)) }}{% endif %}
                                           class="iw-mega-menu__card block no-underline group {{ cardHasBg ? 'iw-mega-menu__card--bg' : '' }} {{ cardLayout == 'horizontal' ? 'iw-mega-menu__card--horizontal' : '' }} {{ cardLayout == 'horizontal' and imgPos == 'right' ? 'iw-mega-menu__card--img-right' : '' }}">
                                            {% if card.image is defined and card.image.id|default(null) is not null %}
                                                {% set cardMedia = sulu_resolve_media(card.image.id, app.request.locale) %}
                                                {% if cardMedia is not null %}
                                                    {# Decorative: the card title right beside it already
                                                       names the link, an alt would be read twice. #}
                                                    {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                                                        media: cardMedia,
                                                        format: 'iw_theme_mega_card',
                                                        alt: '',
                                                        raw: true,
                                                        loading: 'lazy',
                                                        classes: cardRatioClass,
                                                    }) }}
                                                {% endif %}
                                            {% endif %}
                                            <div class="{{ cardLayout == 'horizontal' ? 'iw-mega-menu__card-body' : '' }} p-2">
                                                <span class="{{ cardHasBg ? 'iw-menu__text--level-3' : 'iw-menu__text--level-2' }} text-sm font-medium">{{ card.title }}</span>{% if cardLink %}{{ links.new_tab_hint(cardLink) }}{% endif %}
                                                {% if card.description|default(null) %}
                                                    <span class="{{ cardHasBg ? 'iw-menu__text--level-3' : 'iw-menu__text--level-2' }} block text-xs opacity-60 mt-0.5">{{ card.description }}</span>
                                                {% endif %}
                                            </div>
                                        </{{ cardTag }}>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% elseif column.type == 'featured_column' %}
                        {# Featured column: highlight with image, description, CTA (vertical or horizontal layout) #}
                        {% set featLayout = column.layout|default('vertical') %}
                        {% set featImgPos = column.image_position|default('left') %}
                        {% set featRatioClasses = {'1-1': 'aspect-square', '9-16': 'aspect-[9/16]', '16-9': 'aspect-video'} %}
                        {% set featRatioClass = featRatioClasses[column.image_ratio|default('auto')]|default('') %}
                        {% set featLink = iw_sulu_tailwind_theme_button(column.cta ?? null, columnView.cta ?? null) %}
                        <div class="iw-mega-menu__featured {{ featLayout == 'horizontal' ? 'iw-mega-menu__featured--horizontal' : '' }} {{ featLayout == 'horizontal' and featImgPos == 'right' ? 'iw-mega-menu__featured--img-right' : '' }}">
                            {% if column.image is defined and column.image.id|default(null) is not null %}
                                {% set featMedia = sulu_resolve_media(column.image.id, app.request.locale) %}
                                {% if featMedia is not null %}
                                    {# Decorative: the column title follows it. #}
                                    {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                                        media: featMedia,
                                        format: 'iw_theme_mega_card',
                                        alt: '',
                                        raw: true,
                                        loading: 'lazy',
                                        classes: (featLayout == 'vertical' ? 'mb-4 ' : '') ~ featRatioClass,
                                    }) }}
                                {% endif %}
                            {% endif %}
                            <div class="{{ featLayout == 'horizontal' ? 'iw-mega-menu__featured-body' : '' }}">
                                <span class="iw-menu__text--level-3 font-semibold text-sm block mb-2">{{ column.title }}</span>
                                {% if column.description|default(null) %}
                                    <p class="iw-menu__text--level-3 text-xs opacity-70 mb-3">{{ column.description }}</p>
                                {% endif %}
                                {% include '@ItechWorldSuluTailwindTheme/components/_button.html.twig' with {
                                    button: featLink,
                                    class: 'iw-menu__button no-underline',
                                } only %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endmacro %}

{% macro native_panel(item, panelId, parentLinkable) %}
    {% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}
    <div id="{{ panelId }}" class="iw-mega-menu__dropdown hidden absolute left-0 right-0 top-full z-40 shadow-lg">
        <div class="md:container md:mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {% if parentLinkable %}
                {% set itemHref = sulu_content_path(item.url) %}
                {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
                <a href="{{ itemHref }}"{{ nav.current(itemState) }}
                   class="iw-mega-menu__parent-link iw-menu__text--level-2{{ nav.state_class(itemState) }} inline-flex items-center gap-2 mb-6 font-semibold no-underline hover:opacity-80 transition-opacity">
                    {{ item.title }}
                    <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5-5 5M6 12h12"/></svg>
                </a>
            {% endif %}
            <ul class="iw-menu__list iw-mega-menu__grid--cols-{{ min(item.children|length, 5) }}">
                {% for child in item.children %}
                    {% set childHref = sulu_content_path(child.url) %}
                    {% set childState = iw_sulu_tailwind_theme_nav_state(childHref) %}
                    <li>
                        <a href="{{ childHref }}"{{ nav.current(childState) }}
                           class="iw-menu__text--level-2{{ nav.state_class(childState) }} font-semibold mb-3 block text-sm no-underline hover:opacity-80 transition-opacity">
                            {{ child.title }}
                        </a>
                        {% if child.children is defined and child.children|length > 0 %}
                            <ul class="iw-menu__list space-y-2 mt-2">
                                {% for grandchild in child.children %}
                                    {% set grandchildHref = sulu_content_path(grandchild.url) %}
                                    {% set grandchildState = iw_sulu_tailwind_theme_nav_state(grandchildHref) %}
                                    <li>
                                        <a href="{{ grandchildHref }}"{{ nav.current(grandchildState) }}
                                           class="iw-menu__text--level-2{{ nav.state_class(grandchildState) }} text-sm no-underline hover:opacity-80 transition-opacity">
                                            {{ grandchild.title }}
                                        </a>
                                        {# Fourth level: always open under its entry, indented
                                           with a rule. A fold inside a column would read badly.
                                           It sits on the panel, so it takes the level 2 text. #}
                                        {% if grandchild.children is defined and grandchild.children|length > 0 %}
                                            <ul class="iw-menu__list iw-mega-menu__sublist mt-1.5 space-y-1 pl-3">
                                                {% for leaf in grandchild.children %}
                                                    {% set leafHref = sulu_content_path(leaf.url) %}
                                                    {% set leafState = iw_sulu_tailwind_theme_nav_state(leafHref) %}
                                                    <li>
                                                        <a href="{{ leafHref }}"{{ nav.current(leafState) }}
                                                           class="iw-menu__text--level-2{{ nav.state_class(leafState) }} text-sm no-underline hover:opacity-80 transition-opacity">
                                                            {{ leaf.title }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endmacro %}

{# Width under which the links give way to the burger (see ThemeCompiler). #}
{% set collapseAt = config.collapseAt|default('auto') in ['md', 'lg', 'xl', 'auto'] ? config.collapseAt|default('auto') : 'auto' %}

{% set panelId = iw_sulu_tailwind_theme_unique_id('menu-panel') %}

<header
    data-controller="menu"
    data-menu-open-label-value="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
    data-menu-close-label-value="{{ 'iw_sulu_tailwind_theme.menu_close'|trans({}, 'messages') }}"
    data-menu-scroll-bg-value="{{ (config.scrollBg ?? true) ? 'true' : 'false' }}"
    data-menu-scroll-hide-value="{{ (config.scrollHide ?? false) ? 'true' : 'false' }}"
    class="iw-menu iw-menu--collapse-{{ collapseAt }} {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }} sticky top-0 z-40 w-full"
>
    {# ─── Desktop navbar ───
       Full width and positioned: the mega panels inside it span the whole
       viewport, while the bar content keeps the container width. #}
    <div class="iw-menu__frame relative z-50">
        <div class="md:container md:mx-auto px-4 sm:px-6 lg:px-8">
        <div class="iw-menu__bar flex items-center justify-between">

            {# LEFT — Logo + Site Name #}
            <div class="flex-shrink-0 flex items-center {{ navPosition == 'left' ? 'mr-0' : '' }}">
                {% include '@ItechWorldSuluTailwindTheme/menu/_logo_link.html.twig'
                    with {config: config, nameClass: 'text-xl font-bold'} only %}
            </div>

            {# CENTER — Desktop L1 navigation items #}
            {% set navPositionClass = {
                'left': 'md:ml-6 md:mr-auto',
                'center': 'md:mx-auto',
                'right': 'md:ml-auto md:mr-6'
            } %}
            <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="iw-menu__desktop-nav iw-menu__desktop-only {{ navPositionClass[navPosition]|default('md:mx-auto') }}">
                <ul class="iw-menu__list flex items-center gap-1">
                {% if megaSource == 'snippet' %}
                    {# ─── Snippet mode: render from snippet data ─── #}
                    {% for item in menuItems %}
                        {% if item.type == 'simple_link' %}
                            {% set itemLink = iw_sulu_tailwind_theme_link(item.link|default(null), menuItemsView[loop.index0].link|default(null), item.open_in_new_tab|default(false)) %}
                            {% if itemLink %}
                                {% set itemState = iw_sulu_tailwind_theme_nav_state(itemLink.url) %}
                                <li>
                                    <a
                                        {{ links.attrs(itemLink) }}{{ nav.current(itemState) }}
                                        class="iw-menu__text{{ nav.state_class(itemState) }} block px-4 py-2 text-sm font-medium rounded-md transition-opacity no-underline hover:opacity-80"
                                    >
                                        {{ item.title }}{{ links.new_tab_hint(itemLink) }}
                                    </a>
                                </li>
                            {% endif %}
                        {% elseif item.type == 'mega_dropdown' %}
                            {# Static wrapper: the hover and focus zone of the button and
                               its panel, which positions itself against the frame. #}
                            {% set megaId = iw_sulu_tailwind_theme_unique_id('menu-mega') %}
                            <li class="iw-mega-menu__item">
                                <button
                                    type="button"
                                    data-action="menu#toggleDisclosure"
                                    data-menu-target="popupTrigger"
                                    aria-expanded="false"
                                    aria-controls="{{ megaId }}"
                                    class="iw-menu__text flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-md transition-opacity cursor-pointer"
                                >
                                    {{ item.title }}
                                    {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                                </button>
                                {{ _self.snippet_panel(item, menuItemsView[loop.index0]|default({}), megaId) }}
                            </li>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    {# ─── Native mode: render from page tree ─── #}
                    {% for item in navItems %}
                        {% set itemHref = sulu_content_path(item.url) %}
                        {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
                        {% if item.children is defined and item.children|length > 0 %}
                            {% set megaId = iw_sulu_tailwind_theme_unique_id('menu-mega') %}
                            <li class="iw-mega-menu__item">
                                <button
                                    type="button"
                                    data-action="menu#toggleDisclosure"
                                    data-menu-target="popupTrigger"
                                    aria-expanded="false"
                                    aria-controls="{{ megaId }}"
                                    class="iw-menu__text{{ nav.branch_class(itemState) }} flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-md transition-opacity cursor-pointer"
                                >
                                    {{ item.title }}
                                    {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                                </button>
                                {{ _self.native_panel(item, megaId, parentLinkable) }}
                            </li>
                        {% else %}
                            <li>
                                <a
                                    href="{{ itemHref }}"{{ nav.current(itemState) }}
                                    class="iw-menu__text{{ nav.state_class(itemState) }} block px-4 py-2 text-sm font-medium rounded-md transition-opacity no-underline hover:opacity-80"
                                >
                                    {{ item.title }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                {% endif %}
                </ul>
            </nav>

            {# RIGHT — Language switcher + Social media + CTA (snippet) + Burger (mobile) #}
            <div class="flex items-center gap-3">
                {# Bar actions — in the bar with the links, in the panel with them
                   once the menu collapses. #}
                {% include '@ItechWorldSuluTailwindTheme/menu/_bar_actions.html.twig'
                    with {config: config, slot: 'bar', wideClass: 'iw-menu__desktop-only', narrowClass: 'iw-menu__mobile-only'} only %}

                {# Language switcher — desktop, anchored right (end of the bar) #}
                <div class="iw-menu__desktop-only">
                    {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                        with {config: config, align: 'right'} %}
                </div>

                {# Social media icons — desktop #}
                {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                    links: socialLinks,
                    class: 'flex items-center gap-2 iw-menu__desktop-only',
                    textClass: 'text-sm',
                } only %}

                {# CTA button — snippet mode only, desktop #}
                {% if megaSource == 'snippet' and ctaLink %}
                    {# Hidden through a wrapper: a button style sets its own
                       `display`, which would win over `hidden` on the anchor.
                       Sized by `iw-menu__button`, see the menu CSS variables. #}
                    <div class="iw-menu__desktop-only">
                        {% include '@ItechWorldSuluTailwindTheme/components/_button.html.twig' with {
                            button: ctaLink,
                            class: 'iw-menu__button no-underline',
                        } only %}
                    </div>
                {% endif %}

                {# Animated burger button — mobile only (3 lines → X) #}
                <button
                    type="button"
                    data-action="menu#toggle"
                    data-menu-target="burger"
                    aria-expanded="false"
                    aria-controls="{{ panelId }}"
                    aria-label="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
                    class="iw-menu__burger iw-menu__mobile-only w-10 h-10 flex flex-col items-center justify-center gap-1.5"
                >
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                </button>
            </div>
        </div>
        </div>
    </div>

    {# ─── Mobile overlay panel ─── #}
    <div
        id="{{ panelId }}"
        data-menu-target="panel"
        role="dialog"
        aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
        class="iw-menu__overlay iw-menu__dialog iw-menu__dialog--none iw-menu__below-bar fixed left-0 right-0 bottom-0 z-30 iw-menu__mobile-only"
    >
        <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="iw-menu__overlay-nav overflow-y-auto h-full">
            {% if megaSource == 'snippet' %}
                {# ─── Snippet mode: mobile accordion ─── #}
                <ul class="iw-menu__list">
                {% for item in menuItems %}
                    {% set itemView = menuItemsView[loop.index0]|default({}) %}
                    {% if item.type == 'simple_link' %}
                        {% set itemLink = iw_sulu_tailwind_theme_link(item.link|default(null), itemView.link|default(null), item.open_in_new_tab|default(false)) %}
                        {% if itemLink %}
                            {% set itemState = iw_sulu_tailwind_theme_nav_state(itemLink.url) %}
                            <li class="iw-menu__divider border-b">
                                <a
                                    {{ links.attrs(itemLink) }}{{ nav.current(itemState) }}
                                    class="iw-menu__text{{ nav.state_class(itemState) }} block py-4 text-lg font-medium no-underline"
                                >
                                    {{ item.title }}{{ links.new_tab_hint(itemLink) }}
                                </a>
                            </li>
                        {% endif %}
                    {% elseif item.type == 'mega_dropdown' %}
                        {% set columnsView = itemView.columns|default([]) %}
                        {% set parentLink = iw_sulu_tailwind_theme_link(item.link|default(null), itemView.link|default(null)) %}
                        {% set submenuId = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
                        <li class="iw-menu__divider border-b">
                            <button
                                type="button"
                                data-action="menu#toggleDisclosure"
                                aria-expanded="false"
                                aria-controls="{{ submenuId }}"
                                class="iw-menu__text flex items-center justify-between w-full py-4 text-left cursor-pointer"
                            >
                                <span class="text-lg font-medium">{{ item.title }}</span>
                                {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-5 h-5 flex-shrink-0'} only %}
                            </button>
                            <div id="{{ submenuId }}" class="iw-menu__dropdown--level-2 hidden pb-3 mt-1 px-4">
                                {# The dropdown's own page, when the editor linked one #}
                                {% if parentLink %}
                                    <a
                                        {{ links.attrs(parentLink) }}{{ nav.current(iw_sulu_tailwind_theme_nav_state(parentLink.url)) }}
                                        class="iw-menu__text--level-2 block py-2.5 opacity-80 hover:opacity-100 no-underline italic"
                                    >
                                        {{ item.title }}{{ links.new_tab_hint(parentLink) }}
                                    </a>
                                {% endif %}
                                {# Columns stacked vertically on mobile #}
                                {% for column in item.columns|default([]) %}
                                    {% set columnView = columnsView[loop.index0]|default({}) %}
                                    {% if column.type == 'link_column' %}
                                        {% if column.column_title|default(null) %}
                                            <span class="iw-menu__text--level-2 block py-2 font-semibold text-sm">{{ column.column_title }}</span>
                                        {% endif %}
                                        {% set linksView = columnView.links|default([]) %}
                                        <ul class="iw-menu__list">
                                            {% for linkItem in column.links|default([]) %}
                                                {% set itemLink = iw_sulu_tailwind_theme_link(linkItem.link|default(null), linksView[loop.index0].link|default(null)) %}
                                                {% if itemLink %}
                                                    {% set itemState = iw_sulu_tailwind_theme_nav_state(itemLink.url) %}
                                                    <li>
                                                        <a {{ links.attrs(itemLink) }}{{ nav.current(itemState) }}
                                                           class="iw-menu__text--level-2{{ nav.state_class(itemState) }} block py-1.5 text-sm opacity-70 hover:opacity-100 no-underline">
                                                            {{ linkItem.title }}{{ links.new_tab_hint(itemLink) }}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    {% elseif column.type == 'image_column' %}
                                        {% if column.column_title|default(null) %}
                                            <span class="iw-menu__text--level-2 block py-2 font-semibold text-sm">{{ column.column_title }}</span>
                                        {% endif %}
                                        {# Only the cards that lead somewhere: the images stay on desktop #}
                                        {% set cardsView = columnView.cards|default([]) %}
                                        <ul class="iw-menu__list">
                                            {% for card in column.cards|default([]) %}
                                                {% set cardLink = iw_sulu_tailwind_theme_link(card.link|default(null), cardsView[loop.index0].link|default(null)) %}
                                                {% if cardLink %}
                                                    {% set cardState = iw_sulu_tailwind_theme_nav_state(cardLink.url) %}
                                                    <li>
                                                        <a {{ links.attrs(cardLink) }}{{ nav.current(cardState) }}
                                                           class="iw-menu__text--level-2{{ nav.state_class(cardState) }} block py-1.5 text-sm opacity-70 hover:opacity-100 no-underline">
                                                            {{ card.title }}{{ links.new_tab_hint(cardLink) }}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    {% elseif column.type == 'featured_column' %}
                                        <span class="iw-menu__text--level-2 block py-2 font-semibold text-sm">{{ column.title }}</span>
                                        {% set featLink = iw_sulu_tailwind_theme_button(column.cta ?? null, columnView.cta ?? null) %}
                                        {% if featLink %}
                                            {#- A plain link on mobile: the column shrinks to a line of the accordion. -#}
                                            <a {{ links.attrs(featLink) }}
                                               class="iw-menu__text--level-2 block py-1.5 text-sm opacity-70 hover:opacity-100 no-underline">
                                                {{ featLink.label }}{{ links.new_tab_hint(featLink) }}
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </li>
                    {% endif %}
                {% endfor %}
                </ul>

                {# CTA button — mobile #}
                {% if ctaLink %}
                    <div class="pt-4 pb-2">
                        {% include '@ItechWorldSuluTailwindTheme/components/_button.html.twig' with {
                            button: ctaLink,
                            class: 'iw-menu__button iw-menu__button--block no-underline',
                        } only %}
                    </div>
                {% endif %}
            {% else %}
                {# ─── Native mode: mobile accordion from page tree ─── #}
                {% include '@ItechWorldSuluTailwindTheme/menu/_nav_accordion.html.twig'
                    with {navItems: navItems, clickMode: parentLinkable ? 'selflink' : 'none'} only %}
            {% endif %}

            {# Bar actions left out of the bar, under the links #}
            {% include '@ItechWorldSuluTailwindTheme/menu/_bar_actions.html.twig'
                with {config: config, slot: 'panel', narrowClass: ''} only %}

            {# Language switcher — mobile overlay, inline #}
            {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                with {config: config, display: 'inline'} %}

            {# Social media icons in mobile overlay #}
            {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                links: socialLinks,
                class: 'flex items-center gap-3 pt-6 pb-4',
                size: 'md',
                textClass: '',
            } only %}
        </nav>
    </div>
</header>
