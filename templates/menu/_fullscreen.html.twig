{# Menu — fullscreen overlay menu #}

{# Background image of the curtain split, resolved once. #}
{% set fullscreenMedia = config.fullscreenImage.id|default(null)
    ? sulu_resolve_media(config.fullscreenImage.id, app.request.locale)
    : null %}
{% set twoColumns = config.twoColumns|default(false) %}

{# Parent page click mode: none, split, or selflink (backward compat: boolean → string) #}
{% set clickMode = config.clickParentPage|default('none') %}
{% if clickMode is same as(true) %}{% set clickMode = 'selflink' %}{% endif %}
{% if clickMode is same as(false) %}{% set clickMode = 'none' %}{% endif %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% set panelId = iw_sulu_tailwind_theme_unique_id('menu-panel') %}

<header
    data-controller="menu"
    data-menu-open-label-value="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
    data-menu-close-label-value="{{ 'iw_sulu_tailwind_theme.menu_close'|trans({}, 'messages') }}"
    data-menu-scroll-bg-value="{{ (config.scrollBg ?? true) ? 'true' : 'false' }}"
    data-menu-scroll-hide-value="{{ (config.scrollHide ?? false) ? 'true' : 'false' }}"
    class="iw-menu {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }} sticky top-0 z-40 w-full"
>
    {# Navbar — z-50 so it stays ABOVE the fullscreen panel (z-30): the single
       burger button stays visible and animates into the X (like the burger menu),
       instead of being covered by the panel and needing a separate close button. #}
    <div class="iw-menu__frame relative z-50 container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="iw-menu__bar flex items-center justify-between">

            {# LEFT — Logo + Site Name #}
            <div class="flex-shrink-0 flex items-center">
                {% include '@ItechWorldSuluTailwindTheme/menu/_logo_link.html.twig'
                    with {config: config, nameClass: 'text-xl font-bold'} only %}
            </div>

            {# RIGHT — Language switcher + Social media + Burger #}
            <div class="flex items-center gap-3">
                {# Language switcher — in the bar, reachable without opening the
                   overlay. Hidden when the theme places it in the panel only. #}
                {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                    with {config: config, align: 'right', slot: 'bar'} %}

                {# Social media icons #}
                {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                    links: socialLinks,
                    class: 'hidden md:flex items-center gap-2',
                    textClass: 'text-sm',
                } only %}

                {# Animated burger button — always visible #}
                <button
                    type="button"
                    data-action="menu#toggle"
                    data-menu-target="burger"
                    aria-expanded="false"
                    aria-controls="{{ panelId }}"
                    aria-label="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
                    class="iw-menu__burger w-10 h-10 flex flex-col items-center justify-center gap-1.5"
                >
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                </button>
            </div>
        </div>
    </div>

    {# Fullscreen overlay — sits BELOW the navbar (z-30 < z-50) so the navbar's
       burger stays visible and animates into the X (single button, no separate
       close). #}
    {% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(2), {title: 'title', url: 'url'}) %}

    {# Macro: navigation items (L1 / L2 / L3).
       collapse: which sub-levels fold behind a chevron. 'level3' (default):
       the third level only, 'levels23': the second as well, 'none': every
       level stays open. #}
    {% macro render_nav_items(navItems, columns, clickMode, align, collapse) %}
        {% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}
        {# Rows holding a link and its chevron follow the text alignment. #}
        {% set justifyClass = {'left': 'justify-start', 'center': 'justify-center', 'right': 'justify-end'}[align]|default('justify-center') %}
        {% set l2Folds = collapse == 'levels23' %}
        {% set l3Folds = collapse != 'none' %}
        <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}">
            <ul class="iw-menu__list iw-menu__fullscreen-list{{ columns ? ' iw-menu__fullscreen-list--' ~ columns : '' }}">
                {% for item in navItems %}
                    {% set itemHref = sulu_content_path(item.url) %}
                    {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
                    {% set hasChildren = item.children is defined and item.children|length > 0 %}
                    {% set level2Id = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
                    <li class="iw-menu__parent-item">
                        {% if hasChildren and l2Folds and clickMode != 'split' %}
                            {# L1 folding its children: the whole row is the toggle #}
                            <button
                                type="button"
                                data-action="menu#toggleDisclosure"
                                aria-expanded="false"
                                aria-controls="{{ level2Id }}"
                                class="iw-menu__text{{ nav.branch_class(itemState) }} iw-menu__fullscreen-l1 font-bold inline-flex items-center gap-3 hover:opacity-80 transition-opacity cursor-pointer"
                            >
                                <span>{{ item.title }}</span>
                                {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-6 h-6 flex-shrink-0'} only %}
                            </button>
                        {% elseif hasChildren and l2Folds %}
                            {# Split: the title is a link, a separate chevron folds #}
                            <div class="flex items-center gap-3 w-full {{ justifyClass }}">
                                <a
                                    href="{{ itemHref }}"{{ nav.current(itemState) }}
                                    class="iw-menu__text{{ nav.state_class(itemState) }} iw-menu__fullscreen-l1 font-bold hover:opacity-80 transition-opacity no-underline"
                                >
                                    {{ item.title }}
                                </a>
                                <button
                                    type="button"
                                    data-action="menu#toggleDisclosure"
                                    aria-expanded="false"
                                    aria-controls="{{ level2Id }}"
                                    aria-label="{{ 'iw_sulu_tailwind_theme.menu_submenu_toggle'|trans({'%title%': item.title}, 'messages') }}"
                                    class="iw-menu__text hover:opacity-80 cursor-pointer"
                                >
                                    {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-6 h-6 flex-shrink-0'} only %}
                                </button>
                            </div>
                        {% else %}
                            {# L1 link, its children listed open below #}
                            <a
                                href="{{ itemHref }}"{{ nav.current(itemState) }}
                                class="iw-menu__text{{ nav.state_class(itemState) }} iw-menu__fullscreen-l1 font-bold hover:opacity-80 transition-opacity no-underline"
                            >
                                {{ item.title }}
                            </a>
                        {% endif %}

                        {# L2 children #}
                        {% if hasChildren %}
                            <ul id="{{ level2Id }}" class="iw-menu__list iw-menu__fullscreen-sublist mt-2 space-y-1{{ l2Folds ? ' hidden' : '' }}">
                                {% if l2Folds and clickMode == 'selflink' %}
                                    {# The folded L1 page itself, first of its list #}
                                    <li>
                                        <a
                                            href="{{ itemHref }}"{{ nav.current(itemState) }}
                                            class="iw-menu__text{{ nav.state_class(itemState) }} block text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity no-underline italic"
                                        >
                                            {{ item.title }}
                                        </a>
                                    </li>
                                {% endif %}
                                {% for child in item.children %}
                                    {% set childHref = sulu_content_path(child.url) %}
                                    {% set childState = iw_sulu_tailwind_theme_nav_state(childHref) %}
                                    {% if child.children is defined and child.children|length > 0 %}
                                        {# L2 with L3 children #}
                                        {% set submenuId = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
                                        <li class="iw-menu__parent-item">
                                            {% if l3Folds and clickMode == 'split' %}
                                                {# Split button: L2 is a link + separate chevron #}
                                                <div class="flex items-center gap-2 w-full {{ justifyClass }}">
                                                    <a
                                                        href="{{ childHref }}"{{ nav.current(childState) }}
                                                        class="iw-menu__text{{ nav.state_class(childState) }} text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity no-underline"
                                                    >
                                                        {{ child.title }}
                                                    </a>
                                                    <button
                                                        type="button"
                                                        data-action="menu#toggleDisclosure"
                                                        aria-expanded="false"
                                                        aria-controls="{{ submenuId }}"
                                                        aria-label="{{ 'iw_sulu_tailwind_theme.menu_submenu_toggle'|trans({'%title%': child.title}, 'messages') }}"
                                                        class="iw-menu__text opacity-60 hover:opacity-100 cursor-pointer"
                                                    >
                                                        {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                                                    </button>
                                                </div>
                                            {% elseif l3Folds %}
                                                {# Default button (none + selflink) #}
                                                <button
                                                    type="button"
                                                    data-action="menu#toggleDisclosure"
                                                    aria-expanded="false"
                                                    aria-controls="{{ submenuId }}"
                                                    class="iw-menu__text{{ nav.branch_class(childState) }} inline-flex items-center gap-2 text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity cursor-pointer"
                                                >
                                                    <span>{{ child.title }}</span>
                                                    {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'menu', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                                                </button>
                                            {% else %}
                                                {# Nothing folds: L2 is a link, its children listed open #}
                                                <a
                                                    href="{{ childHref }}"{{ nav.current(childState) }}
                                                    class="iw-menu__text{{ nav.state_class(childState) }} block text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity no-underline"
                                                >
                                                    {{ child.title }}
                                                </a>
                                            {% endif %}
                                            <ul id="{{ submenuId }}" class="iw-menu__list iw-menu__fullscreen-sublist mt-1 space-y-1{{ l3Folds ? ' hidden' : '' }}">
                                                {% if l3Folds and clickMode == 'selflink' %}
                                                    {# Self-link to the L2 page itself #}
                                                    <li>
                                                        <a
                                                            href="{{ childHref }}"{{ nav.current(childState) }}
                                                            class="iw-menu__text{{ nav.state_class(childState) }} block text-sm opacity-50 hover:opacity-100 transition-opacity no-underline italic"
                                                        >
                                                            {{ child.title }}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                                {# L3 grandchildren #}
                                                {% for grandchild in child.children %}
                                                    {% set grandchildHref = sulu_content_path(grandchild.url) %}
                                                    {% set grandchildState = iw_sulu_tailwind_theme_nav_state(grandchildHref) %}
                                                    <li>
                                                        <a
                                                            href="{{ grandchildHref }}"{{ nav.current(grandchildState) }}
                                                            class="iw-menu__text{{ nav.state_class(grandchildState) }} block text-sm opacity-60 hover:opacity-100 transition-opacity no-underline"
                                                        >
                                                            {{ grandchild.title }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                                    {% else %}
                                        {# L2 without children - simple link #}
                                        <li>
                                            <a
                                                href="{{ childHref }}"{{ nav.current(childState) }}
                                                class="iw-menu__text{{ nav.state_class(childState) }} block text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity no-underline"
                                            >
                                                {{ child.title }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endmacro %}

    {# Macro: foot of the panel. The logo stays in the bar, never repeated
       here. The social icons are shown here on mobile only, where the bar
       hides them. #}
    {% macro render_panel_footer(config, socialLinks, localizations) %}
        {% set languageMarkup %}
            {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                with {config: config, localizations: localizations, display: 'inline', slot: 'panel'} only %}
        {% endset %}
        {% set socialMarkup %}
            {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                links: socialLinks,
                class: 'flex md:hidden items-center gap-3',
                size: 'md',
                textClass: '',
            } only %}
        {% endset %}
        {% if languageMarkup|trim is not empty or socialMarkup|trim is not empty %}
            <div class="iw-menu__fullscreen-footer">
                {{ languageMarkup }}
                {{ socialMarkup }}
            </div>
        {% endif %}
    {% endmacro %}

    {# Which sub-levels fold behind a chevron: the third (default), the second
       as well, or none. #}
    {% set collapse = config.fullscreenCollapse|default('level3') in ['level3', 'levels23', 'none'] ? config.fullscreenCollapse|default('level3') : 'level3' %}

    {# Text alignment of a single column, the columns always start on the left. #}
    {% set align = twoColumns ? 'left' : (config.fullscreenAlign|default('center') in ['left', 'center', 'right'] ? config.fullscreenAlign|default('center') : 'center') %}

    {% if fullscreenMedia %}
        {# ═══ WITH IMAGE - curtain split: image left, nav + background right ═══ #}
        {# The panel is transparent, each curtain carries its own content. #}
        <div
            id="{{ panelId }}"
            data-menu-target="panel"
            role="dialog"
            aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
            class="iw-menu__dialog iw-menu__dialog--curtain fixed inset-0 z-30"
        >
            <div class="flex h-full">
                {# Left curtain, image only, from md up. The picture waits in a
                   <template> the controller unpacks when the panel opens and
                   this curtain is shown: no request before, none on mobile. #}
                <div class="iw-menu__curtain iw-menu__curtain--left w-1/2 h-full overflow-hidden hidden md:block">
                    <template data-menu-deferred>
                        {{ include('@ItechWorldSuluTailwindTheme/blocks/common/_image.html.twig', {
                            media: fullscreenMedia,
                            format: 'iw_theme_menu_curtain',
                            alt: '',
                            raw: true,
                            loading: 'eager',
                            classes: 'w-full h-full object-cover',
                        }) }}
                    </template>
                </div>
                {# Right curtain: nav + background, one scroll box under the bar. #}
                <div class="iw-menu__curtain iw-menu__curtain--right iw-menu__fullscreen-nav relative w-full md:w-1/2 h-full">
                    <div class="iw-menu__fullscreen-scroll">
                        <div class="iw-menu__fullscreen-body iw-menu__fullscreen-body--{{ align }} px-6 sm:px-8 lg:px-12">
                            {% if navItems is not empty %}
                                {{ _self.render_nav_items(navItems, twoColumns ? 'split' : null, clickMode, align, collapse) }}
                            {% endif %}
                            {{ _self.render_panel_footer(config, socialLinks, localizations|default([])) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        {# ═══ WITHOUT IMAGE - full panel slides from the right ═══ #}
        <div
            id="{{ panelId }}"
            data-menu-target="panel"
            role="dialog"
            aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
            class="iw-menu__overlay iw-menu__dialog iw-menu__dialog--slide iw-menu__dialog--from-right fixed inset-0 z-30"
        >
            <div class="iw-menu__fullscreen-scroll">
                {# Same container as the bar, so the columns line up with the logo. #}
                <div class="iw-menu__fullscreen-body iw-menu__fullscreen-body--{{ align }} container mx-auto px-4 sm:px-6 lg:px-8">
                    {% if navItems is not empty %}
                        {{ _self.render_nav_items(navItems, twoColumns ? 'two' : null, clickMode, align, collapse) }}
                    {% endif %}
                    {{ _self.render_panel_footer(config, socialLinks, localizations|default([])) }}
                </div>
            </div>
        </div>
    {% endif %}
</header>
