{# Menu — fullscreen overlay menu #}

{# Resolve fullscreen image media URL #}
{% set fullscreenImageUrl = null %}
{% if config.fullscreenImage is defined and config.fullscreenImage.id|default(null) is not null %}
    {% set fsMedia = sulu_resolve_media(config.fullscreenImage.id, app.request.locale) %}
    {% if fsMedia is not null %}
        {% set fullscreenImageUrl = fsMedia.url|default(null) %}
    {% endif %}
{% endif %}
{% set twoColumns = config.twoColumns|default(false) %}

{# Parent page click mode: none, split, or selflink (backward compat: boolean → string) #}
{% set clickMode = config.clickParentPage|default('none') %}
{% if clickMode is same as(true) %}{% set clickMode = 'selflink' %}{% endif %}
{% if clickMode is same as(false) %}{% set clickMode = 'none' %}{% endif %}

{# Load social media links from snippet area #}
{% set socialLinks = [] %}
{% if config.displaySocialMedia|default(false) %}
    {% set socialSnippet = sulu_snippet_load_by_area('iw_theme_menu_social_media_links') %}
    {% if socialSnippet is not null and socialSnippet.content is defined and socialSnippet.content.blocks_social_medias is defined %}
        {% set socialLinks = socialSnippet.content.blocks_social_medias %}
    {% endif %}
{% endif %}

{% set panelId = iw_sulu_tailwind_theme_unique_id('menu-panel') %}

<header
    data-controller="menu"
    data-menu-open-label-value="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
    data-menu-close-label-value="{{ 'iw_sulu_tailwind_theme.menu_close'|trans({}, 'messages') }}"
    data-menu-scroll-bg-value="{{ (config.scrollBg ?? false) ? 'true' : 'false' }}"
    data-menu-scroll-hide-value="{{ (config.scrollHide ?? false) ? 'true' : 'false' }}"
    class="iw-menu {{ config.transparentNavbar|default(false) ? 'iw-menu--transparent' : '' }} sticky top-0 z-40 w-full"
>
    {# Navbar — z-50 so it stays ABOVE the fullscreen panel (z-30): the single
       burger button stays visible and animates into the X (like the burger menu),
       instead of being covered by the panel and needing a separate close button. #}
    <div class="iw-menu__frame relative z-50 container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="iw-menu__bar flex items-center justify-between">

            {# LEFT — Logo + Site Name #}
            <div class="flex-shrink-0 flex items-center">
                {% include '@ItechWorldSuluTailwindTheme/menu/_logo_link.html.twig'
                    with {config: config, nameClass: 'text-xl font-bold'} only %}
            </div>

            {# RIGHT — Language switcher + Social media + Burger #}
            <div class="flex items-center gap-3">
                {# Language switcher — in the bar, reachable without opening the
                   overlay. Hidden when the theme places it in the panel only. #}
                {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                    with {config: config, align: 'right', slot: 'bar'} %}

                {# Social media icons #}
                {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
                    links: socialLinks,
                    class: 'hidden md:flex items-center gap-2',
                    iconClass: 'w-5 h-5',
                    textClass: 'text-sm',
                } only %}

                {# Animated burger button — always visible #}
                <button
                    type="button"
                    data-action="menu#toggle"
                    data-menu-target="burger"
                    aria-expanded="false"
                    aria-controls="{{ panelId }}"
                    aria-label="{{ 'iw_sulu_tailwind_theme.menu_open'|trans({}, 'messages') }}"
                    class="iw-menu__burger w-10 h-10 flex flex-col items-center justify-center gap-1.5"
                >
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                    <span class="iw-menu__burger-line"></span>
                </button>
            </div>
        </div>
    </div>

    {# Fullscreen overlay — sits BELOW the navbar (z-30 < z-50) so the navbar's
       burger stays visible and animates into the X (single button, no separate
       close). #}
    {% set navItems = sulu_page_navigation_root_tree('main', config.childLevels|default(2), {title: 'title', url: 'url'}) %}

    {# Macro: navigation items (L1 / L2 / L3) #}
    {% macro render_nav_items(navItems, twoColumns, clickMode) %}
        {% import '@ItechWorldSuluTailwindTheme/menu/_nav_macros.html.twig' as nav %}
        {% set navClasses = twoColumns
            ? 'grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-2 text-left'
            : 'space-y-4 md:space-y-6 text-center'
        %}
        <nav aria-label="{{ 'iw_sulu_tailwind_theme.menu_main'|trans({}, 'messages') }}" class="overflow-y-auto max-h-full px-6 sm:px-8 py-8">
            <ul class="iw-menu__list {{ navClasses }}">
                {% for item in navItems %}
                    {% set itemHref = sulu_content_path(item.url) %}
                    {% set itemState = iw_sulu_tailwind_theme_nav_state(itemHref) %}
                    <li>
                        {# L1 link - always a direct link in fullscreen #}
                        <a
                            href="{{ itemHref }}"{{ nav.current(itemState) }}
                            class="iw-menu__text{{ nav.state_class(itemState) }} text-2xl md:text-4xl lg:text-5xl font-bold hover:opacity-80 transition-opacity no-underline"
                        >
                            {{ item.title }}
                        </a>

                        {# L2 children #}
                        {% if item.children is defined and item.children|length > 0 %}
                            <ul class="iw-menu__list mt-2 space-y-1">
                                {% for child in item.children %}
                                    {% set childHref = sulu_content_path(child.url) %}
                                    {% set childState = iw_sulu_tailwind_theme_nav_state(childHref) %}
                                    {% if child.children is defined and child.children|length > 0 %}
                                        {# L2 with L3 children #}
                                        {% set submenuId = iw_sulu_tailwind_theme_unique_id('menu-submenu') %}
                                        <li class="iw-menu__parent-item">
                                            {% if clickMode == 'split' %}
                                                {# Split button: L2 is a link + separate chevron #}
                                                <div class="flex items-center gap-2 w-full {{ twoColumns ? 'justify-start' : 'justify-center' }}">
                                                    <a
                                                        href="{{ childHref }}"{{ nav.current(childState) }}
                                                        class="iw-menu__text--level-2{{ nav.state_class(childState) }} text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity no-underline"
                                                    >
                                                        {{ child.title }}
                                                    </a>
                                                    <button
                                                        type="button"
                                                        data-action="menu#toggleDisclosure"
                                                        aria-expanded="false"
                                                        aria-controls="{{ submenuId }}"
                                                        aria-label="{{ 'iw_sulu_tailwind_theme.menu_submenu_toggle'|trans({'%title%': child.title}, 'messages') }}"
                                                        class="iw-menu__text--level-2 opacity-60 hover:opacity-100 cursor-pointer"
                                                    >
                                                        {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'chevron', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                                                    </button>
                                                </div>
                                            {% else %}
                                                {# Default button (none + selflink) #}
                                                <button
                                                    type="button"
                                                    data-action="menu#toggleDisclosure"
                                                    aria-expanded="false"
                                                    aria-controls="{{ submenuId }}"
                                                    class="iw-menu__text--level-2{{ nav.branch_class(childState) }} flex items-center gap-2 text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity w-full cursor-pointer {{ twoColumns ? 'justify-start' : 'justify-center' }}"
                                                >
                                                    <span>{{ child.title }}</span>
                                                    {% include '@ItechWorldSuluTailwindTheme/components/_nav_arrow.html.twig' with {'role': 'chevron', 'direction': 'down', 'class': 'w-4 h-4 flex-shrink-0'} only %}
                                                </button>
                                            {% endif %}
                                            <ul id="{{ submenuId }}" class="iw-menu__list hidden mt-1 space-y-1 {{ twoColumns ? '' : 'text-center' }}">
                                                {% if clickMode == 'selflink' %}
                                                    {# Self-link to the L2 page itself #}
                                                    <li>
                                                        <a
                                                            href="{{ childHref }}"{{ nav.current(childState) }}
                                                            class="iw-menu__text--level-3{{ nav.state_class(childState) }} block text-sm opacity-50 hover:opacity-100 transition-opacity no-underline italic"
                                                        >
                                                            {{ child.title }}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                                {# L3 grandchildren #}
                                                {% for grandchild in child.children %}
                                                    {% set grandchildHref = sulu_content_path(grandchild.url) %}
                                                    {% set grandchildState = iw_sulu_tailwind_theme_nav_state(grandchildHref) %}
                                                    <li>
                                                        <a
                                                            href="{{ grandchildHref }}"{{ nav.current(grandchildState) }}
                                                            class="iw-menu__text--level-3{{ nav.state_class(grandchildState) }} block text-sm opacity-60 hover:opacity-100 transition-opacity no-underline"
                                                        >
                                                            {{ grandchild.title }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                                    {% else %}
                                        {# L2 without children - simple link #}
                                        <li>
                                            <a
                                                href="{{ childHref }}"{{ nav.current(childState) }}
                                                class="iw-menu__text--level-2{{ nav.state_class(childState) }} block text-base md:text-lg opacity-60 hover:opacity-100 transition-opacity no-underline"
                                            >
                                                {{ child.title }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endmacro %}

    {# Macro: logo in overlay — respects admin display toggles.
       transparentSwap is off here: the overlay paints its own opaque background,
       so the transparent-mode variant would be shown over the wrong surface. #}
    {% macro render_overlay_logo(config) %}
        {# Capture first: the wrapper carries padding, so it must not be rendered
           when the toggles are on but no media is actually set. #}
        {% set logoMarkup %}
            {% include '@ItechWorldSuluTailwindTheme/menu/_logo_images.html.twig'
                with { config: config, transparentSwap: false } only %}
        {% endset %}
        {% if logoMarkup|trim is not empty %}
            <div class="flex items-center justify-center pt-4 pb-2">
                {{ logoMarkup }}
            </div>
        {% endif %}
    {% endmacro %}

    {# Macro: social media icons #}
    {% macro render_social_links(socialLinks) %}
        {% include '@ItechWorldSuluTailwindTheme/components/_social_links.html.twig' with {
            links: socialLinks,
            class: 'flex items-center justify-center gap-3 py-6',
            iconClass: 'w-6 h-6',
            textClass: '',
        } only %}
    {% endmacro %}

    {% if fullscreenImageUrl %}
        {# ═══ WITH IMAGE — curtain split: image left, nav+bg right ═══ #}
        {# Panel is transparent (no bg), each volet carries its own content #}
        <div
            id="{{ panelId }}"
            data-menu-target="panel"
            role="dialog"
            aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
            class="iw-menu__dialog iw-menu__dialog--curtain fixed inset-0 z-30"
        >
            <div class="flex h-full">
                {# Left volet — image, slides from the left, full height #}
                <div class="iw-menu__curtain iw-menu__curtain--left w-1/2 h-full overflow-hidden hidden md:block">
                    <img src="{{ fullscreenImageUrl }}" alt="" class="w-full h-full object-cover">
                </div>
                {# Right volet — nav + background, slides from the right #}
                <div class="iw-menu__curtain iw-menu__curtain--right iw-menu__fullscreen-nav iw-menu__overlay-nav--below-bar relative w-full md:w-1/2 h-full overflow-y-auto flex flex-col items-center justify-center">
                    {% if navItems is not empty %}
                        {{ _self.render_nav_items(navItems, twoColumns, clickMode) }}
                    {% endif %}
                    {{ _self.render_overlay_logo(config) }}
                    {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                        with {config: config, display: 'inline', slot: 'panel'} %}
                    {{ _self.render_social_links(socialLinks) }}
                </div>
            </div>
        </div>
    {% else %}
        {# ═══ WITHOUT IMAGE — full panel slides from right ═══ #}
        {# Panel has iw-menu__overlay background, slides as one block #}
        <div
            id="{{ panelId }}"
            data-menu-target="panel"
            role="dialog"
            aria-label="{{ 'iw_sulu_tailwind_theme.menu_dialog'|trans({}, 'messages') }}"
            class="iw-menu__overlay iw-menu__dialog iw-menu__dialog--slide iw-menu__dialog--from-right iw-menu__overlay-nav--below-bar fixed inset-0 z-30 flex flex-col items-center justify-center"
        >
            {% if navItems is not empty %}
                {{ _self.render_nav_items(navItems, twoColumns, clickMode) }}
            {% endif %}
            {{ _self.render_overlay_logo(config) }}
            {% include '@ItechWorldSuluTailwindTheme/menu/_language_switcher.html.twig'
                with {config: config, display: 'inline', slot: 'panel'} %}
            {{ _self.render_social_links(socialLinks) }}
        </div>
    {% endif %}
</header>
