{#
    Menu logo images — desktop and mobile, with their transparent-mode variants.

    Every menu template includes this partial, so the logo markup lives in one
    place: resolving four medias in five templates would be five chances to let
    the variants drift apart.

    When a transparent-mode logo is configured, both variants are rendered
    stacked in the same grid cell and cross-faded by CSS on the
    `.iw-menu--transparent:not(.iw-menu--scrolled)` state — the very state that
    drives the bar background, so the logo never lags behind the background it
    sits on. Without a transparent variant, the markup is the plain <img> it has
    always been.

    Parameters:
    - config: the menuConfig object (required)
    - displayDesktop / displayMobile: override the admin display toggles
      (optional; default to config.displayLogoDesktop / config.displayLogoMobile)
    - transparentSwap: whether the transparent-mode variant applies here
      (optional, default true). Pass false inside overlays and side panels: they
      paint their own opaque background, but they still live under `.iw-menu`,
      so the swap selector would otherwise light up a pale logo over them.
#}
{% set showDesktop = displayDesktop ?? config.displayLogoDesktop|default(false) %}
{% set showMobile = displayMobile ?? config.displayLogoMobile|default(false) %}
{% set allowSwap = transparentSwap ?? true %}

{# Resolve the four medias. A media deleted from the library resolves to null:
   skip that variant rather than rendering a broken image.

   Each variant also tracks whether the URL we ended up with is a raw vector
   file. Sulu does not rasterize SVG uploads, so an SVG logo has no thumbnail
   and is served as-is; if that file declares only a viewBox (no width/height
   attributes) it has no intrinsic size, and `width: auto` next to a bare
   `max-height` resolves to zero inside the flex bar — the logo vanishes. The
   `--vector` modifier gives those an explicit height. The check is deliberately
   "no thumbnail AND svg" rather than just "svg": should a raster thumbnail ever
   exist for an SVG source, we are serving the raster and must not force it. #}
{% set logoDesktopUrl = null %}
{% set logoMobileUrl = null %}
{% set logoDesktopTransparentUrl = null %}
{% set logoMobileTransparentUrl = null %}
{% set logoDesktopVector = false %}
{% set logoMobileVector = false %}
{% set logoDesktopTransparentVector = false %}
{% set logoMobileTransparentVector = false %}

{% if showDesktop and config.logoDesktop.id|default(null) is not null %}
    {% set media = sulu_resolve_media(config.logoDesktop.id, app.request.locale) %}
    {% if media is not null %}
        {% set thumbnail = media.thumbnails['iw_theme_logo_desktop']|default(null) %}
        {% set logoDesktopUrl = thumbnail|default(media.url)|default(null) %}
        {% set logoDesktopVector = thumbnail is null and 'image/svg+xml' == media.mimeType|default('') %}
    {% endif %}
{% endif %}

{% if showMobile and config.logoMobile.id|default(null) is not null %}
    {% set media = sulu_resolve_media(config.logoMobile.id, app.request.locale) %}
    {% if media is not null %}
        {% set thumbnail = media.thumbnails['iw_theme_logo_mobile']|default(null) %}
        {% set logoMobileUrl = thumbnail|default(media.url)|default(null) %}
        {% set logoMobileVector = thumbnail is null and 'image/svg+xml' == media.mimeType|default('') %}
    {% endif %}
{% endif %}

{# Transparent variants only matter when the bar is actually transparent. #}
{% if allowSwap and config.transparentNavbar|default(false) %}
    {% if showDesktop and config.logoTransparentDesktop.id|default(null) is not null %}
        {% set media = sulu_resolve_media(config.logoTransparentDesktop.id, app.request.locale) %}
        {% if media is not null %}
            {% set thumbnail = media.thumbnails['iw_theme_logo_desktop']|default(null) %}
            {% set logoDesktopTransparentUrl = thumbnail|default(media.url)|default(null) %}
            {% set logoDesktopTransparentVector = thumbnail is null and 'image/svg+xml' == media.mimeType|default('') %}
        {% endif %}
    {% endif %}
    {% if showMobile and config.logoTransparentMobile.id|default(null) is not null %}
        {% set media = sulu_resolve_media(config.logoTransparentMobile.id, app.request.locale) %}
        {% if media is not null %}
            {% set thumbnail = media.thumbnails['iw_theme_logo_mobile']|default(null) %}
            {% set logoMobileTransparentUrl = thumbnail|default(media.url)|default(null) %}
            {% set logoMobileTransparentVector = thumbnail is null and 'image/svg+xml' == media.mimeType|default('') %}
        {% endif %}
    {% endif %}
{% endif %}

{% if logoDesktopUrl %}
    {% if logoDesktopTransparentUrl %}
        <span class="iw-menu__logo-swap hidden md:grid">
            <img src="{{ logoDesktopUrl }}" alt=""
                 class="iw-menu__logo--desktop{{ logoDesktopVector ? ' iw-menu__logo--vector' }} iw-menu__logo-state iw-menu__logo-state--default w-auto">
            <img src="{{ logoDesktopTransparentUrl }}" alt=""
                 class="iw-menu__logo--desktop{{ logoDesktopTransparentVector ? ' iw-menu__logo--vector' }} iw-menu__logo-state iw-menu__logo-state--transparent w-auto">
        </span>
    {% else %}
        <img src="{{ logoDesktopUrl }}" alt="" class="iw-menu__logo--desktop{{ logoDesktopVector ? ' iw-menu__logo--vector' }} hidden md:block w-auto">
    {% endif %}
{% endif %}

{% if logoMobileUrl %}
    {% if logoMobileTransparentUrl %}
        <span class="iw-menu__logo-swap grid md:hidden">
            <img src="{{ logoMobileUrl }}" alt=""
                 class="iw-menu__logo--mobile{{ logoMobileVector ? ' iw-menu__logo--vector' }} iw-menu__logo-state iw-menu__logo-state--default w-auto">
            <img src="{{ logoMobileTransparentUrl }}" alt=""
                 class="iw-menu__logo--mobile{{ logoMobileTransparentVector ? ' iw-menu__logo--vector' }} iw-menu__logo-state iw-menu__logo-state--transparent w-auto">
        </span>
    {% else %}
        <img src="{{ logoMobileUrl }}" alt="" class="iw-menu__logo--mobile{{ logoMobileVector ? ' iw-menu__logo--vector' }} block md:hidden w-auto">
    {% endif %}
{% endif %}
