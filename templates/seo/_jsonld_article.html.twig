{#
    JSON-LD structured data for News and Blog articles.
    Generates NewsArticle or BlogPosting schema.org markup.

    Parameters:
    - type: 'NewsArticle' (default) or 'BlogPosting'
#}
{% set schemaType = type|default('NewsArticle') %}

{# Resolve image URL #}
{% set imageUrl = null %}
{# A media deleted from the library resolves to null: skip the image rather than
   taking down the whole page from inside the <head>. #}
{% if extension.excerpt.image is defined and extension.excerpt.image is not empty %}
    {% set imgMedia = sulu_resolve_media(extension.excerpt.image, app.request.locale) %}
    {% if imgMedia is not null %}
        {% set imageUrl = absolute_url(imgMedia.thumbnails['iw_og_image']|default(imgMedia.url)) %}
    {% endif %}
{% elseif content.heroImage is defined and content.heroImage is not empty %}
    {% set heroId = content.heroImage %}
    {% if heroId %}
        {% set imgMedia = sulu_resolve_media(heroId, app.request.locale) %}
        {% if imgMedia is not null %}
            {% set imageUrl = absolute_url(imgMedia.thumbnails['iw_og_image']|default(imgMedia.url)) %}
        {% endif %}
    {% endif %}
{% endif %}

{# Resolve description #}
{% set description = extension.excerpt.description|default('')|striptags|trim %}
{% if description is empty and content.subtitle is defined %}
    {% set description = iw_sulu_tailwind_theme_title_text(content.subtitle)|striptags|trim %}
{% endif %}

{# Build authors array: a Person or an Organization each, with the full name
   whatever the display format, and the website of the Sulu contact card or
   the URL typed for a free name. #}
{% set authorsList = [] %}
{% if articleAuthors is defined and articleAuthors is iterable %}
    {% for author in articleAuthors %}
        {% set party = iw_sulu_tailwind_theme_schema_party(author) %}
        {% if party is not null %}
            {% set authorsList = authorsList|merge([party]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Modification date: the one an editor set in the Settings tab first, then the
   last publication passed by ArticleController. Left out when it does not
   come after the publication date, which would read as a contradiction. #}
{% set modifiedDate = lastModified|default(null) ?: iwContentChanged|default(null) %}
{% if modifiedDate is not null and authored is defined and authored is not empty and modifiedDate < authored %}
    {% set modifiedDate = null %}
{% endif %}

{# Publisher: the site, named and with its logo as set in the theme menu.
   Without a site name there is no Organization to describe. #}
{% set publisherData = null %}
{% set siteConfig = iw_sulu_tailwind_theme_menu_config() %}
{% set siteName = siteConfig.siteName|default('')|trim %}
{% if siteName is not empty %}
    {% set publisherData = {'@type': 'Organization', 'name': siteName, 'url': absolute_url(sulu_content_path('/'))} %}
    {% if siteConfig.logoDesktop.id|default(null) is not null %}
        {% set logoMedia = sulu_resolve_media(siteConfig.logoDesktop.id, app.request.locale) %}
        {% if logoMedia is not null %}
            {% set publisherData = publisherData|merge({'logo': {
                '@type': 'ImageObject',
                'url': absolute_url(logoMedia.thumbnails['iw_theme_logo_desktop']|default(logoMedia.url)),
            }}) %}
        {% endif %}
    {% endif %}
{% endif %}

{# Build categories/tags #}
{% set categories = [] %}
{% if extension.excerpt.categories is defined %}
    {% for cat in extension.excerpt.categories %}
        {% set categories = categories|merge([cat.name|default(cat.title|default(''))]) %}
    {% endfor %}
{% endif %}
{% set keywords = [] %}
{% if extension.excerpt.tags is defined %}
    {% for tag in extension.excerpt.tags %}
        {% set keywords = keywords|merge([tag.name|default(tag)]) %}
    {% endfor %}
{% endif %}

<script type="application/ld+json">
{{ {
    '@context': 'https://schema.org',
    '@type': schemaType,
    'headline': content.title|default(''),
    'datePublished': authored is defined and authored is not empty ? authored|date('c') : null,
    'dateModified': modifiedDate is not null ? modifiedDate|date('c') : null,
    'author': authorsList|length == 1 ? authorsList|first : (authorsList|length > 1 ? authorsList : null),
    'publisher': publisherData,
    'image': imageUrl,
    'description': description is not empty ? description|slice(0, 300) : null,
    'mainEntityOfPage': {
        '@type': 'WebPage',
        '@id': app.request.uri
    },
    'articleSection': categories|length > 0 ? categories|first : null,
    'keywords': keywords|length > 0 ? keywords|join(', ') : null,
}|filter(v => v is not null)|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_PRETTY_PRINT'))|raw }}
</script>
