{#
    JSON-LD structured data for BreadcrumbList.
    Generates schema.org BreadcrumbList from navigation items.

    Parameters:
    - items: array of {title, url} objects (breadcrumb trail)

    An item without a name is dropped: Google rejects the whole list over a
    single empty "name". Positions stay consecutive.
#}
{% set named = (items is defined and items is iterable ? items : [])|filter(item => item.title|default('')|trim is not empty) %}
{% if named|length > 0 %}
{% set listItems = [] %}
{% for item in named %}
    {% set listItem = {
        '@type': 'ListItem',
        'position': loop.index,
        'name': item.title|trim,
    } %}
    {% if not loop.last and item.url|default('') is not empty %}
        {% set listItem = listItem|merge({'item': absolute_url(item.url)}) %}
    {% endif %}
    {% set listItems = listItems|merge([listItem]) %}
{% endfor %}

<script type="application/ld+json">
{{ {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': listItems,
}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_PRETTY_PRINT'))|raw }}
</script>
{% endif %}
