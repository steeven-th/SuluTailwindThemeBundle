{#
    JSON-LD structured data for Event articles.
    Generates Event schema.org markup with location/organizer.
#}

{# Resolve image URL #}
{% set imageUrl = null %}
{# A media deleted from the library resolves to null: skip the image rather than
   taking down the whole page from inside the <head>. #}
{% if extension.excerpt.image is defined and extension.excerpt.image is not empty %}
    {% set imgMedia = sulu_resolve_media(extension.excerpt.image, app.request.locale) %}
    {% if imgMedia is not null %}
        {% set imageUrl = absolute_url(imgMedia.thumbnails['iw_og_image']|default(imgMedia.url)) %}
    {% endif %}
{% elseif content.heroImage is defined and content.heroImage is not empty %}
    {% set heroId = content.heroImage %}
    {% if heroId %}
        {% set imgMedia = sulu_resolve_media(heroId, app.request.locale) %}
        {% if imgMedia is not null %}
            {% set imageUrl = absolute_url(imgMedia.thumbnails['iw_og_image']|default(imgMedia.url)) %}
        {% endif %}
    {% endif %}
{% endif %}

{# Resolve description #}
{% set description = extension.excerpt.description|default('')|striptags|trim %}
{% if description is empty and content.subtitle is defined %}
    {% set description = iw_sulu_tailwind_theme_title_text(content.subtitle)|striptags|trim %}
{% endif %}

{# Event times are wall-clock readings: iw_sulu_tailwind_theme_event_datetime()
   attaches the site's events.timezone without converting them, where the
   `date` filter would print them in PHP's zone. #}

{# Attendance mode #}
{% set isOnline = content.isOnline|default(false) %}
{% set attendanceMode = isOnline ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode' %}

{# Location #}
{% set locationData = null %}
{% if isOnline and content.locationUrl is defined and content.locationUrl is not empty %}
    {% set locationData = {
        '@type': 'VirtualLocation',
        'url': content.locationUrl,
    } %}
{% elseif not isOnline and content.location is defined and content.location is iterable %}
    {% set place = content.location %}
    {% set placeName = place.title|default('')|trim %}
    {% set street = [place.number|default('')|trim, place.street|default('')|trim]|filter(v => v is not empty)|join(' ') %}
    {% set postalAddress = {
        '@type': 'PostalAddress',
        'streetAddress': street,
        'postalCode': place.code|default('')|trim,
        'addressLocality': place.town|default('')|trim,
        'addressCountry': place.country|default('')|trim,
    }|filter(v => v is not empty) %}
    {# Google expects an address on every Place. A location carried over from
       the former free-text field has a name and nothing else, and the name is
       then the best address there is. #}
    {% set address = postalAddress|length > 1 ? postalAddress : (placeName is not empty ? placeName : null) %}
    {% if placeName is not empty or address is not null %}
        {% set locationData = {
            '@type': 'Place',
            'name': placeName is not empty ? placeName : iw_sulu_tailwind_theme_location_address(place)|split("\n")|first,
            'address': address,
        }|filter(v => v is not null) %}
        {% if place.lat|default(null) is not null and place.long|default(null) is not null %}
            {% set locationData = locationData|merge({'geo': {
                '@type': 'GeoCoordinates',
                'latitude': place.lat,
                'longitude': place.long,
            }}) %}
        {% endif %}
    {% endif %}
{% endif %}

{# Organizer #}
{% set organizerData = null %}
{% if content.organizer is defined and content.organizer is iterable and content.organizer|length > 0 %}
    {% set org = content.organizer|first %}
    {% set orgName = iw_sulu_tailwind_theme_author_name(org) %}
    {% if orgName is not empty %}
        {% set orgType = org.type|default('custom') == 'organization' ? 'Organization' : 'Person' %}
        {% set organizerData = {'@type': orgType, 'name': orgName} %}
        {% if org.url is defined and org.url is not empty %}
            {% set organizerData = organizerData|merge({'url': org.url}) %}
        {% endif %}
    {% endif %}
{% endif %}

<script type="application/ld+json">
{{ {
    '@context': 'https://schema.org',
    '@type': 'Event',
    'name': content.title|default(''),
    'startDate': iw_sulu_tailwind_theme_event_datetime(content.startDate|default(null))|default(null),
    'endDate': iw_sulu_tailwind_theme_event_datetime(content.endDate|default(null))|default(null),
    'eventAttendanceMode': attendanceMode,
    'eventStatus': 'https://schema.org/EventScheduled',
    'location': locationData,
    'image': imageUrl,
    'description': description is not empty ? description|slice(0, 300) : null,
    'organizer': organizerData,
}|filter(v => v is not null)|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_PRETTY_PRINT'))|raw }}
</script>
